+// The letter sounds of the UNOWN move. The music drops to a third while a letter
+// sounds, the same as it does for a cry, and comes back when no new letter has
+// started for LETTER_BGM_FRAMES frames. The mixer adds its channels with no limit
+// (a sum past 127 wraps round and crackles), and the battle music alone reaches
+// 115 of 127, so a full scale letter only has room when the music is low.
+// Measured in the mixer: a letter reaches 86 on a side, the low music 38 at most.
+#define LETTER_BGM_VOLUME 85    // of 256, the value used for a cry
+#define LETTER_BGM_FRAMES 10    // a letter lasts 7 frames and its sample ends after 9
+#define LETTER_MONO_VOLUME 352  // of 256: in the middle, each side as loud as the near side is in STEREO
+
+static void Task_DuckBGMForLetters(u8 taskId)
+{
+    if (gTasks[taskId].data[0] != 0)
+    {
+        gTasks[taskId].data[0]--;
+        return;
+    }
+
+    // A cry that is still playing keeps the music low and brings it back itself.
+    if (FuncIsActiveTask(Task_DuckBGMForPokemonCry) != TRUE)
+        m4aMPlayVolumeControl(&gMPlayInfo_BGM, TRACKS_ALL, 256);
+    DestroyTask(taskId);
+}
+
+void PlayLetterSEWithPanning(u16 songNum, s8 pan)
+{
+    u8 taskId;
+
+    if (FuncIsActiveTask(Task_DuckBGMForLetters) != TRUE)
+        CreateTask(Task_DuckBGMForLetters, 80);
+    taskId = FindTaskIdByFunc(Task_DuckBGMForLetters);
+    if (taskId != TASK_NONE) // with no free task the letter plays over the music as it is
+    {
+        gTasks[taskId].data[0] = LETTER_BGM_FRAMES;
+        m4aMPlayVolumeControl(&gMPlayInfo_BGM, TRACKS_ALL, LETTER_BGM_VOLUME);
+    }
+    else
+    {
+        PlaySE12WithPanning(songNum, pan);
+        return;
+    }
+
+    if (gSaveBlock2Ptr->optionsSound == OPTIONS_SOUND_MONO)
+    {
+        // MONO sends both sides to both speakers at half strength, so the side a sound
+        // is on cannot be heard and a sound on one side is only heard at part strength.
+        // The letter plays in the middle instead, at full strength on both sides.
+        PlaySE12WithPanning(songNum, 0);
+        m4aMPlayVolumeControl(&gMPlayInfo_SE1, TRACKS_ALL, LETTER_MONO_VOLUME);
+    }
+    else
+    {
+        PlaySE12WithPanning(songNum, pan);
+    }
+}
