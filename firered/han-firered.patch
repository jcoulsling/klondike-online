+def english_table(groups, rules):
+    """Makes the table the game uses to spell English words by their sound in syllabics
+    (tools/han/han_english_table.py), without the words that are Hän in this translation.
+    Returns those words, the rows that are written in English, and the English words of
+    those rows that the list of sounds does not have."""
+    import han_english_table as T
+    rows = [(g.english, g.final) for g in groups.values() if g.final is not None and g.final != g.english]
+    rows += [(english, han) for english, han in rules.items() if han]
+    han, prose, missing = T.han_words(rows)
+    T.write(han)
+    return sorted(han), prose, sorted(missing)
+
+
+def make():
+    import os
+    proc = subprocess.run(["make", "-j%d" % (os.cpu_count() or 2)], cwd=ROOT, capture_output=True, text=True)
+    return proc.returncode, proc.stdout + proc.stderr
+
+
+def too_long_units(log, placed):
+    """Units the compiler rejected because the text overran a fixed-size slot."""
+    found = []
+    for m in re.finditer(r"^(\S+?):(\d+): (?:warning|error): (?:excess elements|initializer-string)", log, re.M):
+        path, line = m.group(1), int(m.group(2))
+        for (first, last), u in placed.get(path, []):
+            if first <= line <= last:
+                found.append(u)
+    return found
+
+
+# The widest line Game Freak put in a text box is 196 px (measured over every map's
+# dialogue with the game's own glyph widths). Wrapped lines stay within that.
+DIALOGUE_PX = 196
+
+
+def load(max_px=DIALOGUE_PX):
+    cm = Charmap()
+    units = scan_all()
+    groups, skipped = build_groups(units, cm)
+    return cm, units, groups, Wrapper(cm, max_px)
