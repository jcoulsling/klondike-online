+    "Y": ["#.#", "#.#", "#.#", ".#.", ".#.", ".#.", ".#."],
+    "Z": ["####", "...#", "..#.", ".#..", "#...", "#...", "####"],
+    "-": ["...", "...", "...", "###", "...", "...", "..."],
+    "'": [".#", ".#", "#.", "..", "..", "..", ".."],
