diff --git a/tools/han/shot/harness.c b/tools/han/shot/harness.c
new file mode 100644
index 0000000..35fff30
--- /dev/null
+++ b/tools/han/shot/harness.c
@@ -0,0 +1,223 @@
+// Headless mGBA runner: executes a tiny script of waits, key presses and screenshots.
+#include <mgba/core/core.h>
+#include <mgba/core/config.h>
+#include <mgba/core/serialize.h>
+#include <mgba/core/log.h>
+#include <mgba-util/vfs.h>
+#include <mgba/core/blip_buf.h>
+#include <mgba/internal/arm/arm.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static void nolog(struct mLogger* l, int cat, enum mLogLevel lvl, const char* fmt, va_list args) { (void)l;(void)cat;(void)lvl;(void)fmt;(void)args; }
+static struct mLogger sLogger = { .log = nolog };
+
+#define AUDIO_RATE 32768
+static FILE* sAudio;                                 /* audio FILE : the game's sound goes to FILE from now on */
+static long frames = 0;
+#define CALL_MAX 200000
+static unsigned sCallAddr;                           /* callson ADDR : from now on, note r0 and r1 at every call of the function at ADDR */
+static unsigned sCalls[CALL_MAX][2];                 /* callsdump label : print the calls noted so far on one line, and forget them */
+static int sCallCount;                               /* callsoff : stop noting */
+
+/* One frame. The sound of the frame is read every time, and written if a file is open:
+   16 bit, two channels, AUDIO_RATE samples a second, no header. */
+static void step(struct mCore* core) {
+    static int16_t samples[2 * 4096];
+    struct blip_t* left = core->getAudioChannel(core, 0);
+    struct blip_t* right = core->getAudioChannel(core, 1);
+    if (sCallAddr) {                                /* callson: one instruction at a time, noting each call of the function */
+        struct ARMCore* cpu = core->cpu;
+        uint32_t f = core->frameCounter(core);
+        while (core->frameCounter(core) == f) {
+            if ((unsigned) cpu->gprs[15] - 2 == sCallAddr && sCallCount < CALL_MAX) {
+                sCalls[sCallCount][0] = cpu->gprs[0]; sCalls[sCallCount][1] = cpu->gprs[1]; sCallCount++;
+            }
+            core->step(core);
+        }
+    } else {
+        core->runFrame(core);
+    }
+    frames++;
+    int n = blip_samples_avail(left);
+    if (n > 4096) n = 4096;
+    blip_read_samples(left, samples, n, 1);
+    blip_read_samples(right, samples + 1, n, 1);
+    if (sAudio) fwrite(samples, 4, n, sAudio);
+}
+
+static void audiorate(struct mCore* core) {
+    blip_set_rates(core->getAudioChannel(core, 0), core->frequency(core), AUDIO_RATE);
+    blip_set_rates(core->getAudioChannel(core, 1), core->frequency(core), AUDIO_RATE);
+}
+
+static int keybit(const char* k) {
+    const char* names[] = {"A","B","SELECT","START","RIGHT","LEFT","UP","DOWN","R","L"};
+    int bits = 0;                                   /* several keys at once: A+B+START+SELECT */
+    char tmp[64]; strncpy(tmp, k, 63); tmp[63] = 0;
+    for (char* t = strtok(tmp, "+"); t; t = strtok(NULL, "+"))
+        for (int i = 0; i < 10; i++) if (!strcmp(t, names[i])) bits |= 1 << i;
+    return bits;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 3) { fprintf(stderr, "usage: harness rom script\n"); return 1; }
+    mLogSetDefaultLogger(&sLogger);
+    struct mCore* core = mCoreFind(argv[1]);
+    if (!core) { fprintf(stderr, "no core\n"); return 1; }
+    core->init(core);
+    mCoreInitConfig(core, NULL);
+    unsigned w, h;
+    core->desiredVideoDimensions(core, &w, &h);
+    color_t* buf = malloc(w * h * sizeof(color_t));
+    core->setVideoBuffer(core, buf, w);
+    if (!mCoreLoadFile(core, argv[1])) { fprintf(stderr, "load failed\n"); return 1; }
+    core->reset(core);
+    audiorate(core);
+    FILE* f = fopen(argv[2], "r");
+    char cmd[64], arg[512]; int n;
+    char line[1024];
+    while (fgets(line, sizeof line, f)) {
+        if (line[0] == '#' || line[0] == '\n') continue;
+        n = 0; arg[0] = 0;
+        sscanf(line, "%63s %511s %d", cmd, arg, &n);
+        if (!strcmp(cmd, "wait")) {
+            n = atoi(arg);
+            core->setKeys(core, 0);
+            for (int i = 0; i < n; i++) { step(core); }
+        } else if (!strcmp(cmd, "press")) {
+            if (n <= 0) n = 6;
+            core->setKeys(core, keybit(arg));
+            for (int i = 0; i < n; i++) { step(core); }
+            core->setKeys(core, 0);
+            for (int i = 0; i < 6; i++) { step(core); }
+        } else if (!strcmp(cmd, "reset")) {             /* reset : like switching off and on. The save file stays */
+            core->reset(core);
+            audiorate(core);
+        } else if (!strcmp(cmd, "audio")) {             /* audio FILE : record the sound. audio off : stop */
+            if (sAudio) fclose(sAudio);
+            sAudio = strcmp(arg, "off") ? fopen(arg, "wb") : NULL;
+        } else if (!strcmp(cmd, "trace")) {             /* trace ADDR N FRAMES label : run FRAMES frames, print the N bytes each time they change */
+            unsigned addr = strtoul(arg, NULL, 16), nf = 0; char lab[64] = "";
+            unsigned long long last = ~0ULL;
+            sscanf(line, "%*s %*s %*d %u %63s", &nf, lab);
+            for (unsigned fr = 0; fr < nf; fr++) {
+                unsigned long long v = 0;
+                step(core);
+                for (int i = 0; i < n && i < 8; i++) v |= (unsigned long long) core->rawRead8(core, addr + i, -1) << (8 * i);
+                if (v != last) { printf("%s %ld: %llx\n", lab, frames, v); last = v; }
+            }
+        } else if (!strcmp(cmd, "shot")) {
+            FILE* o = fopen(arg, "wb");
+            fprintf(o, "P6\n%u %u\n255\n", w, h);
+            for (unsigned i = 0; i < w * h; i++) {
+                unsigned c = buf[i];
+                fputc(c & 0xFF, o); fputc((c >> 8) & 0xFF, o); fputc((c >> 16) & 0xFF, o);
+            }
+            fclose(o);
+        } else if (!strcmp(cmd, "poke16")) {            /* poke16 ADDR VALUE (hex) */
+            unsigned addr = strtoul(arg, NULL, 16), val = 0; char a2[64];
+            sscanf(line, "%*s %*s %63s", a2); val = strtoul(a2, NULL, 16);
+            core->rawWrite8(core, addr, -1, val & 0xFF); core->rawWrite8(core, addr + 1, -1, (val >> 8) & 0xFF);
+        } else if (!strcmp(cmd, "watch")) {             /* watch ADDR MAXSTEPS label : run one instruction at a time until the
+                                                           32 bit word at ADDR changes. Prints where the game was: pc, lr, r0 to r3. */
+            unsigned addr = strtoul(arg, NULL, 16); char lab[64] = "";
+            sscanf(line, "%*s %*s %*d %63s", lab);
+            struct ARMCore* cpu = core->cpu;
+            unsigned before = 0;
+            for (int i = 0; i < 4; i++) before |= (unsigned) core->rawRead8(core, addr + i, -1) << (8 * i);
+            long steps = 0; int hit = 0;
+            for (; steps < n; steps++) {
+                unsigned pc = cpu->gprs[15];
+                core->step(core);
+                unsigned now = 0;
+                for (int i = 0; i < 4; i++) now |= (unsigned) core->rawRead8(core, addr + i, -1) << (8 * i);
+                if (now != before) {
+                    printf("%s: changed %08x to %08x after %ld steps; pc %08x lr %08x r0 %08x r1 %08x r2 %08x r3 %08x sp %08x\n", lab, before, now, steps,
+                           pc, (unsigned) cpu->gprs[14], (unsigned) cpu->gprs[0], (unsigned) cpu->gprs[1], (unsigned) cpu->gprs[2], (unsigned) cpu->gprs[3], (unsigned) cpu->gprs[13]);
+                    hit = 1; break;
+                }
+            }
+            if (!hit) printf("%s: no change in %ld steps\n", lab, steps);
+        } else if (!strcmp(cmd, "callson")) {
+            sCallAddr = strtoul(arg, NULL, 16) & ~1u;
+        } else if (!strcmp(cmd, "callsoff")) {
+            sCallAddr = 0;
+        } else if (!strcmp(cmd, "callsdump")) {
+            printf("%s:", arg);
+            for (int i = 0; i < sCallCount; i++) printf(" %x,%x", sCalls[i][0], sCalls[i][1]);
+            printf("\n");
+            sCallCount = 0;
+        } else if (!strcmp(cmd, "keys")) {              /* keys A+B : hold these keys from now on, without running a frame. keys NONE lets go. */
+            core->setKeys(core, keybit(arg));
+        } else if (!strcmp(cmd, "calls")) {             /* calls ADDR MAXSTEPS label : run one instruction at a time for MAXSTEPS
+                                                           instructions. Each time the game is about to run the instruction at
+                                                           ADDR (the start of a function), prints r0 and r1. One line in all. */
+            unsigned addr = strtoul(arg, NULL, 16) & ~1u; char lab[64] = "";
+            sscanf(line, "%*s %*s %*d %63s", lab);
+            struct ARMCore* cpu = core->cpu;
+            printf("%s:", lab);
+            for (long steps = 0; steps < n; steps++) {
+                if ((unsigned) cpu->gprs[15] - 2 == addr)
+                    printf(" %x,%x", (unsigned) cpu->gprs[0], (unsigned) cpu->gprs[1]);
+                core->step(core);
+            }
+            printf("\n");
+        } else if (!strcmp(cmd, "poke8")) {             /* poke8 ADDR VALUE (hex) */
+            unsigned addr = strtoul(arg, NULL, 16), val = 0; char a2[64];
+            sscanf(line, "%*s %*s %63s", a2); val = strtoul(a2, NULL, 16);
+            core->rawWrite8(core, addr, -1, val & 0xFF);
+        } else if (!strcmp(cmd, "peek")) {              /* peek ADDR N label : prints N bytes */
+            unsigned addr = strtoul(arg, NULL, 16); char lab[64] = "";
+            sscanf(line, "%*s %*s %*d %63s", lab);
+            printf("%s:", lab);
+            for (int i = 0; i < n; i++) printf(" %02x", core->rawRead8(core, addr + i, -1));
+            printf("\n");
+        } else if (!strcmp(cmd, "peekpath")) {          /* peekpath ADDR N label OFF1 [OFF2] : follow one or two pointers, then print N bytes.
+                                                           The bytes are at *(u32*)ADDR + OFF1, or at *(u32*)(*(u32*)ADDR + OFF1) + OFF2 */
+            unsigned addr = strtoul(arg, NULL, 16); char lab[64] = "", o1[32] = "", o2[32] = "";
+            int k = sscanf(line, "%*s %*s %*d %63s %31s %31s", lab, o1, o2);
+            for (int j = 0; j < k - 1; j++) {
+                unsigned ptr = 0;
+                for (int i = 0; i < 4; i++) ptr |= (unsigned) core->rawRead8(core, addr + i, -1) << (8 * i);
+                addr = ptr + strtoul(j ? o2 : o1, NULL, 16);
+            }
+            printf("%s:", lab);
+            for (int i = 0; i < n; i++) printf(" %02x", core->rawRead8(core, addr + i, -1));
+            printf("\n");
+        } else if (!strcmp(cmd, "peekptr")) {           /* peekptr PTRADDR OFFSET label : one byte at *(u32*)PTRADDR + OFFSET */
+            unsigned paddr = strtoul(arg, NULL, 16), off = 0; char a2[64], lab[64] = "";
+            sscanf(line, "%*s %*s %63s %63s", a2, lab); off = strtoul(a2, NULL, 16);
+            unsigned ptr = 0;
+            for (int i = 0; i < 4; i++) ptr |= (unsigned) core->rawRead8(core, paddr + i, -1) << (8 * i);
+            printf("%s: %02x\n", lab, core->rawRead8(core, ptr + off, -1));
+        } else if (!strcmp(cmd, "pokeptr8")) {          /* pokeptr8 PTRADDR OFFSET VAL : one byte at *(u32*)PTRADDR + OFFSET */
+            unsigned paddr = strtoul(arg, NULL, 16), off = 0, val = 0; char a2[64], a3[64];
+            sscanf(line, "%*s %*s %63s %63s", a2, a3); off = strtoul(a2, NULL, 16); val = strtoul(a3, NULL, 16);
+            unsigned ptr = 0;
+            for (int i = 0; i < 4; i++) ptr |= (unsigned) core->rawRead8(core, paddr + i, -1) << (8 * i);
+            core->rawWrite8(core, ptr + off, -1, val & 0xFF);
+        } else if (!strcmp(cmd, "until")) {             /* until ADDR MASK MAXFRAMES KEY1 KEY2 : alternate keys until (mem & mask) != 0 */
+            unsigned addr = strtoul(arg, NULL, 16), mask = 0, maxf = 0; char k1[16], k2[16];
+            sscanf(line, "%*s %*s %x %u %15s %15s", &mask, &maxf, k1, k2);
+            unsigned f = 0; int which = 0, hit = 0;
+            while (f < maxf && !hit) {
+                core->setKeys(core, keybit(which ? k2 : k1));
+                for (int i = 0; i < 20 && !hit; i++) { step(core); f++; if (core->rawRead8(core, addr, -1) & mask) hit = 1; }
+                which = !which;
+            }
+            core->setKeys(core, 0);
+            printf("until: %s after %u frames\n", hit ? "hit" : "timeout", f);
+        } else if (!strcmp(cmd, "savestate")) {
+            struct VFile* vf = VFileOpen(arg, O_CREAT | O_TRUNC | O_RDWR);
+            mCoreSaveStateNamed(core, vf, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
+            vf->close(vf);
+        } else if (!strcmp(cmd, "loadstate")) {
+            struct VFile* vf = VFileOpen(arg, O_RDONLY);
+            if (vf) { mCoreLoadStateNamed(core, vf, SAVESTATE_SAVEDATA | SAVESTATE_RTC); vf->close(vf); }
+        }
+    }
+    fprintf(stderr, "ran %ld frames\n", frames);
+    return 0;
+}
diff --git a/tools/han/syllabics_test.c b/tools/han/syllabics_test.c
new file mode 100644
index 0000000..34ef580
--- /dev/null
+++ b/tools/han/syllabics_test.c
@@ -0,0 +1,64 @@
+/* Runs the game's syllabics converter on a computer, to check it against Jane's word processor.
+
+       gcc -O1 -o syllabics_test tools/han/syllabics_test.c
+       ./syllabics_test < bytes.txt
+
+   Each line of the input is a string of game text as hex bytes. For each line it prints the pieces the
+   game would show: G<glyph> for a syllabics glyph, with +<marks> when signs follow it; L<byte> for a
+   character shown the usual way. Pieces that show nothing print nothing.
+   tools/han/han_syllabics_check.py makes the input from real strings and compares the output
+   with the word processor. */
+#include <stdio.h>
+#include <string.h>
+
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned char bool8;
+#define TRUE 1
+#define FALSE 0
+
+#include "../../src/data/han_syllabics.h"
+#include "../../src/han_syllabics_core.h"
+
+int main(void)
+{
+    static char line[20000];
+    static u8 text[10000];
+
+    while (fgets(line, sizeof line, stdin))
+    {
+        size_t n = 0, len = strlen(line);
+        const u8 *s;
+        unsigned v;
+
+        for (size_t i = 0; i + 1 < len && sscanf(line + i, "%2x", &v) == 1; i += 2)
+            text[n++] = (u8)v;
+        text[n] = 0xFF;
+        text[n + 1] = text[n + 2] = text[n + 3] = text[n + 4] = 0xFF;
+        for (s = text; *s != 0xFF; )
+        {
+            u16 glyph;
+            u8 used, marks;
+
+            switch (HanSyl_Next(s, &glyph, &used, &marks))
+            {
+            case HAN_SYL_GLYPH:
+                if (marks)
+                    printf("G%d+%d ", glyph, marks);
+                else
+                    printf("G%d ", glyph);
+                s += used;
+                break;
+            case HAN_SYL_SKIP:
+                s += used;
+                break;
+            default:
+                printf("L%02X ", *s);
+                s++;
+                break;
+            }
+        }
+        printf("\n");
+    }
+    return 0;
+}
diff --git a/tools/han/translator_template.html b/tools/han/translator_template.html
new file mode 100644
index 0000000..5d9eaa9
--- /dev/null
+++ b/tools/han/translator_template.html
@@ -0,0 +1,419 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Hän FireRed translator</title>
+<style>
+:root{--bg:#f6f4ef;--card:#fff;--ink:#1f2328;--soft:#5d6570;--line:#d9d5cc;--accent:#2f6f5e;--warn:#b3261e;--done:#e7f3ee;--chip:#ece8df;--tok:#8a5a00}
+@media (prefers-color-scheme:dark){:root{--bg:#17191c;--card:#22252a;--ink:#e8e6e1;--soft:#a2a8b0;--line:#3a3f46;--accent:#6fc3ab;--warn:#ff8a80;--done:#1d2f2a;--chip:#2c3036;--tok:#e0b25c}}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 "Charis SIL","Gentium Plus","Noto Sans","Segoe UI",system-ui,sans-serif}
+header{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 16px}
+h1{font-size:18px;margin:0 0 6px}
+.bar{height:8px;background:var(--chip);border-radius:4px;overflow:hidden;margin:4px 0}
+.bar i{display:block;height:100%;background:var(--accent);width:0}
+.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px}
+input[type=search],select,button,textarea{font:inherit;color:inherit;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 9px}
+input[type=search]{flex:1 1 220px;min-width:0}
+button{cursor:pointer}
+button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
+button.small{padding:2px 8px;font-size:14px}
+.note{color:var(--soft);font-size:14px}
+.unsaved{color:var(--warn);font-weight:600}
+main{padding:12px 16px 60px;max-width:1100px;margin:0 auto}
+.item{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin:10px 0;display:grid;grid-template-columns:1fr 1fr;gap:12px}
+.item.done{background:var(--done)}
+@media (max-width:760px){.item{grid-template-columns:1fr}}
+.meta{font-size:13px;color:var(--soft);margin-bottom:4px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
+.chip{background:var(--chip);border-radius:10px;padding:1px 8px}
+.chip.hot{background:var(--accent);color:#fff}
+.en{white-space:pre-wrap;overflow-wrap:anywhere}
+.en .tok{color:var(--tok);font-size:.85em}
+.now{margin-top:6px;font-size:14px;color:var(--soft);white-space:pre-wrap;overflow-wrap:anywhere}
+textarea{width:100%;min-height:58px;resize:vertical}
+.under{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px;color:var(--soft);margin-top:4px}
+.over{color:var(--warn);font-weight:600}
+.keys{display:flex;flex-wrap:wrap;gap:4px}
+.keys button{padding:2px 8px;min-width:30px}
+#more{display:block;margin:16px auto}
+[hidden]{display:none!important}
+dialog{border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);max-width:640px;width:92vw}
+table{border-collapse:collapse;width:100%}
+td,th{border-bottom:1px solid var(--line);padding:4px 6px;text-align:left}
+td input{width:100%;font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:3px 6px}
+footer{max-width:1100px;margin:0 auto;padding:0 16px 40px;color:var(--soft);font-size:14px}
+footer h2{font-size:15px;color:var(--ink)}
+</style>
+</head>
+<body>
+<header>
+  <h1>Hän FireRed translator</h1>
+  <div class="note" id="progress"></div>
+  <div class="bar"><i id="barfill"></i></div>
+  <div class="row">
+    <input type="search" id="q" placeholder="Search English or Hän">
+    <select id="show" title="Which rows"><option value="todo">Not done yet</option><option value="done">Done</option><option value="all">All</option></select>
+    <select id="section" title="Kind of text"></select>
+    <select id="sort" title="Order"><option value="p">Most important first</option><option value="u">Most used first</option><option value="o">Play order</option></select>
+    <label class="note"><input type="checkbox" id="outside"> Show text outside the plan</label>
+  </div>
+  <div class="row">
+    <button class="primary" id="save">Save file</button>
+    <button id="open">Open file</button>
+    <button id="rulesBtn">Word rules</button>
+    <input type="file" id="file" accept=".json" hidden>
+    <span class="note" id="status"></span>
+    <span class="keys" id="keys"></span>
+  </div>
+</header>
+<main id="list"></main>
+<button id="more" hidden>Show more</button>
+
+<dialog id="rules">
+  <h2 style="margin-top:0">Word rules</h2>
+  <p class="note">A word rule swaps one English word for one Hän word wherever that word stands alone, matching its case. A row you typed always wins over a rule.</p>
+  <table><thead><tr><th>English word</th><th>Hän</th><th></th></tr></thead><tbody id="rulesBody"></tbody></table>
+  <div class="row"><button id="addRule">Add a rule</button><button class="primary" id="closeRules">Done</button></div>
+</dialog>
+
+<footer>
+  <p>Your work is kept in this browser as you type. Use <b>Save file</b> often: the file is your real copy, and it is what gets built into the game.</p>
+  <p>A line whose English is the same as one you already typed is filled for you, here and in the game. It only needs typing if that place should say something different.</p>
+  <p><b>What the game shows.</b> Where the English is in ALL CAPS, the Hän is shown in capitals, however it was typed. A letter typed twice in a row is shown once (aa as a, yy as y), and a vowel typed twice with different marks keeps the first one. tth stays tth. English words are left alone. What you typed is kept as it is; a row says so when the game will show it differently.</p>
+  <p><b>Copy English</b> puts the English into a line as it is, for a line that should stay English. It counts as typed.</p>
+  <p><b>The plan</b> is everything except side features, trainer classes and names, item names, Pokémon names, abilities and natures. Text outside the plan stays English unless you type it. It is listed only when it is typed, or when "Show text outside the plan" is ticked. Side features are the help system, Fame Checker, VS Seeker rematch lines, cable club and union room, trainer card, Teachy TV, mystery events, Trainer Tower, easy chat words, the quest log, and a few lists the game never shows.</p>
+  <p>How rows are ordered: text that is on screen all the time comes first (battle messages, menus, type and move names), then the story in play order, then descriptions, then side features. Within each group, a string used in more places comes first.</p>
+  <h2>A note on the use of an LLM (AI assistant)</h2>
+  <p>An AI assistant (Claude) wrote this tool and the ordering of the rows. It did not write any Hän. Every Hän word here was typed by a person. Lines marked "In the game now" are English with the word rules applied. Contact: jcouls.ling@gmail.com</p>
+</footer>
+
+<script id="data" type="application/json">/*DATA*/</script>
+<script>
+"use strict";
+const DATA = JSON.parse(document.getElementById("data").textContent);
+const ROWS = DATA.rows.map((r, i) => ({i, e: r[0], sec: DATA.sections[r[1]], fam: DATA.families[r[2]], used: r[3], where: r[4], limit: r[5], tier: r[6], order: r[7], now: r[8], base: r[9], plan: r[10] !== 0}));
+const KEY = r => r.fam + "\u0001" + r.e;
+const STORE = "han-firered-translator-v1";
+let typed = {};            // key -> Hän
+let rules = DATA.rules.map(r => ({e: r[0], h: r[1]}));
+let dirty = false, shown = 0, view = [];
+const PAGE = 40;
+
+ROWS.forEach(r => { if (r.base) typed[KEY(r)] = r.base; });
+try {
+  const saved = JSON.parse(localStorage.getItem(STORE) || "null");
+  if (saved && saved.typed) { Object.assign(typed, saved.typed); if (saved.rules) rules = saved.rules; dirty = !!saved.dirty; }
+} catch (e) {}
+// A page made from a corrected file carries the corrections. Where this browser
+// still holds the older text of a row, it takes the newer text. A row that was
+// changed since then is left as it is.
+for (const [fam, eng, was, now] of DATA.fixes || []) {
+  const k = fam + "\u0001" + eng;
+  if (typed[k] === was) { typed[k] = now; dirty = true; }
+}
+
+const $ = id => document.getElementById(id);
+const esc = s => s.replace(/[&<>]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;"}[c]));
+const showEnglish = s => esc(s).replace(/\{[^}]*\}/g, m => '<span class="tok">' + m + "</span>");
+const letters = s => Array.from(s.normalize("NFD")).filter(c => !/[̀-ͯ]/.test(c)).length;
+const loose = s => s.replace(/\{PARA\}|\{SCROLL\}|\n/g, " ").toLowerCase().replace(/[^a-z0-9{}_é]+/g, "");
+
+// ---- What the game shows for typed Hän. The build does the same, so keep the two alike.
+//   - a letter typed twice in a row is shown once; a vowel typed twice with
+//     different marks keeps the first; tth and ddh stay; English words are left alone
+//   - where the English is in ALL CAPS, the Hän is put in capitals
+const ENGLISH = new Set(DATA.english || []);
+const TOKEN_RE = /\{[^}]*\}/g;
+const WORD_RE = /(?:\p{L}\p{M}*)+(?:[’'ʼ\-](?:\p{L}\p{M}*)+)*/gu;
+const stripTokens = s => s.replace(TOKEN_RE, "");
+function outsideTokens(s, fn) {
+  let out = "", last = 0;
+  for (const m of s.matchAll(TOKEN_RE)) { out += fn(s.slice(last, m.index)) + m[0]; last = m.index + m[0].length; }
+  return out + fn(s.slice(last));
+}
+const wordKey = w => w.normalize("NFC").toLowerCase().replace(/[’ʼ]/g, "'");
+function clustersOf(s) {
+  const out = [];
+  for (const ch of s) { if (out.length && /\p{M}/u.test(ch)) out[out.length - 1] += ch; else out.push(ch); }
+  return out;
+}
+function clusterKey(c) {
+  const d = [...c.normalize("NFD").toLowerCase()];
+  return [d[0], [...new Set(d.slice(1))].sort().join("")];
+}
+function singleWord(word) {
+  const cl = clustersOf(word), keys = cl.map(clusterKey), out = [], outKeys = [];
+  for (let i = 0; i < cl.length; i++) {
+    const k = keys[i], last = outKeys[outKeys.length - 1];
+    if (last && /\p{L}/u.test(k[0]) && k[0] === last[0]) {
+      const same = k[1] === last[1];
+      if (same && "td".includes(k[0]) && !k[1] && i + 1 < cl.length && keys[i + 1][0] === "h") { /* tth, ddh: keep */ }
+      else if (same || "aeiou".includes(k[0])) continue;
+    }
+    out.push(cl[i]); outKeys.push(k);
+  }
+  return out.join("");
+}
+function isEnglishText(text) {
+  const words = (stripTokens(text).match(WORD_RE) || []).map(wordKey);
+  if (!words.length) return true;
+  const hits = words.filter(w => ENGLISH.has(w)).length;
+  return hits === words.length || (words.length >= 8 && hits / words.length >= 0.8);
+}
+function singleLetters(text) {
+  const changed = [];
+  if (!text || isEnglishText(text)) return {text, changed};
+  const out = outsideTokens(text, part => part.replace(WORD_RE, w => {
+    if (ENGLISH.has(wordKey(w))) return w;
+    const n = singleWord(w);
+    if (n !== w) changed.push([w, n]);
+    return n;
+  }));
+  return {text: out, changed};
+}
+const upperT = s => outsideTokens(s, t => t.toUpperCase().replace(/É/g, "é"));
+const lowerT = s => outsideTokens(s, t => t.toLowerCase());
+const asciiLetters = s => stripTokens(s).replace(/[^A-Za-z]/g, "");
+const isAllCaps = s => { const l = asciiLetters(s); return l.length >= 2 && l === l.toUpperCase(); };
+const firstOf = src => src.replace(/^[^A-Za-z{]+/, "").slice(0, 1);   // past any opening punctuation
+function gameForm(r, han) {
+  const single = singleLetters(han), src = r.e;
+  let out = single.text;
+  if (isAllCaps(src)) out = upperT(out);
+  else if (asciiLetters(src).length >= 2 && (out === lowerT(out) || out === upperT(out)) &&
+           firstOf(src) === firstOf(src).toUpperCase() && /[a-z]/.test(src) && out && out[0] !== "{")
+    out = out[0].toUpperCase() + out.slice(1);
+  return {text: out, changed: single.changed};
+}
+// A short note for the row when the game will not show the text exactly as typed.
+function gameNoteFor(r, han) {
+  if (!han || !han.trim() || han.trim() === "{NOTHING}") return "";
+  const g = gameForm(r, han);
+  if (isAllCaps(r.e)) return g.text !== han ? "In the game: " + g.text : "";
+  if (!g.changed.length) return "";
+  const seen = new Set(), pairs = [];
+  for (const [a, b] of g.changed) { if (!seen.has(a)) { seen.add(a); pairs.push(a + " > " + b); } }
+  return "In the game, double letters are single: " + pairs.join(", ");
+}
+const exactKey = s => s.replace(/\u2019/g, "'");
+const layoutKey = s => exactKey(s).replace(/\{PARA\}|\{SCROLL\}|\n/g, " ").replace(/\s+/g, " ").trim();
+const own = r => (typed[KEY(r)] || "").trim();
+
+// A line that has no Hän of its own takes the Hän typed for the same English
+// somewhere else: first an identical string, then the same words with different
+// line breaks. The build does exactly the same.
+let sameExact = new Map(), sameLayout = new Map();
+function rebuildSame() {
+  sameExact = new Map(); sameLayout = new Map();
+  const rows = ROWS.filter(own).sort((a, b) => a.order - b.order);
+  for (const r of rows) {
+    const k = exactKey(r.e), l = layoutKey(r.e);
+    if (!sameExact.has(k)) sameExact.set(k, r);
+    if (!sameLayout.has(l)) sameLayout.set(l, r);
+  }
+}
+function copiedFor(r) {
+  if (own(r)) return null;
+  const hit = sameExact.get(exactKey(r.e)) || sameLayout.get(layoutKey(r.e));
+  return hit && hit !== r ? hit : null;
+}
+const isDone = r => !!(own(r) || copiedFor(r));
+
+function persist() {
+  try { localStorage.setItem(STORE, JSON.stringify({typed, rules, dirty})); } catch (e) {}
+  $("status").innerHTML = dirty ? '<span class="unsaved">Not saved to a file yet</span>' : "Saved";
+}
+function progress() {
+  // counted against the plan; text outside the plan stays English unless it is typed
+  let mine = 0, copied = 0, rows = 0, places = 0, total = 0, extra = 0;
+  rebuildSame();
+  for (const r of ROWS) {
+    if (!r.plan) { if (own(r)) extra++; continue; }
+    rows++; total += r.used;
+    if (own(r)) { mine++; places += r.used; }
+    else if (copiedFor(r)) { copied++; places += r.used; }
+  }
+  const done = mine + copied;
+  $("progress").textContent = done + " of " + rows + " strings in the plan are done (" + (100 * done / rows).toFixed(1) + "%): " + mine + " typed, " + copied +
+    " filled because their English is the same. " + (rows - done) + " to go. They fill " + places + " of " + total + " places in the game." +
+    (extra ? " Outside the plan, " + extra + " more are typed." : "");
+  $("barfill").style.width = (100 * done / rows).toFixed(1) + "%";
+}
+function similarFor(r) {
+  const k = loose(r.e);
+  if (!k) return null;
+  const hit = looseIndex.get(k);
+  return hit && hit !== r && (typed[KEY(hit)] || "").trim() ? hit : null;
+}
+let looseIndex = new Map();
+function rebuildLoose() {
+  looseIndex = new Map();
+  for (const r of ROWS) if ((typed[KEY(r)] || "").trim()) { const k = loose(r.e); if (k && !looseIndex.has(k)) looseIndex.set(k, r); }
+}
+
+function refresh() {
+  const q = $("q").value.trim().toLowerCase(), show = $("show").value, sec = $("section").value, sort = $("sort").value;
+  const outside = $("outside").checked;
+  rebuildSame();
+  view = ROWS.filter(r => {
+    if (!r.plan && !outside && !own(r)) return false;      // outside the plan: listed only if typed, or on request
+    const src = copiedFor(r), h = own(r) || (src ? own(src) : "");
+    if (show === "todo" && h) return false;
+    if (show === "done" && !h) return false;
+    if (sec && r.fam !== sec) return false;
+    if (q && !(r.e.toLowerCase().includes(q) || h.toLowerCase().includes(q))) return false;
+    return true;
+  });
+  const cmp = {p: (a, b) => a.tier - b.tier || b.used - a.used || a.order - b.order || a.i - b.i,
+               u: (a, b) => b.used - a.used || a.tier - b.tier || a.order - b.order || a.i - b.i,
+               o: (a, b) => a.order - b.order || a.i - b.i}[sort];
+  view.sort(cmp);
+  rebuildLoose();
+  $("list").innerHTML = "";
+  painters.clear();
+  shown = 0;
+  more();
+  if (!view.length) $("list").innerHTML = '<p class="note">Nothing here.</p>';
+}
+function more() {
+  const frag = document.createDocumentFragment();
+  for (const r of view.slice(shown, shown + PAGE)) frag.appendChild(card(r, shown + 1 + frag.childNodes.length));
+  shown = Math.min(shown + PAGE, view.length);
+  $("list").appendChild(frag);
+  $("more").hidden = shown >= view.length;
+  $("more").textContent = "Show more (" + (view.length - shown) + " left)";
+}
+const painters = new Map();      // row number -> function that redraws that card's state
+function repaintSame(r) {
+  const k = exactKey(r.e), l = layoutKey(r.e);
+  for (const [i, fn] of painters) { const o = ROWS[i]; if (o !== r && (exactKey(o.e) === k || layoutKey(o.e) === l)) fn(); }
+}
+function card(r, n) {
+  const el = document.createElement("div");
+  const val = typed[KEY(r)] || "";
+  el.className = "item" + (val.trim() ? " done" : "");
+  const left = document.createElement("div"), right = document.createElement("div");
+  left.innerHTML = '<div class="meta"><span>#' + n + '</span><span class="chip' + (r.used > 1 ? " hot" : "") + '">fills ' + r.used + (r.used > 1 ? " places" : " place") +
+    '</span><span class="chip">' + esc(r.sec) + '</span>' + (r.plan ? "" : '<span class="chip">outside the plan</span>') + '<span title="' + esc(r.where) + '">' + esc(r.where.split("  (")[0]) + '</span></div><div class="en">' + showEnglish(r.e) + "</div>" +
+    (r.now ? '<div class="now">In the game now: ' + showEnglish(r.now) + "</div>" : "");
+  const ta = document.createElement("textarea");
+  ta.value = val; ta.spellcheck = false; ta.lang = "haa"; ta.rows = Math.min(6, Math.max(2, r.e.split("\n").length));
+  const under = document.createElement("div"); under.className = "under";
+  const count = document.createElement("span");
+  const copyNote = document.createElement("span");
+  const gameNote = document.createElement("span");
+  const useEn = document.createElement("button");
+  useEn.className = "small"; useEn.type = "button"; useEn.textContent = "Copy English";
+  useEn.title = "Keep the English for this line";
+  useEn.onclick = () => { ta.value = r.e; ta.dispatchEvent(new Event("input")); ta.focus(); };
+  const paint = () => {
+    const src = copiedFor(r), v = ta.value.trim() ? ta.value : (src ? typed[KEY(src)] : "");
+    el.classList.toggle("done", !!v.trim());
+    ta.placeholder = src ? typed[KEY(src)] : "";
+    useEn.hidden = !!ta.value.trim();
+    copyNote.textContent = src ? "Filled from the same English in " + src.sec + ". Type here only if this place needs something different." : "";
+    gameNote.textContent = gameNoteFor(r, v);
+    if (r.limit) { const n = letters(v.trim() ? gameForm(r, v).text : v); count.textContent = n + " of " + r.limit + " letters"; count.className = n > r.limit ? "over" : ""; }
+  };
+  painters.set(r.i, paint);
+  ta.addEventListener("input", () => {
+    if (ta.value.trim()) typed[KEY(r)] = ta.value;
+    else if (r.base) typed[KEY(r)] = "";            // remember that this one was cleared
+    else delete typed[KEY(r)];
+    dirty = true; persist(); progress(); paint(); repaintSame(r);
+  });
+  ta.addEventListener("focus", () => { lastField = ta; });
+  under.appendChild(useEn);
+  under.appendChild(count);
+  under.appendChild(gameNote);
+  under.appendChild(copyNote);
+  const sim = similarFor(r);
+  if (sim && !val.trim() && !copiedFor(r)) {
+    const hint = document.createElement("span");
+    hint.textContent = "You typed this for a similar line: " + typed[KEY(sim)].replace(/\n/g, " / ");
+    const use = document.createElement("button"); use.className = "small"; use.textContent = "Use it";
+    use.onclick = () => { ta.value = typed[KEY(sim)]; ta.dispatchEvent(new Event("input")); hint.remove(); use.remove(); };
+    under.appendChild(hint); under.appendChild(use);
+  }
+  right.appendChild(ta); right.appendChild(under);
+  el.appendChild(left); el.appendChild(right);
+  paint();
+  return el;
+}
+
+// letters that are slow to type
+let lastField = null;
+for (const ch of ["ą", "ę", "į", "ǫ", "ų", "ä", "ë", "ö", "ł", "Ł", "ǹ", "’", "̀", "̈", "̨"]) {
+  const b = document.createElement("button");
+  b.className = "small"; b.type = "button";
+  b.textContent = /[̀-ͯ]/.test(ch) ? "◌" + ch : ch;
+  b.title = {"̀": "low tone, goes on the letter before", "̈": "two dots, goes on the letter before", "̨": "nasal hook, goes on the letter before"}[ch] || "";
+  b.onmousedown = e => e.preventDefault();
+  b.onclick = () => {
+    if (!lastField) return;
+    const s = lastField.selectionStart, t = lastField.selectionEnd;
+    lastField.setRangeText(ch, s, t, "end");
+    lastField.dispatchEvent(new Event("input"));
+    lastField.focus();
+  };
+  $("keys").appendChild(b);
+}
+
+// files
+$("save").onclick = () => {
+  const rows = [];
+  for (const r of ROWS) { const h = (typed[KEY(r)] || "").trim(); if (h) rows.push({english: r.e, section: r.fam, han: typed[KEY(r)]}); }
+  const out = {format: "han-firered-translations", version: 1, saved: new Date().toISOString(), rows, rules: rules.filter(x => x.e && x.h).map(x => ({english: x.e, han: x.h}))};
+  const a = document.createElement("a");
+  a.href = URL.createObjectURL(new Blob([JSON.stringify(out, null, 1)], {type: "application/json"}));
+  a.download = "haa_firered-translations_coulson_" + new Date().toISOString().slice(0, 10) + ".json";
+  document.body.appendChild(a); a.click(); a.remove();
+  dirty = false; persist();
+};
+$("open").onclick = () => $("file").click();
+$("file").onchange = async e => {
+  const f = e.target.files[0];
+  if (!f) return;
+  try {
+    const d = JSON.parse(await f.text());
+    if (d.format !== "han-firered-translations") throw new Error("not a save file from this tool");
+    const byKey = new Map(ROWS.map(r => [KEY(r), r]));
+    let n = 0, lost = 0;
+    typed = {};
+    for (const row of d.rows) { const k = row.section + "\u0001" + row.english; if (byKey.has(k)) { typed[k] = row.han; n++; } else lost++; }
+    if (d.rules) rules = d.rules.map(x => ({e: x.english, h: x.han}));
+    dirty = false; persist(); progress(); refresh();
+    $("status").textContent = "Opened " + n + " rows" + (lost ? " (" + lost + " did not match this version of the game)" : "");
+  } catch (err) { $("status").textContent = "Could not open that file: " + err.message; }
+  e.target.value = "";
+};
+
+// rules
+function drawRules() {
+  const body = $("rulesBody"); body.innerHTML = "";
+  rules.forEach((r, i) => {
+    const tr = document.createElement("tr");
+    for (const k of ["e", "h"]) {
+      const td = document.createElement("td"), inp = document.createElement("input");
+      inp.value = r[k]; inp.oninput = () => { r[k] = inp.value; dirty = true; persist(); };
+      td.appendChild(inp); tr.appendChild(td);
+    }
+    const td = document.createElement("td"), del = document.createElement("button");
+    del.className = "small"; del.textContent = "Remove"; del.onclick = () => { rules.splice(i, 1); dirty = true; persist(); drawRules(); };
+    td.appendChild(del); tr.appendChild(td); body.appendChild(tr);
+  });
+}
+$("rulesBtn").onclick = () => { drawRules(); $("rules").showModal(); };
+$("addRule").onclick = () => { rules.push({e: "", h: ""}); drawRules(); };
+$("closeRules").onclick = () => $("rules").close();
+
+const fams = Array.from(new Set(ROWS.map(r => r.fam)));
+$("section").innerHTML = '<option value="">All kinds of text</option>' + fams.map(f => "<option>" + esc(f) + "</option>").join("");
+for (const id of ["q", "show", "section", "sort", "outside"]) $(id).addEventListener(id === "q" ? "input" : "change", refresh);
+$("more").onclick = more;
+window.addEventListener("beforeunload", e => { if (dirty) { e.preventDefault(); e.returnValue = ""; } });
+persist(); progress(); refresh();
+</script>
+</body>
+</html>
