+MANIFEST = ORIG / "MANIFEST.json"
+
+
+def file_hash(path):
+    import hashlib
+    return hashlib.sha1(Path(path).read_bytes()).hexdigest()
+
+
+def restore():
+    """Put the English files back. Returns (files restored, files that somebody
+    edited while the Hän text was in place). Such an edit would be lost, so the
+    edited file is first set aside next to the original as *.edited."""
+    if not ORIG.exists():
+        return 0, []
+    written = json.loads(MANIFEST.read_text()) if MANIFEST.exists() else {}
+    n, edited = 0, []
+    for f in sorted(ORIG.rglob("*")):
+        if f.is_file() and f != MANIFEST:
+            rel = str(f.relative_to(ORIG))
+            target = ROOT / rel
+            if rel in written and target.exists() and file_hash(target) != written[rel]:
+                shutil.copyfile(target, str(target) + ".edited")
+                edited.append(rel)
+            shutil.copyfile(f, target)
+            n += 1
+    shutil.rmtree(ORIG)
+    return n, edited
+
