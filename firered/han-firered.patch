+            print("too long for its slot, left in English: %s" % u.where)
+        LEARNED.write_text(json.dumps(limits, indent=1, sort_keys=True))
+    print("%d strings in the source, %d rows; text box width %d px" % (len(units), sum(1 for g in groups.values() if is_translatable(g.english)), wrapper.max_px))
+    counts = defaultdict(int)
+    for g in groups.values():
+        if g.source:
+            counts[g.source] += 1
+    print("rows: " + ", ".join("%s %d" % kv for kv in sorted(counts.items())))
+    for p in problems:
+        print("NOT PLACED:", p)
+    if argv[1] == "workbook":
+        n = write_book(args[0], groups, rules, problems)
+        print("wrote %s: %d rows" % (args[0], n))
+        return
+    if argv[1] == "tool":
+        fixes = []
+        if "--was" in opts and book:
+            for older in opts["--was"].split(","):       # several older files: OLD1.json,OLD2.json
+                for fix in saved_changes(older, book):
+                    if fix not in fixes:
+                        fixes.append(fix)
+        n = write_tool(args[0], groups, rules, fixes)
+        print("wrote %s: %d rows" % (args[0], n))
+        if fixes:
+            print("%d rows changed since %s; a browser that still holds the older text takes the new one" % (len(fixes), opts["--was"]))
+        return
+    if argv[1] == "apply":
+        files, places, placed = apply(groups)
+        sounds = english_table(groups, rules)
+    print("put %d rows into %d places in %d files" % (sum(1 for g in groups.values() if g.final is not None), places, files))
+    han, prose, missing = sounds
+    print("syllabics: English words are spelled by their sound, but these are read as Hän, because the translation has them as Hän words: %s" % (", ".join(han) or "none"))
+    print("syllabics: %d rows of the translation are written in English (most are English rows with one word swapped by a word rule)" % len(prose))
+    if missing:
+        print("syllabics: plain words in those rows that are not in tools/han/english_sounds.txt, so they are read as Hän: %s" % ", ".join(missing))
+    if argv[1] == "build":
+        print("built pokefirered.gba")
+    if "--report" in opts:
+        write_book(opts["--report"], groups, rules, problems)
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/tools/han/han_theme.py b/tools/han/han_theme.py
new file mode 100644
index 0000000..358d605
--- /dev/null
+++ b/tools/han/han_theme.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Puts CHAMPION JANE's battle theme into the build, if whoever builds has the music.
+
+    python3 tools/han/han_theme.py [PATH/TO/jane_theme.mid or PATH/TO/jane_theme.wav]
+
+The theme is a tune Jane chose. It is someone else's music, so it is not in git and not in the
+patch. This script looks for it in three places: the path it is given, then the HAN_JANE_THEME
+environment variable, then next to the pokefirered folder. It takes one of two kinds of file:
+
+  jane_theme.mid   the tune as notes (a MIDI file). tools/han/han_theme_midi.py arranges it for
+                   the game and the game's own tool mid2agb turns it into a song. This is what
+                   Jane's own game has. If both files are there, this one is used.
+  jane_theme.wav   the tune as one long recorded sound, made by tools/han/han_theme_prepare.py.
+                   The song is then one held note that plays the recording.
+
+What it writes, at each build, none of it in git:
+
+  sound/songs/mus_han_jane.s                      the song
+  sound/direct_sound_samples/han_jane_theme.wav   the recording, or a moment of silence
+  include/han_jane_theme.h                        HAN_JANE_THEME: TRUE with the music, FALSE without;
+                                                  HAN_JANE_THEME_CHANNELS: how many sampled sounds
+                                                  the game may play at once during the song
+
+Without the music the game is built all the same, and CHAMPION JANE's battle has the music it
+had before: the ELITE FOUR's battle music. `make` and han_text.py run this script.
+"""
+import os
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+# The song for the recording, and for a build with no music (where nothing plays it).
+HELD_NOTE_SONG = r"""@ Hän build: CHAMPION JANE's battle theme. It is one long sound (see tools/han/han_theme.py), so the song is one
+@ note that is held. The sound itself goes round and round from its loop point; the track only has to stay alive.
+@ There are two tracks, and both play the same note. A sound in the middle plays at half strength on each
+@ side, so one track alone is half as loud as the game's own music can be; two together are full strength.
+
+	.include "MPlayDef.s"
+
+	.section .rodata
+	.global	mus_han_jane
+	.align	2
+
+mus_han_jane_1:
+	.byte	KEYSH , 0
+	.byte	TEMPO , 120/2
+	.byte		VOICE , 0
+	.byte		VOL   , 127
+	.byte		PAN   , c_v
+	.byte		TIE   , Cn3 , v127
+mus_han_jane_1_loop:
+	.byte	W96
+	.byte	GOTO
+	 .word	mus_han_jane_1_loop
+	.byte	FINE
+
+mus_han_jane_2:
+	.byte	KEYSH , 0
+	.byte		VOICE , 0
+	.byte		VOL   , 127
+	.byte		PAN   , c_v
+	.byte		TIE   , Cn3 , v127
+mus_han_jane_2_loop:
+	.byte	W96
+	.byte	GOTO
+	 .word	mus_han_jane_2_loop
+	.byte	FINE
+
+	.align	2
+mus_han_jane:
+	.byte	2	@ NumTrks
+	.byte	0	@ NumBlks
+	.byte	0	@ Priority
+	.byte	0	@ Reverb
+
+	.word	voicegroup_han_jane
+
+	.word	mus_han_jane_1
+	.word	mus_han_jane_2
+
+	.end
+"""
+
+MIDI_OPTIONS = ["-E", "-R50", "-G250", "-V105", "-L", "mus_han_jane"]   # as the game's own songs, with voicegroup250
+
+
+def put(path, data):
+    path = Path(path)
+    data = data if isinstance(data, bytes) else data.encode("utf-8")
+    if not path.exists() or path.read_bytes() != data:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data)
+        return True
+    return False
+
+
+def silence(rate=10512, n=1024):
+    fmt = struct.pack("<HHIIHH", 1, 1, rate, rate, 1, 8)
+    body = b"WAVE" + b"fmt " + struct.pack("<I", len(fmt)) + fmt + b"data" + struct.pack("<I", n) + bytes([128]) * n
+    return b"RIFF" + struct.pack("<I", len(body)) + body
+
+
+def song_from_midi(midi):
+    """The MIDI, arranged, as the text of a song. Also gives the lines that say what was kept."""
+    import han_theme_midi
+    tool = ROOT / "tools/mid2agb/mid2agb"
+    if not tool.exists():
+        subprocess.run(["make", "-C", str(ROOT / "tools/mid2agb")], check=True, stdout=subprocess.DEVNULL)
+    work = ROOT / "build/han_theme"
+    work.mkdir(parents=True, exist_ok=True)
+    tpb, tracks, report = han_theme_midi.arrange(str(midi))
+    han_theme_midi.write_midi(str(work / "arranged.mid"), tpb, tracks)
+    done = subprocess.run([str(tool), str(work / "arranged.mid"), str(work / "mus_han_jane.s")] + MIDI_OPTIONS,
+                          capture_output=True, text=True)
+    if done.returncode:
+        sys.exit("han_theme.py: mid2agb could not read the arranged MIDI\n" + done.stdout + done.stderr)
+    return (work / "mus_han_jane.s").read_text(), report
+
+
+def main(argv):
+    places = [a for a in argv[1:] if not a.startswith("--")][:1]
+    if os.environ.get("HAN_JANE_THEME"):
+        places.append(os.environ["HAN_JANE_THEME"])
+    places += [ROOT.parent / "jane_theme.mid", ROOT.parent / "jane_theme.wav"]
+    places = [Path(p) for p in places if Path(p).is_file()]
+    midi = next((p for p in places if p.suffix.lower() in (".mid", ".midi")), None)
+    wav = next((p for p in places if p.suffix.lower() == ".wav"), None)
+    report = []
+    if midi:
+        song, report = song_from_midi(midi)
+        sound, found, channels = silence(), midi, 8
+    elif wav:
+        song, sound, found, channels = HELD_NOTE_SONG, wav.read_bytes(), wav, 5
+    else:
+        song, sound, found, channels = HELD_NOTE_SONG, silence(), None, 5
+    put(ROOT / "sound/songs/mus_han_jane.s", song)
+    put(ROOT / "sound/direct_sound_samples/han_jane_theme.wav", sound)
+    put(ROOT / "include/han_jane_theme.h",
+        "// Made by tools/han/han_theme.py. Do not edit.\n"
+        "#ifndef GUARD_HAN_JANE_THEME_H\n#define GUARD_HAN_JANE_THEME_H\n\n"
+        "#define HAN_JANE_THEME %s // is CHAMPION JANE's own battle theme in this build?\n"
+        "#define HAN_JANE_THEME_CHANNELS %d // sampled sounds at once while it plays (the game's own songs: 5)\n\n#endif\n"
+        % ("TRUE" if found else "FALSE", channels))
+    if "--touch" in argv:
+        (ROOT / "include/han_jane_theme.h").touch()
+    print("han_theme.py: CHAMPION JANE's theme: %s" % (found if found else "no music found, so her battle has the ELITE FOUR's battle music, as before"))
+    for line in report:
+        print("han_theme.py: " + line)
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/tools/han/han_theme_midi.py b/tools/han/han_theme_midi.py
new file mode 100644
index 0000000..5474229
--- /dev/null
+++ b/tools/han/han_theme_midi.py
@@ -0,0 +1,299 @@
+#!/usr/bin/env python3
+"""Arranges a MIDI file of CHAMPION JANE's tune for the game's sound engine.
+
+    python3 tools/han/han_theme_midi.py MUSIC.mid OUT.mid
+
+tools/han/han_theme.py uses this at each build, then runs the game's own tool mid2agb on OUT.mid.
+Run by hand, it writes OUT.mid and says what it kept.
+
+Jane sent a MIDI of the whole tune (17 November 2026) and asked that the theme start "just a few
+verses before the famous solo". The file is a full band: seventeen tracks, more than the game can
+play at once. The game plays a song on ten tracks at most, with eight sampled sounds at a time
+while this song plays (five for the game's own songs; see MPlayStart in src/m4a.c) and four
+simple "beep" channels. So this script picks and thins. Everything it decides is in RECIPE below.
+
+What it does:
+  - starts at START_BAR and stops at END_BAR. The song then goes back to the start, for ever;
+  - fades in over FADE_BEATS beats. The MIDI's own fade-out at its end is kept, so the tune
+    fades out, and comes in again from the start point;
+  - keeps the parts listed in PARTS, in that order. When more notes sound than the game can
+    play, the game drops notes from the parts lower in the list first;
+  - gives each part an instrument of the game (a number in voicegroup250, sound/voice_groups.inc);
+  - drums: the bass drum, snare, tom and crashes are the game's drum kit. The ride and the
+    hi-hats go to the game's noise channel, as in the game's own songs. Jane asked for the
+    drums to be turned down: see DRUMS;
+  - bends of the guitar strings are kept. The MIDI says them in steps of an octave split in
+    8192; the game has 64 steps, so each part's bends are rescaled to the smallest range that
+    holds them;
+  - the vibrato wheel is kept, much reduced: the game's vibrato is sixteen times deeper for the
+    same number;
+  - tracks whose name starts with "$", and "Chord", are a keyboard's own control notes, not
+    music. They are left out.
+
+The recipe is written for one particular file (FREEBRD.mid, 228,158 bytes, sha1
+5af9f3f5e7f9918e4b0fa4c90f6b4fdb009862d0). With another file it will run, and say which
+channels it found nothing on, but the choices will not fit.
+
+The music is someone else's. Neither the MIDI nor anything made from it is in git or in the patch.
+"""
+import struct
+import sys
+
+START_BAR = 133     # the second half of the last chorus: three sung lines, 27 seconds, then the solo
+END_BAR = 305       # the end of the MIDI, after its fade-out
+FADE_BEATS = 6      # the fade in: just under 3 seconds
+BEATS_PER_BAR = 4   # the file is in 4/4 throughout
+LEAD_IN = 2         # clocks of silence before the first bar, where each track is set up after the loop point
+
+# name, MIDI channel (counted from 0), instrument number in voicegroup250, volume (1 = as the MIDI has it)
+# The volumes were set by measuring, not by ear: each part was played by itself in the game and its level
+# read off a recording. With these, in the solo, the two solo guitars together are the loudest thing, the bass
+# and the strummed guitar are a little under half of that, the drums less again, and the whole is as loud as
+# the game's own gym battle music. Before the solo the sung line is a little above the guitar and the bass.
+PARTS = [
+    ("solo guitar",       2, 29, 1.20),
+    ("second solo guitar", 4, 29, 1.20),
+    ("bass",              1, 33, 0.85),
+    ("drum kit",          9, 0, None),      # see DRUMS
+    ("sung line",         3, 73, 1.27),     # a flute plays what is sung. It stops where the solo starts
+    ("slide guitar",      8, 29, 1.10),     # it stops eight bars before the solo
+    ("solo guitar, extra notes", 5, 29, 1.00),
+    ("strummed guitar",   13, 25, 0.90),
+    ("ride and hi-hats",  9, 127, None),    # see DRUMS
+]
+# Left out: channels 14 and 15, two more guitars playing the same chords as the strummed one.
+# With them, twelve notes sound at once. Channels 6, 7, 11 and 12 are silent after START_BAR.
+
+DRUMS = {
+    "volume": 0.60,                          # Jane: "turn down the drums"
+    # MIDI drum note -> the note of the game's drum kit (voicegroup002) with the same drum
+    "kit": {35: 36, 36: 36, 38: 38, 40: 38, 41: 41, 43: 43, 45: 45, 47: 47, 48: 48, 50: 50, 49: 49, 57: 57, 53: 53},
+    "kit_clocks": 24,                        # a drum's note is held this long at most: the bass drum stops dead at its note's end
+    # these go to the noise channel. The note is the one the game's songs use for a hi-hat.
+    "noise": {42: 84, 44: 84, 46: 84, 51: 84, 59: 84},
+    "noise_clocks": 2,
+    "noise_volume": 1.60,                   # the noise channel is faint next to the sampled drums
+}
+VIBRATO_DIVISOR = 16
+CLOCKS_PER_BEAT = 24                         # the game's own count. mid2agb turns the file's ticks into these.
+
+
+# ---------------------------------------------------------------- reading a MIDI file
+
+def _vlq(b, i):
+    n = 0
+    while True:
+        c = b[i]; i += 1
+        n = (n << 7) | (c & 0x7F)
+        if c < 0x80:
+            return n, i
+
+
+def read_midi(path):
+    """Gives (ticks per beat, tracks). A track is (name, events); an event is (tick, kind, ...):
+    (tick, 'meta', type, data) or (tick, status high nibble, channel, data1, data2)."""
+    data = open(path, "rb").read()
+    if data[:4] != b"MThd":
+        raise ValueError("%s is not a MIDI file" % path)
+    hlen, fmt, ntrk, div = struct.unpack(">IHHH", data[4:14])
+    if div & 0x8000:
+        raise ValueError("%s counts time in film frames; this script reads beats only" % path)
+    pos = 8 + hlen
+    tracks = []
+    while pos + 8 <= len(data) and len(tracks) < ntrk:
+        tlen = struct.unpack(">I", data[pos + 4:pos + 8])[0]
+        if data[pos:pos + 4] == b"MTrk":
+            tracks.append(_read_track(data[pos + 8:pos + 8 + tlen]))
+        pos += 8 + tlen
+    return div, tracks
+
+
+def _read_track(b):
+    i = 0; t = 0; status = 0; out = []; name = ""
+    while i < len(b):
+        d, i = _vlq(b, i)
+        t += d
+        c = b[i]
+        if c == 0xFF:
+            typ = b[i + 1]
+            n, i = _vlq(b, i + 2)
+            if typ == 3 and not name:
+                name = b[i:i + n].decode("latin-1")
+            out.append((t, "meta", typ, bytes(b[i:i + n])))
+            i += n
+        elif c in (0xF0, 0xF7):
+            n, i = _vlq(b, i + 1)
+            i += n
+        else:
+            if c & 0x80:
+                status = c; i += 1
+            kind = status & 0xF0
+            if kind in (0xC0, 0xD0):
+                out.append((t, kind, status & 0x0F, b[i], 0)); i += 1
+            else:
+                out.append((t, kind, status & 0x0F, b[i], b[i + 1])); i += 2
+    return name, out
+
+
+# ---------------------------------------------------------------- arranging
+
+def _channel(tracks, ch):
+    """Everything one channel does, from the tracks that hold music."""
+    ev = []
+    for name, events in tracks:
+        if name.startswith("$") or name == "Chord":
+            continue
+        ev += [e for e in events if e[1] != "meta" and e[2] == ch]
+    ev.sort(key=lambda e: e[0])
+    notes = []; on = {}
+    ctl = {7: [], 10: [], 11: [], 1: []}; bends = []; rng = 2; rpn = [None, None]
+    for e in ev:
+        t, kind, _, d1, d2 = e
+        if kind == 0x90 and d2:
+            on.setdefault(d1, []).append((t, d2))
+        elif kind in (0x80, 0x90):
+            if on.get(d1):
+                t0, vel = on[d1].pop(0)
+                notes.append((t0, t, d1, vel))
+        elif kind == 0xB0:
+            if d1 in ctl:
+                ctl[d1].append((t, d2))
+            elif d1 == 101:
+                rpn[0] = d2
+            elif d1 == 100:
+                rpn[1] = d2
+            elif d1 in (98, 99):
+                rpn = [None, None]
+            elif d1 == 6 and rpn == [0, 0]:
+                rng = d2                                  # the range of the bends, in semitones
+        elif kind == 0xE0:
+            bends.append((t, ((d2 << 7) | d1) - 8192))
+    notes.sort()
+    return notes, ctl, bends, rng
+
+
+def _at(series, tick, default):
+    v = default
+    for t, x in series:
+        if t > tick:
+            break
+        v = x
+    return v
+
+
+def arrange(src):
+    """Gives (ticks per beat, [(name, channel, events)], report lines). Events are (tick, order, bytes)."""
+    tpb, tracks = read_midi(src)
+    clock = tpb / CLOCKS_PER_BEAT
+    bar = BEATS_PER_BAR * tpb
+    S, E = START_BAR * bar, END_BAR * bar
+    lead = int(round(LEAD_IN * clock))
+    setup = int(round(clock))                 # one clock after the loop point
+    new = lambda t: t - S + lead
+    report = []
+
+    # the conductor's track: tempo, and the two marks mid2agb reads as "go back to here" and "from here"
+    tempos = sorted((t, struct.unpack(">I", b"\0" + d)[0]) for _, events in tracks for (t, k, typ, d) in
+                    [e for e in events if e[1] == "meta"] if typ == 0x51)
+    cond = [(0, 0, b"\xFF\x58\x04" + bytes([BEATS_PER_BAR, 2, 24, 8])), (0, 1, b"\xFF\x06\x01[")]
+    cond.append((setup, 0, b"\xFF\x51\x03" + struct.pack(">I", _at(tempos, S, 500000))[1:]))
+    for t, us in tempos:
+        if S < t < E:
+            cond.append((new(t), 0, b"\xFF\x51\x03" + struct.pack(">I", us)[1:]))
+    cond.append((new(E), 0, b"\xFF\x06\x01]"))
+    out = [("conductor", None, cond)]
+
+    fade_end = S + FADE_BEATS * tpb
+    for number, (name, ch, voice, volume) in enumerate(PARTS):
+        notes, ctl, bends, rng = _channel(tracks, ch)
+        is_kit = ch == 9 and voice == 0
+        is_noise = ch == 9 and voice != 0
+        if ch == 9:
+            table = DRUMS["kit"] if is_kit else DRUMS["noise"]
+            hold = int(round((DRUMS["kit_clocks"] if is_kit else DRUMS["noise_clocks"]) * clock))
+            kept = sorted((t0, table[n], vel) for t0, t1, n, vel in notes if n in table)
+            notes = []
+            for i, (t0, n, vel) in enumerate(kept):
+                nxt = next((u for u, m, _ in kept[i + 1:] if m == n), None)
+                notes.append((t0, min(t0 + hold, nxt if nxt is not None else t0 + hold), n, vel))
+            volume = DRUMS["volume"] * (DRUMS["noise_volume"] if is_noise else 1.0)
+            bends = []; ctl[1] = []
+        notes = [(t0, min(t1, E), n, vel) for t0, t1, n, vel in notes if S <= t0 < E and t1 > t0]
+        if not notes:
+            report.append("  %-26s channel %2d: no notes between the start and the end. Left out." % (name, ch + 1))
+            continue
+        och = len(out) - 1                      # its channel in the new file
+        st = 0xB0 | och
+        ev = [(setup, 0, bytes([0xC0 | och, voice])), (setup, 1, bytes([st, 10, _at(ctl[10], S, 64)]))]
+
+        # volume: the MIDI's own, times the part's share, times its fades, times the fade in
+        base = _at(ctl[7], S, 100) * volume
+        e0 = _at(ctl[11], S, 127) or 127
+        ticks = sorted({S + (fade_end - S) * k // 12 for k in range(13)} | {t for t, _ in ctl[11] if fade_end < t < E})
+        last = None
+        for t in ticks:
+            fade = min(1.0, (t - S) / (fade_end - S)) if t < fade_end else 1.0
+            v = max(0, min(127, int(round(base * _at(ctl[11], t, e0) / e0 * fade))))
+            if v != last:
+                ev.append((max(setup, new(t)), 2, bytes([st, 7, v]))); last = v
+
+        # bends, in the smallest whole range that holds them
+        b_in = [(t, x) for t, x in bends if S <= t < E]
+        if bends:
+            semis = lambda x: x / 8192.0 * rng
+            start = _at(bends, S, 0)
+            top = max([abs(semis(x)) for _, x in b_in] + [abs(semis(start)), 0.0])
+            r = max(2, int(top + 0.999))
+            ev.append((setup, 3, bytes([st, 20, r])))
+            last = None
+            for t, x in [(S, start)] + b_in:
+                v = 64 + max(-64, min(63, int(round(semis(x) / r * 64))))
+                if v != last:
+                    ev.append((max(setup, new(t)), 4, bytes([0xE0 | och, 0, v]))); last = v
+        # vibrato
+        if ctl[1]:
+            last = None
+            for t, x in [(S, _at(ctl[1], S, 0))] + [(t, x) for t, x in ctl[1] if S <= t < E]:
+                v = int(round(x / VIBRATO_DIVISOR))
+                if v != last:
+                    ev.append((max(setup, new(t)), 5, bytes([st, 1, v]))); last = v
+        for t0, t1, n, vel in notes:
+            ev.append((new(t0), 9, bytes([0x90 | och, n, vel])))
+            ev.append((new(t1), -1, bytes([0x80 | och, n, 0])))
+        out.append((name, och, ev))
+        report.append("  %-26s channel %2d -> track %d, instrument %3d: %5d notes, volume %3d%s%s" % (
+            name, ch + 1, och + 1, voice, len(notes), int(round(base)),
+            ", %d bends" % len(b_in) if b_in else "", ", vibrato" if ctl[1] else ""))
+    secs = 0.0; t0 = S; us = _at(tempos, S, 500000)
+    for t, x in [p for p in tempos if S < p[0] < E] + [(E, 0)]:
+        secs += (t - t0) * us / tpb / 1e6; t0 = t; us = x
+    report.insert(0, "from bar %d to bar %d: %d:%02d, then round again" % (START_BAR, END_BAR, secs // 60, secs % 60))
+    return tpb, out, report
+
+
+def write_midi(path, tpb, tracks):
+    body = b""
+    for name, ch, events in tracks:
+        events = sorted(events, key=lambda e: (e[0], e[1]))
+        t = 0; b = b"\x00\xFF\x03" + bytes([len(name)]) + name.encode("ascii", "replace")
+        for tick, _, data in events:
+            d = tick - t; t = tick
+            v = [d & 0x7F]; d >>= 7
+            while d:
+                v.append((d & 0x7F) | 0x80); d >>= 7
+            b += bytes(reversed(v)) + data
+        b += b"\x00\xFF\x2F\x00"
+        body += b"MTrk" + struct.pack(">I", len(b)) + b
+    open(path, "wb").write(b"MThd" + struct.pack(">IHHH", 6, 1, len(tracks), tpb) + body)
+
+
+def main(argv):
+    if len(argv) != 3:
+        sys.exit(__doc__.split("\n")[2].strip())
+    tpb, tracks, report = arrange(argv[1])
+    write_midi(argv[2], tpb, tracks)
+    print("han_theme_midi.py: %s\n%s" % (argv[2], "\n".join(report)))
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/tools/han/han_theme_prepare.py b/tools/han/han_theme_prepare.py
new file mode 100644
index 0000000..804dbd9
--- /dev/null
+++ b/tools/han/han_theme_prepare.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Turns a piece of music into the one long sound the game plays as CHAMPION JANE's battle theme.
+
+    python3 tools/han/han_theme_prepare.py MUSIC.mp3 ../jane_theme.wav [--start 201] [--seconds 83] [--rate 10512] [--fade 3] [--gain 3] [--drums 0.4]
+
+Jane asked for a tune of her choice as CHAMPION JANE's theme, starting 3:21 into it and fading in
+(17 November 2026). The game cannot play an mp3, and a cartridge of this kind holds 16 MB, so the
+piece is cut and thinned out: one channel, 8 bits, about ten thousand samples a second. At that
+rate a little under a megabyte holds about 83 seconds, which then plays round and round.
+
+What it does:
+  - reads the music with ffmpeg (which must be installed), from --start, for --seconds;
+  - turns the drums down to --drums of what they were (Jane asked for this). The piece is one
+    recording with the whole band in it, so no instrument can be taken out by name. What can be
+    done is to split the sound into what is struck (short, wide in pitch: drums, and the start of
+    any note) and what is held (long, at one pitch: everything else), and put the two back together
+    with less of the first. See drums_down(). This step needs the Python packages numpy and scipy;
+    with --drums 1 it is left out and they are not needed;
+  - turns it up --gain times, and holds the few loudest peaks down so that nothing is cut off
+    (ffmpeg's limiter). Music has a few peaks far above the rest; scaled by its loudest peak
+    alone, the piece came out four times quieter than the game's own battle music;
+  - makes it start from silence over --fade seconds;
+  - blends the last second and a half into what came just before the point it loops back to,
+    so the join cannot be heard as a jump. It loops back to the end of the fade, so the fade is heard once;
+  - writes a .wav with that loop marked in it. tools/han/han_theme.py puts it in the build.
+
+The music itself is never put in git or in the patch. Whoever builds the game supplies the file.
+"""
+import argparse
+import struct
+import subprocess
+import sys
+from array import array
+
+
+FULL_RATE = 44100
+
+
+def drums_down(sound, keep):
+    """sound: 32 bit floats at FULL_RATE, as bytes. Gives the same back with the struck part at `keep` of its level.
+
+    The usual way to tell struck sounds from held ones (Fitzgerald 2010, "Harmonic/percussive separation using
+    median filtering"): look at the sound as a picture of pitch against time. A held note is a line along time,
+    a drum hit is a line along pitch. Smooth the picture along time and the hits go; smooth it along pitch and
+    the notes go. Each point of the picture is then shared between the two by how strong it is in each.
+    The two parts add up to the sound exactly, so keep=1 changes nothing.
+    """
+    try:
+        import numpy as np
+        from scipy.ndimage import median_filter
+        from scipy.signal import istft, stft
+    except ImportError:
+        sys.exit("han_theme_prepare.py: turning the drums down needs the Python packages numpy and scipy "
+                 "(pip install numpy scipy), or run with --drums 1 to leave them as they are")
+    x = np.frombuffer(sound, dtype="<f4").astype(np.float64)
+    size, step, reach = 2048, 512, 31
+    _, _, picture = stft(x, fs=FULL_RATE, nperseg=size, noverlap=size - step)
+    strength = np.abs(picture)
+    held = median_filter(strength, size=(1, reach)) ** 2
+    struck = median_filter(strength, size=(reach, 1)) ** 2
+    share_held = held / (held + struck + 1e-12)
+    _, y = istft(picture * (share_held + keep * (1 - share_held)), fs=FULL_RATE, nperseg=size, noverlap=size - step)
+    y = y[:len(x)]
+    if len(y) < len(x):
+        y = np.concatenate([y, np.zeros(len(x) - len(y))])
+    return y.astype("<f4").tobytes()
+
+
+def main(argv):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("music"); ap.add_argument("out")
+    ap.add_argument("--start", type=float, default=201.0)
+    ap.add_argument("--seconds", type=float, default=83.0)
+    ap.add_argument("--rate", type=int, default=10512)
+    ap.add_argument("--fade", type=float, default=3.0)
+    ap.add_argument("--blend", type=float, default=1.5)
+    ap.add_argument("--gain", type=float, default=3.0)
+    ap.add_argument("--drums", type=float, default=0.4)
+    a = ap.parse_args(argv[1:])
+
+    # 1. the piece as it is: one channel, 44100 samples a second
+    raw = subprocess.run(["ffmpeg", "-v", "error", "-ss", str(a.start), "-t", str(a.seconds), "-i", a.music,
+                          "-ac", "1", "-ar", str(FULL_RATE), "-f", "f32le", "-"], capture_output=True)
+    if raw.returncode or not raw.stdout:
+        sys.exit("han_theme_prepare.py: ffmpeg could not read %s\n%s" % (a.music, raw.stderr.decode()[-300:]))
+    whole = raw.stdout[:len(raw.stdout) // 4 * 4]
+    # 2. the drums down
+    if a.drums < 1:
+        whole = drums_down(whole, a.drums)
+    # 3. louder, with the peaks held, and thinned to the game's rate
+    raw = subprocess.run(["ffmpeg", "-v", "error", "-f", "f32le", "-ar", str(FULL_RATE), "-ac", "1", "-i", "-",
+                          "-af", "alimiter=level_in=%g:limit=0.97:attack=5:release=60:level=0" % a.gain,
+                          "-ac", "1", "-ar", str(a.rate), "-f", "f32le", "-"], input=whole, capture_output=True)
+    if raw.returncode or not raw.stdout:
+        sys.exit("han_theme_prepare.py: ffmpeg could not make the sound louder\n%s" % raw.stderr.decode()[-300:])
+    sound = array("f"); sound.frombytes(raw.stdout[:len(raw.stdout) // 4 * 4])
+    n = len(sound)
+    fade = int(a.fade * a.rate); blend = int(a.blend * a.rate)
+    if n < fade + 2 * blend:
+        sys.exit("han_theme_prepare.py: the piece is too short")
+    out = array("f", sound)
+    for i in range(fade):                       # in from silence
+        out[i] = sound[i] * i / fade
+    for i in range(blend):                      # the end runs into what came just before the loop point
+        t = i / blend
+        out[n - blend + i] = sound[n - blend + i] * (1 - t) + sound[fade - blend + i] * t
+    peak = max(max(out), -min(out)) or 1.0
+    data = bytes(max(0, min(255, int(round(128 + 120 * v / peak)))) for v in out)
+
+    smpl = struct.pack("<9I6I", 0, 0, 1000000000 // a.rate, 60, 0, 0, 0, 1, 0, 0, 0, fade, n - 1, 0, 0)
+    fmt = struct.pack("<HHIIHH", 1, 1, a.rate, a.rate, 1, 8)
+    body = b"WAVE" + b"fmt " + struct.pack("<I", len(fmt)) + fmt + b"data" + struct.pack("<I", n) + data + (b"\0" if n & 1 else b"") \
+        + b"smpl" + struct.pack("<I", len(smpl)) + smpl
+    open(a.out, "wb").write(b"RIFF" + struct.pack("<I", len(body)) + body)
+    print("han_theme_prepare.py: %s: %.1f seconds from %.0f s, %d samples a second, %d bytes; it loops back to %.1f s; drums at %g"
+          % (a.out, n / a.rate, a.start, a.rate, n, fade / a.rate, a.drums))
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/tools/han/han_title.py b/tools/han/han_title.py
new file mode 100644
index 0000000..f9e291d
--- /dev/null
+++ b/tools/han/han_title.py
@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""Redraws the blinking prompt on the title screen ("PRESS START") with other words.
+
+    python3 tools/han/han_title.py "START K'ÄDÄNDEY"
+
+The prompt is a picture, not text. Its letters are tiles in
+graphics/title_screen/copyright_press_start.png, and
+graphics/title_screen/copyright_press_start.bin says where each tile goes on
+the screen. This script draws the words into the tiles the old prompt used
+(plus a few empty ones) and puts them on the same line of the screen. The
+copyright line below it is not touched.
+
+The words are Jane's. This script only draws letters. It has these letters:
+A D E K N P R S T Y, Ä, an apostrophe and a space. A new word may need a new
+letter added to GLYPHS below.
+
+Safe to run again: it always starts from the tiles it owns.
+"""
+import struct
+import sys
+import unicodedata
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+PNG = ROOT / "graphics/title_screen/copyright_press_start.png"
+MAP = ROOT / "graphics/title_screen/copyright_press_start.bin"
+
+BG, EDGE = 6, 1                     # background, and the edge round each letter
+ROW_COLOURS = [5, 5, 4, 3, 3]       # the letters are lit from above, one colour a row
+# Colours 1 to 5 are the ones the game blinks. The copyright line uses 6 to 10.
+
+# Tiles this script may draw into: the twelve of the old prompt, then the empty ones.
+SLOTS = list(range(0x15, 0x1B)) + list(range(0x35, 0x3B)) + list(range(0x1B, 0x20)) + [0x3E, 0x3F]
+MAP_W = 32
+TEXT_ROW = 16                       # the screen row of the prompt; marks above a letter go in row 15
+FIRST_COL, LAST_COL = 2, 16         # the picture on the right of the screen starts after column 16
+RIGHT_EDGE = 130                    # last pixel the old prompt used
+
+# Letter shapes, five rows each. S T A R E P are the game's own; the rest are drawn to match.
+GLYPHS = {
+    "S": ["XXXXXXX", "XX.....", "XXXXXXX", ".....XX", "XXXXXXX"],
+    "T": ["XXXXXXXX", "...XX...", "...XX...", "...XX...", "...XX..."],
+    "A": ["...XX...", "..XXXX..", ".XX..XX.", "XX....XX", "XXXXX..X"],
+    "R": ["XXXXXX.", "XX...XX", "XX...XX", "XX.XXX.", "XX..XXX"],
+    "E": ["XXXXXXX", "XX.....", "XXXXXX.", "XX.....", "XXXXXXX"],
+    "P": ["XXXXXXX", "XX...XX", "XX...XX", "XXXXXXX", "XX....."],
+    "K": ["XX...XX", "XX..XX.", "XXXXX..", "XX..XX.", "XX...XX"],
+    "D": ["XXXXXX.", "XX...XX", "XX...XX", "XX...XX", "XXXXXX."],
+    "N": ["XX...XX", "XXX..XX", "XX.X.XX", "XX..XXX", "XX...XX"],
+    "Y": ["XX....XX", ".XX..XX.", "..XXXX..", "...XX...", "...XX..."],
+    "'": ["XX", ".X", "..", "..", ".."],
+}
+WORD_GAP = 6
+TIGHT_AFTER = {"A"}                 # the game sets the next letter right against an A
+
+
+def letters(text):
+    """[(base letter, has two dots above)] for the text, in capitals."""
+    out = []
+    for ch in unicodedata.normalize("NFD", text.upper().replace("’", "'").replace("ʼ", "'")):
+        if ch == "̈" and out:
+            out[-1] = (out[-1][0], True)
+        elif unicodedata.combining(ch):
+            sys.exit("This script cannot draw the mark U+%04X yet." % ord(ch))
+        elif ch == " " or ch in GLYPHS:
+            out.append((ch, False))
+        else:
+            sys.exit("This script has no letter %r yet. Add it to GLYPHS." % ch)
+    return out
+
+
+def render(text):
+    """The prompt as a grid of palette indexes, 16 pixels high: marks row, then letter row."""
+    cols = (LAST_COL - FIRST_COL + 1) * 8
+    ink = [[0] * cols for _ in range(16)]       # 0 nothing, else the colour
+    x = 0
+    spans = []
+    for base, dots in letters(text):
+        if base == " ":
+            x += WORD_GAP - 1
+            continue
+        shape = GLYPHS[base]
+        w = len(shape[0])
+        spans.append((x, w, shape, dots))
+        x += w + (0 if base in TIGHT_AFTER else 1)
+    width = spans[-1][0] + spans[-1][1]
+    left = RIGHT_EDGE - FIRST_COL * 8 - width + 1     # end where the old prompt ended
+    if left < 1:
+        sys.exit("Too wide: %d pixels, and %d fit." % (width, RIGHT_EDGE - FIRST_COL * 8))
+    for x, w, shape, dots in spans:
+        for r, line in enumerate(shape):
+            for c, ch in enumerate(line):
+                if ch == "X":
+                    ink[8 + 2 + r][left + x + c] = ROW_COLOURS[r]
+        if dots:                                       # two dots, two pixels square, one pixel clear of the letter
+            for dx in (1, 2, w - 3, w - 2):
+                for y in (7, 8):
+                    ink[y][left + x + dx] = ROW_COLOURS[0]
+    grid = [[BG] * cols for _ in range(16)]
+    for y in range(16):
+        for xx in range(cols):
+            if ink[y][xx]:
+                grid[y][xx] = ink[y][xx]
+            elif any(0 <= y + dy < 16 and 0 <= xx + dx < cols and ink[y + dy][xx + dx]
+                     for dy in (-1, 0, 1) for dx in (-1, 0, 1)):
+                grid[y][xx] = EDGE
+    return grid, left + FIRST_COL * 8, width
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    text = sys.argv[1]
+    grid, screen_x, width = render(text)
+
+    im = Image.open(PNG)
+    px = im.load()
+    for slot in SLOTS:                                 # start clean
+        for y in range(8):
+            for x in range(8):
+                px[(slot % 16) * 8 + x, (slot // 16) * 8 + y] = BG
+
+    vals = list(struct.unpack("<%dH" % (MAP.stat().st_size // 2), MAP.read_bytes()))
+    pal = vals[TEXT_ROW * MAP_W + 5] & 0xF000 or 0xF000
+    for row in (TEXT_ROW - 1, TEXT_ROW):
+        for col in range(MAP_W):
+            if (vals[row * MAP_W + col] & 0x3FF) in SLOTS:
+                vals[row * MAP_W + col] = 0            # the old prompt
+
+    used = {}
+    for half, row in ((0, TEXT_ROW - 1), (1, TEXT_ROW)):
+        for i in range(LAST_COL - FIRST_COL + 1):
+            tile = tuple(tuple(grid[half * 8 + y][i * 8 + x] for x in range(8)) for y in range(8))
+            if all(v == BG for line in tile for v in line):
+                continue
+            if tile not in used:
+                if len(used) == len(SLOTS):
+                    sys.exit("Too many different tiles: %d are free." % len(SLOTS))
+                slot = SLOTS[len(used)]
+                used[tile] = slot
+                for y in range(8):
+                    for x in range(8):
+                        px[(slot % 16) * 8 + x, (slot // 16) * 8 + y] = tile[y][x]
+            vals[row * MAP_W + FIRST_COL + i] = pal | used[tile]
+
+    im.save(PNG)
+    MAP.write_bytes(struct.pack("<%dH" % len(vals), *vals))
+    print("title prompt: %r, %d pixels wide from x=%d, %d of %d tiles used"
+          % (text.upper(), width, screen_x, len(used), len(SLOTS)))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/han/han_unown_letters.py b/tools/han/han_unown_letters.py
new file mode 100644
index 0000000..97044b9
--- /dev/null
+++ b/tools/han/han_unown_letters.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Draws the syllabics letters that fly at the foe in the UNOWN's move.
+
+    python3 tools/han/han_unown_letters.py
+
+The move's animation is BULLET SEED's with a letter in place of each seed.
+Every "bullet" is a different letter, picked at random from the 180 letters of
+the Carrier syllabics table at https://www.ydli.org/dakinfo/dulkwah.htm: 30
+rows of 6, with none of the finals. Jane chose the set on 16 November 2026.
+
+It writes two pictures into graphics/battle_anims/sprites/:
+
+    unown_glyphs.png   all 180 letters, 16 by 16 each, one under the other
+    unown_glyph.png    the first letter alone. The game loads this one in the
+                       usual way and takes the colours from it.
+
+The shapes are the 16 pixel letters of GNU Unifont, with a white edge so they
+show on any background. Unifont must be installed to run this (on Ubuntu:
+sudo apt install unifont). The pictures are in the patch, so the game builds
+without it. Safe to run again.
+
+The game code is AnimUnownGlyph in src/battle_anim_effects_2.c. If the number
+of letters changes, change UNOWN_GLYPH_COUNT there too.
+"""
+import sys
+import unicodedata
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "graphics/battle_anims/sprites"
+FONT = "/usr/share/fonts/opentype/unifont/unifont.otf"
+
+# The table, row by row. In each row the vowels are a, ʌ, e, i, o, u.
+LETTERS = (
+    "ᗭᗪᗫᗬᗩᗨ" "ᗡᗞᗟᗠᗝᗜ" "ᑕᑐᑓᑔᑎᑌ" "ᗧᗤᗥᗦᗣᗢ" "ᗺᗷᗸᗹᗶᗵ" "ᗴᗱᗲᗳᗰᗯ"      # b t d t' k g
+    "ᘀᗽᗾᗿᗼᗻ" "ᙠᙝᙞᙟᙜᙛ" "ᘛᘗᘘᘙᘖᘔ" "ᘡᘞᘟᘠᘝᘜ" "ᙦᙣᙤᙥᙢᙡ" "ᙍᙊᙋᙌᙉᙈ"      # k' ch j ch' ts dz
+    "ᙬᙩᙪᙫᙨᙧ" "ᘇᘄᘅᘆᘃᘂ" "ᘍᘊᘋᘌᘉᘈ" "ᘧᘤᘥᘦᘣᘢ" "ᘳᘰᘱᘲᘯᘮ" "ᘹᘶᘷᘸᘵᘴ"      # ts' n m l lh tl
+    "ᘭᘪᘫᘬᘩᘨ" "ᘿᘼᘽᘾᘻᘺ" "ᙓᙐᙑᙒᙏᙎ" "ᙅᙂᙃᙄᙁᙀ" "ᙙᙖᙗᙘᙕᙔ" "ᗉᗆᗇᗈᗅᗄ"      # dl tl' s z sh kh
+    "ᗏᗌᗍᗎᗋᗊ" "ᐸᐳᐶᐷᐱᐯ" "ᗕᗒᗓᗔᗑᗐ" "ᗛᗘᗙᗚᗗᗖ" "ᘓᘐᘑᘒᘏᘎ" "ᐊᐅᐈᐉᐃᐁ"      # gh h w wh y (no consonant)
+)
+CLEAR, WHITE, BLACK = 0, 1, 2
+PALETTE = [(115, 197, 164), (248, 248, 248), (16, 16, 24)] + [(0, 0, 0)] * 13
+
+
+def ink_of(font, ch):
+    """The pixels of one letter, as (x, y) from the corner of its own box."""
+    im = Image.new("L", (48, 48), 255)
+    ImageDraw.Draw(im).text((16, 16), ch, font=font, fill=0)
+    cells = {(x, y) for y in range(48) for x in range(48) if im.getpixel((x, y)) < 128}
+    if not cells:
+        sys.exit("The font has no shape for %s (U+%04X)." % (ch, ord(ch)))
+    x0, y0 = min(x for x, y in cells), min(y for x, y in cells)
+    return {(x - x0, y - y0) for x, y in cells}
+
+
+def frame(ink, ch):
+    """The letter in the middle of a 16 by 16 frame: black line, white edge, white inside."""
+    w, h = max(x for x, y in ink) + 1, max(y for x, y in ink) + 1
+    if w > 14 or h > 14:
+        sys.exit("%s is %d by %d: too big for a 16 by 16 frame with an edge." % (ch, w, h))
+    dx, dy = (16 - w) // 2, (16 - h) // 2
+    cells = {(x + dx, y + dy) for x, y in ink}
+    outside, todo = set(), [(0, 0)]            # all that the outside can reach without crossing a line
+    while todo:
+        x, y = todo.pop()
+        if (x, y) in outside or (x, y) in cells or not (0 <= x < 16 and 0 <= y < 16):
+            continue
+        outside.add((x, y))
+        todo += [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
+    grid = [[CLEAR] * 16 for _ in range(16)]
+    for y in range(16):
+        for x in range(16):
+            if (x, y) in cells:
+                grid[y][x] = BLACK
+            elif (x, y) not in outside:
+                grid[y][x] = WHITE
+            elif any((x + i, y + j) in cells for i in (-1, 0, 1) for j in (-1, 0, 1)):
+                grid[y][x] = WHITE
+    return grid
+
+
+def save(path, frames):
+    im = Image.new("P", (16, 16 * len(frames)), CLEAR)
+    flat = []
+    for colour in PALETTE:
+        flat += list(colour)
+    im.putpalette(flat + [0] * (768 - len(flat)))
+    px = im.load()
+    for i, grid in enumerate(frames):
+        for y, row in enumerate(grid):
+            for x, v in enumerate(row):
+                px[x, i * 16 + y] = v
+    im.save(path, bits=4)
+
+
+def main():
+    assert len(LETTERS) == 180 and len(set(LETTERS)) == 180
+    for ch in LETTERS:                         # a final would have FINAL in its name, or no vowel at the end
+        name = unicodedata.name(ch)
+        assert "FINAL" not in name and name[-1] in "AEIOU", name
+    font = ImageFont.truetype(FONT, 16)
+    frames = [frame(ink_of(font, ch), ch) for ch in LETTERS]
+    save(OUT / "unown_glyphs.png", frames)
+    save(OUT / "unown_glyph.png", frames[:1])
+    print("wrote unown_glyphs.png (%d letters) and unown_glyph.png" % len(frames))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/han/han_unown_trio.py b/tools/han/han_unown_trio.py
new file mode 100644
index 0000000..bd5b3af
--- /dev/null
+++ b/tools/han/han_unown_trio.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Puts three UNOWN into one picture for CHAMPION JANE's UNOWN: J on top, C and ? below it.
+
+The three touch and do not overlap: the J's hook rests on the C, and the ? hangs
+from the J. The C and the ? do not touch each other. Jane asked for this on
+16 November 2026. The script checks it and stops if a change to PLACES breaks it.
+
+    python3 tools/han/han_unown_trio.py
+
+It reads the game's own pictures of the three shapes and writes
+graphics/pokemon/unown/trio/front.png. Nothing is redrawn: each shape is moved
+whole, pixel for pixel. The build runs this by itself (see the rule at the end
+of graphics_file_rules.mk), so the picture is made on the builder's computer
+and the patch holds no picture from the game.
+
+To change the arrangement, change PLACES.
+"""
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+UNOWN = ROOT / "graphics/pokemon/unown"
+OUT = UNOWN / "trio/front.png"
+
+# shape, then where the left and top of its drawing go in the new 64 by 64 picture.
+PLACES = [
+    ("j", 30, 8),
+    ("c", 8, 31),
+    ("question_mark", 38, 27),
+]
+# pairs that must touch: pixels side by side, with none shared and none between
+TOUCHING = [("j", "c"), ("j", "question_mark")]
+
+
+def main():
+    out = None
+    drawn = {}
+    for name, left, top in PLACES:
+        src = Image.open(UNOWN / name / "front.png")
+        assert src.mode == "P" and src.size == (64, 64), name
+        if out is None:
+            out = Image.new("P", (64, 64), 0)
+            out.putpalette(src.getpalette())
+            palette = src.getpalette()[:48]
+        assert src.getpalette()[:48] == palette, "the three pictures must share one palette"
+        px = src.load()
+        cells = [(x, y) for y in range(64) for x in range(64) if px[x, y]]
+        x0, y0 = min(x for x, y in cells), min(y for x, y in cells)
+        dst = out.load()
+        for x, y in cells:
+            nx, ny = x - x0 + left, y - y0 + top
+            assert 0 <= nx < 64 and 0 <= ny < 64, "%s does not fit at %d, %d" % (name, left, top)
+            dst[nx, ny] = px[x, y]
+        drawn[name] = {(x - x0 + left, y - y0 + top) for x, y in cells}
+    names = list(drawn)
+    for i, a in enumerate(names):
+        for b in names[i + 1:]:
+            assert not drawn[a] & drawn[b], "%s and %s overlap" % (a, b)
+    for a, b in TOUCHING:
+        beside = [p for p in drawn[a] if any((p[0] + dx, p[1] + dy) in drawn[b] for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)))]
+        assert beside, "%s and %s do not touch" % (a, b)
+    OUT.parent.mkdir(exist_ok=True)
+    out.save(OUT, bits=4)
+    print("wrote %s" % OUT.relative_to(ROOT))
+
+
+if __name__ == "__main__":
+    main()
