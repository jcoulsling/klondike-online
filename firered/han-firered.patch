+//
+// The game has no way to the internet. The web page that runs it does: it finds the mailbox below in the
+// emulator's memory by its marker, and each frame it
+//   - reads "mine": where this player is (map, tile, facing, whether walking, which picture), and
+//   - writes "others": the same for up to four other players in the same room.
+// Here, every frame in the overworld, "mine" is written and each of "others" on the same map is drawn
+// as a sprite that walks towards the tile it was sent. Nothing else in the game is touched: the other
+// players cannot be talked to, stopped by, or battled from the map. The emulator on its own (no page)
+// never fills "others", so nothing is drawn.
+
+EWRAM_DATA struct HanMailbox gHanMailbox = {0};
+
+#define GHOST_TAG 0x4B0B
+
+static void SpriteCB_Ghost(struct Sprite *sprite)
+{
+}
+
+static s16 StepTowards(s16 cur, s16 target, s16 speed)
+{
+    if (cur < target)
+        return (target - cur < speed) ? target : cur + speed;
+    if (cur > target)
+        return (cur - target < speed) ? target : cur - speed;
+    return cur;
+}
+
+static void WriteMine(void)
+{
+    struct HanPlayerState *me = &gHanMailbox.mine;
+    struct ObjectEvent *obj = &gObjectEvents[gPlayerAvatar.objectEventId];
+
+    me->active = TRUE;
+    me->mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    me->mapNum = gSaveBlock1Ptr->location.mapNum;
+    me->facing = obj->facingDirection;
+    me->x = gSaveBlock1Ptr->pos.x;
+    me->y = gSaveBlock1Ptr->pos.y;
+    me->gfx = GetPlayerAvatarGraphicsIdByCurrentState();
+    me->walking = gPlayerAvatar.tileTransitionState != T_NOT_MOVING;
+    gHanMailbox.frame++;
+}
+
+static void UpdateGhost(u8 slot, struct HanPlayerState *they)
+{
+    u8 id = gHanMailbox.spriteIds[slot];
+    struct Sprite *sprite = &gSprites[id];
+    s16 targetX, targetY, wx, wy, tx, ty, dx, dy, speed;
+    u8 dir;
+
+    if (!they->active
+     || they->mapGroup != gSaveBlock1Ptr->location.mapGroup
+     || they->mapNum != gSaveBlock1Ptr->location.mapNum)
+    {
+        if (id != MAX_SPRITES && sprite->inUse && sprite->data[7] == GHOST_TAG)
+            DestroySprite(sprite);
+        gHanMailbox.spriteIds[slot] = MAX_SPRITES;
+        return;
+    }
+    targetX = they->x * 16;
+    targetY = they->y * 16;
+    if (id == MAX_SPRITES || !sprite->inUse || sprite->data[7] != GHOST_TAG || sprite->data[6] != they->gfx)
+    {
+        if (id != MAX_SPRITES && sprite->inUse && sprite->data[7] == GHOST_TAG)
+            DestroySprite(sprite);
+        id = CreateObjectGraphicsSprite(they->gfx, SpriteCB_Ghost, 0, 0, 0);
+        gHanMailbox.spriteIds[slot] = id;
+        if (id == MAX_SPRITES)
+            return;
+        sprite = &gSprites[id];
+        sprite->data[7] = GHOST_TAG;
+        sprite->data[6] = they->gfx;
+        sprite->data[0] = targetX;     // where it stands now, in pixels of the map
+        sprite->data[1] = targetY;
+        sprite->coordOffsetEnabled = TRUE;
+        sprite->centerToCornerVecX = -8;
+        sprite->centerToCornerVecY = -16;
+        sprite->oam.priority = gSprites[gPlayerAvatar.spriteId].oam.priority;
+    }
+    wx = sprite->data[0];
+    wy = sprite->data[1];
+    dx = targetX - wx;
+    dy = targetY - wy;
+    if (dx > 80 || dx < -80 || dy > 80 || dy < -80)
+    {
+        wx = targetX;
+        wy = targetY;
+        dx = dy = 0;
+    }
+    speed = 1;
+    if (dx > 20 || dx < -20 || dy > 20 || dy < -20)
+        speed = 2;
+    if (dx > 48 || dx < -48 || dy > 48 || dy < -48)
+        speed = 4;
+    if (they->walking && speed == 1)
+        speed = 1;
+    wx = StepTowards(wx, targetX, speed);
+    wy = StepTowards(wy, targetY, speed);
+    sprite->data[0] = wx;
+    sprite->data[1] = wy;
+
+    dir = they->facing;
+    if (wx != targetX || wy != targetY)
+    {
+        if ((dx < 0 ? -dx : dx) >= (dy < 0 ? -dy : dy))
+            dir = dx > 0 ? DIR_EAST : DIR_WEST;
+        else
+            dir = dy > 0 ? DIR_SOUTH : DIR_NORTH;
+        StartSpriteAnimIfDifferent(sprite, GetMoveDirectionAnimNum(dir));
+    }
+    else
+    {
+        StartSpriteAnimIfDifferent(sprite, GetFaceDirectionAnimNum(they->facing));
+    }
+
+    tx = (wx >> 4) + MAP_OFFSET;
+    ty = (wy >> 4) + MAP_OFFSET;
+    SetSpritePosToMapCoords(tx, ty, &sprite->x, &sprite->y);
+    sprite->x += (wx & 15) + 8;
+    sprite->y += (wy & 15) + 16 + sprite->centerToCornerVecY;
+    sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority;
+    if (wy > gSaveBlock1Ptr->pos.y * 16)
+        sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority - 1; // in front of this player
+    else
+        sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority + 1;
+}
+
+// Called every frame the overworld runs, after the camera has moved.
+void HanMultiplayerFrame(void)
+{
+    u8 i;
+
+    if (gHanMailbox.magic[0] == 0)
+    {
+        // One letter at a time: a string would also stand in the ROM, and the page must find only this one.
+        gHanMailbox.magic[0] = 'K';
+        gHanMailbox.magic[1] = 'L';
+        gHanMailbox.magic[2] = 'N';
+        gHanMailbox.magic[3] = 'D';
+        gHanMailbox.magic[4] = 'K';
+        gHanMailbox.magic[5] = 'M';
+        gHanMailbox.magic[6] = 'B';
+        gHanMailbox.magic[7] = 'X';
+        for (i = 0; i < HAN_OTHERS; i++)
+            gHanMailbox.spriteIds[i] = MAX_SPRITES;
+    }
+    WriteMine();
+    for (i = 0; i < HAN_OTHERS; i++)
+        UpdateGhost(i, &gHanMailbox.others[i]);
+}
diff --git a/src/han_syllabics_core.h b/src/han_syllabics_core.h
new file mode 100644
index 0000000..4828587
--- /dev/null
+++ b/src/han_syllabics_core.h
@@ -0,0 +1,206 @@
+// Hän build: turns Latin Hän text into Jane's Hän syllabics, a syllable at a time.
+//
+// It follows the converter in her word processor (han-word-processor.html: tokenize,
+// eaglePreprocess, matchV), set as that page starts: the Eagle way of writing finals,
+// and a letter y between a consonant and its vowel shown as a dot.
+// Two things differ on purpose:
+//  - The end of a string counts as the end of a word. The word processor treats the very
+//    end of its text as a consonant still waiting for a vowel, which only suits typing.
+//  - th, dh, tth, ddh, sr, zr, tr, dr and zh have no final in her font, so here they have none.
+//
+// This file has no game code in it, so the same lines can be compiled on a computer and
+// checked against the word processor (tools/han/syllabics_test.c).
+// It needs u8, u16, bool8, TRUE and FALSE, and the tables in data/han_syllabics.h.
+
+#define HAN_SYL_NONE   0 // not syllabics: show the character the usual way
+#define HAN_SYL_GLYPH  1
+#define HAN_SYL_SKIP   2 // shows nothing
+
+#define HAN_SYL_MARK_NASAL  1
+#define HAN_SYL_MARK_TONE   2
+#define HAN_SYL_MARK_DOT    4
+
+#define HAN_SYL_ONSET_COUNT (sizeof(sHanSylOnsets) / sizeof(sHanSylOnsets[0]))
+#define HAN_SYL_PRENASAL_COUNT (sizeof(sHanSylPrenasal) / sizeof(sHanSylPrenasal[0]))
+
+static u8 HanSyl_Letter(const u8 *s)
+{
+    return sHanSylLetters[*s] & HAN_SYL_LETTER_MASK;
+}
+
+static bool8 HanSyl_VowelAt(const u8 *s)
+{
+    switch (HanSyl_Letter(s))
+    {
+    case HAN_SYL_L_A:
+    case HAN_SYL_L_E:
+    case HAN_SYL_L_I:
+    case HAN_SYL_L_O:
+    case HAN_SYL_L_U:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// The letters at s spell this onset.
+static bool8 HanSyl_Match(const u8 *s, const u8 *letters, u8 length)
+{
+    u8 i;
+
+    for (i = 0; i < length; i++)
+    {
+        if (HanSyl_Letter(s + i) != letters[i])
+            return FALSE;
+    }
+    return TRUE;
+}
+
+// Reads the vowel at s. Gives its column in the grid and its marks. Returns how many characters it took:
+// two when the vowel is written twice, which counts as one and keeps the marks of the first.
+static u8 HanSyl_ReadVowel(const u8 *s, u8 *column, u8 *marks)
+{
+    u8 info = sHanSylLetters[*s];
+    u8 letter = info & HAN_SYL_LETTER_MASK;
+    bool8 dots = (info & HAN_SYL_DIAERESIS) != 0;
+
+    switch (letter)
+    {
+    case HAN_SYL_L_A:
+        *column = dots ? 0 : 1;
+        break;
+    case HAN_SYL_L_E:
+        *column = dots ? 2 : 3;
+        break;
+    case HAN_SYL_L_I:
+        *column = 4;
+        break;
+    case HAN_SYL_L_O:
+        *column = dots ? 2 : 5; // ö is written as ë
+        break;
+    default:
+        *column = 6;
+        break;
+    }
+    if (info & HAN_SYL_NASAL_HOOK)
+        *marks |= HAN_SYL_MARK_NASAL;
+    if (info & HAN_SYL_GRAVE)
+        *marks |= HAN_SYL_MARK_TONE;
+    return HanSyl_Letter(s + 1) == letter ? 2 : 1;
+}
+
+// Reads the next piece of the text at s. For HAN_SYL_GLYPH it gives the glyph and the marks that follow it.
+// used is how many characters of the text the piece took.
+static u8 HanSyl_Next(const u8 *s, u16 *glyph, u8 *used, u8 *marks)
+{
+    const struct HanSylOnset *onset;
+    u8 letter = HanSyl_Letter(s);
+    u8 next, column, i;
+    bool8 dot;
+
+    *marks = 0;
+    *used = 1;
+    if (letter == 0)
+        return HAN_SYL_NONE;
+
+    // An apostrophe that is not part of t', k' and the like is the glottal stop.
+    if (letter == HAN_SYL_APOSTROPHE)
+    {
+        *glyph = HAN_SYL_FINALS_BASE + HAN_SYL_FINAL_GLOTTAL;
+        return HAN_SYL_GLYPH;
+    }
+
+    // n, l, w, y and r at the end of a syllable, the Eagle way: n, nn and nh are all one n final.
+    if (letter == HAN_SYL_L_N || letter == HAN_SYL_L_L || letter == HAN_SYL_L_W || letter == HAN_SYL_L_Y || letter == HAN_SYL_L_R)
+    {
+        next = HanSyl_Letter(s + 1);
+        if ((next == letter || next == HAN_SYL_L_H) && !HanSyl_VowelAt(s + 2))
+        {
+            *used = 2;
+            if (next == letter && letter != HAN_SYL_L_N && letter != HAN_SYL_L_R
+             && HanSyl_Letter(s + 2) == letter && !HanSyl_VowelAt(s + 3))
+                *used = 3;
+            for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+            {
+                onset = &sHanSylOnsets[i];
+                if (onset->length == 1 && onset->letters[0] == letter)
+                    break;
+            }
+            *glyph = HAN_SYL_FINALS_BASE + onset->final;
+            if (sHanSylLetters[*s] & HAN_SYL_GRAVE)
+                *marks = HAN_SYL_MARK_TONE;
+            return HAN_SYL_GLYPH;
+        }
+    }
+
+    // nd, mb, nj, ng and ndz before a vowel: an n final, then the syllable.
+    for (i = 0; i < HAN_SYL_PRENASAL_COUNT; i++)
+    {
+        if (HanSyl_Match(s, &sHanSylPrenasal[i][1], sHanSylPrenasal[i][0]) && HanSyl_VowelAt(s + sHanSylPrenasal[i][0]))
+        {
+            *glyph = HAN_SYL_FINALS_BASE + HAN_SYL_FINAL_N;
+            return HAN_SYL_GLYPH;
+        }
+    }
+
+    // A consonant and a vowel, with or without a y between them.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (!HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        dot = HanSyl_Letter(s + onset->length) == HAN_SYL_L_Y && HanSyl_VowelAt(s + onset->length + 1);
+        if (!dot && !HanSyl_VowelAt(s + onset->length))
+            continue;
+        if (onset->lead != HAN_SYL_NO) // tth is a t final and then th
+        {
+            *glyph = HAN_SYL_FINALS_BASE + onset->lead;
+            return HAN_SYL_GLYPH;
+        }
+        if (onset->row == HAN_SYL_NO)  // r and ng have no syllables
+            return HAN_SYL_NONE;
+        *used = onset->length + dot;
+        *used += HanSyl_ReadVowel(s + *used, &column, marks);
+        if (dot)
+            *marks |= HAN_SYL_MARK_DOT;
+        *glyph = onset->row * HAN_SYL_VOWELS + column;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A vowel with no consonant.
+    if (HanSyl_VowelAt(s))
+    {
+        *used = HanSyl_ReadVowel(s, &column, marks);
+        *glyph = HAN_SYL_ROW_VOWEL * HAN_SYL_VOWELS + column;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A consonant with no vowel after it: its final, if it has one.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (onset->final == HAN_SYL_NO || !HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        if (onset->ejectiveBase && HanSyl_Letter(s + onset->length) == HAN_SYL_APOSTROPHE)
+            break;
+        *used = onset->length;
+        *glyph = HAN_SYL_FINALS_BASE + onset->final;
+        if (sHanSylLetters[*s] & HAN_SYL_GRAVE)
+            *marks = HAN_SYL_MARK_TONE;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A consonant that has no final. The word processor leaves it out, unless its last letter can stand as a final.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (!HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        if (HanSyl_Letter(s + onset->length) != HAN_SYL_APOSTROPHE && !onset->endsInFinal)
+        {
+            *used = onset->length;
+            return HAN_SYL_SKIP;
+        }
+        break;
+    }
+    return HAN_SYL_NONE;
+}
