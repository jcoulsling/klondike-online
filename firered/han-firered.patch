+#!/usr/bin/env python3
+"""Render sample lines with the font sheets, the way the game draws them.
+Usage: python3 tools/han/han_preview.py out.png
+"""
+import re, sys, unicodedata
+from pathlib import Path
+from PIL import Image
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(Path(__file__).parent))
+import han_font as H
+
+def load_charmap():
+    cm = {}
+    for line in (ROOT / "charmap.txt").read_text(encoding="utf-8").splitlines():
+        if line.startswith("@ Hiragana"):
+            break
+        m = re.match(r"'(\\?.[^']*)'\s*=\s*([0-9A-F]{2})\s*$", line)
+        if m:
+            key = m.group(1)
+            key = "'" if key == "\\'" else key
+            cm[unicodedata.normalize("NFC", key)] = int(m.group(2), 16)
+    return cm
+
+def clusters(s):
+    d = unicodedata.normalize("NFD", s)
+    out, i = [], 0
+    while i < len(d):
+        j = i + 1
+        while j < len(d) and unicodedata.combining(d[j]):
+            j += 1
+        out.append(unicodedata.normalize("NFC", d[i:j]))
+        i = j
+    return out
+
+COLORS = {H.OUT: (255, 255, 255), H.BG: (255, 255, 255), H.INK: (96, 96, 96), H.SHADOW: (208, 208, 200)}
+
+def render(lines, kind, scale=4):
+    src = (ROOT / "src" / "text.c").read_text()
+    font = H.Font(kind)
+    widths, _ = H.read_widths(src, font.width_tables[0])
+    cm = load_charmap()
+    lh = 16
+    W = max(sum(widths[cm[c]] for c in clusters(l)) for l in lines) + 8
+    img = Image.new("RGB", (W, lh * len(lines) + 4), (255, 255, 255))
+    for li, line in enumerate(lines):
+        x = 4
+        for c in clusters(line):
+            code = cm[c]
+            g = font.read(code)
+            for yy in font.rows:
+                for xx in range(widths[code]):
+                    v = g[yy][xx]
+                    if v in (H.INK, H.SHADOW):
+                        img.putpixel((x + xx, 2 + li * lh + yy), COLORS[v])
+            x += widths[code]
+    return img.resize((img.width * scale, img.height * scale), Image.NEAREST)
+
+if __name__ == "__main__":
+    lines = [
+        "a à ä ą ą̀ ä̀ ą̈ ą̈̀   e è ë ę ę̀ ë̀ ę̈ ę̈̀",
+        "o ò ö ǫ ǫ̀ ö̀ ǫ̈ ǫ̈̀   i ì į į̀  u ù ų ų̀",
+        "l ł n ǹ * ’  g p q y j",
+        "A À Ä Ą Ą̀ Ä̀ Ą̈ Ą̈̀   E È Ë Ę Ę̀ Ë̀ Ę̈ Ę̈̀",
+        "O Ò Ö Ǫ Ǫ̀ Ö̀ Ǫ̈ Ǫ̈̀   I Ì Į Į̀  U Ù Ų Ų̀",
+        "L Ł N Ǹ",
+    ]
+    a = render(lines, "normal")
+    b = render(lines, "small")
+    out = Image.new("RGB", (max(a.width, b.width), a.height + b.height + 8), (255, 255, 255))
+    out.paste(a, (0, 0)); out.paste(b, (0, a.height + 8))
+    out.save(sys.argv[1])
