diff --git a/src/decompress.c b/src/decompress.c
index f4740f9..a1ef78c 100644
--- a/src/decompress.c
+++ b/src/decompress.c
@@ -2,6 +2,7 @@
 #include "gflib.h"
 #include "decompress.h"
 #include "pokemon.h"
+#include "graphics.h"
 
 extern const struct CompressedSpriteSheet gMonFrontPicTable[];
 extern const struct CompressedSpriteSheet gMonBackPicTable[];
@@ -80,6 +81,14 @@ void HandleLoadSpecialPokePic(const struct CompressedSpriteSheet *src, void *des
     LoadSpecialPokePic(src, dest, species, personality, isFrontPic);
 }
 
+// Hän build: a female PIKACHU has a heart-shaped tail, as in later games. Personality 0 is what the POKéDEX
+// and other screens that show no POKéMON of the player's pass, so it gets the usual picture.
+static bool32 IsHeartTailPikachu(s32 species, u32 personality)
+{
+    return species == SPECIES_PIKACHU && personality != 0
+        && GetGenderFromSpeciesAndPersonality(SPECIES_PIKACHU, personality) == MON_FEMALE;
+}
+
 void LoadSpecialPokePic(const struct CompressedSpriteSheet *src, void *dest, s32 species, u32 personality, bool8 isFrontPic)
 {
     if (species == SPECIES_UNOWN)
@@ -98,6 +107,8 @@ void LoadSpecialPokePic(const struct CompressedSpriteSheet *src, void *dest, s32
     }
     else if (species > NUM_SPECIES) // is species unknown? draw the ? icon
         LZ77UnCompWram(gMonFrontPicTable[0].data, dest);
+    else if (IsHeartTailPikachu(species, personality)) // Hän build
+        LZ77UnCompWram(isFrontPic ? gMonFrontPic_PikachuFemale : gMonBackPic_PikachuFemale, dest);
     else
         LZ77UnCompWram(src->data, dest);
 
@@ -341,12 +352,10 @@ void LoadSpecialPokePic_DontHandleDeoxys(const struct CompressedSpriteSheet *src
             LZ77UnCompWram(gMonFrontPicTable[i].data, dest);
     }
     else if (species > NUM_SPECIES) // is species unknown? draw the ? icon
-    {
         LZ77UnCompWram(gMonFrontPicTable[0].data, dest);
-    }
+    else if (IsHeartTailPikachu(species, personality)) // Hän build
+        LZ77UnCompWram(isFrontPic ? gMonFrontPic_PikachuFemale : gMonBackPic_PikachuFemale, dest);
     else
-    {
         LZ77UnCompWram(src->data, dest);
-    }
     DrawSpindaSpots(species, personality, dest, isFrontPic);
 }
