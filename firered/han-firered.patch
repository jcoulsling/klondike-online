+}
+
+// Call once a frame. Returns CHEAT_NONE, or the cheat whose last key was just pressed.
+u8 CheatCodeEntered(void)
+{
+    u16 keys = JOY_NEW(DPAD_ANY | A_BUTTON | B_BUTTON | SELECT_BUTTON | START_BUTTON | L_BUTTON | R_BUTTON);
+    u8 i, j;
+
+    if (keys == 0)
+        return CHEAT_NONE;
+    for (i = 0; i < CHEAT_LENGTH - 1; i++)
+        sCheatKeys[i] = sCheatKeys[i + 1];
+    sCheatKeys[CHEAT_LENGTH - 1] = keys;
+    for (i = 0; i < ARRAY_COUNT(sCheatCodes); i++)
+    {
+        for (j = 0; j < CHEAT_LENGTH && (sCheatCodes[i][j] == 0 || sCheatKeys[j] == sCheatCodes[i][j]); j++)
