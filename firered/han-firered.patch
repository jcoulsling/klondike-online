+#!/usr/bin/env python3
+"""Makes the Hän syllabics font for the game from Jane's own font.
+
+    python3 tools/han/han_syllabics.py PATH/TO/_HanSyllabics.ttf
+
+The game can show its text in Hän syllabics (the cheat Up, Up, Up, Up, Select:
+see HanSyl_Next in src/han_syllabics_core.h). This script draws the letters it
+needs and writes the tables that say which Latin letters make which syllable:
+
+    graphics/fonts/han_syllabics.png   one 16 by 16 cell for each glyph
+    src/data/han_syllabics.h           the tables for the game code
+
+The shapes are Jane's. Every syllable and final is drawn from her font
+(family "Han Syllabics Custom Rounded Dot") at 12 pixels, one bit, with the
+game's own grey shadow added. Nothing is redrawn by hand. Her custom letters
+are the private-use code points U+F0000 to U+F005C in that font.
+
+The grid is the GRID table of her word processor (han-word-processor.html),
+with the code points of the font, and the finals are the ones her handoff
+note lists for November 2026. The font file is not in the patch: only the
+picture made from it is. Run this again only when the font or the grid changes.
+
+A line of game text is 14 pixels high. The nasal tilde, the low tone mark and
+the dot for a consonant plus y sit on top of the syllable, in the two top rows
+of its cell, so a marked syllable is exactly as wide as a plain one. Every
+syllable is drawn eight times, once for each set of marks. A syllable that is
+too tall to leave a clear row under its marks is drawn one or two pixels
+lower when it has marks. The tilde is the pixels the font itself gives at
+this size. The tone mark is a two pixel slope and the dot is two by two, so
+that the two can be told apart.
+
+A proper name (a person, a Pokémon, a place) starts with an asterisk, as in
+Carrier syllabics. The asterisk is the * of the same font. The game draws it:
+see HanSyl_NameStartsAt in src/text.c. The names the game's own lists do not
+have are in proper_names.txt, next to this script.
+"""
+import re
+import sys
+import unicodedata
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+ROOT = Path(__file__).resolve().parents[2]
+PNG = ROOT / "graphics/fonts/han_syllabics.png"
+HEADER = ROOT / "src/data/han_syllabics.h"
+CHARMAP = ROOT / "charmap.txt"
+SIZE = 12                 # pixels per em
+BASELINE = 11             # row of the cell that the letters stand on (the first row under them): as for Latin capitals
+MARK_ROWS = 2             # the marks take the top rows of the cell
+CELL_HEIGHT = 14          # rows the game copies, as for its Latin letters
+BG, INK, SHADOW = 0, 1, 2
+PALETTE = [(144, 200, 255), (56, 56, 56), (216, 216, 216), (255, 255, 255)]   # as in graphics/fonts/latin_normal.png
+
+VOWELS = ["ä", "a", "ë", "e", "i", "o", "u"]          # the columns of the grid
+
+
+def series(base):
+    return [base + i for i in range(7)]
+
+
+# Onset, then its seven syllables in the order of VOWELS.
+ROWS = [
+    ("b",    [0x15ED, 0xF0000, 0x15EA, 0x15EB, 0x15EC, 0x15E9, 0x15E8]),
+    ("t",    [0x15E1, 0xF0001, 0x15DE, 0x15DF, 0x15E0, 0x15DD, 0x15DC]),
+    ("d",    [0x1455, 0xF0002, 0x1450, 0x1453, 0x1454, 0x144E, 0x144C]),
+    ("t'",   [0x15E7, 0xF0003, 0x15E4, 0x15E5, 0x15E6, 0x15E3, 0x15E2]),
+    ("k",    [0x15FA, 0xF0004, 0x15F7, 0x15F8, 0x15F9, 0x15F6, 0x15F5]),
+    ("g",    [0x15F4, 0xF0005, 0x15F1, 0x15F2, 0x15F3, 0x15F0, 0x15EF]),
+    ("k'",   [0x1600, 0xF0006, 0x15FD, 0x15FE, 0x15FF, 0x15FC, 0x15FB]),
+    ("ch",   [0x1660, 0xF0007, 0x165D, 0x165E, 0x165F, 0x165C, 0x165B]),
+    ("j",    [0x161B, 0xF0008, 0x1617, 0x1618, 0x1619, 0x1616, 0x1614]),
+    ("ch'",  [0x1621, 0xF0009, 0x161E, 0x161F, 0x1620, 0x161D, 0x161C]),
+    ("ts",   [0x1666, 0xF000A, 0x1663, 0x1664, 0x1665, 0x1662, 0x1661]),
+    ("dz",   [0x164D, 0xF000B, 0x164A, 0x164B, 0x164C, 0x1649, 0x1648]),
+    ("ts'",  [0x166C, 0xF000C, 0x1669, 0x166A, 0x166B, 0x1668, 0x1667]),
+    ("n",    [0x1607, 0xF000D, 0x1604, 0x1605, 0x1606, 0x1603, 0x1602]),
+    ("m",    [0x160D, 0xF000E, 0x160A, 0x160B, 0x160C, 0x1609, 0x1608]),
+    ("l",    [0x1627, 0xF000F, 0x1624, 0x1625, 0x1626, 0x1623, 0x1622]),
+    ("ł",    [0x1633, 0xF0010, 0x1630, 0x1631, 0x1632, 0x162F, 0x162E]),
+    ("tl",   [0x1639, 0xF0011, 0x1636, 0x1637, 0x1638, 0x1635, 0x1634]),
+    ("dl",   [0x162D, 0xF0012, 0x162A, 0x162B, 0x162C, 0x1629, 0x1628]),
+    ("tl'",  [0x163F, 0xF0013, 0x163C, 0x163D, 0x163E, 0x163B, 0x163A]),
+    ("s",    [0x1653, 0xF0014, 0x1650, 0x1651, 0x1652, 0x164F, 0x164E]),
+    ("z",    [0x1645, 0xF0015, 0x1642, 0x1643, 0x1644, 0x1641, 0x1640]),
+    ("sh",   [0x1659, 0xF0016, 0x1656, 0x1657, 0x1658, 0x1655, 0x1654]),
+    ("kh",   [0x15C9, 0xF0017, 0x15C6, 0x15C7, 0x15C8, 0x15C5, 0x15C4]),
+    ("gh",   [0x15CF, 0xF0018, 0x15CC, 0x15CD, 0x15CE, 0x15CB, 0x15CA]),
+    ("h",    [0x1438, 0xF0019, 0x1433, 0x1436, 0x1437, 0x1431, 0x142F]),
+    ("w",    [0x15D5, 0xF001A, 0x15D2, 0x15D3, 0x15D4, 0x15D1, 0x15D0]),
+    ("hw",   [0x15DB, 0xF001B, 0x15D8, 0x15D9, 0x15DA, 0x15D7, 0x15D6]),
+    ("y",    [0x1613, 0xF001C, 0x1610, 0x1611, 0x1612, 0x160F, 0x160E]),
+    ("th",   series(0xF001E)),
+    ("dh",   series(0xF0025)),
+    ("tth'", series(0xF002C)),
+    ("sr",   series(0xF0033)),
+    ("zr",   series(0xF003A)),
+    ("tr",   series(0xF0041)),
+    ("tr'",  series(0xF0048)),
+    ("dr",   series(0xF004F)),
+    ("zh",   series(0xF0056)),
+    ("V",    [0x140A, 0xF001D, 0x1405, 0x1408, 0x1409, 0x1403, 0x1401]),      # a vowel with no consonant
+]
+
+# Finals. "Q" is the glottal stop.
+FINALS = [("b", 0x15EE), ("t", 0x142A), ("k", 0x1420), ("g", 0x141F), ("k'", 0x1601), ("n", 0x1423), ("m", 0x14BC),
+          ("ng", 0x14D1), ("l", 0x14A1), ("ł", 0x14A1), ("s", 0x1506), ("z", 0x1646), ("sh", 0x165A), ("kh", 0x1425),
+          ("gh", 0x1426), ("h", 0x144B), ("w", 0x02B7), ("y", 0x153E), ("r", 0x18F4), ("Q", 0x1427)]
+
+# Onsets that are written as a final and then another onset: tth is t and th.
+LEADS = {"tth": "t", "ddh": "t", "khw": "k"}
+# Onsets the word processor knows that have neither syllables nor a lead here.
+OTHER_ONSETS = ["ng", "r"]
+EJECTIVE_BASES = {"t", "k", "ch", "ts", "tl", "tth", "tr"}
+PRENASAL = ["ndz", "mb", "nd", "nj", "ng"]            # before a vowel these start with an n final
+
+# The three marks, as pixel rows. The tilde is what the font draws at 12 pixels. At that size the
+# font's tone mark and a dot that can be seen are too much alike, so the tone mark is a plain slope.
+SIGNS = {
+    "nasal": [".#.#", "#.##"],
+    "tone":  ["#.", ".#"],
+    "dot":   ["##", "##"],
+}
+MARK_NASAL, MARK_TONE, MARK_DOT = 1, 2, 4
+
+LETTERS = "abcdefghijklmnopqrstuvwxyz"
+L_STROKE = 27       # ł
+L_APOSTROPHE = 28
+F_DIAERESIS, F_NASAL, F_GRAVE = 0x20, 0x40, 0x80
+
+
+NAMES = Path(__file__).resolve().parent / "proper_names.txt"
+
+
+def read_names():
+    """(extra proper names, names of the trainer list that are not proper names), from proper_names.txt."""
+    lines = [n.strip() for n in NAMES.read_text(encoding="utf-8").splitlines() if n.strip() and not n.startswith("#")]
+    return [n for n in lines if not n.startswith("-")], [n[1:] for n in lines if n.startswith("-")]
+
+
+def latin_codes():
+    """Character -> game byte, from charmap.txt. The first line for a character wins."""
+    out = {}
+    for line in CHARMAP.read_text(encoding="utf-8").splitlines():
+        m = re.match(r"^'(\\.|[^'\\]+)'\s*=\s*([0-9A-Fa-f]{2})\s*(@.*)?$", line.strip())
+        if m:
+            key = m.group(1)[1:] if m.group(1).startswith("\\") else m.group(1)
+            out.setdefault(key, int(m.group(2), 16))
+    return out
+
+
+def game_bytes(name, codes):
+    try:
+        return [codes[ch] for ch in name]
+    except KeyError as e:
+        sys.exit("proper_names.txt: %s has a character that is not in charmap.txt: %s" % (name, e))
+
+
+def letter_code(ch):
+    if ch == "ł":
+        return L_STROKE
+    if ch == "'":
+        return L_APOSTROPHE
+    return LETTERS.index(ch) + 1
+
+
+def letter_table():
+    """Game byte -> the letter it is and the marks on it."""
+    table = [0] * 256
+    seen = set()
+    for line in CHARMAP.read_text(encoding="utf-8").splitlines():
+        line = line.split("@")[0].strip()
+        if not line.startswith("'") or "=" not in line:
+            continue
+        key, _, value = line.rpartition("=")
+        key = key.strip()[1:-1].replace("\\'", "'")
+        codes = value.split()
+        if len(codes) != 1 or not key:
+            continue
+        code = int(codes[0], 16)
+        nfd = unicodedata.normalize("NFD", key)
+        base, marks = nfd[0], nfd[1:]
+        if base in "’ʼ'" and not marks:
+            entry = L_APOSTROPHE
+        elif base in "łŁ" and not marks:
+            entry = L_STROKE
+        elif base.lower() in LETTERS and len(base) == 1 and all(unicodedata.combining(m) for m in marks):
+            entry = LETTERS.index(base.lower()) + 1
+            if "̈" in marks:
+                entry |= F_DIAERESIS
+            if "̨" in marks:
+                entry |= F_NASAL
+            if "̀" in marks:
+                entry |= F_GRAVE
+        else:
+            continue
+        if code not in seen:            # the Latin letters come first in the file; later lines reuse the codes for kana
+            seen.add(code)
+            table[code] = entry
+    return table
+
+
+def ink_of(font, ch):
+    """Pixels of one letter as (x, row from the baseline), left edge at 0."""
+    im = Image.new("1", (48, 48), 1)
+    draw = ImageDraw.Draw(im)
+    draw.fontmode = "1"
+    ascent = font.getmetrics()[0]
+    draw.text((16, 16), ch, font=font, fill=0)
+    cells = [(x, y) for y in range(48) for x in range(48) if im.getpixel((x, y)) == 0]
+    if not cells:
+        sys.exit("The font has no shape for U+%04X." % ord(ch))
+    x0 = min(x for x, y in cells)
+    return {(x - x0, y - 16 - ascent) for x, y in cells}
+
+
+def cell(ink, width):
+    """A 16 by 16 cell: the ink and a shadow to the right and below. Only CELL_HEIGHT rows and width columns are shown."""
+    grid = [[BG] * 16 for _ in range(16)]
+    for x, y in ink:
+        if not (0 <= x < 15 and 0 <= y < CELL_HEIGHT):
+            sys.exit("A glyph does not fit its cell at %d, %d." % (x, y))
+        grid[y][x] = INK
+    for x, y in ink:
+        for dx, dy in ((1, 0), (0, 1), (1, 1)):
+            if grid[y + dy][x + dx] == BG:
+                grid[y + dy][x + dx] = SHADOW
+    return grid
+
+
+def letter_ink(font, code):
+    return {(x, y + BASELINE) for x, y in ink_of(font, chr(code))}
+
+
+def width_of(ink):
+    return min(max(x for x, y in ink) + 3, 16)
+
+
+def mark_strip(mask, gap):
+    """The marks of one set side by side, in the order tilde, tone, dot. Returns (ink, width)."""
+    ink, x = set(), 0
+    for bit, name in ((MARK_NASAL, "nasal"), (MARK_TONE, "tone"), (MARK_DOT, "dot")):
+        if mask & bit:
+            for y, row in enumerate(SIGNS[name]):
+                for dx, c in enumerate(row):
+                    if c == "#":
+                        ink.add((x + dx, y))
+            x += len(SIGNS[name][0]) + gap
+    return ink, x - gap
+
+
+def marked_ink(ink, mask):
+    """The ink of a syllable with its marks on top. The cell stays as wide as the plain syllable."""
+    if not mask:
+        return ink
+    width = width_of(ink)
+    strip, strip_width = mark_strip(mask, 1)
+    if strip_width > width:                     # three marks on a narrow syllable: no space between them
+        strip, strip_width = mark_strip(mask, 0)
+    ink_width = max(x for x, y in ink) + 1
+    left = max(0, min((ink_width - strip_width + 1) // 2, width - strip_width))
+    top = min(y for x, y in ink)
+    down = max(0, MARK_ROWS + 1 - top)          # one clear row between the marks and the syllable
+    return {(x, y + down) for x, y in ink} | {(x + left, y) for x, y in strip}
+
+
+def check_marked(name, plain, both, mask):
+    """What must hold for every marked syllable. Returns a list of what does not."""
+    wrong = []
+    width = width_of(plain)
+    marks = {(x, y) for x, y in both if y < MARK_ROWS}
+    body = both - marks
+    if len(body) != len(plain):
+        wrong.append("the syllable changed shape")
+    if any(x >= width for x, y in marks):
+        wrong.append("a mark is cut off at the right")
+    if any(y >= CELL_HEIGHT for x, y in both):
+        wrong.append("it leaves the bottom of the cell")
+    if any((x + dx, y + dy) in body for x, y in marks for dx in (-1, 0, 1) for dy in (-1, 0, 1)):
+        wrong.append("a mark touches the syllable")
+    expect = sum(sum(row.count("#") for row in SIGNS[n]) for b, n in ((MARK_NASAL, "nasal"), (MARK_TONE, "tone"), (MARK_DOT, "dot")) if mask & b)
+    if len(marks) != expect:
+        wrong.append("a mark is not whole")
+    return ["%s with marks %d: %s" % (name, mask, w) for w in wrong]
+
+
+def onset_table():
+    """Every onset, longest first, with what the game needs to know about it."""
+    rows = {name: i for i, (name, _) in enumerate(ROWS) if name != "V"}
+    finals = {name: i for i, (name, _) in enumerate(FINALS) if name != "Q"}
+    names = list(rows) + [n for n in LEADS] + [n for n in OTHER_ONSETS]
+    names += [n for n in finals if n not in names]
+    names.sort(key=len, reverse=True)
+    out = []
+    for name in names:
+        suffix = any(name[len(name) - k:] in finals for k in range(1, len(name)))
+        out.append(dict(name=name, letters=[letter_code(c) for c in name], row=rows.get(name), final=finals.get(name),
+                        lead=finals[LEADS[name]] if name in LEADS else None, ejective=name in EJECTIVE_BASES, suffix=suffix))
+    return out
+
+
+def c_array(values, per_line=16, fmt="%3d"):
+    lines = []
+    for i in range(0, len(values), per_line):
+        lines.append("    " + ", ".join(fmt % v for v in values[i:i + per_line]) + ",")
+    return "\n".join(lines)
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    font = ImageFont.truetype(sys.argv[1], SIZE)
+    cells, widths, wrong = [], [], []
+    lowered = 0
+    for name, codes in ROWS:
+        for vowel, code in zip(VOWELS, codes):
+            plain = letter_ink(font, code)
+            width = width_of(plain)
+            widths.append(width)
+            for mask in range(8):                 # the plain syllable, then each set of marks
+                both = marked_ink(plain, mask)
+                if mask:
+                    wrong += check_marked(name + vowel, plain, both, mask)
+                    lowered += mask == 1 and min(y for x, y in both if y >= MARK_ROWS) > min(y for x, y in plain)
+                cells.append(cell(both, width))
+    syllables = len(widths)
+    for name, code in FINALS:
+        ink = letter_ink(font, code)
+        cells.append(cell(ink, width_of(ink)))
+        widths.append(width_of(ink))
+    asterisk = len(widths)                        # the asterisk that starts a proper name, from the font
+    ink = letter_ink(font, ord("*"))
+    cells.append(cell(ink, width_of(ink)))
+    widths.append(width_of(ink))
+    if wrong:
+        sys.exit("\n".join(wrong))
+
+    rows = (len(cells) + 15) // 16
+    im = Image.new("P", (256, rows * 16), BG)
+    flat = []
+    for colour in PALETTE:
+        flat += list(colour)
+    im.putpalette(flat + [0] * (768 - len(flat)))
+    px = im.load()
+    for i, grid in enumerate(cells):
+        for y in range(16):
+            for x in range(16):
+                px[(i % 16) * 16 + x, (i // 16) * 16 + y] = grid[y][x]
+    im.save(PNG, bits=2)
+
+    onsets = onset_table()
+    letters = letter_table()
+    none = 0xFF
+    h = []
+    h.append("// Made by tools/han/han_syllabics.py. Do not edit: change the script and run it again.")
+    h.append("// The Hän syllabics font and the tables that turn Latin letters into its glyphs.")
+    h.append("")
+    h.append("#define HAN_SYL_VOWELS          %d   // columns of the grid: %s" % (len(VOWELS), " ".join(VOWELS)))
+    h.append("#define HAN_SYL_ROW_VOWEL       %d   // the row for a vowel with no consonant" % [n for n, _ in ROWS].index("V"))
+    h.append("#define HAN_SYL_FINALS_BASE     %d   // first glyph of the finals" % syllables)
+    h.append("#define HAN_SYL_FINAL_N         %d" % [n for n, _ in FINALS].index("n"))
+    h.append("#define HAN_SYL_FINAL_GLOTTAL   %d" % [n for n, _ in FINALS].index("Q"))
+    h.append("#define HAN_SYL_ASTERISK        %d   // drawn before a proper name" % asterisk)
+    h.append("#define HAN_SYL_GLYPH_COUNT     %d" % len(widths))
+    h.append("#define HAN_SYL_MARK_SETS       8   // each syllable is in the font this many times: plain, then with each set of marks")
+    h.append("// Where a glyph is in the font. Marks are for syllables only.")
+    h.append("#define HAN_SYL_CELL(glyph, marks) ((glyph) < HAN_SYL_FINALS_BASE ? (glyph) * HAN_SYL_MARK_SETS + (marks) \\")
+    h.append("                                    : HAN_SYL_FINALS_BASE * (HAN_SYL_MARK_SETS - 1) + (glyph))")
+    h.append("#define HAN_SYL_GLYPH_HEIGHT    %d" % CELL_HEIGHT)
+    h.append("#define HAN_SYL_NO              0x%02X" % none)
+    h.append("")
+    h.append("#define HAN_SYL_LETTER_MASK     0x1F  // 1 to 26: a to z")
+    h.append("#define HAN_SYL_LETTER_STROKE   %d    // ł" % L_STROKE)
+    h.append("#define HAN_SYL_APOSTROPHE      %d" % L_APOSTROPHE)
+    h.append("#define HAN_SYL_DIAERESIS       0x%02X" % F_DIAERESIS)
+    h.append("#define HAN_SYL_NASAL_HOOK      0x%02X" % F_NASAL)
+    h.append("#define HAN_SYL_GRAVE           0x%02X" % F_GRAVE)
+    for ch in "aeiouhnlwyr":
+        h.append("#define HAN_SYL_L_%s             %d" % (ch.upper(), letter_code(ch)))
+    h.append("")
+    h.append("// For each character of the game's text: which letter it is, and the marks on it. 0: not a letter.")
+    h.append("static const u8 sHanSylLetters[256] =\n{\n%s\n};" % c_array(letters, 16, "0x%02X"))
+    h.append("")
+    h.append("struct HanSylOnset")
+    h.append("{")
+    h.append("    u8 length;")
+    h.append("    u8 letters[4];")
+    h.append("    u8 row;          // its row of syllables, or HAN_SYL_NO")
+    h.append("    u8 final;        // its final, or HAN_SYL_NO")
+    h.append("    u8 lead;         // written as this final and then the rest (tth is t and th), or HAN_SYL_NO")
+    h.append("    u8 ejectiveBase:1;")
+    h.append("    u8 endsInFinal:1; // some ending of it is a consonant that has a final")
+    h.append("};")
+    h.append("")
+    h.append("// Longest first.")
+    h.append("static const struct HanSylOnset sHanSylOnsets[] =\n{")
+    for o in onsets:
+        letters4 = o["letters"] + [0] * (4 - len(o["letters"]))
+        h.append("    {%d, {%s}, %s, %s, %s, %d, %d}, // %s" % (
+            len(o["letters"]), ", ".join("%2d" % v for v in letters4),
+            "%3d" % o["row"] if o["row"] is not None else "HAN_SYL_NO",
+            "%2d" % o["final"] if o["final"] is not None else "HAN_SYL_NO",
+            "%2d" % o["lead"] if o["lead"] is not None else "HAN_SYL_NO",
+            o["ejective"], o["suffix"], o["name"]))
+    h.append("};")
+    h.append("")
+    h.append("// Before a vowel these begin with an n final: nda is n and da.")
+    h.append("static const u8 sHanSylPrenasal[][4] =\n{")
+    for p in PRENASAL:
+        h.append("    {%d, %s}, // %s" % (len(p), ", ".join("%2d" % letter_code(c) for c in p.ljust(3, "a")[:len(p)]) + ", 0" * (3 - len(p)), p))
+    h.append("};")
+    h.append("")
+    h.append("// One width for each glyph. A syllable is as wide with marks as without.")
+    h.append("static const u8 sHanSylGlyphWidths[HAN_SYL_GLYPH_COUNT] =\n{\n%s\n};" % c_array(widths))
+    h.append("")
+    extra, left_out = read_names()
+    codes = latin_codes()
+    h.append("// Proper names that are in none of the game's own lists, or only inside a longer name")
+    h.append("// (tools/han/proper_names.txt). Each name ends with 0xFF, and so does the list.")
+    h.append("static const u8 sHanSylExtraNames[] =\n{")
+    for n in extra:
+        h.append("    " + ", ".join("0x%02X" % b for b in game_bytes(n, codes) + [0xFF]) + ", // " + n)
+    h.append("    0xFF\n};")
+    h.append("")
+    h.append("// Names in the trainer list that are not proper names, or are also ordinary words of the game.")
+    h.append("static const u8 sHanSylNotNames[] =\n{")
+    for n in left_out:
+        h.append("    " + ", ".join("0x%02X" % b for b in game_bytes(n, codes) + [0xFF]) + ", // " + n)
+    h.append("    0xFF\n};")
+    h.append("")
+    HEADER.write_text("\n".join(h), encoding="utf-8")
+    print("wrote %s: %d cells (%d syllables, each with %d sets of marks; %d finals; the asterisk), %d rows"
+          % (PNG.relative_to(ROOT), len(cells), syllables, 8, len(FINALS), rows))
+    print("every marked syllable checked: marks whole, inside the cell, one clear row under them. %d syllables are drawn lower when marked." % lowered)
+    print("wrote %s: %d onsets" % (HEADER.relative_to(ROOT), len(onsets)))
+
+
+if __name__ == "__main__":
+    main()
