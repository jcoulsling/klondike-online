diff --git a/Makefile b/Makefile
index 8b454db..5529078 100644
--- a/Makefile
+++ b/Makefile
@@ -184,6 +184,8 @@ DATA_ASM_SRCS := $(wildcard $(DATA_ASM_SUBDIR)/*.s)
 DATA_ASM_OBJS := $(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.o,$(DATA_ASM_SRCS))
 
 SONG_SRCS := $(wildcard $(SONG_SUBDIR)/*.s)
+# Hän build: this song is made at build time (tools/han/han_theme.py), so it may not be there yet when make starts.
+SONG_SRCS := $(sort $(SONG_SRCS) $(SONG_SUBDIR)/mus_han_jane.s)
 SONG_OBJS := $(patsubst $(SONG_SUBDIR)/%.s,$(SONG_BUILDDIR)/%.o,$(SONG_SRCS))
 
 MID_SRCS := $(wildcard $(MID_SUBDIR)/*.mid)
@@ -295,6 +297,32 @@ $(C_BUILDDIR)/battle_tower.o: CFLAGS += -Wno-div-by-zero
 $(C_BUILDDIR)/librfu_intr.o: override CFLAGS += -marm -mthumb-interwork -O2 -mtune=arm7tdmi -march=armv4t -mabi=apcs-gnu -fno-toplevel-reorder -fno-aggressive-loop-optimizations -Wno-pointer-to-int-cast
 endif
 
+# Hän build: in syllabics the game spells English words by their sound. The table it uses is made
+# from the list of words here. tools/han/han_text.py makes it again at every build, without the
+# words that are Hän in the translated text. See tools/han/han_english_table.py.
+src/data/han_english_sounds.h: tools/han/english_sounds.txt tools/han/han_english_table.py
+	python3 tools/han/han_english_table.py
+$(C_BUILDDIR)/text.o: src/data/han_english_sounds.h
+
+# Hän build: the Pokémon pictures and animations of Emerald. tools/han/han_emerald.py copies what
+# they need from a copy of the pokeemerald source into files that are not in git: pictures, tables
+# and src/pokemon_animation.c. The file named here stands for all of them. It is made before the
+# sources are scanned, with the other generated files. See the script for where the copy must be.
+AUTO_GEN_TARGETS += src/data/graphics/pokemon_emerald.h
+# The same script copies the little pictures of Emerald's TWIN and STEVEN, for the twins and BRANDON on the maps.
+graphics/object_events/pics/people/emerald_twin.4bpp graphics/object_events/pics/people/emerald_steven.4bpp: %.4bpp: %.png
+	$(GFX) $< $@ -mwidth 2 -mheight 4
+src/data/graphics/pokemon_emerald.h: tools/han/han_emerald.py src/data/graphics/pokemon.h
+	python3 tools/han/han_emerald.py --touch
+
+# Hän build: CHAMPION JANE's battle theme. tools/han/han_theme.py brings in the music if whoever builds has it,
+# and a song that is not played if not. None of the three files is in git.
+AUTO_GEN_TARGETS += include/han_jane_theme.h
+include/han_jane_theme.h: tools/han/han_theme.py tools/han/han_theme_midi.py
+	python3 tools/han/han_theme.py --touch
+sound/direct_sound_samples/han_jane_theme.wav sound/songs/mus_han_jane.s: include/han_jane_theme.h ;
+$(C_BUILDDIR)/m4a.o: include/han_jane_theme.h
+
 # Dependency rules (for the *.c & *.s sources to .o files)
 # Have to be explicit or else missing files won't be reported.
 
