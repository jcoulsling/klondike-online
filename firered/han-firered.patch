+#!/usr/bin/env python3
+"""Hän text for pokefirered.
+
+Moves text between one workbook and the game's source files.
+
+    python3 tools/han/han_text.py workbook OUT.xlsx [--from OLD.xlsx] [--rom pokefirered.gba]
+        Write the workbook, with any Hän carried over from OLD.xlsx (this
+        tool's workbook, or a sheet exported by Han_FireRed_Tool.html).
+
+    python3 tools/han/han_text.py tool OUT.html [--from BOOK] [--was OLDER.json]
+        Write the HTML translator: a page to type Hän into, with the strings
+        still to do ranked by how much they matter in play. Its "Save file"
+        makes a .json that every command here reads in place of a workbook.
+        --was: BOOK is a corrected copy of OLDER.json. A browser that still
+        holds the older text of a corrected row takes the new text. Several
+        older files can be given with commas between them.
+
+    python3 tools/han/han_text.py build BOOK.xlsx [--report OUT.xlsx]
+        Put the Hän from BOOK.xlsx into the source files and run make.
+        If a name turns out too long for its slot, that one place is left in
+        English, noted, and the build carries on.
+
+    python3 tools/han/han_text.py apply BOOK.xlsx
+        Only change the source files. Run make yourself.
+
+    python3 tools/han/han_text.py restore
+        Put the English source files back.
+
+A string that appears in many places is one row and fills every place.
+The original English files are kept in .han_orig/ so the text can be put in
+again and again. Change game code only after running restore: a file edited
+while the Hän text is in place is set aside as *.edited and the tool stops.
+"""
+import json
+import re
+import shutil
+import subprocess
+import sys
+import unicodedata
+from collections import defaultdict, OrderedDict
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ORIG = ROOT / ".han_orig"
+sys.path.insert(0, str(Path(__file__).parent))
+
+GRAVE, DIAERESIS, OGONEK = "\u0300", "\u0308", "\u0328"
+MARKS = {GRAVE, DIAERESIS, OGONEK}
+
+# ---------------------------------------------------------------------------
+# Character map and encoder (the same rules as tools/preproc)
+# ---------------------------------------------------------------------------
+def letter_key(s, i):
+    """One letter plus its grave / diaeresis / ogonek, however it was typed."""
+    ch = s[i]
+    d = unicodedata.normalize("NFD", ch)
+    base, marks = d[0], set(d[1:])
+    if not marks or not marks <= MARKS:
+        base, marks = ch, set()
+    j = i + 1
+    while j < len(s) and s[j] in MARKS:
+        marks.add(s[j])
+        j += 1
+    return (base, frozenset(marks)), j
+
+
+class Charmap:
+    def __init__(self, path=None):
+        self.chars, self.escapes, self.consts = {}, {}, {}
+        text = (path or ROOT / "charmap.txt").read_text(encoding="utf-8")
+        for raw in text.splitlines():
+            line = raw.strip()
+            if not line or line.startswith("@"):
+                continue
+            m = re.match(r"^'(\\.|[^'\\]+)'\s*=\s*([0-9A-Fa-f ]+?)\s*(@.*)?$", line)
+            if m:
+                lit, seq = m.group(1), bytes(int(b, 16) for b in m.group(2).split())
+                if lit.startswith("\\") and lit[1] not in "'\\":
+                    self.escapes.setdefault(lit[1], seq)
+                else:
+                    if lit.startswith("\\"):
+                        lit = lit[1]
+                    key, _ = letter_key(lit, 0)
+                    self.chars.setdefault(key, seq)
+                continue
+            m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([0-9A-Fa-f ]+?)\s*(@.*)?$", line)
+            if m:
+                self.consts.setdefault(m.group(1), bytes(int(b, 16) for b in m.group(2).split()))
+
+    def tokens(self, s):
+        """Split source-syntax text into ('c', key) / ('e', char) / ('b', inside-braces)."""
+        out, i = [], 0
+        while i < len(s):
+            ch = s[i]
+            if ch == "\\" and i + 1 < len(s):
+                out.append(("e", s[i + 1]))
+                i += 2
+            elif ch == "{":
+                j = s.find("}", i)
+                if j < 0:
+                    raise ValueError("unclosed {")
+                out.append(("b", s[i + 1:j]))
+                i = j + 1
+            else:
+                key, j = letter_key(s, i)
+                out.append(("c", key))
+                i = j
+        return out
+
+    def encode_token(self, tok):
+        kind, val = tok
+        if kind == "c":
+            if val not in self.chars:
+                raise KeyError(show_key(val))
+            return self.chars[val]
+        if kind == "e":
+            if val in '"\\':
+                return self.chars[(val, frozenset())]
+            if val not in self.escapes:
+                raise KeyError("\\" + val)
+            return self.escapes[val]
+        out = b""
+        for part in val.split():
+            if re.match(r"^[A-Za-z_]", part):
+                if part not in self.consts:
+                    raise KeyError("{" + part + "}")
+                out += self.consts[part]
+            else:
+                out += bytes([int(part, 0) & 0xFF])
+        return out
+
+    def encode(self, s):
+        return b"".join(self.encode_token(t) for t in self.tokens(s))
+
+
+def tidy_marks(text):
+    """An accent typed twice on one letter counts once."""
+    out, i = [], 0
+    while i < len(text):
+        j = i + 1
+        seen = []
+        while j < len(text) and unicodedata.combining(text[j]):
+            if text[j] not in seen:
+                seen.append(text[j])
+            j += 1
+        out.append(text[i] + "".join(seen))
+        i = j
+    return "".join(out)
+
+
+def show_key(key):
+    base, marks = key
+    return unicodedata.normalize("NFC", base + "".join(m for m in (OGONEK, DIAERESIS, GRAVE) if m in marks))
+
+
+# ---------------------------------------------------------------------------
+# Workbook syntax <-> source syntax
+#   workbook: real line breaks, {PARA}, {SCROLL}; everything else as in source
+# ---------------------------------------------------------------------------
+def to_friendly(src):
+    out, i = [], 0
+    while i < len(src):
+        if src[i] == "\\" and i + 1 < len(src):
+            e = src[i + 1]
+            out.append({"n": "\n", "p": "{PARA}", "l": "{SCROLL}", '"': '"'}.get(e, "\\" + e))
+            i += 2
+        else:
+            out.append(src[i])
+            i += 1
+    return "".join(out)
+
+
+def to_source(friendly):
+    s = friendly.replace("\r", "")
+    s = s.replace("{PARA}", "\x00p").replace("{SCROLL}", "\x00l")
+    out, i = [], 0
+    while i < len(s):
+        ch = s[i]
+        if ch == "\x00":
+            out.append("\\" + s[i + 1])
+            i += 2
+        elif ch == "\n":
+            out.append("\\n")
+            i += 1
+        elif ch == '"':
+            out.append('\\"')
+            i += 1
+        elif ch == "\\":
+            if i + 1 < len(s) and s[i + 1] in "npl":
+                out.append(s[i:i + 2])
+                i += 2
+            else:
+                raise ValueError("stray backslash")
+        elif ch == "$":
+            raise ValueError("$ cannot be used in text")
+        else:
+            out.append(ch)
+            i += 1
+    return "".join(out)
+
+
+TOKEN_RE = re.compile(r"\{[^}]*\}")
+
+
+def outside_tokens(s, fn):
+    out, last = [], 0
+    for m in TOKEN_RE.finditer(s):
+        out.append(fn(s[last:m.start()]))
+        out.append(m.group(0))
+        last = m.end()
+    out.append(fn(s[last:]))
+    return "".join(out)
+
+
+def strip_tokens(s):
+    return TOKEN_RE.sub("", s)
+
+
+# ---------------------------------------------------------------------------
+# Case matching and rules (same behaviour as Han_FireRed_Tool.html)
+# ---------------------------------------------------------------------------
+def upper(s):
+    # the game writes POKéMON and POKé BALL with a small é inside capitals
+    return outside_tokens(s, lambda t: t.upper().replace("É", "é"))
+
+
+def lower(s):
+    return outside_tokens(s, str.lower)
+
+
+def title_first(s):
+    return s[:1].upper() + s[1:] if s and s[0] != "{" else s
+
+
+def is_all_caps(src):
+    letters = re.sub(r"[^A-Za-z]", "", strip_tokens(src))
+    return len(letters) >= 2 and letters == letters.upper()
+
+
+def match_source_case(src, out):
+    """Mirror the case of the English onto a translation.
+
+    English in ALL CAPS: the translation is put in capitals however it was
+    typed. Otherwise only a translation typed in one case is changed, and
+    mixed case is left as typed."""
+    if not src or not out:
+        return out
+    if is_all_caps(src):
+        return upper(out)
+    letters = re.sub(r"[^A-Za-z]", "", strip_tokens(src))
+    if len(letters) < 2:
+        return out
+    if out != lower(out) and out != upper(out):
+        return out                      # deliberately mixed case: leave it
+    first = re.sub(r"^[^A-Za-z{]+", "", src)[:1]   # past any opening punctuation: "'s nickname?" starts small
+    if first == first.upper() and re.search(r"[a-z]", src):
+        return title_first(out)
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Single letters: in Hän text a letter written twice in a row is shown once
+# ---------------------------------------------------------------------------
+# Jane's rule (16 November 2026). What the game shows:
+#   - the same letter twice in a row becomes one: aa, ii, ww, yy, nn, rr ...
+#   - a vowel written twice with different marks keeps the first one: ìi is ì
+#   - tth stays tth (and ddh stays ddh): those are single sounds, not doubles
+#   - English words are left alone: FOSSIL, BALL, floor, boot
+# The typed text is not changed. Only what goes into the game is.
+#
+# A word counts as English when the game's own English text has it. A few such
+# words are Hän where Jane types them; they are listed here.
+HAN_NOT_ENGLISH = {"choo"}
+NAME_FAMILIES = {"Trainer names", "Pokémon names", "Other: ingame_trades"}   # names are not English words
+_LETTER = r"[^\W\d_][\u0300-\u036F]*"
+WORD_RE = re.compile("(?:%s)+(?:[’'ʼ\\-](?:%s)+)*" % (_LETTER, _LETTER))
+HAN_VOWELS = set("aeiou")
+
+
+def english_words(groups):
+    """Every word of the game's English text, lower case, without the name tables."""
+    words = set()
+    for g in groups.values():
+        if g.family in NAME_FAMILIES:
+            continue
+        for w in WORD_RE.findall(strip_tokens(g.english)):
+            words.add(word_key(w))
+    return words - HAN_NOT_ENGLISH
+
+
+def word_key(w):
+    return unicodedata.normalize("NFC", w).lower().replace("’", "'").replace("ʼ", "'")
+
+
+def letter_clusters(s):
+    """A letter with its marks is one item: ǫ̈ is one, whatever way it was typed."""
+    out = []
+    for ch in s:
+        if out and unicodedata.combining(ch):
+            out[-1] += ch
+        else:
+            out.append(ch)
+    return out
+
+
+def _cluster_key(c):
+    d = unicodedata.normalize("NFD", c).lower()
+    return d[0], "".join(sorted(set(d[1:])))
+
+
+def single_word(word):
+    cl = letter_clusters(word)
+    keys = [_cluster_key(c) for c in cl]
+    out, out_keys = [], []
+    for i, (c, k) in enumerate(zip(cl, keys)):
+        if out and k[0].isalpha() and k[0] == out_keys[-1][0]:
+            same = k[1] == out_keys[-1][1]
+            if same and k[0] in "td" and not k[1] and i + 1 < len(cl) and keys[i + 1][0] == "h":
+                pass                                    # tth, ddh: keep
+            elif same or k[0] in HAN_VOWELS:
+                continue                                # the second of a pair is dropped
+        out.append(c)
+        out_keys.append(k)
+    return "".join(out)
+
+
+def is_english_text(text, english):
+    """True if the typed text is English: every word, or most words of a longer line."""
+    words = [word_key(w) for w in WORD_RE.findall(strip_tokens(text))]
+    if not words:
+        return True
+    hits = sum(1 for w in words if w in english)
+    return hits == len(words) or (len(words) >= 8 and hits / len(words) >= 0.8)
+
+
+def single_letters(text, english):
+    """The text with doubled letters made single. Returns (text, [(typed, shown), ...])."""
+    if not text or is_english_text(text, english):
+        return text, []
+    changed = []
+
+    def fix(part):
+        def one(m):
+            w = m.group(0)
+            if word_key(w) in english:
+                return w
+            new = single_word(w)
+            if new != w:
+                changed.append((w, new))
+            return new
+        return WORD_RE.sub(one, part)
+
+    return outside_tokens(text, fix), changed
+
+
+def match_case(sample, replacement):
+    letters = re.sub(r"[^A-Za-z]", "", sample)
+    if not letters:
+        return replacement
+    if letters == letters.upper() and len(letters) > 1:
+        return replacement.upper()
+    if letters == letters.lower():
+        return replacement.lower()
+    if sample[0] == sample[0].upper():
+        return replacement[:1].upper() + replacement[1:]
+    return replacement
+
+
+def apply_rules(eng, rules):
+    """Word rules: swap whole words, matching the case of the word replaced."""
+    out, hit = eng, False
+    for key in sorted((k for k, v in rules.items() if v), key=len, reverse=True):
+        pat = re.compile(r"\b" + re.escape(key) + r"\b", re.IGNORECASE | re.ASCII)
+
+        def swap(text, pat=pat, key=key):
+            return pat.sub(lambda m: match_case(m.group(0), single_letters(rules[key], ENGLISH)[0]), text)
+
+        new = outside_tokens(out, swap)
+        if new != out:
+            out, hit = new, True
+    return out if hit else None
+
+
+# ---------------------------------------------------------------------------
+# Line wrapping, measured in pixels with the game's own glyph widths
+# ---------------------------------------------------------------------------
+class Wrapper:
+    LINES_PER_BOX = 2
+    NAME_PX = 42        # {PLAYER}, {RIVAL}: 7 letters
+    BUFFER_PX = 60      # other fill-ins: about a 10 letter name
+
+    def __init__(self, charmap, max_px):
+        import han_font
+        src = (ROOT / "src" / "text.c").read_text()
+        self.widths, _ = han_font.read_widths(src, "sFontNormalLatinGlyphWidths")
+        self.cm = charmap
+        self.max_px = max_px
+
+    def measure(self, friendly):
+        px = 0
+        try:
+            toks = self.cm.tokens(friendly.replace("\n", " ").replace("\x01", " "))
+        except ValueError:
+            return len(friendly) * 6
+        for tok in toks:
+            try:
+                data = self.cm.encode_token(tok)
+            except (KeyError, ValueError):
+                px += 6
+                continue
+            if tok[0] == "b":
+                if data[:1] == b"\xFC":
+                    continue
+                if data[:1] == b"\xFD":
+                    px += self.NAME_PX if data[1:2] in (b"\x01", b"\x06") else self.BUFFER_PX
+                    continue
+            px += sum(self.widths[b] for b in data)
+        return px
+
+    @staticmethod
+    def shape(orig):
+        has_para = bool(re.search(r"\{PARA\}|\{SCROLL\}", orig or ""))
+        max_lines = 1
+        for box in re.split(r"\{PARA\}|\{SCROLL\}", orig or ""):
+            max_lines = max(max_lines, len(box.split("\n")))
+        return has_para, max_lines
+
+    def wrap_lines(self, part, max_px):
+        out = []
+        # a {TOKEN WITH SPACES} is one word
+        part = TOKEN_RE.sub(lambda m: m.group(0).replace(" ", "\x01"), part)
+        for seg in part.split("\n"):
+            words = seg.split()
+            if not words:
+                out.append("")
+                continue
+            cur = ""
+            for w in words:
+                trial = cur + " " + w if cur else w
+                if self.measure(trial) <= max_px or not cur:
+                    cur = trial
+                else:
+                    out.append(cur)
+                    cur = w
+            if cur:
+                out.append(cur)
+        return [line.replace("\x01", " ") for line in out] or [""]
+
+    def wrap_part(self, part, max_px):
+        """Wrap the text of one box. Typed line breaks are kept. If a line turns
+        out too wide, the sentence it belongs to is re-flowed as a whole, so a
+        long line does not leave one stray word on a line of its own. Lists and
+        indented lines are never re-flowed."""
+        out = []
+        for para in re.split(r"(\n\s*\n)", part):
+            if not para.strip():
+                out += [""] * (para.count("\n") - 1)
+                continue
+            typed = para.split("\n")
+            lines = self.wrap_lines(para, max_px)
+            structured = any(re.match(r"\s|\{CIRCLE", ln) for ln in typed)
+            if len(lines) > len(typed) and not structured:
+                lines = self.wrap_lines(" ".join(typed), max_px)
+            out += lines
+        return out or [""]
+
+    def format(self, text, orig, dialogue=False):
+        """Fit a translation to the kind of screen the English was on.
+
+        Text box dialogue (map scripts, or any English with {PARA}/{SCROLL})
+        becomes two-line boxes joined by {PARA}. Anything else keeps the number
+        of lines its screen has and never gains a {PARA}."""
+        if not text:
+            return text
+        has_para, max_lines = self.shape(orig)
+        boxed = has_para or dialogue
+        per_box = self.LINES_PER_BOX if boxed else max_lines
+        if self.is_page(orig, dialogue):
+            # a full-page screen has no "next box": a typed {PARA} would cut the text off
+            text = re.sub(r"\s*(\{PARA\}|\{SCROLL\})\s*", "\n", text).strip("\n")
+        # Other screens can be wider than a text box, so there a line is only
+        # wrapped if it is clearly wider than the widest English line was.
+        max_px = self.max_px
+        if not boxed:
+            widest = max(self.measure(line) for line in re.split(r"\{PARA\}|\{SCROLL\}|\n", orig or ""))
+            max_px = max(max_px, widest + 8)
+        parts = []
+        for part in re.split(r"(\{PARA\}|\{SCROLL\})", text):
+            if part in ("{PARA}", "{SCROLL}"):
+                parts.append(part)
+                continue
+            if not part.strip():
+                parts.append("")
+                continue
+            lines = self.wrap_part(part.strip(" "), max_px)
+            out = lines[0]
+            for i in range(1, len(lines)):
+                out += ("{PARA}" if boxed and i % per_box == 0 else "\n") + lines[i]
+            parts.append(out)
+        result = "".join(parts)
+        # "'s nickname?" is printed straight after a name. A space typed in front
+        # of its translation is the only thing between the two, so it is kept.
+        if re.match(r"['’]s\b", orig or "") and text.startswith(" ") and not result.startswith(" "):
+            result = " " + result
+        # A piece of a sentence ("Wild ", " is", " points") is joined to a name
+        # or a number by the game. The spaces at its ends are all that keeps the
+        # two apart, so the translation gets the same ones.
+        if orig and result.strip(" "):
+            lead = len(orig) - len(orig.lstrip(" "))
+            trail = len(orig) - len(orig.rstrip(" "))
+            if lead:
+                result = " " * lead + result.lstrip(" ")
+            if trail:
+                result = result.rstrip(" ") + " " * trail
+        tail = re.search(r"(\{PARA\}|\{SCROLL\})\s*$", orig or "")
+        if tail and not result.rstrip().endswith(tail.group(1)):
+            result = result.rstrip() + tail.group(1)
+        return result
+
+    def is_page(self, orig, dialogue=False):
+        """A screen that shows a whole page of text at once, not a two-line box."""
+        has_para, max_lines = self.shape(orig)
+        return not has_para and not dialogue and max_lines > 2
+
+    def line_overflow(self, text, orig, dialogue=False):
+        has_para, max_lines = self.shape(orig)
+        if has_para or dialogue:
+            return 0, max_lines
+        worst = max(len(box.split("\n")) for box in re.split(r"\{PARA\}|\{SCROLL\}", text or ""))
+        return max(0, worst - max_lines), max_lines
+
+
+# ---------------------------------------------------------------------------
+# Finding every string in the source
+# ---------------------------------------------------------------------------
+SKIP_FILES = {"src/text.c", "src/data/pokemon/pokedex_text_lg.h",
+              "src/data/text/move_names_english.h"}      # kept in English on purpose
+JSON_TEXT_KEYS = {
+    "src/data/items.json": ("english", "description_english"),
+    "src/data/region_map/region_map_sections.json": ("name",),
+}
+
+STORY_ORDER = """PalletTown Route1 ViridianCity Route22 Route2 ViridianForest PewterCity Route3 MtMoon Route4
+CeruleanCity Route24 Route25 Route5 Route6 VermilionCity SSAnne Route11 DiglettsCave Route9 Route10 RockTunnel
+PowerPlant LavenderTown Route8 Route7 UndergroundPath CeladonCity RocketHideout PokemonTower SaffronCity SilphCo
+Route12 Route13 Route14 Route15 FuchsiaCity SafariZone Route16 Route17 Route18 Route19 Route20 SeafoamIslands
+CinnabarIsland PokemonMansion Route21 Route23 VictoryRoad IndigoPlateau PokemonLeague OneIsland TwoIsland ThreeIsland
+MtEmber BerryForest FourIsland IcefallCave FiveIsland SixIsland SevenIsland CeruleanCave""".split()
+
+
+def section_of(path, owner):
+    p = path
+    if p == "data/text/new_game_intro.inc":
+        return "New game intro", 0
+    m = re.match(r"data/maps/([^/]+)/", p)
+    if m:
+        name = m.group(1)
+        base = name.split("_")[0]
+        rank = 4000
+        for i, prefix in enumerate(STORY_ORDER):
+            if base == prefix:
+                rank = 1000 + i * 10
+                break
+        return "Map: " + name, rank
+    table = {
+        "src/data/text/species_names.h": ("Pokémon names", 9000),
+        "src/data/text/move_names.h": ("Move names", 9010),
+        "src/move_descriptions.c": ("Move descriptions", 9015),
+        "src/data/text/abilities.h": ("Abilities", 9030),
+        "src/data/trainers.h": ("Trainer names", 9040),
+        "src/data/text/trainer_class_names.h": ("Trainer classes", 9045),
+        "src/data/pokemon/pokedex_text_fr.h": ("Pokédex", 9050),
+        "src/data/pokemon/pokedex_entries.h": ("Pokédex", 9050),
+        "src/data/region_map/region_map_sections.json": ("Map names", 9060),
+        "src/data/text/nature_names.h": ("Natures", 9070),
+        "src/strings.c": ("Menus and system", 6000),
+        "src/battle_message.c": ("Battle messages", 6100),
+    }
+    if p in table:
+        return table[p]
+    if p == "src/data/items.json":
+        return ("Item names", 9020) if owner == "english" else ("Item descriptions", 9025)
+    if owner == "gTypeNames":
+        return "Type names", 9005
+    stem = Path(p).stem
+    if p.startswith("data/"):
+        return "Scripts: " + stem, 5000
+    return "Other: " + stem, 9500
+
+
+class Unit:
+    __slots__ = ("path", "kind", "context", "owner", "text", "span", "indent", "multi", "limit", "pos")
+
+    def __init__(self, **kw):
+        self.limit = None
+        self.owner = ""
+        self.multi = False
+        self.indent = ""
+        for k, v in kw.items():
+            setattr(self, k, v)
+
+    @property
+    def where(self):
+        return "%s  (%s)" % (self.context, self.path) if self.context else self.path
+
+
+def tracked_files():
+    out = subprocess.run(["git", "ls-files", "data", "src", "include"], cwd=ROOT, capture_output=True, text=True, check=True)
+    return [f for f in out.stdout.splitlines() if f not in SKIP_FILES]
+
+
+def read_original(path):
+    """The English version of a source file, even after apply has changed it."""
+    backup = ORIG / path
+    return (backup if backup.exists() else ROOT / path).read_text(encoding="utf-8")
+
+
+ASM_LABEL = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)::?")
+ASM_STRING = re.compile(r'^(\s*)\.string\s+"((?:[^"\\]|\\.)*)"\s*(@.*)?$')
+
+
+def scan_asm(path, text):
+    """Each run of .string lines up to a "$" is one string. A run only counts if
+    it starts right after a label or right after another finished string: text
+    split up by .if / #ifdef blocks is left alone."""
+    units, label, count = [], None, 0
+    lines = text.split("\n")
+    cur, before = None, "other"
+    for n, line in enumerate(lines):
+        m = ASM_STRING.match(line)
+        if m:
+            if cur is None:
+                cur = dict(start=n, indent=m.group(1), parts=[], ok=before in ("label", "end"))
+            lit = m.group(2)
+            if lit.endswith("$") and not lit.endswith("\\$"):
+                cur["parts"].append(lit[:-1])
+                if cur["ok"]:
+                    context = label if count == 0 else "%s+%d" % (label, count)
+                    units.append(Unit(path=path, kind="asm", context=context or "", text="".join(cur["parts"]),
+                                      span=(cur["start"], n), indent=cur["indent"], pos=cur["start"]))
+                count += 1
+                cur, before = None, "end"
+            else:
+                cur["parts"].append(lit)
+            continue
+        stripped = line.strip()
+        if not stripped or stripped.startswith("@"):
+            if cur is None:
+                continue
+        cur = None
+        m = ASM_LABEL.match(line)
+        if m:
+            label, count, before = m.group(1), 0, "label"
+        else:
+            before = "other"
+    return units
+
+
+C_LITERAL = re.compile(r'(?<![A-Za-z0-9_])_\(\s*((?:"(?:[^"\\]|\\.)*"\s*)+)\)')
+C_STRING = re.compile(r'"((?:[^"\\]|\\.)*)"')
+C_ARRAY = re.compile(r"\b([A-Za-z_]\w*)\s*\[[^\]]*\]\s*\[([^\]]+)\]\s*=\s*\{")
+C_NAME = re.compile(r"(?:\.([A-Za-z_]\w*)|\[([A-Za-z_]\w*)\]|\b([A-Za-z_]\w*)\s*(?:\[[^\]]*\]\s*)*)\s*=\s*$")
+
+
+def c_lengths():
+    """NAME_LENGTH style constants, for the fixed-size name tables."""
+    vals = {}
+    for f in ("include/constants/global.h", "include/battle_main.h", "include/global.h", "include/constants/items.h"):
+        p = ROOT / f
+        if p.exists():
+            for m in re.finditer(r"#define\s+(\w+)\s+(\d+)\s*(?://.*)?$", p.read_text(), re.M):
+                vals.setdefault(m.group(1), int(m.group(2)))
+    return vals
+
+
+def field_sizes(lengths):
+    """Size of every fixed u8 field[...] in the headers, for names kept in structs."""
+    sizes = {}
+    for f in (ROOT / "include").rglob("*.h"):
+        for m in re.finditer(r"\bu8\s+(\w+)\[([^\]]+)\];", f.read_text(errors="ignore")):
+            try:
+                size = eval(re.sub(r"[A-Za-z_]\w*", lambda t: str(lengths[t.group(0)]), m.group(2)), {"__builtins__": {}})
+            except Exception:
+                continue
+            sizes[m.group(1)] = max(sizes.get(m.group(1), 0), size)
+    return sizes
+
+
+LEARNED = Path(__file__).parent / "slot_limits.json"
+OLD_OFFSETS = Path(__file__).parent / "old_tool_offsets.json"
+
+
+def learned_limits():
+    return json.loads(LEARNED.read_text()) if LEARNED.exists() else {}
+
+
+def scan_c(path, text, lengths, fields=None, learned=None):
+    arrays = []
+    for m in C_ARRAY.finditer(text):
+        depth, i = 0, m.end() - 1
+        while i < len(text):
+            if text[i] == "{":
+                depth += 1
+            elif text[i] == "}":
+                depth -= 1
+                if depth == 0:
+                    break
+            i += 1
+        expr = m.group(2)
+        try:
+            size = eval(re.sub(r"[A-Za-z_]\w*", lambda t: str(lengths[t.group(0)]), expr), {"__builtins__": {}})
+        except Exception:
+            size = None
+        arrays.append((m.end(), i, m.group(1), size))
+    units = []
+    for m in C_LITERAL.finditer(text):
+        lits = C_STRING.findall(m.group(1))
+        before = text[max(0, m.start() - 200):m.start()]
+        nm = C_NAME.search(before)
+        context = next((g for g in nm.groups() if g), "") if nm else ""
+        limit, owner = None, ""
+        if nm and nm.group(1) and fields and nm.group(1) in fields:
+            limit = fields[nm.group(1)] - 1
+        for a_start, a_end, a_name, a_size in arrays:
+            if a_start <= m.start() <= a_end:
+                owner = a_name
+                if a_size:
+                    limit = a_size - 1
+        if owner and context != owner:
+            context = "%s[%s]" % (owner, context) if context else owner
+        if limit is None and path.startswith("src/data/easy_chat/"):
+            limit = 12          # every easy chat buffer assumes words of at most 12 letters
+        known = (learned or {}).get("%s|%s" % (path, context))
+        if known is not None:
+            limit = known if limit is None else min(limit, known)
+        line_start = text.rfind("\n", 0, m.start()) + 1
+        first_quote = m.start() + m.group(0).index('"')
+        units.append(Unit(path=path, kind="c", context=context, owner=owner, text="".join(lits), span=(m.start(), m.end()),
+                          indent=" " * (first_quote - line_start), multi=len(lits) > 1, limit=limit, pos=m.start()))
+    return units
+
+
+def scan_json(path, text, keys, lengths):
+    units = []
+    pat = re.compile(r'"(%s)"\s*:\s*"((?:[^"\\]|\\.)*)"' % "|".join(keys))
+    for m in pat.finditer(text):
+        value = json.loads('"' + m.group(2) + '"')
+        limit = None
+        if path.endswith("items.json") and m.group(1) == "english":
+            limit = lengths.get("ITEM_NAME_LENGTH", 14) - 1
+        units.append(Unit(path=path, kind="json", context=m.group(1), owner=m.group(1), text=value, span=m.span(2), limit=limit, pos=m.start()))
+    return units
+
+
+def scan_all():
+    lengths = c_lengths()
+    fields = field_sizes(lengths)
+    learned = learned_limits()
+    units = []
+    for path in tracked_files():
+        if path in JSON_TEXT_KEYS:
+            units += scan_json(path, read_original(path), JSON_TEXT_KEYS[path], lengths)
+        elif path.endswith((".inc", ".s")) and path.startswith("data/"):
+            text = read_original(path)
+            if ".string" in text:
+                units += scan_asm(path, text)
+        elif path.endswith((".c", ".h")):
+            text = read_original(path)
+            if '_(' in text:
+                units += scan_c(path, text, lengths, fields, learned)
+    return units
+
+
+# ---------------------------------------------------------------------------
+# Groups: every place that holds the same string is one row
+# ---------------------------------------------------------------------------
+def family_of(section):
+    """Rows are kept apart by kind of text. All dialogue is one family, so a
+    line said in ten maps is one row; each name table is its own family, so
+    THUNDER the move and THUNDER the Pokédex category are separate rows."""
+    if section.startswith(("Map:", "Scripts:")) or section == "New game intro":
+        return "Dialogue"
+    return section
+
+
+class Group:
+    def __init__(self, family, data, unit, section, rank):
+        self.family = family
+        self.data = data                 # encoded bytes: the true identity of the string
+        self.key = (family, data)
+        self.units = [unit]
+        self.english = to_friendly(unit.text)
+        self.section, self.rank = section, rank
+        self.han = None                  # typed by a person
+        self.final = None                # what goes in the game
+        self.fit_units = []              # the places it fits
+        self.source = ""
+        self.notes = []
+        self.similar = ""
+
+    @property
+    def dialogue(self):
+        """Shown in the ordinary two-line text box: everything a map script says."""
+        return any(u.kind == "asm" and u.path.startswith("data/maps/") for u in self.units)
+
+
+def is_translatable(english):
+    plain = strip_tokens(english)
+    if not re.search(r"[A-Za-z]", plain):
+        return False
+    return not re.search(r"[\u3040-\u30ff\u4e00-\u9fff\uff00-\uffef]", plain)
+
+
+def build_groups(units, cm):
+    groups = OrderedDict()
+    skipped = 0
+    for u in units:
+        try:
+            data = cm.encode(u.text)
+        except (KeyError, ValueError):
+            skipped += 1
+            continue
+        section, rank = section_of(u.path, u.owner)
+        key = (family_of(section), data)
+        if key in groups:
+            g = groups[key]
+            g.units.append(u)
+            if rank < g.rank:
+                g.section, g.rank, g.english = section, rank, to_friendly(u.text)
+        else:
+            groups[key] = Group(key[0], data, u, section, rank)
+    return groups, skipped
+
+
+def layout_key(english):
+    s = re.sub(r"\{PARA\}|\{SCROLL\}|\n", " ", english)
+    return re.sub(r"\s+", " ", s).strip().replace("\u2019", "'")
+
+
+def loose_key(english):
+    s = re.sub(r"\{PARA\}|\{SCROLL\}|\n", " ", english).lower()
+    return re.sub(r"[^a-z0-9{}_é]+", "", s)
+
+
+# ---------------------------------------------------------------------------
+# Reading workbooks
+# ---------------------------------------------------------------------------
+def fd_tokens(source_text, cm):
+    """{VAR<n>} from the old tool -> the name the source uses for that fill-in."""
+    out = {}
+    for tok in cm.tokens(source_text):
+        if tok[0] == "b":
+            try:
+                data = cm.encode_token(tok)
+            except KeyError:
+                continue
+            if data[:1] == b"\xFD" and len(data) == 2:
+                out.setdefault(data[1], "{" + tok[1] + "}")
+    return out
+
+
+def modernise(han, group, cm):
+    table = fd_tokens(group.units[0].text, cm)
+
+    def repl(m):
+        n = int(m.group(1))
+        if n not in table:
+            raise ValueError("{VAR%d} is not in the English" % n)
+        return table[n]
+    return re.sub(r"\{VAR(\d+)\}", repl, han)
+
+
+OLD_CATEGORY = {"Move": "Move names", "Item": "Item names", "Type": "Type names", "Pokémon": "Pokémon names",
+                "Ability": "Abilities"}
+
+
+def pick_family(candidates, category):
+    """The old tool's sheet has one row per ROM offset. When the same bytes are
+    in several families, its Category column says which one the row was."""
+    if len(candidates) == 1:
+        return candidates[0]
+    want = OLD_CATEGORY.get(category or "")
+    for g in candidates:
+        if g.family == want:
+            return g
+    for fam in ("Dialogue", "Menus and system", "Battle messages"):
+        for g in candidates:
+            if g.family == fam and not want:
+                return g
+    return candidates[0]
+
+
+def read_book(path, groups, cm, rom=None):
+    """Returns (typed translations by group key, rules, rows that found no place)."""
+    if str(path).lower().endswith(".json"):          # saved by the HTML translator
+        saved = json.loads(Path(path).read_text(encoding="utf-8"))
+        manual, problems, rules = {}, [], OrderedDict()
+        lookup = {(g.family, g.english): g for g in groups.values()}
+        for row in saved.get("rows", []):
+            han = str(row.get("han", ""))
+            if not han.strip():
+                continue
+            group = lookup.get((row.get("section"), row.get("english")))
+            if group is None:
+                problems.append(("", row.get("english"), han, "this row does not match this version of the game"))
+                continue
+            try:
+                manual[group.key] = modernise(han, group, cm)
+            except ValueError as e:
+                problems.append(("", group.english, han, str(e)))
+        for rule in saved.get("rules", []):
+            if rule.get("english") and rule.get("han"):
+                rules[str(rule["english"])] = str(rule["han"])
+        return manual, rules, problems
+    import openpyxl
+    wb = openpyxl.load_workbook(path)
+    ws = wb["Strings"]
+    header = [str(c.value or "").strip() for c in ws[1]]
+    manual, problems = {}, []
+    rules = OrderedDict()
+    if "Rules" in wb.sheetnames:
+        for row in wb["Rules"].iter_rows(min_row=2, values_only=True):
+            if row and len(row) >= 3 and row[1] and row[2]:
+                rules[str(row[1])] = str(row[2])
+    by_data = defaultdict(list)
+    for g in groups.values():
+        by_data[g.data].append(g)
+    if "Offset" in header:                       # exported by Han_FireRed_Tool.html
+        table = json.loads(OLD_OFFSETS.read_text()) if OLD_OFFSETS.exists() else {}
+        by_first_unit = {(g.units[0].path, g.units[0].context, g.units[0].pos): g for g in groups.values()}
+        rom_bytes = Path(rom).read_bytes() if rom else None
+        learned = {}
+        col = {name: header.index(name) for name in ("Offset", "English", "Hän")}
+        cat_col = header.index("Category") if "Category" in header else None
+        for row in ws.iter_rows(min_row=2, values_only=True):
+            offset, han = str(row[col["Offset"]]), row[col["Hän"]]
+            category = row[cat_col] if cat_col is not None else None
+            group = None
+            if rom_bytes is not None:
+                off = int(offset, 16)
+                end = rom_bytes.find(b"\xFF", off)
+                candidates = by_data.get(rom_bytes[off:end])
+                if candidates:
+                    group = pick_family(candidates, category)
+                    u = group.units[0]
+                    learned[offset] = [u.path, u.context, u.pos]
+            elif offset in table:
+                group = by_first_unit.get(tuple(table[offset]))
+            if han is None or not str(han).strip():
+                continue
+            if group is None:
+                problems.append((offset, row[col["English"]], str(han), "this string was not found in the source"))
+                continue
+            try:
+                text = modernise(str(han), group, cm)
+            except ValueError as e:
+                problems.append((offset, group.english, str(han), str(e)))
+                continue
+            if group.key in manual and manual[group.key] != text:
+                problems.append((offset, group.english, str(han), "a different Hän was given for the same English: kept the first"))
+                continue
+            manual[group.key] = text
+        if rom_bytes is not None:
+            OLD_OFFSETS.write_text(json.dumps(learned, ensure_ascii=False, indent=0))
+    else:                                        # this tool's own workbook
+        e_col, h_col = header.index("English"), header.index("Hän")
+        s_col = header.index("Section") if "Section" in header else None
+        by_english = defaultdict(list)
+        for g in groups.values():
+            by_english[g.english].append(g)
+        for row in ws.iter_rows(min_row=2, values_only=True):
+            eng, han = row[e_col], row[h_col]
+            if eng is None or han is None or not str(han).strip():
+                continue
+            eng = str(eng).replace("_x000D_", "").replace("\r", "")
+            candidates = by_english.get(eng)
+            if not candidates:
+                problems.append(("", eng, str(han), "the English cell was changed, so this row no longer matches the game"))
+                continue
+            family = family_of(str(row[s_col])) if s_col is not None and row[s_col] else None
+            group = next((g for g in candidates if g.family == family), candidates[0])
+            try:
+                manual[group.key] = modernise(str(han), group, cm)
+            except ValueError as e:
+                problems.append(("", eng, str(han), str(e)))
+    return manual, rules, problems
+
+
+# ---------------------------------------------------------------------------
+# Deciding what goes in the game
+# ---------------------------------------------------------------------------
+ENGLISH = set()         # the game's English words; filled in by resolve()
+
+
+def resolve(groups, manual, rules, cm, wrapper, skip=()):
+    """Work out what each row shows in the game.
+
+    In order: what was typed on the row; the same English typed on another
+    row; the same words typed with different line breaks; the word rules."""
+    ENGLISH.clear()
+    ENGLISH.update(english_words(groups))
+
+    def game_text(g, han):
+        """Typed Hän as the game shows it: doubled letters single, case of the English."""
+        text, changed = single_letters(han, ENGLISH)
+        if changed:
+            pairs = list(OrderedDict.fromkeys(changed))
+            g.notes.append("double letters made single: " + ", ".join("%s > %s" % p for p in pairs))
+        return match_source_case(g.english, text)
+
+    order = sorted(manual, key=lambda k: groups[k].rank)
+    by_data, by_layout, by_loose = {}, {}, {}
+    for key in order:
+        g, han = groups[key], manual[key]
+        by_data.setdefault(g.data, (g, han))
+        by_layout.setdefault(layout_key(g.english), (g, han))
+        by_loose.setdefault(loose_key(g.english), (g, han))
+
+    for g in groups.values():
+        g.han, g.final, g.source, g.notes, g.similar, g.fit_units = None, None, "", [], "", []
+        if not is_translatable(g.english):
+            continue
+        candidate = None
+        if g.key in manual:
+            g.han = manual[g.key]
+            candidate, g.source = game_text(g, g.han), "typed"
+        elif g.data in by_data:
+            other, han = by_data[g.data]
+            candidate, g.source = game_text(g, han), "repeat"
+            g.notes.append("same English as the row in " + other.section)
+        elif layout_key(g.english) in by_layout:
+            other, han = by_layout[layout_key(g.english)]
+            candidate, g.source = game_text(g, han), "repeat"
+            g.notes.append("same words as: " + other.english.replace("\n", " / "))
+        else:
+            ruled = apply_rules(g.english, rules)
+            if ruled is not None:
+                candidate, g.source = ruled, "rule"
+            else:
+                near = by_loose.get(loose_key(g.english))
+                if near:
+                    g.similar = "%s   [for: %s]" % (near[1], near[0].english.replace("\n", " / "))
+        if candidate is None:
+            continue
+        if candidate.strip() == "{NOTHING}":
+            # the string is to be left out of the game altogether
+            g.final, g.fit_units = "", list(g.units)
+            g.notes.append("shows nothing")
+            continue
+        if wrapper.is_page(g.english, g.dialogue) and re.search(r"\{PARA\}|\{SCROLL\}", candidate):
+            g.notes.append("{PARA} does nothing on this screen, so it became a line break")
+        text = tidy_marks(wrapper.format(candidate, g.english, g.dialogue))
+        try:
+            data = cm.encode(to_source(text))
+        except KeyError as e:
+            g.notes.append("not in the game font: %s" % str(e).strip("'\""))
+            g.source += ", not used"
+            continue
+        except ValueError as e:
+            g.notes.append(str(e))
+            g.source += ", not used"
+            continue
+        g.fit_units = [u for u in g.units
+                       if (u.limit is None or len(data) <= u.limit) and (u.path, u.pos) not in skip]
+        if len(g.fit_units) < len(g.units):
+            slots = sorted({u.limit for u in g.units if u.limit is not None and len(data) > u.limit})
+            what = "%d letters, the slot holds %s" % (len(data), " or ".join(str(n) for n in slots) if slots else "fewer")
+            if not g.fit_units:
+                g.notes.append("too long for this name slot: " + what)
+                g.notes.append("would be: " + text)
+                g.source += ", not used"
+                continue
+            g.notes.append("too long for %d of its %d places: %s" % (len(g.units) - len(g.fit_units), len(g.units), what))
+        over, shown = wrapper.line_overflow(text, g.english, g.dialogue)
+        if over:
+            g.notes.append("%d lines, this screen shows %d" % (shown + over, shown))
+        g.final = text
