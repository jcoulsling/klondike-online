+#!/usr/bin/env python3
+"""Checks the game's syllabics converter against Jane's word processor.
+
+    python3 tools/han/han_syllabics_check.py BOOK PATH/TO/han-word-processor.html
+
+BOOK is the workbook or save file with the Hän text. Every piece of Hän text in
+it, and a sample of the English text, goes through both converters:
+
+  - the game's, the same C lines the game is built from (src/han_syllabics_core.h),
+    compiled here for the computer by way of tools/han/syllabics_test.c
+  - the word processor's, run in a real browser by tools/han/syllabics_ref.js
+
+It prints how many pieces come out the same and lists every piece that differs.
+Differences of a kind that is meant are counted apart:
+
+  - the word processor keeps the acute of a letter like é as a mark. The game leaves it out.
+  - r before a vowel: the word processor prints the Latin letters in brackets, [re].
+    The game shows the Latin letters without the brackets.
+  - the keys of the typing layout (q , ; ^ % `) mean marks in the word processor.
+    In game text they are just characters.
+  - the word processor has private glyphs for finals that the font does not have
+    (th, tr and so on, in English words). The game writes two finals, t and h.
+
+Needs gcc, node and the playwright package. The word processor is Jane's file
+and is not in this repository.
+"""
+import collections
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import unicodedata
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.normpath(os.path.join(HERE, '..', '..'))
+sys.path.insert(0, HERE)
+import han_text as H        # noqa: E402
+import han_syllabics as S   # noqa: E402
+
+
+def segments(text):
+    text = re.sub(r"\{[^}]*\}", "\n", text)
+    text = text.replace("\\n", "\n").replace("\\p", "\n").replace("\\l", "\n")
+    return [s.strip() for s in text.split("\n") if s.strip()]
+
+
+def wp_to_font(cp):
+    """The word processor uses its own private code points. The font and the game use others."""
+    if 0xE000 <= cp <= 0xE01D:
+        return 0xF0000 + cp - 0xE000
+    for lo, base in ((0xE01E, 0xF001E), (0xE026, 0xF0025), (0xE036, 0xF002C), (0xE046, 0xF0033), (0xE04E, 0xF003A),
+                     (0xE056, 0xF0041), (0xE05E, 0xF0048), (0xE066, 0xF004F), (0xE06E, 0xF0056)):
+        if lo <= cp <= lo + 6:
+            return base + cp - lo
+    return {0x144A: 0x14A1, 0x1525: 0x1425, 0x1526: 0x1426, 0x02B8: 0x153E, 0x02B3: 0x18F4}.get(cp, cp)
+
+
+def r_brackets(cps):
+    """The word processor's [re] becomes one token."""
+    out, i = [], 0
+    while i < len(cps):
+        if cps[i] == ord('[') and i + 1 < len(cps) and cps[i + 1] == ord('r') and ord(']') in cps[i:i + 8]:
+            i = cps.index(ord(']'), i) + 1
+            out.append('r+vowel')
+        else:
+            out.append(cps[i])
+            i += 1
+    return out
+
+
+def r_vowel(cps, vowel_glyphs):
+    """The game's r, then a vowel glyph and its marks, becomes the same token."""
+    out, i = [], 0
+    while i < len(cps):
+        if cps[i] == ord('r') and i + 1 < len(cps) and cps[i + 1] in vowel_glyphs:
+            i += 2
+            while i < len(cps) and cps[i] in (0x300, 0x303, 0x307):
+                i += 1
+            out.append('r+vowel')
+        else:
+            out.append(cps[i])
+            i += 1
+    return out
+
+
+def show(cps):
+    return ' '.join(('%X' % c) if isinstance(c, int) and (c > 0x2FF or c < 0x21) else (chr(c) if isinstance(c, int) else str(c))
+                    for c in cps)
+
+
+def main():
+    if len(sys.argv) != 3:
+        sys.exit(__doc__)
+    book, wp = sys.argv[1], sys.argv[2]
+    work = tempfile.mkdtemp(prefix='syllabics_check_')
+    test = os.path.join(work, 'syllabics_test')
+    subprocess.run(['gcc', '-O1', '-o', test, os.path.join(HERE, 'syllabics_test.c')], check=True)
+
+    cm, units, groups, wrapper = H.load()
+    manual, rules, problems = H.read_book(book, groups, cm, None)
+    H.resolve(groups, manual, rules, cm, wrapper, set())
+    han, eng = [], []
+    for g in groups.values():
+        if g.final is not None and g.source and g.source.split(',')[0] in ('typed', 'repeat'):
+            han += segments(g.final)
+        elif H.is_translatable(g.english):
+            eng += segments(g.english)
+    han = sorted(set(han))
+    eng = sorted(set(eng))[::7]
+    print(len(han), 'pieces of Hän text,', len(eng), 'pieces of English text')
+
+    inv = {}
+    for line in open(os.path.join(ROOT, 'charmap.txt'), encoding='utf-8'):
+        m = re.match(r"'((?:\\'|[^'])+)'\s*=\s*([0-9A-F]{2})\s*$", line.split('@')[0].strip())
+        if m and int(m.group(2), 16) not in inv:
+            inv[int(m.group(2), 16)] = m.group(1).replace("\\'", "'")
+    code_of = [c for _, cs in S.ROWS for c in cs] + [c for _, c in S.FINALS]
+    vowel_glyphs = set(dict(S.ROWS)['V'])   # the row of syllables with no consonant
+
+    def run(strings, tag):
+        ok, encoded = [], []
+        for s in strings:
+            try:
+                b = bytes(cm.encode(s))
+            except Exception:
+                continue
+            ok.append(s)
+            encoded.append(b)
+        out = subprocess.run([test], input="\n".join(b.hex() for b in encoded) + "\n", capture_output=True, text=True).stdout.splitlines()
+        fin, fout = os.path.join(work, 'in_%s.json' % tag), os.path.join(work, 'out_%s.json' % tag)
+        json.dump([s.lower() for s in ok], open(fin, 'w', encoding='utf-8'), ensure_ascii=False)
+        subprocess.run(['node', os.path.join(HERE, 'syllabics_ref.js'), wp, fin, fout], check=True)
+        ref = json.load(open(fout, encoding='utf-8'))
+        same, diffs = 0, []
+        known = collections.Counter()
+        for s, line, r in zip(ok, out, ref['res']):
+            mine = []
+            for tok in line.split():
+                if tok[0] == 'G':
+                    g, _, m = tok[1:].partition('+')
+                    mine.append(code_of[int(g)])
+                    m = int(m or 0)
+                    if m & 1:
+                        mine.append(0x303)
+                    if m & 2:
+                        mine.append(0x300)
+                    if m & 4:
+                        mine.append(0x307)
+                else:
+                    ch = inv.get(int(tok[1:], 16), '?')
+                    mine += [ord(c) for c in unicodedata.normalize('NFD', ch.lower()).replace('’', "'")]
+            theirs = [wp_to_font(c) if isinstance(c, int) else c for c in r]
+            while theirs and theirs[-1] == 0x20:
+                theirs.pop()
+            theirs = [0x27 if c == 0x2019 else c for c in theirs]
+            while mine and mine[-1] == 0x20:
+                mine.pop()
+            no_acute = [c for c in theirs if c != 0x301]
+            if mine == theirs:
+                same += 1
+            elif mine == no_acute:
+                known['acute left out'] += 1
+            elif r_vowel(mine, vowel_glyphs) == r_brackets(no_acute):
+                known['r and a vowel: the word processor prints [re], the game r and the vowel'] += 1
+            elif any(isinstance(c, int) and 0xE000 <= c <= 0xE0FF for c in theirs):
+                known['a final the font has no glyph for (th, tr and so on): the game writes two finals'] += 1
+            elif re.search(r"[q,;^%`]", s.lower()):
+                known['typing keys (q , ; ^ % `) in the text'] += 1
+            else:
+                diffs.append((s, mine, theirs))
+        print(tag, '- the word processor started as:', ref['state'])
+        print(tag, '-', same, 'of', len(ok), 'the same;', len(diffs), 'differ in another way;', len(strings) - len(ok), 'could not be encoded')
+        print('   differences of a known kind:', dict(known))
+        for s, mine, theirs in diffs:
+            print('  ', repr(s))
+            print('      game:          ', show(mine))
+            print('      word processor:', show(theirs))
+
+    run(han, 'Hän')
+    run(eng, 'English')
+
+
+if __name__ == '__main__':
+    main()
