+// "the 2 eye pixels he has" to be "red like his mouth" after the attack (17 November 2026).
+// No picture is added for it. The ODDISH's picture has two pixels for eyes, in each of its two frames, and its
+// mouth is colour 3 of the picture's sixteen: the eye pixels are set to that colour, in the copy of the picture
+// the battle holds in memory. The places are those of the picture this build uses, Emerald's (see han_emerald.py).
+static const u8 sOddishEyes[][3] = { // frame, x, y
+    {0, 26, 37}, {0, 32, 37},
+    {1, 26, 36}, {1, 32, 36},
+};
+#define ODDISH_MOUTH_COLOR 3
+
+static void SetPicPixel(u8 *tiles, u32 x, u32 y, u32 color)
+{
+    // 8 by 8 tiles, 8 to a row; 4 bytes to a row of a tile; the left pixel of two is the low half of the byte.
+    // It is written two bytes at a time: the machine ignores a single byte written to the sprites' part of the screen.
+    u32 offset = ((y / 8) * 8 + x / 8) * TILE_SIZE_4BPP + (y % 8) * 4 + (x % 8) / 2;
+    u16 *pair = (u16 *)(tiles + (offset & ~1));
+    u32 shift = (offset & 1) * 8 + (x & 1) * 4;
+
+    *pair = (*pair & ~(0xF << shift)) | (color << shift);
+}
+
+// onScreen: also change what is on the screen now. The screen shows the first frame while a POKéMON stands still.
+void HanRedOddishEyes(u8 battlerId, bool8 onScreen)
+{
+    u8 *pic = gMonSpritesGfxPtr->sprites[GetBattlerPosition(battlerId)];
+    u8 *screen = (u8 *)(OBJ_VRAM0 + gSprites[gBattlerSpriteIds[battlerId]].oam.tileNum * TILE_SIZE_4BPP);
+    u32 i;
+
+    for (i = 0; i < ARRAY_COUNT(sOddishEyes); i++)
+    {
+        SetPicPixel(pic + sOddishEyes[i][0] * MON_PIC_SIZE, sOddishEyes[i][1], sOddishEyes[i][2], ODDISH_MOUTH_COLOR);
+        if (onScreen && sOddishEyes[i][0] == 0)
+            SetPicPixel(screen, sOddishEyes[i][1], sOddishEyes[i][2], ODDISH_MOUTH_COLOR);
+    }
+}
+
+// It has used the move if it knows it and has less than all of its PP. So the eyes are red again when its
+// picture is loaded again, after it was taken back or stood behind a SUBSTITUTE.
+static bool8 OddishHasUsedItsMove(struct Pokemon *mon)
+{
+    u32 i;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (GetMonData(mon, MON_DATA_MOVE1 + i) == MOVE_ODDISH_SMOKE
+         && GetMonData(mon, MON_DATA_PP1 + i) < CalculatePPWithBonus(MOVE_ODDISH_SMOKE, GetMonData(mon, MON_DATA_PP_BONUSES), i))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// The end of the move's animation: the smoke has cleared, and the eyes are red.
+void AnimTask_OddishRedEyes(u8 taskId)
+{
+    u8 battler = gBattleAnimAttacker;
+
+    if (GetBattlerSide(battler) == B_SIDE_OPPONENT // the picture from the front
+     && gBattleSpritesDataPtr->battlerData[battler].transformSpecies == SPECIES_NONE
+     && !gBattleSpritesDataPtr->battlerData[battler].behindSubstitute
+     && GetMonData(&gEnemyParty[gBattlerPartyIndexes[battler]], MON_DATA_SPECIES) == SPECIES_ODDISH)
+        HanRedOddishEyes(battler, TRUE);
+    DestroyAnimVisualTask(taskId);
+}
