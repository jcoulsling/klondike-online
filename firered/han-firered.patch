+// ---------------------------------------------------------------------------------------------------------------
+// Hän build: the ability sign and the item sign. When a Pokémon's ability or the item it holds does something,
+// a small sign slides in with the name of the ability or the item, stays a moment and slides out.
+// Jane asked for it on 17 November 2026, so that people see which ability a Pokémon has when it acts.
+// The sign has that one name only: the Pokémon's name is in the line of text below, and where the sign is says
+// whose it is. An ability's sign has a yellow stripe, an item's a green one.
+//
+// The idea, the places on the screen and the sliding are those of the ability pop-up of the open-source
+// pokeemerald-expansion project (https://github.com/rh-hideout/pokeemerald-expansion, src/battle_interface.c).
+// The code here is written for this game and is simpler: the sign has no picture file. Its box is drawn with
+// rectangles as wide as the name needs, the name is printed on it with the game's own text printer (so Hän
+// letters and syllabics come out as they do everywhere else), and the result is copied into two sprites of 64 by 32.
+// It does not stop the battle: the lines of text go on while the sign is up.
+#define TAG_HAN_ABILITY_SIGN  0xD740 // the colours, and the tiles of battler 0. The next three tags are battlers 1 to 3
+#define SIGN_SLIDE            128    // how far off its place it starts, in pixels
+#define SIGN_SPEED            8      // pixels a frame
+#define SIGN_STAY             100    // frames it stays in place
+
+#define sSignState    data[0]
+#define sSignTimer    data[1]
+#define sSignBattler  data[2]
+#define sSignWhat     data[3] // which ability or item it names: the same one again makes it stay up longer
+#define sSignOther    data[4] // the sprite of the right half
+#define sSignFromLeft data[5]
+
+enum { SIGN_IN, SIGN_UP, SIGN_OUT };
+
+static void SpriteCB_HanAbilitySign(struct Sprite *sprite);
+
+static const struct WindowTemplate sHanSignWindowTemplate = {
+    .bg = 0,
+    .tilemapLeft = 0,
+    .tilemapTop = 0,
+    .width = 16,
+    .height = 4,
+    .paletteNum = 0,
+    .baseBlock = 0
+};
+
+// 0 see-through, 1 the box, 2 its edge, 3 the letters, 4 their shadow, 5 the stripe of an ability, 6 of an item
+static const u16 sHanSignPalette[16] = {
+    RGB(0, 31, 0), RGB(4, 6, 10), RGB(27, 27, 25), RGB(31, 31, 31), RGB(1, 1, 3), RGB(31, 23, 5), RGB(9, 27, 11),
+};
+
+static const struct SpritePalette sHanSignSpritePalette = {sHanSignPalette, TAG_HAN_ABILITY_SIGN};
+
+static const struct OamData sOamData_HanAbilitySign = {
+    .shape = SPRITE_SHAPE(64x32),
+    .size = SPRITE_SIZE(64x32),
+    .priority = 0
+};
+
+static const struct SpriteTemplate sSpriteTemplate_HanAbilitySign = {
+    .tileTag = TAG_HAN_ABILITY_SIGN,
+    .paletteTag = TAG_HAN_ABILITY_SIGN,
+    .oam = &sOamData_HanAbilitySign,
+    .anims = gDummySpriteAnimTable,
+    .images = NULL,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCallbackDummy
+};
+
+// Where a sign rests, by the place its Pokémon stands in: the middle of the left half of the sign, and the edge
+// of the screen it slides in from. The sign is 128 wide and 16 of that stays off the edge it comes from.
+// Jane found that a sign on the right covered the opposing Pokémon. So with one Pokémon a side, the foe's sign is
+// at the top left, above the foe's own box, where there is nothing, and the player's is at the bottom left, just
+// above the text. With two a side the foes' boxes fill the top left, so the foes' signs are in the top right corner.
+struct HanSignPlace
+{
+    s16 x;
+    s16 y;
+    bool8 fromLeft;
+};
+
+static const struct HanSignPlace sHanSignPlaces[2][MAX_BATTLERS_COUNT] = {
+    { // one against one
+        [B_POSITION_PLAYER_LEFT]    = { 16, 103, TRUE},
+        [B_POSITION_OPPONENT_LEFT]  = { 16,   9, TRUE},
+    },
+    { // two against two
+        [B_POSITION_PLAYER_LEFT]    = { 16,  86, TRUE},
+        [B_POSITION_OPPONENT_LEFT]  = {160,   9, FALSE},
+        [B_POSITION_PLAYER_RIGHT]   = { 16, 103, TRUE},
+        [B_POSITION_OPPONENT_RIGHT] = {160,  26, FALSE},
+    },
+};
+
+static u8 FindHanAbilitySign(u8 battler)
+{
+    u8 i;
+
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        if (gSprites[i].inUse && gSprites[i].callback == SpriteCB_HanAbilitySign && gSprites[i].sSignBattler == battler)
+            return i;
+    }
+    return MAX_SPRITES;
+}
+
+static void RemoveHanAbilitySign(struct Sprite *sprite)
+{
+    u8 battler = sprite->sSignBattler;
+    u8 i;
+
+    DestroySprite(&gSprites[sprite->sSignOther]);
+    DestroySprite(sprite);
+    FreeSpriteTilesByTag(TAG_HAN_ABILITY_SIGN + battler);
+    for (i = 0; i < MAX_BATTLERS_COUNT; i++)
+    {
+        if (FindHanAbilitySign(i) != MAX_SPRITES)
+            return; // another sign still uses the colours
+    }
+    FreeSpritePaletteByTag(TAG_HAN_ABILITY_SIGN);
+}
+
+static void SpriteCB_HanAbilitySign(struct Sprite *sprite)
+{
+    switch (sprite->sSignState)
+    {
+    case SIGN_IN:
+        if (sprite->x2 == 0)
+        {
+            sprite->sSignState = SIGN_UP;
+            sprite->sSignTimer = SIGN_STAY;
+        }
+        else
+        {
+            sprite->x2 += sprite->sSignFromLeft ? SIGN_SPEED : -SIGN_SPEED;
+        }
+        break;
+    case SIGN_UP:
+        if (--sprite->sSignTimer <= 0)
+            sprite->sSignState = SIGN_OUT;
+        break;
+    case SIGN_OUT:
+        sprite->x2 += sprite->sSignFromLeft ? -SIGN_SPEED : SIGN_SPEED;
+        if (sprite->x2 <= -SIGN_SLIDE || sprite->x2 >= SIGN_SLIDE)
+        {
+            RemoveHanAbilitySign(sprite);
+            return;
+        }
+        break;
+    }
+    gSprites[sprite->sSignOther].x2 = sprite->x2;
+}
+
+// what: a number for the ability or item, to tell two signs apart. stripe: the colour number of the stripe.
+static void ShowHanSign(u8 battler, const u8 *text, s16 what, u8 stripe)
+{
+    static const u8 sColors[3] = {1, 3, 4}; // behind the letters, the letters, their shadow
+    struct SpriteSheet sheet;
+    struct SpriteTemplate template;
+    const struct HanSignPlace *place;
+    u8 *pixels, *tiles;
+    u8 spriteId, otherId, windowId, textX;
+    u32 row, col;
+    s32 width;
+    bool8 fromLeft;
+
+    if (battler >= gBattlersCount)
+        return;
+
+    spriteId = FindHanAbilitySign(battler);
+    if (spriteId != MAX_SPRITES)
+    {
+        if (gSprites[spriteId].sSignWhat == what && gSprites[spriteId].sSignState != SIGN_OUT)
+        {
+            gSprites[spriteId].sSignTimer = SIGN_STAY; // the same sign again: it stays up longer
+            return;
+        }
+        RemoveHanAbilitySign(&gSprites[spriteId]);
+    }
+
+    place = &sHanSignPlaces[IsDoubleBattle() ? 1 : 0][GetBattlerPosition(battler)];
+    fromLeft = place->fromLeft;
+
+    // Draw the sign in a window that is never put on the screen
+    tiles = Alloc(16 * 4 * TILE_SIZE_4BPP);
+    if (tiles == NULL)
+        return;
+    windowId = AddWindow(&sHanSignWindowTemplate);
+    if (windowId == 0xFF)
+    {
+        Free(tiles);
+        return;
+    }
+    // The box is 16 high, in the middle of the sprite, and as wide as the name and a little more. Sixteen pixels
+    // of the sign are off the edge of the screen, so the box starts or ends there.
+    width = GetStringWidth(FONT_SMALL, text, 0);
+    if (width > 96)
+        width = 96;
+    width += 16 + 6 + 8; // the part off the screen, the stripe and the space before the name, the space after it
+    FillWindowPixelBuffer(windowId, PIXEL_FILL(0));
+    if (fromLeft)
+    {
+        FillWindowPixelRect(windowId, PIXEL_FILL(2), 0, 8, width, 16);
+        FillWindowPixelRect(windowId, PIXEL_FILL(1), 0, 9, width - 1, 14);
+        FillWindowPixelRect(windowId, PIXEL_FILL(stripe), width - 5, 9, 4, 14);
+        textX = 16 + 4;
+    }
+    else
+    {
+        FillWindowPixelRect(windowId, PIXEL_FILL(2), 128 - width, 8, width, 16);
+        FillWindowPixelRect(windowId, PIXEL_FILL(1), 128 - width + 1, 9, width - 1, 14);
+        FillWindowPixelRect(windowId, PIXEL_FILL(stripe), 128 - width + 1, 9, 4, 14);
+        textX = 128 - width + 9;
+    }
+    AddTextPrinterParameterized4(windowId, FONT_SMALL, textX, 9, 0, 0, sColors, -1, text);
+
+    // A window's tiles go row by row, 16 to a row. A sprite's go row by row, 8 to a row, the left half first
+    pixels = (u8 *)GetWindowAttribute(windowId, WINDOW_TILE_DATA);
+    for (row = 0; row < 4; row++)
+    {
+        for (col = 0; col < 16; col++)
+            CpuCopy32(pixels + (row * 16 + col) * TILE_SIZE_4BPP, tiles + ((col / 8) * 32 + row * 8 + (col % 8)) * TILE_SIZE_4BPP, TILE_SIZE_4BPP);
+    }
+    RemoveWindow(windowId);
+
+    sheet.data = tiles;
+    sheet.size = 16 * 4 * TILE_SIZE_4BPP;
+    sheet.tag = TAG_HAN_ABILITY_SIGN + battler;
+    LoadSpriteSheet(&sheet);
+    Free(tiles);
+    if (GetSpriteTileStartByTag(sheet.tag) == 0xFFFF)
+        return; // no room for the tiles just now: no sign this time
+    if (IndexOfSpritePaletteTag(TAG_HAN_ABILITY_SIGN) == 0xFF && LoadSpritePalette(&sHanSignSpritePalette) == 0xFF)
+    {
+        FreeSpriteTilesByTag(sheet.tag);
+        return;
+    }
+
+    template = sSpriteTemplate_HanAbilitySign;
+    template.tileTag = sheet.tag;
+    spriteId = CreateSprite(&template, place->x, place->y, 0);
+    otherId = CreateSprite(&template, place->x + 64, place->y, 0);
+    if (spriteId == MAX_SPRITES || otherId == MAX_SPRITES)
+    {
+        if (spriteId != MAX_SPRITES)
+            DestroySprite(&gSprites[spriteId]);
+        if (otherId != MAX_SPRITES)
+            DestroySprite(&gSprites[otherId]);
+        FreeSpriteTilesByTag(sheet.tag);
+        return;
+    }
+    gSprites[otherId].oam.tileNum += 32; // the right half of the tiles
+    gSprites[spriteId].sSignState = SIGN_IN;
+    gSprites[spriteId].sSignBattler = battler;
+    gSprites[spriteId].sSignWhat = what;
+    gSprites[spriteId].sSignOther = otherId;
+    gSprites[spriteId].sSignFromLeft = fromLeft;
+    gSprites[spriteId].x2 = gSprites[otherId].x2 = fromLeft ? -SIGN_SLIDE : SIGN_SLIDE;
+    gSprites[spriteId].callback = SpriteCB_HanAbilitySign;
+}
+
+void HanShowAbilitySign(u8 battler, u8 ability)
+{
+    if (ability != ABILITY_NONE && ability < ABILITIES_COUNT)
+        ShowHanSign(battler, gAbilityNames[ability], ability, 5);
+}
+
+// The sign of the item a Pokémon holds, when the item does something.
+void HanShowItemSign(u8 battler, u16 item)
+{
+    if (item != ITEM_NONE && item < ITEMS_COUNT)
+        ShowHanSign(battler, ItemId_GetName(item), 0x400 + item, 6);
+}
