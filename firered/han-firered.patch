+static const u8 sJaneUnownName[POKEMON_NAME_LENGTH + 1] = _("UNOWN CHO"); // the name Jane gave it
+
+static void CreateJaneMon(struct Pokemon *mon, const struct TrainerMonItemCustomMoves *data, const struct JaneMon *set, u32 seed)
+{
+    u32 personality, otId;
+    u8 iv = 0;
+    s32 i;
+
+    // The personality number decides the nature, the sex, the ability and the UNOWN's letter. Look for one that fits.
+    for (personality = seed; ; personality++)
+    {
+        if (personality % NUM_NATURES != set->nature)
+            continue;
+        if (gSpeciesInfo[data->species].abilities[1] != ABILITY_NONE && (personality & 1) != set->secondAbility)
+            continue;
+        if (set->female && (personality & 0xFF) >= gSpeciesInfo[data->species].genderRatio)
+            continue;
+        if (set->letterJ && GET_UNOWN_LETTER(personality) != 9) // J is the tenth letter
+            continue;
+        break;
+    }
+    otId = HIHALF(personality) ^ LOHALF(personality); // with this trainer number it is shiny
+    if (!set->shiny)
+        otId ^= 0x8000;
+
+    CreateMon(mon, data->species, data->lvl, MAX_PER_STAT_IVS, TRUE, personality, OT_ID_PRESET, otId);
+    SetMonData(mon, MON_DATA_HELD_ITEM, &data->heldItem);
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        SetMonData(mon, MON_DATA_MOVE1 + i, &data->moves[i]);
+        SetMonData(mon, MON_DATA_PP1 + i, &gBattleMoves[data->moves[i]].pp);
+    }
+    for (i = 0; i < NUM_STATS; i++)
+        SetMonData(mon, MON_DATA_HP_EV + i, &set->evs[i]);
+    if (set->noAttackIv)
+        SetMonData(mon, MON_DATA_ATK_IV, &iv);
+    if (set->letterJ)
+        SetMonData(mon, MON_DATA_NICKNAME, sJaneUnownName);
+    CalculateMonStats(mon);
+}
