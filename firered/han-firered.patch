+        case SPECIES_GYARADOS:  ability = ABILITY_ICE_SCALES;   break;
+        case SPECIES_STANTLER:  ability = ABILITY_SNOW_CLOAK;   break;
+        case SPECIES_URSARING:  ability = ABILITY_ICE_BEARD;    break;
+        }
