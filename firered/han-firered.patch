+// ---------------------------------------------------------------------------
+// Hän build: in syllabics a proper name starts with an asterisk
+// ---------------------------------------------------------------------------
+// Proper names are people, Pokémon and places. The game knows a name when it is written exactly as
+// in one of its lists: the Pokémon names, the trainer names, the map names, the extra names in
+// data/han_syllabics.h, the player's and the rival's name, and the nicknames of the Pokémon on both
+// sides of a battle. Nothing is added to the text: the asterisk is only drawn.
+
+static EWRAM_DATA const u8 *sHanSylWordEnd = NULL;     // where the last letter drawn ended: text that goes on from there is inside a word
+static EWRAM_DATA const u8 *sHanSylNamePending = NULL; // the name whose asterisk is drawn and whose first letter is not yet
+static EWRAM_DATA const u8 *sHanSylNameBegin = NULL;   // the last name that got its asterisk: from here
+static EWRAM_DATA const u8 *sHanSylNameEnd = NULL;     // to here
+static EWRAM_DATA const u8 *sHanEngStart = NULL;       // the English word being drawn: the printer comes back to its first letter for each glyph
+static EWRAM_DATA u8 sHanEngIndex = 0;                 // which of its glyphs is drawn next
+
+struct HanSylWalk // the same, for measuring a string from start to end
+{
+    const u8 *wordEnd;
+    const u8 *nameEnd;
+};
+
+// A new string is about to be printed. Text buffers are used again and again, so what was noted
+// about the last string must not be read as being about this one.
+void HanSyl_ResetNames(void)
+{
+    sHanSylWordEnd = NULL;
+    sHanSylNamePending = NULL;
+    sHanSylNameBegin = NULL;
+    sHanSylNameEnd = NULL;
+    sHanEngStart = NULL;
+}
+
+// a to z or ł, with or without marks, in either case. Not the apostrophe.
+static bool8 HanSyl_IsLetter(u8 c)
+{
+    u8 letter = sHanSylLetters[c] & HAN_SYL_LETTER_MASK;
+
+    return letter != 0 && letter != HAN_SYL_APOSTROPHE;
+}
+
+static bool8 HanSyl_IsCapital(u8 c)
+{
+    return (c >= CHAR_A && c <= CHAR_Z)     // A to Z
+        || (c >= 0x87 && c <= 0x9B)         // the capitals added for Hän
+        || (c >= 0x01 && c <= 0x15)         // the game's own accented capitals
+        || (c >= 0xF1 && c <= 0xF3);
+}
+
+// The length of the name, if the text at s is that name and a word ends after it. Else 0.
+// A name ends at EOS or after max characters.
+static u32 HanSyl_NameMatch(const u8 *s, const u8 *name, u32 max)
+{
+    u32 i;
+    u8 next;
+
+    for (i = 0; i < max && name[i] != EOS; i++)
+    {
+        if (s[i] != name[i])
+            return 0;
+    }
+    if (i == 0)
+        return 0;
+    next = s[i];
+    if (HanSyl_IsLetter(next) || (next >= CHAR_0 && next <= CHAR_9))
+        return 0;
+    return i;
+}
+
+// TRUE if name is one of the names of a list in which each name ends with EOS, and so does the list.
+static bool8 HanSyl_InList(const u8 *list, const u8 *name, u32 max)
+{
+    u32 i;
+
+    while (*list != EOS)
+    {
+        for (i = 0; i < max && name[i] != EOS && list[i] == name[i]; i++)
+            ;
+        if (list[i] == EOS && (i == max || name[i] == EOS))
+            return TRUE;
+        while (*list++ != EOS)
+            ;
+    }
+    return FALSE;
+}
+
+// The length of the longest proper name that starts at s, or 0.
+static u32 HanSyl_NameLength(const u8 *s)
+{
+    u32 best = 0;
+    u32 length, i;
+    const u8 *name;
+    u8 first = *s;
+
+#define TRY_NAME(ptr, max)                    \
+    {                                         \
+        length = HanSyl_NameMatch(s, ptr, max); \
+        if (length > best)                    \
+            best = length;                    \
+    }
+
+    // names the player typed: any case
+    TRY_NAME(gSaveBlock2Ptr->playerName, PLAYER_NAME_LENGTH)
+    TRY_NAME(gSaveBlock1Ptr->rivalName, PLAYER_NAME_LENGTH)
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        TRY_NAME(gPlayerParty[i].box.nickname, POKEMON_NAME_LENGTH)
+        TRY_NAME(gEnemyParty[i].box.nickname, POKEMON_NAME_LENGTH)
+    }
+
+    // the game's own lists are all in capitals
+    if (!HanSyl_IsCapital(first))
+        return best;
+    for (i = 1; i < NUM_SPECIES; i++)
+    {
+        if (gSpeciesNames[i][0] == first)
+            TRY_NAME(gSpeciesNames[i], POKEMON_NAME_LENGTH)
+    }
+    for (i = 1; i < NUM_TRAINERS; i++)
+    {
+        name = gTrainers[i].trainerName;
+        if (name[0] == first && !HanSyl_InList(sHanSylNotNames, name, sizeof(gTrainers[i].trainerName)))
+            TRY_NAME(name, sizeof(gTrainers[i].trainerName))
+    }
+    for (i = 0; (name = HanSyl_PlaceName(i)) != NULL; i++)
+    {
+        if (name[0] == first)
+            TRY_NAME(name, 0xFF)
+    }
+    for (name = sHanSylExtraNames; *name != EOS;)
+    {
+        TRY_NAME(name, 0xFF)
+        while (*name++ != EOS)
+            ;
+    }
+#undef TRY_NAME
+    return best;
+}
+
+// TRUE, once, when a proper name starts at s: the asterisk is drawn now and the printer comes back to s.
+static bool8 HanSyl_NameStartsAt(const u8 *s)
+{
+    u32 length;
+
+    if (s == sHanSylNamePending)
+    {
+        sHanSylNamePending = NULL;
+        return FALSE;
+    }
+    if (s == sHanSylWordEnd || (s > sHanSylNameBegin && s < sHanSylNameEnd) || !HanSyl_IsLetter(*s))
+        return FALSE;
+    length = HanSyl_NameLength(s);
+    if (length == 0)
+        return FALSE;
+    sHanSylNamePending = s;
+    sHanSylNameBegin = s;
+    sHanSylNameEnd = s + length;
+    return TRUE;
+}
+
+// ---------------------------------------------------------------------------
+// Hän build: in syllabics an English word is spelled by its sound
+// ---------------------------------------------------------------------------
+// The table of words is made when the game is built. How a word is found in it is in han_english_core.h.
+
+#include "data/han_english_sounds.h"
+#include "han_english_core.h"
+
+// A syllable with marks is one picture: the marks sit on top of it, in the same cell.
+static void DecompressGlyph_HanSyllabics(u16 glyph, u8 marks)
+{
+    const u16 *glyphs = sFontHanSyllabicsGlyphs + (0x20 * HAN_SYL_CELL(glyph, marks));
+
+    DecompressGlyphTile(glyphs, (u16 *)gGlyphInfo.pixels);
+    DecompressGlyphTile(glyphs + 0x8, (u16 *)(gGlyphInfo.pixels + 0x20));
+    DecompressGlyphTile(glyphs + 0x10, (u16 *)(gGlyphInfo.pixels + 0x40));
+    DecompressGlyphTile(glyphs + 0x18, (u16 *)(gGlyphInfo.pixels + 0x60));
+    gGlyphInfo.width = sHanSylGlyphWidths[glyph];
+    gGlyphInfo.height = HAN_SYL_GLYPH_HEIGHT;
+}
+
+// Draws the piece of text that starts at the character RenderText has just read, as syllabics.
+// FALSE: it is not a letter that turns into syllabics, and RenderText draws it the usual way.
+// The asterisk of a proper name is drawn on a visit of its own: the printer then comes back
+// to the same character. So is each glyph of an English word.
+static bool8 RenderHanSyllabics(struct TextPrinter *textPrinter, u16 *result)
+{
+    const u8 *start = textPrinter->printerTemplate.currentChar - 1;
+    struct HanEngWord word;
+    u16 glyph;
+    u8 used, marks;
+    s32 width;
+
+    if (start != sHanEngStart && HanSyl_NameStartsAt(start))
+    {
+        DecompressGlyph_HanSyllabics(HAN_SYL_ASTERISK, 0);
+        textPrinter->printerTemplate.currentChar = start;
+    }
+    else if ((start == sHanEngStart || start != sHanSylWordEnd) && HanEng_Find(start, &word))
+    {
+        // An English word: one of its glyphs on each visit. The printer stays on the word's
+        // first letter until the last one is drawn.
+        if (start != sHanEngStart || sHanEngIndex >= word.total)
+        {
+            sHanEngStart = start;
+            sHanEngIndex = 0;
+        }
+        glyph = HanEng_Glyph(&word, sHanEngIndex++);
+        DecompressGlyph_HanSyllabics(glyph & HAN_ENG_GLYPH_MASK, glyph >> HAN_ENG_GLYPH_BITS);
+        if (sHanEngIndex >= word.total)
+        {
+            sHanEngStart = NULL;
+            sHanSylWordEnd = start + word.length;
+            textPrinter->printerTemplate.currentChar = start + word.length;
+        }
+        else
+        {
+            textPrinter->printerTemplate.currentChar = start;
+        }
+    }
+    else
+    {
+        switch (HanSyl_Next(start, &glyph, &used, &marks))
+        {
+        case HAN_SYL_NONE:
+            if (HanSyl_IsLetter(*start))
+                sHanSylWordEnd = start + 1;
+            return FALSE;
+        case HAN_SYL_SKIP:
+            sHanSylWordEnd = start + used;
+            textPrinter->printerTemplate.currentChar = start + used;
+            *result = RENDER_REPEAT;
+            return TRUE;
+        }
+        sHanSylWordEnd = start + used;
+        DecompressGlyph_HanSyllabics(glyph, glyph < HAN_SYL_FINALS_BASE ? marks : 0);
+        textPrinter->printerTemplate.currentChar = start + used;
+    }
+
+    CopyGlyphToWindow(textPrinter);
+    textPrinter->printerTemplate.currentX += gGlyphInfo.width;
+    if (textPrinter->minLetterSpacing)
+    {
+        width = textPrinter->minLetterSpacing - gGlyphInfo.width;
+        if (width > 0)
+        {
+            ClearTextSpan(textPrinter, width);
+            textPrinter->printerTemplate.currentX += width;
+        }
+    }
+    *result = RENDER_PRINT;
+    return TRUE;
+}
+
+// The width of the syllabics piece at *str. Leaves *str on its last character.
+// FALSE: it is not a letter that turns into syllabics, and the caller measures it the usual way.
+// Either way *width holds what this function has counted: with FALSE that is the asterisk
+// of a proper name that starts here, or nothing. Marks add no width.
+static bool8 HanSyllabicsWidth(const u8 **str, int *width, struct HanSylWalk *walk)
+{
+    const u8 *s = *str;
+    struct HanEngWord word;
+    u16 glyph;
+    u8 used, marks;
+    u8 type;
+    u32 i;
+
+    *width = 0;
+    if (s != walk->wordEnd && !(s < walk->nameEnd) && HanSyl_IsLetter(*s))
+    {
+        u32 length = HanSyl_NameLength(s);
+
+        if (length != 0)
+        {
+            *width = sHanSylGlyphWidths[HAN_SYL_ASTERISK];
+            walk->nameEnd = s + length;
+        }
+    }
+    if (s != walk->wordEnd && HanEng_Find(s, &word))
+    {
+        for (i = 0; i < word.total; i++)
+            *width += sHanSylGlyphWidths[HanEng_Glyph(&word, i) & HAN_ENG_GLYPH_MASK];
+        walk->wordEnd = s + word.length;
+        *str += word.length - 1;
+        return TRUE;
+    }
+    type = HanSyl_Next(s, &glyph, &used, &marks);
+    if (type == HAN_SYL_NONE)
+    {
+        if (HanSyl_IsLetter(*s))
+            walk->wordEnd = s + 1;
+        return FALSE;
+    }
+    walk->wordEnd = s + used;
+    *str += used - 1;
+    if (type == HAN_SYL_GLYPH)
+        *width += sHanSylGlyphWidths[glyph];
+    return TRUE;
+}
