+def write_tool(path, groups, rules, fixes=()):
+    rows = [g for g in groups.values() if is_translatable(g.english)]
+    order = {g.key: i for i, g in enumerate(sorted(rows, key=lambda g: g.rank))}
+    sections, families = [], []
+
+    def index(table, value):
+        if value not in table:
+            table.append(value)
+        return table.index(value)
+    data_rows = []
+    for g in rows:
+        limits = [u.limit for u in g.units if u.limit is not None]
+        # only rule rows: the page works out copies of identical English itself, as it is typed
+        now = g.final if g.final and g.source == "rule" else ""
+        places = "; ".join(u.where for u in g.units[:3]) + (" and %d more" % (len(g.units) - 3) if len(g.units) > 3 else "")
+        data_rows.append([g.english, index(sections, g.section), index(families, g.family), len(g.units), places,
+                          min(limits) if limits else None, tier_of(g), order[g.key], now, g.han or "",
+                          1 if in_plan(g) else 0])
+    data = {"sections": sections, "families": families, "rows": data_rows, "rules": [[k, v] for k, v in rules.items()],
+            "fixes": list(fixes), "english": sorted(english_words(groups))}
+    template = (Path(__file__).parent / "translator_template.html").read_text(encoding="utf-8")
+    blob = json.dumps(data, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
+    Path(path).write_text(template.replace("/*DATA*/", blob), encoding="utf-8")
+    return len(data_rows)
