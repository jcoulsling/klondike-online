+// ---------------------------------------------------------------------------
+// Hän build: Nuzlocke mode.
+//
+// Rules, when FLAG_NUZLOCKE is set:
+//  1. A Pokémon that faints is dead. It is marked, and from then on nothing
+//     heals or revives it: not a Pokémon Center, not an item, not the PC.
+//  2. Only the first wild Pokémon met in each area can be caught.
+//  3. If the whole party is dead, the run is over: the mode switches itself
+//     off and everything is healed, so the game can never get stuck.
+//
+// The "dead" mark is one of the four unused ribbon bits every Pokémon has. It
+// travels with the Pokémon into the PC and back.
+// ---------------------------------------------------------------------------
+bool8 Nuzlocke_IsOn(void)
+{
+    return FlagGet(FLAG_NUZLOCKE);
+}
+
+bool8 Nuzlocke_IsDead(struct Pokemon *mon)
+{
+    return GetMonData(mon, MON_DATA_UNUSED_RIBBONS) & 1;
+}
+
+static bool8 IsPlayerPartyMon(struct Pokemon *mon)
+{
+    return mon >= &gPlayerParty[0] && mon < &gPlayerParty[PARTY_SIZE];
+}
+
+static bool8 IsRealMon(struct Pokemon *mon)
+{
+    return GetMonData(mon, MON_DATA_SPECIES) != SPECIES_NONE && !GetMonData(mon, MON_DATA_IS_EGG);
+}
+
+// TRUE if this Pokémon must stay fainted. Marks it dead if it has just fainted.
+bool8 Nuzlocke_BlocksHealing(struct Pokemon *mon)
+{
+    u8 mark;
+
+    if (!Nuzlocke_IsOn() || !IsPlayerPartyMon(mon) || !IsRealMon(mon))
+        return FALSE;
+    if (Nuzlocke_IsDead(mon))
+        return TRUE;
+    if (GetMonData(mon, MON_DATA_HP) == 0)
+    {
+        mark = GetMonData(mon, MON_DATA_UNUSED_RIBBONS) | 1;
+        SetMonData(mon, MON_DATA_UNUSED_RIBBONS, &mark);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// Switches the mode off and forgets who was dead.
+void Nuzlocke_End(void)
+{
+    u8 i, box, pos, mark;
+
+    FlagClear(FLAG_NUZLOCKE);
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE)
+        {
+            mark = GetMonData(&gPlayerParty[i], MON_DATA_UNUSED_RIBBONS) & ~1;
+            SetMonData(&gPlayerParty[i], MON_DATA_UNUSED_RIBBONS, &mark);
+        }
+    }
+    for (box = 0; box < TOTAL_BOXES_COUNT; box++)
+    {
+        for (pos = 0; pos < IN_BOX_COUNT; pos++)
+        {
+            if (GetBoxMonDataAt(box, pos, MON_DATA_SPECIES) != SPECIES_NONE)
+            {
+                mark = GetBoxMonDataAt(box, pos, MON_DATA_UNUSED_RIBBONS) & ~1;
+                SetBoxMonData(GetBoxedMonPtr(box, pos), MON_DATA_UNUSED_RIBBONS, &mark);
+            }
+        }
+    }
+}
+
+// After a battle: whoever fainted is dead.
+void Nuzlocke_AfterBattle(void)
+{
+    u8 i;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        Nuzlocke_BlocksHealing(&gPlayerParty[i]);
+}
+
+// For a battle that does not count (the first rival battle): whoever fainted
+// in it is not dead. Without this the heal that follows would mark it dead.
+void Nuzlocke_SpareFainted(void)
+{
+    u8 i;
+    u16 hp = 1;
+
+    if (!Nuzlocke_IsOn())
+        return;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (IsRealMon(&gPlayerParty[i]) && !Nuzlocke_IsDead(&gPlayerParty[i])
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP) == 0)
+            SetMonData(&gPlayerParty[i], MON_DATA_HP, &hp);
+    }
+}
+
+// At the start of a wild battle: is this the first encounter in this area?
+void Nuzlocke_OnWildBattleStart(void)
+{
+    u16 area = gMapHeader.regionMapSectionId;
+    u16 flag;
+
+    FlagSet(FLAG_NUZLOCKE_CAN_CATCH);
+    if (!Nuzlocke_IsOn() || area < KANTO_MAPSEC_START || area >= MAPSEC_NONE)
+        return;
+    flag = FLAG_NUZLOCKE_AREAS_START + (area - KANTO_MAPSEC_START);
+    if (FlagGet(flag))
+        FlagClear(FLAG_NUZLOCKE_CAN_CATCH);
+    else
+        FlagSet(flag);
+}
+
+bool8 Nuzlocke_CanCatch(void)
+{
+    return !Nuzlocke_IsOn() || FlagGet(FLAG_NUZLOCKE_CAN_CATCH);
+}
+
+static bool8 Nuzlocke_WholePartyDead(void)
+{
+    u8 i;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (IsRealMon(&gPlayerParty[i]) && !Nuzlocke_BlocksHealing(&gPlayerParty[i]))
+            return FALSE;
+    }
+    return TRUE;
+}
