+#!/usr/bin/env python3
+"""Swap Professor Oak's first lines for a chart of every Hän glyph, or put them back.
+
+    python3 tools/han/glyph_chart.py on     then  make
+    python3 tools/han/glyph_chart.py off    then  make
+
+Start a new game to see the chart. It is a test card of letters, not words.
+"""
+import sys
+from pathlib import Path
+
+PATH = Path(__file__).resolve().parents[2] / "data" / "text" / "new_game_intro.inc"
+STOCK = ('    .string "Hello, there!\\n"\n'
+         '    .string "Glad to meet you!\\p"\n')
+CHART = ('    .string "ą ą̀ ä̀ ą̈ ą̈̀ ę ę̀ ë̀ ę̈ ę̈̀ a à ä\\n"\n'
+         '    .string "ǫ ǫ̀ ö̀ ǫ̈ ǫ̈̀ į į̀ ų ų̀ ł ǹ * o ò ö\\p"\n'
+         '    .string "Ą Ą̀ Ä̀ Ą̈ Ą̈̀ Ę Ę̀ Ë̀ Ę̈ Ę̈̀ A À Ä\\n"\n'
+         '    .string "Ǫ Ǫ̀ Ö̀ Ǫ̈ Ǫ̈̀ Į Į̀ Ų Ų̀ Ł Ǹ O Ò Ö\\p"\n'
+         '    .string "e è ë i ì u ù E È Ë I Ì U Ù ’\\n"\n'
+         '    .string "aąa eęe iįi oǫo uųu lłl nǹn\\p"\n')
+
+def main():
+    mode = sys.argv[1] if len(sys.argv) > 1 else ""
+    text = PATH.read_text(encoding="utf-8")
+    if mode == "on" and STOCK in text:
+        text = text.replace(STOCK, CHART)
+    elif mode == "off" and CHART in text:
+        text = text.replace(CHART, STOCK)
+    elif mode not in ("on", "off"):
+        sys.exit(__doc__)
+    PATH.write_text(text, encoding="utf-8")
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/han/han_animalese.py b/tools/han/han_animalese.py
new file mode 100644
index 0000000..b06642d
--- /dev/null
+++ b/tools/han/han_animalese.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Cut the 26 letter sounds of animalese.js into samples the game can play, and turn them up.
+
+    python3 tools/han/han_animalese.py PATH/TO/animalese.wav
+
+The sound library is animalese.wav from https://github.com/Acedio/animalese.js
+(c) 2014 Josh Simmons, licence CC BY 4.0, https://creativecommons.org/licenses/by/4.0/
+It is 26 letters, A to Z, 0.15 seconds each, 44100 Hz, 8 bit, one channel.
+
+Changes made here, three of them:
+1. Each letter is cut out on its own.
+2. It is resampled to 13379 Hz, the rate the game mixes sound at.
+3. It is turned up until its loudest point is full scale (127 of 128). The letters
+   of the library are very uneven: O is already full scale and needs nothing, M is
+   turned up 6.9 times. It is one gain for the whole letter, so the shape of the
+   sound is the same. Pitch and speed are not changed.
+Letters that are almost silent in the library (F, S, T, V, X and Z: after
+resampling, and before turning up, the loudest point is under 16 of 128) are left
+out. Turned up to full scale they would be mostly the hiss of the 8 bit recording.
+The results are sound/direct_sound_samples/animalese_a.wav and so on, 20 files.
+They are kept in the repository, so this script is only needed to make them again.
+"""
+import math
+import os
+import sys
+import wave
+
+import numpy as np
+
+LIBRARY_RATE = 44100
+LETTER_SECONDS = 0.15          # library_letter_secs in animalese.js
+GAME_RATE = 13379
+QUIET = 16                     # letters whose loudest point is below this (of 128) are left out
+FULL_SCALE = 127               # every letter kept is turned up until its loudest point is this
+TAPS = 24                      # half width of the resampling filter, in input samples at the cutoff
+OUT_DIR = os.path.join(os.path.dirname(__file__), '..', '..', 'sound', 'direct_sound_samples')
+
+
+def resample(x, rate_in, rate_out):
+    """Windowed sinc resampling with a low pass at the new Nyquist rate."""
+    ratio = rate_out / rate_in
+    cutoff = min(1.0, ratio) * 0.95
+    half = TAPS / cutoff
+    n_out = int(round(len(x) * ratio))
+    out = np.zeros(n_out)
+    for n in range(n_out):
+        centre = n / ratio
+        lo = max(0, int(math.ceil(centre - half)))
+        hi = min(len(x) - 1, int(math.floor(centre + half)))
+        k = np.arange(lo, hi + 1)
+        t = k - centre
+        h = cutoff * np.sinc(cutoff * t) * (0.5 + 0.5 * np.cos(np.pi * t / half))
+        out[n] = float(np.dot(x[lo:hi + 1], h))
+    return out
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    with wave.open(sys.argv[1]) as w:
+        if (w.getnchannels(), w.getsampwidth(), w.getframerate()) != (1, 1, LIBRARY_RATE):
+            sys.exit('expected the animalese.wav of animalese.js: one channel, 8 bit, 44100 Hz')
+        library = np.frombuffer(w.readframes(w.getnframes()), dtype=np.uint8).astype(float) - 128.0
+    per_letter = int(math.floor(LETTER_SECONDS * LIBRARY_RATE))
+    if len(library) < 26 * per_letter:
+        sys.exit('the file is too short for 26 letters')
+    kept, left_out = [], []
+    for i in range(26):
+        name = chr(ord('a') + i)
+        letter = library[i * per_letter:(i + 1) * per_letter]
+        sound = resample(letter, LIBRARY_RATE, GAME_RATE)
+        loudest = np.abs(sound).max()
+        if np.round(loudest) < QUIET:
+            left_out.append(name)
+            continue
+        kept.append('%s x%.2f' % (name, FULL_SCALE / loudest))
+        sound = np.round(sound * (FULL_SCALE / loudest))     # turned up before rounding to 8 bit
+        out = np.clip(sound + 128.0, 0, 255).astype(np.uint8)
+        path = os.path.join(OUT_DIR, 'animalese_%s.wav' % name)
+        with wave.open(path, 'wb') as o:
+            o.setnchannels(1)
+            o.setsampwidth(1)
+            o.setframerate(GAME_RATE)
+            o.writeframes(out.tobytes())
+    print('wrote %d letters, %d samples each, to %s' % (len(kept), len(out), os.path.normpath(OUT_DIR)))
+    print('turned up by: %s' % ', '.join(kept))
+    print('left out as too quiet: %s' % ''.join(left_out))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/han/han_emerald.py b/tools/han/han_emerald.py
new file mode 100644
index 0000000..ab61ee7
--- /dev/null
+++ b/tools/han/han_emerald.py
@@ -0,0 +1,277 @@
+#!/usr/bin/env python3
+"""Brings the Pokémon pictures and animations of Pokémon Emerald into the build.
+
+    python3 tools/han/han_emerald.py [PATH/TO/pokeemerald]
+
+Jane asked for the sprites and animations from Emerald. In Emerald a Pokémon's
+front picture has two frames, and each Pokémon moves in its own way when it
+comes out: it squashes, hops, shakes, glows. This script takes what that needs
+from a copy of the pokeemerald source (https://github.com/pret/pokeemerald)
+and writes it into this source tree. Nothing it writes is in the patch or in
+git: every file below is made again at each build.
+
+Without a path it looks at the POKEEMERALD environment variable, then for a
+folder named pokeemerald next to this one. `make` and han_text.py run it.
+The pictures were checked against pokeemerald at the commit in COMMIT.
+
+What it writes:
+
+  graphics/pokemon/NAME/emerald_front.png    Emerald's front picture, two frames (64 by 128)
+  graphics/pokemon/NAME/emerald_back.png     Emerald's back picture
+  graphics/pokemon/NAME/emerald_normal.pal   Emerald's colours
+  graphics/pokemon/NAME/emerald_shiny.pal
+  src/data/graphics/pokemon_emerald.h        FireRed's list of picture files, pointing at the files above
+  src/data/pokemon_graphics/emerald_front_pic_coordinates.h   where each picture stands
+  src/data/pokemon_graphics/emerald_back_pic_coordinates.h
+  src/data/pokemon_graphics/emerald_enemy_mon_elevation.h     how high a flying foe floats
+  src/data/pokemon_graphics/emerald_front_pic_anims.h         which frame shows when
+  src/data/pokemon_graphics/emerald_anim_tables.h             which way each Pokémon moves, and after how long
+  include/pokemon_animation.h                the names of the ways of moving
+  src/pokemon_animation.c                    the code that moves a picture, from Emerald, with the changes in CODE_CHANGES
+  graphics/object_events/pics/people/emerald_twin.png    the little picture of Emerald's TWIN, for the twins on the maps
+  graphics/object_events/palettes/emerald_twin.pal       the colours Emerald gives that picture
+  graphics/trainers/front_pics/emerald_steven_front_pic.png   Emerald's STEVEN, for BRANDON in a battle
+  graphics/object_events/pics/people/emerald_steven.png       and on the map
+  graphics/object_events/palettes/emerald_steven.pal
+  graphics/pokemon/pikachu/emerald_front_female.png    a female PIKACHU, with a heart-shaped tail: see HEART_TAIL
+  graphics/pokemon/pikachu/emerald_back_female.png
+
+FireRed's own pictures stay for DEOXYS and CASTFORM. FireRed shows their forms
+with its own picture layout, which Emerald's pictures do not fit. The ghost of
+POKéMON TOWER and CHAMPION JANE's three UNOWN are not in Emerald at all.
+"""
+import os
+import re
+import shutil
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+COMMIT = "9103e529c2fbdd7add4a1ff3350c6c1f92112c42"      # pokeemerald, 14 November 2026
+KEEP_FIRERED = {"deoxys", "castform"}                    # picture folders that keep FireRed's own pictures
+PICTURES = ROOT / "src/data/graphics/pokemon.h"
+KINDS = {"front.4bpp.lz": ("anim_front.png", "emerald_front.png", "emerald_front.4bpp.lz"),
+         "back.4bpp.lz": ("back.png", "emerald_back.png", "emerald_back.4bpp.lz"),
+         "normal.gbapal.lz": ("normal.pal", "emerald_normal.pal", "emerald_normal.gbapal.lz"),
+         "shiny.gbapal.lz": ("shiny.pal", "emerald_shiny.pal", "emerald_shiny.gbapal.lz")}
+LINE = re.compile(r'^const u32 (\w+)\[\] = INCBIN_U32\("graphics/pokemon/(.+)/(front\.4bpp\.lz|back\.4bpp\.lz|normal\.gbapal\.lz|shiny\.gbapal\.lz)"\);$')
+
+# Changes to Emerald's src/pokemon_animation.c so that it compiles here. Each is (old text, new text)
+# and must be found in the file, so a change in Emerald's file is noticed.
+CODE_CHANGES = [
+]
+
+
+def find_emerald(argv):
+    places = [a for a in argv[1:] if not a.startswith("--")][:1]
+    if os.environ.get("POKEEMERALD"):
+        places.append(os.environ["POKEEMERALD"])
+    places += [ROOT.parent / "pokeemerald", ROOT.parent.parent / "pokeemerald"]
+    for place in places:
+        if (Path(place) / "src/pokemon_animation.c").exists():
+            return Path(place)
+    sys.exit("han_emerald.py: no copy of the pokeemerald source found.\n"
+             "Get one next to this folder:\n"
+             "    git clone https://github.com/pret/pokeemerald ../pokeemerald\n"
+             "    git -C ../pokeemerald checkout %s\n"
+             "or give its path: python3 tools/han/han_emerald.py PATH, or set POKEEMERALD." % COMMIT)
+
+
+def put(path, data):
+    """Write a file only when it changes, so make does not build it again for nothing."""
+    path = Path(path)
+    data = data if isinstance(data, bytes) else data.encode("utf-8")
+    if not path.exists() or path.read_bytes() != data:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data)
+        return True
+    return False
+
+
+def read(path):
+    return Path(path).read_text(encoding="utf-8-sig")
+
+
+def pictures(emerald):
+    """Copies the pictures and writes the list of picture files. Returns the folders that take Emerald's pictures."""
+    out, taken, copied = [], set(), 0
+    for line in read(PICTURES).splitlines():
+        m = LINE.match(line)
+        if m:
+            name, folder, kind = m.groups()
+            theirs, mine, built = KINDS[kind]
+            front = emerald / "graphics/pokemon" / folder / "anim_front.png"
+            # a palette is shared by a folder's subfolders (the UNOWN letters): take it when any of them is taken
+            whole = front.exists() or any((emerald / "graphics/pokemon" / folder).glob("*/anim_front.png"))
+            source = emerald / "graphics/pokemon" / folder / theirs
+            if whole and source.exists() and folder.split("/")[0] not in KEEP_FIRERED:
+                copied += put(ROOT / "graphics/pokemon" / folder / mine, source.read_bytes())
+                line = 'const u32 %s[] = INCBIN_U32("graphics/pokemon/%s/%s");' % (name, folder, built)
+                if kind == "front.4bpp.lz":
+                    taken.add(name)
+        out.append(line)
+    head = ["// Made by tools/han/han_emerald.py from data/graphics/pokemon.h. Do not edit.",
+            "// The same list, with the Pokémon pictures of Emerald where Emerald has them.", ""]
+    put(ROOT / "src/data/graphics/pokemon_emerald.h", "\n".join(head + out) + "\n")
+    return taken, copied
+
+
+def species_with_emerald(taken):
+    """SPECIES names whose front picture is now Emerald's."""
+    table = read(ROOT / "src/data/pokemon_graphics/front_pic_table.h")
+    return {m.group(1) for m in re.finditer(r"SPECIES_SPRITE\((\w+),\s*(\w+)\)", table) if m.group(2) in taken}, \
+           [m.group(1) for m in re.finditer(r"SPECIES_SPRITE\((\w+),\s*(\w+)\)", table)]
+
+
+COORD = re.compile(r"\[SPECIES_(\w+)\]\s*=\s*\{\s*\.size\s*=\s*MON_COORDS_SIZE\((\d+),\s*(\d+)\),\s*\.y_offset\s*=\s*(\d+),?\s*\}", re.S)
+
+
+def coordinates(emerald, name, table, use):
+    mine = {m.group(1): m.groups()[1:] for m in COORD.finditer(read(ROOT / "src/data/pokemon_graphics" / name))}
+    theirs = {m.group(1): m.groups()[1:] for m in COORD.finditer(read(emerald / "src/data/pokemon_graphics" / name))}
+    order = [m.group(1) for m in COORD.finditer(read(ROOT / "src/data/pokemon_graphics" / name))]
+    lines = ["// Made by tools/han/han_emerald.py. Do not edit.",
+             "// Where each picture stands: Emerald's numbers for Emerald's pictures, FireRed's for the rest.",
+             "const struct MonCoords %s[] =" % table, "{"]
+    for species in order:
+        w, h, y = theirs[species] if species in use and species in theirs else mine[species]
+        lines.append("    [SPECIES_%s] = { .size = MON_COORDS_SIZE(%s, %s), .y_offset = %s }," % (species, w, h, y))
+    lines.append("};")
+    put(ROOT / "src/data/pokemon_graphics" / ("emerald_" + name), "\n".join(lines) + "\n")
+
+
+def elevation(emerald, use):
+    one = re.compile(r"\[SPECIES_(\w+)\]\s*=\s*(\d+)")
+    mine = dict(one.findall(read(ROOT / "src/data/pokemon_graphics/enemy_mon_elevation.h")))
+    theirs = dict(one.findall(read(emerald / "src/data/pokemon_graphics/enemy_mon_elevation.h")))
+    lines = ["// Made by tools/han/han_emerald.py. Do not edit.",
+             "// How high above the ground a foe floats: Emerald's numbers for Emerald's pictures.",
+             "const u8 gEnemyMonElevation[NUM_SPECIES] =", "{"]
+    for species in sorted(set(mine) | set(theirs)):
+        value = theirs.get(species, "0") if species in use else mine.get(species, "0")
+        if value != "0":
+            lines.append("    [SPECIES_%s] = %s," % (species, value))
+    lines.append("};")
+    put(ROOT / "src/data/pokemon_graphics/emerald_enemy_mon_elevation.h", "\n".join(lines) + "\n")
+
+
+def tables(emerald):
+    source = read(emerald / "src/pokemon.c")
+    out = ["// Made by tools/han/han_emerald.py from Emerald's src/pokemon.c. Do not edit.",
+           "// Which way each Pokémon moves when it comes out, and how many frames it waits first.", ""]
+    for name in ("sMonFrontAnimIdsTable", "sMonAnimationDelayTable"):
+        m = re.search(r"static const u8 %s\[NUM_SPECIES - 1\] =\n\{.*?\n\};\n" % name, source, re.S)
+        if not m:
+            sys.exit("han_emerald.py: %s is not in Emerald's src/pokemon.c as expected" % name)
+        out.append(m.group(0))
+    put(ROOT / "src/data/pokemon_graphics/emerald_anim_tables.h", "\n".join(out))
+    put(ROOT / "src/data/pokemon_graphics/emerald_front_pic_anims.h",
+        "// Made by tools/han/han_emerald.py: Emerald's src/data/pokemon_graphics/front_pic_anims.h. Do not edit.\n"
+        + read(emerald / "src/data/pokemon_graphics/front_pic_anims.h"))
+    # FireRed already has a few of the BACK_ANIM names, with the same numbers written another way
+    header = re.sub(r"^#define (BACK_ANIM_\w+)", r"#undef \1\n#define \1", read(emerald / "include/pokemon_animation.h"), flags=re.M)
+    put(ROOT / "include/pokemon_animation.h",
+        "// Made by tools/han/han_emerald.py: Emerald's include/pokemon_animation.h. Do not edit.\n" + header)
+
+
+def code(emerald):
+    source = read(emerald / "src/pokemon_animation.c")
+    for old, new in CODE_CHANGES:
+        if old not in source:
+            sys.exit("han_emerald.py: Emerald's src/pokemon_animation.c no longer has this text:\n%s" % old)
+        source = source.replace(old, new)
+    put(ROOT / "src/pokemon_animation.c",
+        "// Made by tools/han/han_emerald.py: Emerald's src/pokemon_animation.c with the changes listed there. Do not edit.\n" + source)
+
+
+def twin(emerald):
+    """Copies the little picture of Emerald's TWIN and its colours. Jane asked for it on 17 November 2026: the
+    twins who stand where GIOVANNI stood are two of these. The picture has the same nine frames, 16 by 32, as
+    FireRed's people, so it goes in as it is."""
+    n = put(ROOT / "graphics/object_events/pics/people/emerald_twin.png",
+            (emerald / "graphics/object_events/pics/people/twin.png").read_bytes())
+    n += put(ROOT / "graphics/object_events/palettes/emerald_twin.pal",
+             (emerald / "graphics/object_events/palettes/npc_2.pal").read_bytes())
+    return n
+
+
+def steven(emerald):
+    """Copies Emerald's STEVEN: the big picture for a battle, the little one for the map and its colours.
+    Jane asked for BRANDON, who stands where KOGA stood, to have STEVEN's sprite (17 November 2026)."""
+    n = put(ROOT / "graphics/trainers/front_pics/emerald_steven_front_pic.png",
+            (emerald / "graphics/trainers/front_pics/steven.png").read_bytes())
+    n += put(ROOT / "graphics/object_events/pics/people/emerald_steven.png",
+             (emerald / "graphics/object_events/pics/people/steven.png").read_bytes())
+    n += put(ROOT / "graphics/object_events/palettes/emerald_steven.pal",
+             (emerald / "graphics/object_events/palettes/npc_4.pal").read_bytes())
+    return n
+
+
+# Jane asked for a female PIKACHU to have the heart-shaped tail it has in later games (17 November 2026).
+# Emerald has no such picture, so it is made here from Emerald's own PIKACHU: a small notch is cut into the
+# end of the tail. Each entry is (x, y, the colour number there now, the colour number to put). 0 is see-through.
+# The script stops if a pixel is not what it expects, so a different PIKACHU picture is never spoiled.
+HEART_TAIL = {
+    "anim_front.png": ("emerald_front_female.png", [
+        # first frame: the end of the tail is the edge at x = 53
+        (53, 23, 6, 0), (52, 23, 4, 6),
+        (53, 24, 6, 0), (52, 24, 4, 0), (51, 24, 4, 6),
+        (53, 25, 6, 0), (52, 25, 4, 0), (51, 25, 4, 0), (50, 25, 4, 6),
+        (53, 26, 6, 0), (52, 26, 4, 0), (51, 26, 4, 6),
+        (53, 27, 6, 0), (52, 27, 4, 6),
+        # second frame: the edge at x = 56
+        (56, 96, 6, 0), (55, 96, 4, 6),
+        (56, 97, 6, 0), (55, 97, 4, 0), (54, 97, 4, 6),
+        (56, 98, 6, 0), (55, 98, 4, 0), (54, 98, 4, 0), (53, 98, 4, 6),
+        (56, 99, 6, 0), (55, 99, 4, 0), (54, 99, 4, 6),
+        (56, 100, 6, 0), (55, 100, 4, 6)]),
+    "back.png": ("emerald_back_female.png", [
+        # seen from behind the tail points left: its end is the edge at x = 6 and 7
+        (6, 33, 5, 0), (7, 33, 2, 5),
+        (6, 34, 5, 0), (7, 34, 2, 0), (8, 34, 2, 5),
+        (7, 35, 4, 0), (8, 35, 2, 0), (9, 35, 3, 0), (10, 35, 3, 5),
+        (7, 36, 5, 0), (8, 36, 2, 0), (9, 36, 3, 5),
+        (7, 37, 5, 0), (8, 37, 2, 5)]),
+}
+
+
+def heart_tail(emerald):
+    """Writes the two pictures of the female PIKACHU. Returns how many files changed."""
+    import io
+    from PIL import Image
+    n = 0
+    for theirs, (mine, pixels) in HEART_TAIL.items():
+        picture = Image.open(emerald / "graphics/pokemon/pikachu" / theirs)
+        for x, y, now, new in pixels:
+            if picture.getpixel((x, y)) != now:
+                sys.exit("han_emerald.py: %s is not the PIKACHU picture the heart tail was made for (pixel %d, %d)." % (theirs, x, y))
+            picture.putpixel((x, y), new)
+        out = io.BytesIO()
+        picture.save(out, format="PNG")
+        n += put(ROOT / "graphics/pokemon/pikachu" / mine, out.getvalue())
+    return n
+
+
+def main(argv):
+    emerald = find_emerald(argv)
+    taken, copied = pictures(emerald)
+    copied += twin(emerald) + steven(emerald) + heart_tail(emerald)
+    use, everyone = species_with_emerald(taken)
+    coordinates(emerald, "front_pic_coordinates.h", "gMonFrontPicCoords", use)
+    coordinates(emerald, "back_pic_coordinates.h", "gMonBackPicCoords", use)
+    elevation(emerald, use)
+    tables(emerald)
+    code(emerald)
+    kept = sorted(s for s in set(everyone) - use)
+    if "--touch" in argv:       # `make` runs this when the script is newer than the list: now the list is newer
+        (ROOT / "src/data/graphics/pokemon_emerald.h").touch()
+    print("han_emerald.py: Emerald's pictures for %d Pokémon (%d files new or changed). FireRed's own stay for: %s"
+          % (len(use), copied, ", ".join(kept) or "none"))
+    import han_sylveon
+    han_sylveon.main(["han_sylveon.py"])    # MANDI's SYLVEON: its pictures
+    import han_klondike
+    han_klondike.main(["han_klondike.py"])  # the title screen: KLONDIKE VERSION and the UNOWN D
+
+
+if __name__ == "__main__":
+    main(sys.argv)
