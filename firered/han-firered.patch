@@ -0,0 +1,240 @@
+#!/usr/bin/env python3
+"""Hän type labels for pokefirered.
+
+The coloured type labels on the summary screen, TM case and move tutor are
+pictures, not text. This redraws them from the type names in the workbook.
+
+Each label is 32 x 12 pixels. A name is drawn in capitals, in the large
+lettering the game uses when it fits, and in a smaller lettering when it is
+long. Types with no Hän name keep the game's own label.
+
+han_text.py calls this during a build. To look at the labels without building:
+    python3 tools/han/han_labels.py preview OUT.png "TYPE_FIRE=Kwän" "TYPE_WATER=Chu"
+"""
+import re
+import sys
+import unicodedata
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+SHEET = "graphics/interface/menu_info.png"
+INK, SHADOW = 31, 30                     # palette indices used by the stock labels
+GRAVE, DIAERESIS, OGONEK = "̀", "̈", "̨"
+
+# ---------------------------------------------------------------------------
+# Two alphabets. Rows run top to bottom, "#" is ink.
+# ---------------------------------------------------------------------------
+BIG = {  # 7 rows tall, like the game's own labels
+    "A": [".##.", "#..#", "#..#", "####", "#..#", "#..#", "#..#"],
+    "B": ["###.", "#..#", "#..#", "###.", "#..#", "#..#", "###."],
+    "C": [".##.", "#..#", "#...", "#...", "#...", "#..#", ".##."],
+    "D": ["###.", "#..#", "#..#", "#..#", "#..#", "#..#", "###."],
+    "E": ["####", "#...", "#...", "###.", "#...", "#...", "####"],
+    "F": ["####", "#...", "#...", "###.", "#...", "#...", "#..."],
+    "G": [".##.", "#..#", "#...", "#.##", "#..#", "#..#", ".###"],
+    "H": ["#..#", "#..#", "#..#", "####", "#..#", "#..#", "#..#"],
+    "I": ["###", ".#.", ".#.", ".#.", ".#.", ".#.", "###"],
+    "J": ["..##", "...#", "...#", "...#", "...#", "#..#", ".##."],
+    "K": ["#..#", "#.#.", "##..", "##..", "#.#.", "#..#", "#..#"],
+    "L": ["#...", "#...", "#...", "#...", "#...", "#...", "####"],
+    "Ł": [".#..", ".#..", ".##.", "##..", ".#..", ".#..", ".###"],
+    "M": ["#...#", "##.##", "#.#.#", "#.#.#", "#...#", "#...#", "#...#"],
+    "N": ["#..#", "##.#", "##.#", "#.##", "#.##", "#..#", "#..#"],
+    "O": [".##.", "#..#", "#..#", "#..#", "#..#", "#..#", ".##."],
+    "P": ["###.", "#..#", "#..#", "###.", "#...", "#...", "#..."],
+    "Q": [".##.", "#..#", "#..#", "#..#", "#.##", "#..#", ".###"],
+    "R": ["###.", "#..#", "#..#", "###.", "#.#.", "#..#", "#..#"],
+    "S": [".###", "#...", "#...", ".##.", "...#", "...#", "###."],
+    "T": ["###", ".#.", ".#.", ".#.", ".#.", ".#.", ".#."],
+    "U": ["#..#", "#..#", "#..#", "#..#", "#..#", "#..#", ".##."],
+    "V": ["#...#", "#...#", "#...#", ".#.#.", ".#.#.", "..#..", "..#.."],
+    "W": ["#...#", "#...#", "#...#", "#.#.#", "#.#.#", "##.##", "#...#"],
