@@ -0,0 +1,268 @@
+#!/usr/bin/env python3
+"""Turns the list of English words spelled by sound into a table for the game.
+
+    python3 tools/han/han_english_table.py              keeps the words the table now leaves out
+    python3 tools/han/han_english_table.py --none       leaves no word out
+    python3 tools/han/han_english_table.py WORD ...     leaves these words out
+
+Reads tools/han/english_sounds.txt and writes src/data/han_english_sounds.h, which the
+game uses in syllabics to draw an English word by its sound (HanEng_Find in src/text.c).
+A word that is left out of the table is read by the game as Hän, letter by letter.
+
+han_text.py runs this at every build and leaves out the words that are Hän somewhere in
+the translated text (a word of Jane's that is spelled like an English word must not be
+read as the English one). `make` runs it when the table is not there yet, or when the
+list is newer than the table.
+
+NAME's is not in the list for every name. When the game does not find a word that ends
+in 's, it looks for the word without it and adds the sound of the 's itself. Which sound
+that is, is worked out here from the end of the word (possessive below) and kept with it.
+"""
+import re
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parent.parent
+SOUNDS = HERE / "english_sounds.txt"
+HEADER = ROOT / "src/data/han_english_sounds.h"
+sys.path.insert(0, str(HERE))
+
+
+def glyph_numbers():
+    """Syllable or final, as written in the list -> the number the game has for its glyph."""
+    import han_syllabics as S
+    rows = {name: i for i, (name, _) in enumerate(S.ROWS)}
+    finals = {}
+    for i, (name, _) in enumerate(S.FINALS):
+        finals.setdefault(name, i)
+    finals_base = len(S.ROWS) * len(S.VOWELS)
+
+    def number(piece):
+        if piece[-1] in S.VOWELS:
+            onset, column, marks = piece[:-1], S.VOWELS.index(piece[-1]), 0
+            if onset.endswith("y") and onset != "y" and onset[:-1] in rows:
+                onset, marks = onset[:-1], S.MARK_DOT
+            row = rows["V" if onset == "" else onset]
+            return (row * len(S.VOWELS) + column) | (marks << 9)
+        return finals_base + finals[piece]
+    return number
+
+
+# What 's adds to a word, by the last piece of the word's sound. Each line: how many pieces
+# the 's takes off the end, the syllable it puts there (or None), and the final it ends with.
+# English has s after p, t, k, f and th, iz after s, z, sh, ch and j, and z after anything else.
+# A final here stands for more than one English sound (t for t and d, b for p and b), so
+# after t, b, k and h (which is f) the 's is s.
+POSSESSIVE = [(0, None, "z"), (0, None, "s"), (1, "si", "z"), (1, "zi", "z"), (1, "shi", "z"), (2, "chi", "z")]
+COUNT_BITS = 5      # an entry's count byte: how many glyphs, and above that which line of POSSESSIVE
+
+
+def possessive(pieces):
+    """Which line of POSSESSIVE the word takes."""
+    import han_syllabics as S
+    last = pieces[-1]
+    if last[-1] in S.VOWELS:
+        return 0
+    if last in ("t", "b", "k", "h"):
+        return 1
+    if last == "s":
+        return 2
+    if last == "z":
+        return 3
+    if last == "sh":
+        return 5 if len(pieces) > 1 and pieces[-2] == "t" else 4
+    return 0
+
+
+WORD_RUN = re.compile("[A-Za-z\u00C0-\u024F\u0300-\u036F'’ʼ]+")
+PLAIN_RUN = re.compile("[A-Za-zéÉ'’ʼ]+")
+
+
+def words_of(text):
+    """The words of a text that the game would look up in the table, in small letters.
+
+    As HanEng_WordLength in src/text.c: a word is a run of letters and apostrophes that starts
+    with a letter, with the apostrophes at its end taken off, and all of it is plain a to z
+    (é counts as e). A word with any other letter in it is Hän and is not looked up. A word
+    next to a {PLACEHOLDER} is not counted: the game joins it to whatever the placeholder gives.
+    """
+    words = set()
+    text = re.sub(r"\{[^}]*\}", "\0", text)
+    for m in WORD_RUN.finditer(text):
+        run = m.group(0)
+        if "\0" in (text[m.start() - 1:m.start()], text[m.end():m.end() + 1]):
+            continue
+        if run[0] in "'’ʼ" or not PLAIN_RUN.fullmatch(run):
+            continue
+        word = run.rstrip("'’ʼ").lower().replace("é", "e").replace("’", "'").replace("ʼ", "'")
+        words.add(word)
+    return words
+
+
+PROSE_WORDS = 6         # a row of English has at least this many words,
+PROSE_SHARE = 0.75      # and at least this share of them are English words of the list
+
+
+def english_prose(text, vocabulary):
+    """TRUE if a row of the translation is written in English (the notice at the start of the game).
+
+    Jane's rows are Hän with English words in them here and there. A few rows are English
+    sentences. This tells the two apart by counting: a row is English when it has at least
+    PROSE_WORDS words and at least PROSE_SHARE of them are plain words that are in vocabulary.
+    """
+    runs = [r for r in WORD_RUN.findall(re.sub(r"\{[^}]*\}", " ", text)) if r.strip("'’ʼ")]
+    if len(runs) < PROSE_WORDS:
+        return False
+    english = sum(1 for r in runs if words_of(r) & vocabulary)
+    return english >= PROSE_SHARE * len(runs)
+
+
+def same_word(word, english):
+    """TRUE if an English word of the row is this word with another ending, or ends in it.
+
+    POKé BALL in a row whose English has BALLS, save where the English has saved, battle
+    where it has battling, badge where it has THUNDERBADGE. Words of three letters or
+    fewer are never matched this way.
+    """
+    if len(word) < 4:
+        return False
+    for e in english:
+        same = 0
+        while same < min(len(word), len(e)) and word[same] == e[same]:
+            same += 1
+        if same >= max(4, len(word) - 1) or e.endswith(word):
+            return True
+    return False
+
+
+def han_words(rows):
+    """The words of the list that are Hän words in the translated text.
+
+    rows: (the English, what the translation puts there) for every translated row and word rule.
+
+    The game cannot tell a Hän word from an English word that is spelled the same, so such
+    a word is taken out of the list and the game reads it as Hän everywhere. The rule is
+    made to err on that side: a Hän word must never be read as English.
+
+    A plain word in a translated row is taken to be English only when
+      - the English of that row has the same word (a name the translation keeps: POKéMON, TV),
+      - or the English of that row has it with another ending (same_word),
+      - or the whole row is written in English (english_prose).
+    Any other plain word in a translated row is Hän. Returns those that are in the list,
+    the rows found to be English, and the plain words of those rows that the list lacks.
+    """
+    table = set(read_sounds())
+    han, prose_rows, missing = set(), [], set()
+    for english, final in rows:
+        if english_prose(final, table):
+            prose_rows.append(final)
+            missing |= words_of(final) - table
+            continue
+        english = words_of(english)
+        for word in (words_of(final) & table) - english:
+            if not same_word(word, english):
+                han.add(word)
+    return han, prose_rows, missing
+
+
+def left_out_now():
+    """The words the table in the game's source leaves out now."""
+    if not HEADER.exists():
+        return set()
+    m = re.search(r"^// LEFT OUT: (.*)$", HEADER.read_text(encoding="utf-8"), re.M)
+    return set(m.group(1).split()) if m else set()
+
+
+def read_sounds():
+    words = {}
+    for n, line in enumerate(SOUNDS.read_text(encoding="utf-8").splitlines(), 1):
+        if not line.strip() or line.startswith("#"):
+            continue
+        parts = line.split("\t")
+        if len(parts) < 2:
+            sys.exit("%s line %d: a word, a tab, its sound" % (SOUNDS.name, n))
+        words[parts[0].strip().lower()] = parts[1].strip()
+    return words
+
+
+def key_of(word):
+    """The word as the game compares it: 1 to 26 for a to z, 28 for an apostrophe."""
+    out = []
+    for ch in word:
+        if ch == "'":
+            out.append(28)
+        elif "a" <= ch <= "z":
+            out.append(ord(ch) - ord("a") + 1)
+        else:
+            return None
+    return out
+
+
+def write(left_out=None):
+    """Writes the table. left_out: the words to leave out, or None to keep the ones left out now."""
+    import han_syllabics as S
+    number = glyph_numbers()
+    left_out = left_out_now() if left_out is None else {w.lower() for w in left_out}
+    entries = []
+    for word, sound in read_sounds().items():
+        key = key_of(word)
+        if key is None or word in left_out:
+            continue
+        pieces = sound.split(".")
+        try:
+            glyphs = [number(piece) for piece in pieces]
+        except (KeyError, ValueError, IndexError):
+            sys.exit("%s: the sound of %s has a piece the font does not have: %s" % (SOUNDS.name, word, sound))
+        if len(glyphs) >= 1 << COUNT_BITS:
+            sys.exit("%s: the sound of %s has more than %d pieces" % (SOUNDS.name, word, (1 << COUNT_BITS) - 1))
+        entries.append((key, glyphs, possessive(pieces)))
+    entries.sort()
+    data, offsets = [], []
+    for key, glyphs, kind in entries:
+        offsets.append(len(data))
+        data += key + [0, len(glyphs) | kind << COUNT_BITS]
+        for g in glyphs:
+            data += [g & 0xFF, g >> 8]
+    longest = max(len(k) for k, _, _ in entries)
+    h = ["// Made by tools/han/han_english_table.py from tools/han/english_sounds.txt. Do not edit.",
+         "// English words spelled by their sound, for the game's text in syllabics.",
+         "// %d words. The next line lists the words left out because they are Hän words in the translated text." % len(entries),
+         "// LEFT OUT: %s" % " ".join(sorted(left_out)),
+         "",
+         "#define HAN_ENG_WORD_COUNT %d" % len(entries),
+         "#define HAN_ENG_MAX_WORD   %d   // letters in the longest word" % longest,
+         "#define HAN_ENG_COUNT_BITS %d" % COUNT_BITS,
+         "#define HAN_ENG_GLYPH_BITS 9    // a glyph is its number, plus its marks times 512",
+         "#define HAN_ENG_NONE       0xFFFF",
+         "",
+         "// What 's adds to a word: how many glyphs it takes off the end, the syllable it puts there (or none),",
+         "// and the final it ends with. Which line a word takes is in its entry.",
+         "static const u16 sHanEngPossessive[][3] =\n{"]
+    for drop, syllable, final in POSSESSIVE:
+        h.append("    {%d, %s, %d}, // %s" % (drop, "HAN_ENG_NONE" if syllable is None else "%d" % number(syllable), number(final),
+                                         " ".join(x for x in (syllable, final) if x)))
+    h += ["};", "",
+          "// An entry: the word's letters (1 to 26 for a to z, 28 for an apostrophe), a 0, a count byte,",
+          "// then each glyph in two bytes, low byte first. The count byte is how many glyphs,",
+          "// plus 32 times the line of sHanEngPossessive.",
+          "static const u8 sHanEngData[] =\n{"]
+    for i in range(0, len(data), 24):
+        h.append("    " + ", ".join("%d" % v for v in data[i:i + 24]) + ",")
+    h += ["};", "",
+          "// Where each word's entry starts in sHanEngData. The words are in the order of their letters.",
+          "static const u32 sHanEngOffsets[HAN_ENG_WORD_COUNT] =\n{"]
+    for i in range(0, len(offsets), 12):
+        h.append("    " + ", ".join("%d" % v for v in offsets[i:i + 12]) + ",")
+    h += ["};", ""]
+    text = "\n".join(h)
+    if not HEADER.exists() or HEADER.read_text(encoding="utf-8") != text:
+        HEADER.write_text(text, encoding="utf-8")
+    return len(entries), len(data) + 4 * len(offsets)
+
+
+if __name__ == "__main__":
+    args = sys.argv[1:]
+    n, size = write(None if not args else [] if args == ["--none"] else args)
+    HEADER.touch()      # `make` runs this when the list is newer than the table: now the table is the newer one
+    print("wrote %s: %d words, %d bytes in the game" % (HEADER.relative_to(ROOT), n, size))
