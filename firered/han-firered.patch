+#!/usr/bin/env python3
+"""Spells every English word of the game by its sound, in the letters of Jane's syllabics.
+
+    python3 tools/han/han_english_sounds.py PATH/TO/checkpoint20.npz [TRANSLATIONS.json]
+
+In syllabics the game used to read English words letter by letter, as if they were
+Hän. Jane asked for words that are not Hän to be spelled by how they sound, as well as
+that can be done. This script makes the list the game uses for that:
+
+    tools/han/english_sounds.txt      one line for each word:  word <tab> its sound <tab> where the sound came from
+
+It is run by hand, and the list is kept in the repository, so building the game needs
+none of what this script needs. Any line of the list can be changed by hand: put "hand"
+in its third column and this script will keep it.
+
+The words are those of the game's own English text. With a file of translations (the
+file the translator page saves), the words of the rows that Jane wrote in English are
+added: see english_prose in han_english_table.py for which rows those are.
+
+Where the sounds come from, in this order:
+  1. the lists of words in this script: letters said as letters (TM, HP), short forms
+     said in full (LV, SP), and the words and Pokémon names the guess got wrong
+  2. the CMU Pronouncing Dictionary, through the Python package cmudict
+     (c) Carnegie Mellon University, BSD licence, http://www.speech.cs.cmu.edu/cgi-bin/cmudict
+  3. the same dictionary for the word without its ending ('s, s, es, ed, ing, ly, er, est)
+  4. a guess, for names and made-up words the dictionary does not have (BULBASAUR,
+     VIRIDIAN): the letter-to-sound model of g2p_en by Kyubyong Park and Jongseok Kim,
+     Apache licence 2.0, https://github.com/Kyubyong/g2p. Its file checkpoint20.npz is
+     the argument. Guesses are marked "guess" in the list: they are the lines to check.
+
+How an English sound is written. This is not Hän: it is English, written with the
+syllables Jane's font has. The choices are the assistant's, made as well as it could.
+
+  consonant before a vowel:
+    p b > b     t > t     d > d     k > k     g > g     ch > ch    j > j
+    f > hw      v > w     th (thin) > th      th (this) > dh
+    s > s       z > z     sh > sh   zh (measure) > zh   h > h
+    m > m       n > n     l > l     w > w     y > y
+    r > zr, and tr, dr after t and d (the font has no r syllables)
+    a consonant, then y, then a vowel (cute, few) > the syllable with the dot
+  consonant with no vowel after it (written as a final):
+    p b > b     t d > t   k > k     g > g     ch j > t, then sh   f > h    v > w
+    th > t      s > s     z > z     sh zh > sh    h > h     m > m     n > n
+    ng > ng     l > l     r > r     w > w     y > y
+  vowel:
+    ee, i (beat, bit) > i       e (bet) > e        a (bat) > ä      a (father) > a
+    u (but, duck) > ë           the weak vowel (about, the) > ë     aw, o (bought, boat) > o
+    oo (book, boot) > u         ay (bait) > e and a y final         ie (bite) > a and a y final
+    ow (bout) > a and a w final                    oy (boy) > o and a y final
+    er (bird, butter) > ë and an r final
+"""
+import re
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+OUT = HERE / "english_sounds.txt"
+sys.path.insert(0, str(HERE))
+
+LETTER_NAMES = {
+    "a": "EY", "b": "B IY", "c": "S IY", "d": "D IY", "e": "IY", "f": "EH F", "g": "JH IY", "h": "EY CH",
+    "i": "AY", "j": "JH EY", "k": "K EY", "l": "EH L", "m": "EH M", "n": "EH N", "o": "OW", "p": "P IY",
+    "q": "K Y UW", "r": "AA R", "s": "EH S", "t": "T IY", "u": "Y UW", "v": "V IY", "w": "D AH B AH0 L Y UW",
+    "x": "EH K S", "y": "W AY", "z": "Z IY",
+}
+# Words said in a way the dictionary would not give. Sounds are in the dictionary's own notation.
+FIXES = {
+    "a": "AH0", "i": "AY", "pokemon": "P OW K AH0 M AA N", "poke": "P OW K AH0", "pkmn": "P OW K AH0 M AA N",
+    "atk": "AH0 T AE K", "def": "D EH F", "exp": "EH K S P", "lv": "L EH V AH0 L", "no": "N OW",
+    "mr": "M IH S T ER0", "mrs": "M IH S IH Z", "dr": "D AA K T ER0", "prof": "P R AH0 F", "jr": "JH UW N Y ER0",
+    "st": "S EY N T", "mt": "M AW N T", "rt": "R UW T", "vs": "V ER S AH0 S", "sp": "S P EH SH AH0 L",
+    "lt": "L UW T EH N AH0 N T", "pokedex": "P OW K AH0 D EH K S", "pokemart": "P OW K AH0 M AA R T",
+}
+
+# Other words the guess got wrong: places, badges, berries, words the game writes as one,
+# the names in the credits, and the game's laughs and cries.
+WORDS = {
+    "firered": "F AY ER0 R EH D", "leafgreen": "L IY F G R IY N", "athabaskan": "AE TH AH0 B AE S K AH0 N",
+    "cerulean": "S ER0 UW L IY AH0 N", "fuchsia": "F Y UW SH AH0", "seagallop": "S IY G AE L AH0 P",
+    "tanoby": "T AH0 N OW B IY", "hoenn": "HH OW EH N", "sevault": "S EH V AO L T", "sevii": "S EH V IY AY",
+    "dept": "D IH P AA R T M AH0 N T", "dojo": "D OW JH OW", "giga": "G IH G AH0", "parlyz": "P AE R AH0 L AY Z",
+    "boulderbadge": "B OW L D ER0 B AE JH", "cascadebadge": "K AE S K EY D B AE JH",
+    "thunderbadge": "TH AH N D ER0 B AE JH", "rainbowbadge": "R EY N B OW B AE JH", "soulbadge": "S OW L B AE JH",
+    "marshbadge": "M AA R SH B AE JH", "volcanobadge": "V AA L K EY N OW B AE JH", "earthbadge": "ER TH B AE JH",
+    "softboiled": "S AO F T B OY L D", "sonicboom": "S AA N IH K B UW M", "itemfinder": "AY T AH0 M F AY N D ER0",
+    "tinymushrooms": "T AY N IY M AH SH R UW M Z", "mysticticket": "M IH S T IH K T IH K AH0 T",
+    "auroraticket": "ER0 AO R AH0 T IH K AH0 T", "lightningrod": "L AY T N IH NG R AA D",
+    "compoundeyes": "K AA M P AW N D AY Z", "energypowder": "EH N ER0 JH IY P AW D ER0",
+    "birdcall": "B ER D K AO L", "candybars": "K AE N D IY B AA R Z", "pokedexes": "P OW K AH0 D EH K S IH Z",
+    "pokemaniac": "P OW K AH0 M EY N IY AE K", "hotheaded": "HH AA T HH EH D IH D",
+    "evasiveness": "IH V EY S IH V N AH0 S", "magnificence": "M AE G N IH F AH0 S AH0 N S",
+    "unseeable": "AH0 N S IY AH0 B AH0 L", "ungiven": "AH0 N G IH V AH0 N", "tomboyish": "T AA M B OY IH SH",
+    "forelegs": "F AO R L EH G Z", "foreleg": "F AO R L EH G", "battlers": "B AE T L ER0 Z", "battler": "B AE T L ER0",
+    "deleter": "D IH L IY T ER0",
+    "aspear": "AE S P IH R", "figy": "F IH G IY", "bluk": "B L AH K", "wepear": "W IY P EH R", "pomeg": "P OW M EH G",
