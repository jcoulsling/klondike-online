@@ -172,9 +172,17 @@ u8 *CopyEasyChatWord(u8 *dest, u16 easyChatWord)
     }
     else if (easyChatWord != EC_WORD_UNDEFINED)
     {
+        // Hän: move names can now be longer than 12 letters, but the mail, trainer
+        // card and union room buffers that hold easy chat words cannot. Copy at
+        // most 12 letters here so a long word is cut off instead of overrunning them.
         u16 index = EC_INDEX(easyChatWord);
         u8 groupId = EC_GROUP(easyChatWord);
-        resultStr = StringCopy(dest, GetEasyChatWord(groupId, index));
+        const u8 *word = GetEasyChatWord(groupId, index);
+        u32 i;
+        for (i = 0; i < 12 && word[i] != EOS; i++)
+            dest[i] = word[i];
+        dest[i] = EOS;
+        resultStr = &dest[i];
