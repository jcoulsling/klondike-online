+// ---------------------------------------------------------------------------
+// Hän build: a Pokémon's entrance animation, as in Emerald
+// ---------------------------------------------------------------------------
+// The front picture plays its two frames and moves in the way its species has in Emerald
+// (pokemon_animation.c). The back picture only moves, in a way picked by species and nature.
+
+#define READ_PTR_FROM_TASK(taskId, dataId)                      \
+    (void *)(                                                   \
+    ((u16)(gTasks[taskId].data[dataId]) |                       \
+    ((u16)(gTasks[taskId].data[dataId + 1]) << 16)))
+
+#define STORE_PTR_IN_TASK(ptr, taskId, dataId)                 \
+{                                                              \
+    gTasks[taskId].data[dataId] = (u32)(ptr);                  \
+    gTasks[taskId].data[dataId + 1] = (u32)(ptr) >> 16;        \
+}
+
+#define sAnimId    data[2]
+#define sAnimDelay data[3]
+
+// FALSE for the Pokémon whose front picture has one frame for the animation: the two that keep
+// FireRed's pictures, and the two that Emerald leaves still as well (SPINDA's spots are drawn
+// on one frame, UNOWN's letter is picked when the picture is loaded).
+bool8 HasTwoFramesAnimation(u16 species)
+{
+    return (species != SPECIES_NONE
+         && species != SPECIES_CASTFORM
+         && species != SPECIES_DEOXYS
+         && species != SPECIES_SPINDA
+         && species != SPECIES_UNOWN
+         && species < NUM_SPECIES);
+}
+
+static void Task_AnimateAfterDelay(u8 taskId)
+{
+    if (--gTasks[taskId].sAnimDelay == 0)
+    {
+        LaunchAnimationTaskForFrontSprite(READ_PTR_FROM_TASK(taskId, 0), gTasks[taskId].sAnimId);
+        DestroyTask(taskId);
+    }
+}
+
+void BattleAnimateFrontSprite(struct Sprite *sprite, u16 species, bool8 noCry, u8 panMode)
+{
+    if (gHitMarker & HITMARKER_NO_ANIMATIONS && !(gBattleTypeFlags & BATTLE_TYPE_LINK))
+        DoMonFrontSpriteAnimation(sprite, species, noCry, panMode | SKIP_FRONT_ANIM);
+    else
+        DoMonFrontSpriteAnimation(sprite, species, noCry, panMode);
+}
+
+void DoMonFrontSpriteAnimation(struct Sprite *sprite, u16 species, bool8 noCry, u8 panModeAnimFlag)
+{
+    s8 pan;
+
+    switch (panModeAnimFlag & (u8)~SKIP_FRONT_ANIM) // the rest is where the cry comes from
+    {
+    case 0:
+        pan = -25;
+        break;
+    case 1:
+        pan = 25;
+        break;
+    default:
+        pan = 0;
+        break;
+    }
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        panModeAnimFlag |= SKIP_FRONT_ANIM;
+    if (panModeAnimFlag & SKIP_FRONT_ANIM)
+    {
+        // no animation: only the cry
+        if (!noCry)
+            PlayCry_Normal(species, pan);
+        sprite->callback = SpriteCallbackDummy;
+    }
+    else
+    {
+        if (!noCry)
+        {
+            PlayCry_Normal(species, pan);
+            if (HasTwoFramesAnimation(species))
+                StartSpriteAnim(sprite, 1);
+        }
+        if (sMonAnimationDelayTable[species - 1] != 0)
+        {
+            // this Pokémon waits before it moves
+            u8 taskId = CreateTask(Task_AnimateAfterDelay, 0);
+
+            STORE_PTR_IN_TASK(sprite, taskId, 0);
+            gTasks[taskId].sAnimId = sMonFrontAnimIdsTable[species - 1];
+            gTasks[taskId].sAnimDelay = sMonAnimationDelayTable[species - 1];
+        }
+        else
+        {
+            LaunchAnimationTaskForFrontSprite(sprite, sMonFrontAnimIdsTable[species - 1]);
+        }
+        sprite->callback = SpriteCallbackDummy_2;
+    }
+}
+
+void BattleAnimateBackSprite(struct Sprite *sprite, u16 species)
+{
+    if ((gHitMarker & HITMARKER_NO_ANIMATIONS && !(gBattleTypeFlags & BATTLE_TYPE_LINK))
+     || species == SPECIES_NONE || species >= NUM_SPECIES)
+    {
+        sprite->callback = SpriteCallbackDummy;
+    }
+    else
+    {
+        LaunchAnimationTaskForBackSprite(sprite, GetSpeciesBackAnimSet(species));
+        sprite->callback = SpriteCallbackDummy_2;
+    }
+}
+
+#undef sAnimId
+#undef sAnimDelay
