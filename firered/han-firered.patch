+        gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_MID;
+    }
+    if (!NameIsSet(gSaveBlock1Ptr->rivalName)) // her last words name the rival
+        StringCopy(gSaveBlock1Ptr->rivalName, gNameChoice_Green);
+    GiveJaneCheatTeam(BossTopLevel(sCheatBosses[boss].trainer));
+
+    gJaneCheatBattle = TRUE; // the game starts again when the battle is over. JANE's is in her room: see battle_bg.c
+    gTrainerBattleOpponent_A = sCheatBosses[boss].trainer;
+    sTrainerADefeatSpeech = (u8 *)sCheatBosses[boss].defeat;
+    sTrainerBattleMode = TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT;
+    sTrainerVictorySpeech = NULL;
+    sRivalBattleFlags = 0;
+    gBattleTypeFlags = BATTLE_TYPE_TRAINER;
+    gBattleTerrain = BATTLE_TERRAIN_BUILDING;
+    gMain.savedCallback = CB2_AfterJaneCheatBattle;
+    PlayMapChosenOrBattleBGM(0);
+    SetMainCallback2(CB2_InitBattle);
+}
