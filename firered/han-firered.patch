+        AddTextPrinterParameterized3(0, FONT_NORMAL, 2, pos * 16, sTextColor1, -1, sBossCursor);
+    else
+        FillWindowPixelRect(0, PIXEL_FILL(10), 0, pos * 16, 12, 16);
+}
+
+static void Task_BossMenuStart(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        u8 boss = gTasks[taskId].data[0];
+
+        FreeAllWindowBuffers();
+        DestroyTask(taskId);
+        StartCheatBattle(boss);
+    }
+}
+
+static void Task_BossMenu(u8 taskId)
+{
+    s16 *pos = &gTasks[taskId].data[0];
+
+    if (gPaletteFade.active)
+        return;
+    if (JOY_NEW(DPAD_UP | DPAD_DOWN))
+    {
+        BossMenu_DrawCursor(*pos, FALSE);
+        if (JOY_NEW(DPAD_UP))
+            *pos = (*pos == 0) ? CheatBossCount() - 1 : *pos - 1;
+        else
+            *pos = (*pos == CheatBossCount() - 1) ? 0 : *pos + 1;
+        BossMenu_DrawCursor(*pos, TRUE);
+        CopyWindowToVram(0, COPYWIN_GFX);
+        PlaySE(SE_SELECT);
+    }
+    else if (JOY_NEW(A_BUTTON))
+    {
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+        gTasks[taskId].func = Task_BossMenuStart;
+    }
+    else if (JOY_NEW(B_BUTTON))
+    {
+        DoSoftReset();
+    }
+}
+
+void CB2_InitBossMenu(void)
+{
+    u32 i;
+
+    SetVBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    SetGpuReg(REG_OFFSET_BG0CNT, 0);
+    SetGpuReg(REG_OFFSET_BG0HOFS, 0);
+    SetGpuReg(REG_OFFSET_BG0VOFS, 0);
+    DmaFill16(3, 0, (void *)VRAM, VRAM_SIZE);
+    DmaFill32(3, 0, (void *)OAM, OAM_SIZE);
+    DmaFill16(3, 0, (void *)(PLTT + 2), PLTT_SIZE - 2);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplate, NELEMS(sBgTemplate));
+    ChangeBgX(0, 0, 0);
+    ChangeBgY(0, 0, 0);
+    InitWindows(sBossWindowTemplate);
+    DeactivateAllTextPrinters();
+    LoadPalette(sBg_Pal, BG_PLTT_ID(0), sizeof(sBg_Pal));
+    LoadPalette(sTextbox_Pal, BG_PLTT_ID(15), sizeof(sTextbox_Pal));
+    SetGpuReg(REG_OFFSET_WININ, 0);
+    SetGpuReg(REG_OFFSET_WINOUT, 0);
+    SetGpuReg(REG_OFFSET_BLDCNT, 0);
+    SetGpuReg(REG_OFFSET_BLDALPHA, 0);
+    SetGpuReg(REG_OFFSET_BLDY, 0);
+    LoadStdWindowGfx(0, 0x1B1, BG_PLTT_ID(2));
+    FillWindowPixelBuffer(0, PIXEL_FILL(10));
+    for (i = 0; i < CheatBossCount(); i++)
+        AddTextPrinterParameterized3(0, FONT_NORMAL, 14, i * 16, sTextColor1, -1, gTrainers[CheatBossTrainer(i)].trainerName);
+    BossMenu_DrawCursor(0, TRUE);
+    MainMenu_DrawWindow(&sBossWindowTemplate[0]); // the frame first: it writes over the window's place
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_OBJ_1D_MAP | DISPCNT_OBJ_ON | DISPCNT_BG0_ON);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    SetVBlankCallback(VBlankCB_MainMenu);
+    SetMainCallback2(CB2_MainMenu);
+    CreateTask(Task_BossMenu, 0);
+}
+
+static void Task_OpenBossMenu(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        FreeAllWindowBuffers();
+        DestroyTask(taskId);
+        SetMainCallback2(CB2_InitBossMenu);
+    }
+}
