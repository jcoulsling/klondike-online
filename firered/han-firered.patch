+static bool8 PlayerNameIs(const u8 *name)
+{
+    u8 i, c;
+
+    for (i = 0; i < PLAYER_NAME_LENGTH + 1; i++)
+    {
+        c = gSaveBlock2Ptr->playerName[i];
+        if (c >= CHAR_a && c <= CHAR_z)
+            c -= CHAR_a - CHAR_A;
+        if (c != name[i])
+            return FALSE;
+        if (c == EOS)
+            break;
+    }
+    return TRUE;
+}
+
+static const struct NameStarter *GetNameStarter(void)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sNameStarters); i++)
+    {
+        if (PlayerNameIs(sNameStarters[i].name))
+            return &sNameStarters[i];
+    }
+    return NULL;
+}
+
+// SPECIES_NONE if this player's name has no fourth starter.
+u16 GetNameStarterSpecies(void)
+{
+    const struct NameStarter *starter = GetNameStarter();
+
+    return starter != NULL ? starter->species : SPECIES_NONE;
+}
+
+u16 GetNameStarterRivalChoice(void)
+{
+    const struct NameStarter *starter = GetNameStarter();
+
+    return starter != NULL ? starter->rivalChoice : 0;
+}
+
+// A shiny, female personality with a nature that changes no stat.
+static u32 GiftPersonality(u16 species, u32 otId)
+{
+    u32 key = (otId >> 16) ^ (otId & 0xFFFF);
+    u32 low, personality;
+
+    for (low = 0; low < 0x10000; low++)
+    {
+        personality = ((low ^ key) << 16) | low; // the two halves and the two trainer numbers cancel out: shiny
+        if (GetGenderFromSpeciesAndPersonality(species, personality) == MON_FEMALE
+         && (personality % NUM_NATURES) % 6 == 0) // the nature: HARDY, DOCILE, SERIOUS, BASHFUL or QUIRKY
+            return personality;
+    }
+    return key << 16;
+}
+
+bool8 NameStarter_HasBonus(struct Pokemon *mon)
+{
+    return (GetMonData(mon, MON_DATA_UNUSED_RIBBONS) & NAME_STARTER_BONUS_MARK) != 0;
+}
+
+// ROWAN's PIKACHU on a trainer's team: made as the gift is. Shiny, female, 31 in every hidden number,
+// a nature that changes no stat, and the mark (50 more in every stat, THUNDER never misses).
+void CreateRowansPikachu(struct Pokemon *mon, u8 level, u16 heldItem, const u16 *moves)
+{
+    u32 otId = 0x00012345; // any number: the personality is made to be shiny with it
+    u8 mark;
+    u8 i;
+
+    CreateMon(mon, SPECIES_PIKACHU, level, 31, TRUE, GiftPersonality(SPECIES_PIKACHU, otId), OT_ID_PRESET, otId);
+    mark = GetMonData(mon, MON_DATA_UNUSED_RIBBONS) | NAME_STARTER_BONUS_MARK;
+    SetMonData(mon, MON_DATA_UNUSED_RIBBONS, &mark);
+    CalculateMonStats(mon);
+    SetMonData(mon, MON_DATA_HELD_ITEM, &heldItem);
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        SetMonData(mon, MON_DATA_MOVE1 + i, &moves[i]);
+        SetMonData(mon, MON_DATA_PP1 + i, &gBattleMoves[moves[i]].pp);
+    }
+}
+
+// Called right after the starter is handed over. Does nothing for the usual three.
+void GiveNameStarterExtras(void)
+{
+    const struct NameStarter *starter = GetNameStarter();
+    struct Pokemon *mon = &gPlayerParty[0];
+    u8 i;
+
+    if (starter == NULL || GetMonData(mon, MON_DATA_SPECIES) != starter->species)
+        return;
+
+    if (starter->gift)
+    {
+        u32 otId = gSaveBlock2Ptr->playerTrainerId[0]
+                 | (gSaveBlock2Ptr->playerTrainerId[1] << 8)
+                 | (gSaveBlock2Ptr->playerTrainerId[2] << 16)
+                 | (gSaveBlock2Ptr->playerTrainerId[3] << 24);
+        u8 mark;
+
+        // made again from nothing: 31 in every hidden number, shiny and female
+        CreateMon(mon, starter->species, 5, 31, TRUE, GiftPersonality(starter->species, otId), OT_ID_PLAYER_ID, 0);
+        SetMonData(mon, MON_DATA_OT_NAME, gSaveBlock2Ptr->playerName);
+        SetMonData(mon, MON_DATA_OT_GENDER, &gSaveBlock2Ptr->playerGender);
+        mark = GetMonData(mon, MON_DATA_UNUSED_RIBBONS) | NAME_STARTER_BONUS_MARK;
+        SetMonData(mon, MON_DATA_UNUSED_RIBBONS, &mark);
+        CalculateMonStats(mon); // again, now with the 50 more
+    }
+
+    if (starter->item != ITEM_NONE)
+    {
+        u8 item[2];
+
+        item[0] = starter->item;
+        item[1] = starter->item >> 8;
+        SetMonData(mon, MON_DATA_HELD_ITEM, item);
+    }
+
+    for (i = 0; i < ARRAY_COUNT(starter->moves); i++)
+    {
+        if (starter->moves[i] != MOVE_NONE
+         && GiveMoveToMon(mon, starter->moves[i]) == MON_HAS_MAX_MOVES)
+            DeleteFirstMoveAndGiveMoveToMon(mon, starter->moves[i]);
+    }
+}
+
+// Hän build: the team for the boss fight menu (see StartCheatBattle in battle_setup.c).
+// It is a team a player might bring to the champion in the Johto games, with MEWTWO in the last place.
+// Jane changed the first two: FERALIGATR for TYPHLOSION, and AERODACTYL for GYARADOS. Both have a
+// set used in competitive play in these games. AERODACTYL has AERIAL ACE where that set has HIDDEN POWER,
+// because the type of HIDDEN POWER depends on the IVs and these are random.
+// Levels scale: the first five are 3 under the highest level in the boss's party (never under 5).
+// Each has a line of species and takes the stage that fits its level, so against a low boss the team
+// is TOTODILE, MAREEP and so on. The set of moves is used only in the last stage; before that a
+// Pokémon knows what it would know at its level. MEWTWO is always at the top, level 100. Jane asked for 1000,
+// but the game cannot hold a level over 100.
+struct CheatMon
+{
+    u16 species[3];      // the stages, first to last. A line with fewer stages repeats the last one
+    u8 evolveAt[2];      // the level at which the second and the third stage begin
+    bool8 shiny;
+    bool8 fixedLevel;    // MEWTWO: stays at 100
+    u16 moves[MAX_MON_MOVES];
+};
+
+static const struct CheatMon sJaneCheatTeam[PARTY_SIZE] = {
+    {{SPECIES_TOTODILE, SPECIES_CROCONAW, SPECIES_FERALIGATR}, {18, 30}, FALSE, FALSE,
+        {MOVE_SWORDS_DANCE, MOVE_EARTHQUAKE, MOVE_ROCK_SLIDE, MOVE_HYDRO_PUMP}},
+    {{SPECIES_AERODACTYL, SPECIES_AERODACTYL, SPECIES_AERODACTYL}, {0, 0}, FALSE, FALSE,
+        {MOVE_ROCK_SLIDE, MOVE_EARTHQUAKE, MOVE_DOUBLE_EDGE, MOVE_AERIAL_ACE}},
+    {{SPECIES_MAREEP, SPECIES_FLAAFFY, SPECIES_AMPHAROS}, {15, 30}, FALSE, FALSE,
+        {MOVE_THUNDER_PUNCH, MOVE_THUNDER_WAVE, MOVE_HEADBUTT, MOVE_LIGHT_SCREEN}},
+    {{SPECIES_ZUBAT, SPECIES_GOLBAT, SPECIES_CROBAT}, {22, 40}, FALSE, FALSE,
+        {MOVE_FLY, MOVE_CONFUSE_RAY, MOVE_BITE, MOVE_WING_ATTACK}},
+    {{SPECIES_EEVEE, SPECIES_EEVEE, SPECIES_ESPEON}, {0, 20}, FALSE, FALSE,
+        {MOVE_PSYBEAM, MOVE_SHADOW_BALL, MOVE_BITE, MOVE_SAND_ATTACK}},
+    {{SPECIES_MEWTWO, SPECIES_MEWTWO, SPECIES_MEWTWO}, {0, 0}, FALSE, TRUE,
+        {MOVE_PSYCHIC, MOVE_PSYCH_UP, MOVE_FUTURE_SIGHT, MOVE_AMNESIA}},
+};
+
+void GiveJaneCheatTeam(u8 bossLevel)
+{
+    u32 otId = gSaveBlock2Ptr->playerTrainerId[0]
+             | (gSaveBlock2Ptr->playerTrainerId[1] << 8)
+             | (gSaveBlock2Ptr->playerTrainerId[2] << 16)
+             | (gSaveBlock2Ptr->playerTrainerId[3] << 24);
+    u8 i, j;
+
+    ZeroPlayerPartyMons();
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        const struct CheatMon *set = &sJaneCheatTeam[i];
+        struct Pokemon *mon = &gPlayerParty[i];
+        u32 low = Random();
+        u32 personality = low | (Random() << 16);
+        u8 level = 100;
+        u8 stage = 2;
+
+        if (!set->fixedLevel)
+        {
+            level = bossLevel > 8 ? bossLevel - 3 : 5;
+            if (level > 100)
+                level = 100;
+            if (level < set->evolveAt[0])
+                stage = 0;
+            else if (level < set->evolveAt[1])
+                stage = 1;
+        }
+        if (set->shiny)
+            personality = ((low ^ HIHALF(otId) ^ LOHALF(otId)) << 16) | low; // the halves cancel out: shiny
+        CreateMon(mon, set->species[stage], level, USE_RANDOM_IVS, TRUE, personality, OT_ID_PLAYER_ID, 0);
+        SetMonData(mon, MON_DATA_OT_NAME, gSaveBlock2Ptr->playerName);
+        SetMonData(mon, MON_DATA_OT_GENDER, &gSaveBlock2Ptr->playerGender);
+        if (stage == 2)
+        {
+            for (j = 0; j < MAX_MON_MOVES; j++)
+                SetMonMoveSlot(mon, set->moves[j], j);
+        }
+    }
+    CalculatePlayerPartyCount();
+}
