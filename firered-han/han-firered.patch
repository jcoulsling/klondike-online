diff --git a/sound/songs/se_animalese.s b/sound/songs/se_animalese.s
new file mode 100644
index 0000000..e767bd4
--- /dev/null
+++ b/sound/songs/se_animalese.s
@@ -0,0 +1,57 @@
+@ The letter sounds of the UNOWN move. One short song for each letter.
+@ animalese.js letter sounds, (c) 2014 Josh Simmons, CC BY 4.0, https://github.com/Acedio/animalese.js
+@ The samples are made by tools/han/han_animalese.py.
+@
+@ Each letter plays at its own speed, with no change of pitch.
+@ A note lasts 7 frames, and the letters of the move land 7 frames apart,
+@ so one letter runs until the next one starts. (animalese.js gives each letter 0.075 seconds, about 4.5 frames.)
+
+	.include "MPlayDef.s"
+
+	.section .rodata
+
+	.macro animalese_song letter:req, voice:req
+	.global	se_animalese_\letter
+se_animalese_\letter\()_1:
+	.byte	KEYSH , 0
+	.byte	TEMPO , 150/2
+	.byte		VOICE , \voice
+	.byte		VOL   , 127
+	.byte		N07   , Cn3 , v127
+	.byte	W07
+	.byte	FINE
+
+	.align	2
+se_animalese_\letter:
+	.byte	1	@ NumTrks
+	.byte	0	@ NumBlks
+	.byte	4	@ Priority
+	.byte	0	@ Reverb
+
+	.word	voicegroup_animalese
+
+	.word	se_animalese_\letter\()_1
+	.endm
+
+	animalese_song a, 0
+	animalese_song b, 1
+	animalese_song c, 2
+	animalese_song d, 3
+	animalese_song e, 4
+	animalese_song g, 5
+	animalese_song h, 6
+	animalese_song i, 7
+	animalese_song j, 8
+	animalese_song k, 9
+	animalese_song l, 10
+	animalese_song m, 11
+	animalese_song n, 12
+	animalese_song o, 13
+	animalese_song p, 14
+	animalese_song q, 15
+	animalese_song r, 16
+	animalese_song u, 17
+	animalese_song w, 18
+	animalese_song y, 19
+
+	.end
