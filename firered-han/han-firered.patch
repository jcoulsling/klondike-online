+}
+
+static void CB2_HanHoennFlyInit(void)
+{
+    switch (sState)
+    {
+    case 0:
+        SetVBlankCallback(NULL);
+        DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+        DmaClear32(3, (void *)OAM, OAM_SIZE);
+        DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+        SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_MODE_0);
+        ResetBgsAndClearDma3BusyFlags(FALSE);
+        InitBgsFromTemplates(1, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+        ResetPaletteFade();
+        ResetSpriteData();
+        ResetTasks();
+        FreeAllSpritePalettes();
+        ScanlineEffect_Stop();
+        sState++;
+        break;
+    case 1:
+        LZ77UnCompVram(sMapTiles, BG_CHAR_ADDR(0));
+        LZ77UnCompVram(sMapTilemap, BG_SCREEN_ADDR(28));
+        LoadPalette(sMapPal, BG_PLTT_ID(7), 2 * PLTT_SIZE_4BPP);
+        SetBgTilemapBuffer(1, sTilemapBuffer);
+        FillBgTilemapBufferRect_Palette0(1, 0, 0, 0, 0x20, 0x20);
+        InitWindows(sWindowTemplates);
+        DeactivateAllTextPrinters();
+        LoadPalette(gStandardMenuPalette, BG_PLTT_ID(15), PLTT_SIZE_4BPP);
+        PutWindowTilemap(0);
+        // a hint, so the way to the Kanto and Sevii fly map can be found
+        FillWindowPixelBuffer(1, PIXEL_FILL(1));
+        AddTextPrinterParameterized3(1, FONT_SMALL, 2, 1, (const u8[]){1, 2, 3}, 0, sText_Hint);
+        PutWindowTilemap(1);
+        CopyWindowToVram(1, COPYWIN_FULL);
+        LoadSpriteSheet(&sCursorSheet);
+        LoadSpritePalette(&sCursorSpritePal);
+        sCursorId = CreateSprite(&sCursorTemplate, 0, 0, 0);
+        sSel = 0;
+        while (sSel < HOENN_FLY_COUNT - 1 && !FlagGet(VISIT_FLAG(sSel)))
+            sSel++; // the first town visited
+        sExit = 0;
+        ShowName();
+        sState++;
+        break;
+    case 2:
+        SetVBlankCallback(VBlankCB);
+        // Emerald's map is an affine background: a 64 by 64 map of one-byte tile numbers
+        SetGpuReg(REG_OFFSET_BG2CNT, BGCNT_PRIORITY(1) | BGCNT_CHARBASE(0) | BGCNT_SCREENBASE(28) | BGCNT_WRAP | BGCNT_AFF512x512);
+        SetGpuReg(REG_OFFSET_BG2PA, 0x100);
+        SetGpuReg(REG_OFFSET_BG2PB, 0);
+        SetGpuReg(REG_OFFSET_BG2PC, 0);
+        SetGpuReg(REG_OFFSET_BG2PD, 0x100);
+        SetGpuReg(REG_OFFSET_BG2X_L, 0);
+        SetGpuReg(REG_OFFSET_BG2X_H, 0);
+        SetGpuReg(REG_OFFSET_BG2Y_L, 0);
+        SetGpuReg(REG_OFFSET_BG2Y_H, 0);
+        ShowBg(1);
+        ShowBg(2);
+        SetGpuReg(REG_OFFSET_BG2CNT, BGCNT_PRIORITY(1) | BGCNT_CHARBASE(0) | BGCNT_SCREENBASE(28) | BGCNT_WRAP | BGCNT_AFF512x512);
+        SetGpuReg(REG_OFFSET_DISPCNT, GetGpuReg(REG_OFFSET_DISPCNT) | DISPCNT_OBJ_1D_MAP | DISPCNT_OBJ_ON);
+        CopyBgTilemapBufferToVram(1);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        sState = 0;
+        SetMainCallback2(CB2_HanHoennFly);
+        break;
+    }
+}
+
+static void CB2_HanHoennFly(void)
+{
+    RunTasks();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+    RunTextPrinters();
+    if (sState == 0)
+    {
+        if (gPaletteFade.active)
+            return;
+        if (JOY_NEW(A_BUTTON) && !FlagGet(VISIT_FLAG(sSel)))
+            PlaySE(SE_FAILURE);
+        else if (JOY_NEW(A_BUTTON))
+        {
+            sExit = 0;
+            PlaySE(SE_USE_ITEM);
+            BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+            sState = 1;
+        }
+        else if (JOY_NEW(B_BUTTON))
+        {
+            sExit = 1;
+            BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+            sState = 1;
+        }
+        else if (JOY_NEW(SELECT_BUTTON))
+        {
+            sExit = 2;
+            PlaySE(SE_SELECT);
+            BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+            sState = 1;
+        }
+        else if (JOY_NEW(DPAD_LEFT))
+            Move(-1, 0);
+        else if (JOY_NEW(DPAD_RIGHT))
+            Move(1, 0);
+        else if (JOY_NEW(DPAD_UP))
+            Move(0, -1);
+        else if (JOY_NEW(DPAD_DOWN))
+            Move(0, 1);
+    }
+    else if (!gPaletteFade.active)
+    {
+        const struct HanHoennFlyTown *t = &sHanHoennFlyTowns[sSel];
+
+        FreeAllWindowBuffers();
+        if (sExit == 0)
+        {
+            if (t->heal)
+                SetWarpDestinationToHealLocation(t->heal);
+            else
+                SetWarpDestination(t->mapGroup, t->mapNum, -1, t->wx, t->wy);
+            ReturnToFieldFromFlyMapSelect();
+        }
+        else if (sExit == 1)
+            SetMainCallback2(CB2_ReturnToPartyMenuFromFlyMap);
+        else
+        {
+            gHanFlyForceKanto = TRUE;
+            SetMainCallback2(CB2_OpenFlyMap);
+        }
+    }
+}
+
+// true if the player stands in Hoenn
+bool8 HanInHoenn(void)
+{
+    return GetCurrentRegionMapSectionId() < KANTO_MAPSEC_START;
+}
diff --git a/src/han_link.c b/src/han_link.c
new file mode 100644
index 0000000..0e5d2b3
--- /dev/null
+++ b/src/han_link.c
@@ -0,0 +1,143 @@
+#include "global.h"
+#include "gflib.h"
+#include "battle.h"
+#include "han_multiplayer.h"
+#include "link.h"
+#include "main.h"
+
+// Hän build: the cable of a link battle, replaced by the web page (Jane, 22 November 2026).
+//
+// The game's own link battle runs as it does over the cable. Only the bottom is changed: link.c asks this file for
+// the player number, sending a block, standing by and closing when gHanMailbox.link.on is set. A block that goes out
+// is copied to gBlockSendBuffer and the page takes it (txSeq / txAck). A block that comes in is written by the page to
+// gBlockRecvBuffer[the other player] and the game is told (rxSeq / rxSeen); the page does not write the next one before
+// the game has used this one (rxFull). Standing by and closing are counters the page passes on.
+
+extern void (*gLinkCallback)(void);
+extern u8 gBlockReceivedStatus[MAX_LINK_PLAYERS];
+
+static EWRAM_DATA u8 sStandbyDone = 0;
+static EWRAM_DATA u8 sAborted = 0;
+
+void HanLinkStart(u8 myId, u8 peer, const struct LinkPlayer *me, const struct LinkPlayer *other)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+    u8 i;
+
+    gLinkPlayers[myId] = *me;
+    gLinkPlayers[myId ^ 1] = *other;
+    for (i = 0; i < 2; i++)
+    {
+        gLinkPlayers[i].id = i;
+        gLinkPlayers[i].linkType = LINKTYPE_BATTLE;
+        gBlockReceivedStatus[i] = FALSE;
+    }
+    l->myId = myId;
+    l->peer = peer;
+    l->txAck = l->txSeq;
+    l->rxSeen = l->rxSeq;
+    l->rxFull = 0;
+    l->syncOut = 0;
+    l->syncIn = 0;
+    l->closeOut = 0;
+    l->closeIn = 0;
+    l->sendAddr = (u32)gBlockSendBuffer;
+    l->recvAddr = (u32)gBlockRecvBuffer[myId ^ 1];
+    l->mailAddr = (u32)&gHanMailbox;
+    sStandbyDone = 0;
+    sAborted = 0;
+    l->gone = 0;
+    gLinkCallback = NULL;
+    gReceivedRemoteLinkPlayers = TRUE;
+    l->on = 1;
+}
+
+bool8 HanLinkSend(const void *src, u16 size)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    if (size > BLOCK_BUFFER_SIZE || l->txAck != l->txSeq)
+        return FALSE;
+    CpuCopy16(src, gBlockSendBuffer, (size + 1) & ~1);
+    CpuCopy16(src, gBlockRecvBuffer[l->myId], (size + 1) & ~1);
+    gBlockReceivedStatus[l->myId] = TRUE;
+    l->txSize = size;
+    l->txSeq++;
+    return TRUE;
+}
+
+bool8 HanLinkSendDone(void)
+{
+    return gLinkCallback == NULL && gHanMailbox.link.txAck == gHanMailbox.link.txSeq;
+}
+
+static void CB_Standby(void)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    if (!sStandbyDone)
+    {
+        l->syncOut++;
+        sStandbyDone = 1;
+    }
+    if ((u8)(l->syncIn - l->syncOut) < 128)  // the other one has stood by as often as I have
+    {
+        sStandbyDone = 0;
+        gLinkCallback = NULL;
+    }
+}
+
+void HanLinkStandby(void)
+{
+    if (gLinkCallback == NULL)
+        gLinkCallback = CB_Standby;
+}
+
+static void CB_Close(void)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    l->closeOut = 1;
+    if (l->closeIn)
+    {
+        gBattleTypeFlags &= ~(BATTLE_TYPE_LINK_IN_BATTLE | 0xFFFF0000);
+        gReceivedRemoteLinkPlayers = FALSE;
+        l->on = 0;
+        l->closeIn = 0;   // closeOut stays 1 so that the page still tells the other game; HanLinkStart clears it
+        gLinkCallback = NULL;
+    }
+}
+
+void HanLinkCloseReady(void)
+{
+    if (gLinkCallback == NULL)
+        gLinkCallback = CB_Close;
+}
+
+// every frame
+void HanLinkFrame(void)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    if (!l->on)
+        return;
+    if (l->gone && !sAborted)
+    {
+        // the other player is gone: nothing more will come, so end the battle (as a draw) and close
+        sAborted = 1;
+        l->closeIn = 1;
+        gLinkCallback = NULL;
+        if ((gBattleTypeFlags & BATTLE_TYPE_LINK) && gMain.inBattle)
+            HanLinkAbortBattle();
+    }
+    if (l->gone)
+        l->closeIn = 1;
+    if (l->rxSeen != l->rxSeq)
+    {
+        l->rxSeen = l->rxSeq;
+        gBlockReceivedStatus[l->myId ^ 1] = TRUE;
+    }
+    l->rxFull = gBlockReceivedStatus[l->myId ^ 1];
+    if (gLinkCallback != NULL)
+        gLinkCallback();
+}
diff --git a/src/han_multiplayer.c b/src/han_multiplayer.c
new file mode 100644
index 0000000..2d31104
--- /dev/null
+++ b/src/han_multiplayer.c
@@ -0,0 +1,303 @@
+#include "global.h"
+#include "gflib.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "han_multiplayer.h"
+#include "han_custom.h"
+#include "han_follower.h"
+#include "constants/event_objects.h"
+#include "main_menu.h"
+#include "sound.h"
+#include "constants/songs.h"
+
+// Hän build: other players on the overworld.
+//
+// The game has no way to the internet. The web page that runs it does: it finds the mailbox below in the
+// emulator's memory by its marker, and each frame it
+//   - reads "mine": where this player is (map, tile, facing, whether walking, which picture), and
+//   - writes "others": the same for up to four other players in the same room.
+// Here, every frame in the overworld, "mine" is written and each of "others" on the same map is drawn
+// as a sprite that walks towards the tile it was sent. Nothing else in the game is touched: the other
+// players cannot be talked to, stopped by, or battled from the map. The emulator on its own (no page)
+// never fills "others", so nothing is drawn.
+
+EWRAM_DATA struct HanMailbox gHanMailbox = {0};
+
+#define GHOST_TAG 0x4B0B
+#define GHOST_BODY_PAL 0x4C20   // palette tags, plus the slot
+#define GHOST_FOLLOW_PAL 0x4C30
+
+static void SpriteCB_Ghost(struct Sprite *sprite)
+{
+}
+
+static s16 StepTowards(s16 cur, s16 target, s16 speed)
+{
+    if (cur < target)
+        return (target - cur < speed) ? target : cur + speed;
+    if (cur > target)
+        return (cur - target < speed) ? target : cur - speed;
+    return cur;
+}
+
+// Which map this is, as two bytes. The group and number in the save block were seen to be 255 and 255 in a game
+// that was standing in Pallet Town (22 November 2026), so they are not trusted. The address of the map's event
+// list in the ROM is different for every map and the same in every copy of this ROM.
+static void MapId(u8 *hi, u8 *lo)
+{
+    u32 p = (u32)gMapHeader.events;
+    u16 id = (p >> 2) ^ (p >> 18);
+
+    *hi = id >> 8;
+    *lo = id & 0xFF;
+}
+
+static void WriteMine(void)
+{
+    struct HanPlayerState *me = &gHanMailbox.mine;
+    struct ObjectEvent *obj = &gObjectEvents[gPlayerAvatar.objectEventId];
+
+    me->active = TRUE;
+    MapId(&me->mapGroup, &me->mapNum);
+    me->facing = obj->facingDirection;
+    me->x = gSaveBlock1Ptr->pos.x;
+    me->y = gSaveBlock1Ptr->pos.y;
+    me->gfx = GetPlayerAvatarGraphicsIdByCurrentState();
+    me->walking = gPlayerAvatar.tileTransitionState != T_NOT_MOVING;
+    HanLookPicPal(&me->pic, &me->pal);
+    me->follow = HanFollowSpecies();
+    gHanMailbox.frame++;
+}
+
+static void UpdateGhost(u8 slot, struct HanPlayerState *they)
+{
+    u8 id = gHanMailbox.spriteIds[slot];
+    struct Sprite *sprite = &gSprites[id];
+    s16 targetX, targetY, wx, wy, tx, ty, dx, dy, speed;
+    u8 dir, mapHi, mapLo;
+    u16 owGfx, key, follow;
+    const u16 *owPal;
+
+    MapId(&mapHi, &mapLo);
+    if (!they->active || they->mapGroup != mapHi || they->mapNum != mapLo)
+    {
+        if (id != MAX_SPRITES && sprite->inUse && sprite->data[7] == GHOST_TAG)
+            DestroySprite(sprite);
+        gHanMailbox.spriteIds[slot] = MAX_SPRITES;
+        HanGhostFollowerDestroy(gHanMailbox.followIds[slot], GHOST_FOLLOW_PAL + slot);
+        gHanMailbox.followIds[slot] = MAX_SPRITES;
+        FreeSpritePaletteByTag(GHOST_BODY_PAL + slot);
+        return;
+    }
+    targetX = they->x * 16;
+    targetY = they->y * 16;
+    // a player walking on foot is drawn as their chosen character, in their palette
+    key = 0;
+    owPal = NULL;
+    if ((they->gfx == OBJ_EVENT_GFX_RED_NORMAL || they->gfx == OBJ_EVENT_GFX_GREEN_NORMAL)
+     && HanOwFor(they->pic, they->pal, &owGfx, &owPal))
+        key = they->pic | (they->pal << 8);
+    if (id == MAX_SPRITES || !sprite->inUse || sprite->data[7] != GHOST_TAG || sprite->data[6] != they->gfx || sprite->data[5] != key)
+    {
+        if (id != MAX_SPRITES && sprite->inUse && sprite->data[7] == GHOST_TAG)
+            DestroySprite(sprite);
+        // the player's own pictures are the customizer's look, which is for this game only: others are shown as
+        // a plain trainer of their kind
+        FreeSpritePaletteByTag(GHOST_BODY_PAL + slot);
+        id = CreateObjectGraphicsSprite(key ? owGfx
+                                      : they->gfx == OBJ_EVENT_GFX_RED_NORMAL ? OBJ_EVENT_GFX_YOUNGSTER
+                                      : they->gfx == OBJ_EVENT_GFX_GREEN_NORMAL ? OBJ_EVENT_GFX_LASS : they->gfx,
+                                        SpriteCB_Ghost, 0, 0, 0);
+        gHanMailbox.spriteIds[slot] = id;
+        if (id == MAX_SPRITES)
+            return;
+        sprite = &gSprites[id];
+        if (key)
+        {
+            struct SpritePalette pal;
+            u8 idx;
+
+            pal.data = owPal;
+            pal.tag = GHOST_BODY_PAL + slot;
+            idx = LoadSpritePalette(&pal);
+            if (idx != 0xFF)
+                sprite->oam.paletteNum = idx;
+        }
+        sprite->data[5] = key;
+        sprite->data[7] = GHOST_TAG;
+        sprite->data[6] = they->gfx;
+        sprite->data[0] = targetX;     // where it stands now, in pixels of the map
+        sprite->data[1] = targetY;
+        sprite->coordOffsetEnabled = TRUE;
+        sprite->centerToCornerVecX = -8;
+        sprite->centerToCornerVecY = -16;
+        sprite->oam.priority = gSprites[gPlayerAvatar.spriteId].oam.priority;
+    }
+    wx = sprite->data[0];
+    wy = sprite->data[1];
+    dx = targetX - wx;
+    dy = targetY - wy;
+    if (dx > 80 || dx < -80 || dy > 80 || dy < -80)
+    {
+        wx = targetX;
+        wy = targetY;
+        dx = dy = 0;
+    }
+    speed = 1;
+    if (dx > 20 || dx < -20 || dy > 20 || dy < -20)
+        speed = 2;
+    if (dx > 48 || dx < -48 || dy > 48 || dy < -48)
+        speed = 4;
+    if (they->walking && speed == 1)
+        speed = 1;
+    wx = StepTowards(wx, targetX, speed);
+    wy = StepTowards(wy, targetY, speed);
+    sprite->data[0] = wx;
+    sprite->data[1] = wy;
+
+    dir = they->facing;
+    if (wx != targetX || wy != targetY)
+    {
+        if ((dx < 0 ? -dx : dx) >= (dy < 0 ? -dy : dy))
+            dir = dx > 0 ? DIR_EAST : DIR_WEST;
+        else
+            dir = dy > 0 ? DIR_SOUTH : DIR_NORTH;
+        StartSpriteAnimIfDifferent(sprite, GetMoveDirectionAnimNum(dir));
+    }
+    else
+    {
+        StartSpriteAnimIfDifferent(sprite, GetFaceDirectionAnimNum(they->facing));
+    }
+
+    tx = (wx >> 4) + MAP_OFFSET;
+    ty = (wy >> 4) + MAP_OFFSET;
+    SetSpritePosToMapCoords(tx, ty, &sprite->x, &sprite->y);
+    sprite->x += (wx & 15) + 8;
+    sprite->y += (wy & 15) + 16 + sprite->centerToCornerVecY;
+    sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority;
+    // their follower, one tile behind them
+    follow = they->follow;
+    id = gHanMailbox.followIds[slot];
+    if (follow == 0)
+    {
+        if (id != MAX_SPRITES)
+            HanGhostFollowerDestroy(id, GHOST_FOLLOW_PAL + slot);
+        gHanMailbox.followIds[slot] = MAX_SPRITES;
+    }
+    else
+    {
+        struct Sprite *fs = &gSprites[id];
+
+        if (id == MAX_SPRITES || !fs->inUse || fs->data[6] != follow)
+        {
+            HanGhostFollowerDestroy(id, GHOST_FOLLOW_PAL + slot);
+            id = HanGhostFollowerCreate(follow, GHOST_FOLLOW_PAL + slot);
+            gHanMailbox.followIds[slot] = id;
+            if (id != MAX_SPRITES)
+                gSprites[id].data[6] = follow;
+        }
+        if (id != MAX_SPRITES)
+        {
+            fs = &gSprites[id];
+            tx = wx;
+            ty = wy;
+            switch (they->facing)
+            {
+            case DIR_SOUTH: ty -= 16; break;
+            case DIR_NORTH: ty += 16; break;
+            case DIR_WEST: tx += 16; break;
+            default: tx -= 16; break;
+            }
+            SetSpritePosToMapCoords((tx >> 4) + MAP_OFFSET, (ty >> 4) + MAP_OFFSET, &fs->x, &fs->y);
+            fs->x += (tx & 15) + 8;
+            fs->y += (ty & 15) + 16 + fs->centerToCornerVecY;
+            fs->oam.priority = sprite->oam.priority;
+            if (fs->x != fs->data[4] || fs->y != fs->data[5])
+                StartSpriteAnimIfDifferent(fs, GetMoveDirectionAnimNum(they->facing)); // walking: it walks behind them
+            else
+                StartSpriteAnimIfDifferent(fs, GetFaceDirectionAnimNum(they->facing));
+            fs->data[4] = fs->x;
+            fs->data[5] = fs->y;
+        }
+    }
+    if (wy > gSaveBlock1Ptr->pos.y * 16)
+        sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority - 1; // in front of this player
+    else
+        sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority + 1;
+    // their follower is on a layer above every player
+    if (gHanMailbox.followIds[slot] != MAX_SPRITES)
+    {
+        u8 low = sprite->subpriority < gSprites[gPlayerAvatar.spriteId].subpriority ? sprite->subpriority : gSprites[gPlayerAvatar.spriteId].subpriority;
+
+        gSprites[gHanMailbox.followIds[slot]].subpriority = low > 0 ? low - 1 : 0;
+    }
+}
+
+// Whether another player stands on this map tile (x and y as the game's own object events have them, with MAP_OFFSET), so
+// that the player cannot walk through them. They hold the tile they have been sent, and the tile they are still walking
+// away from.
+bool8 HanPlayerAt(s16 x, s16 y)
+{
+    u8 i, mapHi, mapLo;
+
+    MapId(&mapHi, &mapLo);
+    x -= MAP_OFFSET;
+    y -= MAP_OFFSET;
+    for (i = 0; i < HAN_OTHERS; i++)
+    {
+        struct HanPlayerState *they = &gHanMailbox.others[i];
+        struct Sprite *sprite;
+        u8 id = gHanMailbox.spriteIds[i];
+
+        if (!they->active || they->mapGroup != mapHi || they->mapNum != mapLo)
+            continue;
+        if (they->x == x && they->y == y)
+            return TRUE;
+        if (id < MAX_SPRITES)
+        {
+            sprite = &gSprites[id];
+            if (sprite->inUse && sprite->data[7] == GHOST_TAG)
+            {
+                // still on its way: it holds the tiles its picture is on
+                if ((sprite->data[0] >> 4) == x && (sprite->data[1] >> 4) == y)
+                    return TRUE;
+                if (((sprite->data[0] + 15) >> 4) == x && ((sprite->data[1] + 15) >> 4) == y)
+                    return TRUE;
+            }
+        }
+    }
+    return FALSE;
+}
+
+// Called every frame the overworld runs, after the camera has moved.
+void HanMultiplayerFrame(void)
+{
+    u8 i;
+
+    // Jane asked (22 November 2026): the code for syllabics also works while walking around, so that
+    // they can be turned off again without going back to the title screen.
+    if (CheatCodeEntered() == CHEAT_SYLLABICS)
+    {
+        gHanSyllabics ^= TRUE;
+        PlaySE(SE_SUCCESS);
+    }
+    if (gHanMailbox.magic[0] == 0)
+    {
+        // One letter at a time: a string would also stand in the ROM, and the page must find only this one.
+        gHanMailbox.magic[0] = 'K';
+        gHanMailbox.magic[1] = 'L';
+        gHanMailbox.magic[2] = 'N';
+        gHanMailbox.magic[3] = 'D';
+        gHanMailbox.magic[4] = 'K';
+        gHanMailbox.magic[5] = 'M';
+        gHanMailbox.magic[6] = 'B';
+        gHanMailbox.magic[7] = 'X';
+        for (i = 0; i < HAN_OTHERS; i++)
+            gHanMailbox.spriteIds[i] = MAX_SPRITES, gHanMailbox.followIds[i] = MAX_SPRITES;
+    }
+    WriteMine();
+    HanTradeFrame();
+    for (i = 0; i < HAN_OTHERS; i++)
