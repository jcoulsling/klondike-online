+def pick_family(candidates, category):
+    """The old tool's sheet has one row per ROM offset. When the same bytes are
+    in several families, its Category column says which one the row was."""
+    if len(candidates) == 1:
+        return candidates[0]
+    want = OLD_CATEGORY.get(category or "")
+    for g in candidates:
+        if g.family == want:
+            return g
+    for fam in ("Dialogue", "Menus and system", "Battle messages"):
+        for g in candidates:
+            if g.family == fam and not want:
+                return g
+    return candidates[0]
