+    "gText_LoweringStats", "gText_KeepAnEyeOnHP", "gText_OakNoRunningFromATrainer", "gText_WinEarnsPrizeMoney",
+    "gText_HowDissapointing", "gText_OakImportantToGetToKnowPokemonThroughly", "gText_OakThisIsListOfPokemon",
+    "sText_OldManUsedItem", "gText_WhatWillOldManDo", "sText_YouThrowABallNowRight", "sText_PokedudeUsedItem",
