+#define HAN_LOOK_HAT   4 // 0 none, then the pack's hats
+#define HAN_LOOK_OUTFIT 5 // 0 top, trousers and shoes; 1 gi; 2 dress with apron
+#define HAN_LOOK_SKIN  6
