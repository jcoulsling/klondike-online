+
+def in_plan(g):
+    if all((u.context or "") in PLAN_REMOVED for u in g.units):
+        return False
+    if g.family in PLAN_OUT_FAMILIES:
+        return False
+    if g.family.startswith("Other: "):
+        return g.family[len("Other: "):] in PLAN_IN_OTHER
+    if g.family == "Dialogue" and g.rank >= 4000:        # not a map on the story route
+        return g.section.startswith("Scripts: ") and g.section[len("Scripts: "):] not in PLAN_OUT_SCRIPTS
+    return True
+
+
+def tier_of(g):
+    if not in_plan(g):
+        return 4
+    if any(p.search(g.english) for p in CORE):
+        # a line said once on the story route is not on screen all the time
+        once = g.family == "Dialogue" and g.rank < 4000 and len(g.units) == 1
+        return 1 if once else 0
+    if g.family.startswith("Other: "):
+        return 1
+    tier = TIERS.get(g.family, 4)
+    if g.family == "Dialogue" and g.rank >= 4000:        # shared scripts
+        tier = 1 if g.section[len("Scripts: "):] in OFTEN_SEEN_SCRIPTS else 2
+    return tier
+
+
+def saved_changes(old_path, new_path):
+    """Rows whose Hän differs between two save files of the translator page."""
+    def rows(path):
+        saved = json.loads(Path(path).read_text(encoding="utf-8"))
+        return {(str(r.get("section")), str(r.get("english"))): str(r.get("han", "")) for r in saved.get("rows", [])}
+    old, new = rows(old_path), rows(new_path)
+    return [[sec, eng, old[(sec, eng)], han] for (sec, eng), han in new.items()
+            if (sec, eng) in old and old[(sec, eng)] != han]
+
+
+def write_tool(path, groups, rules, fixes=()):
+    rows = [g for g in groups.values() if is_translatable(g.english)]
+    order = {g.key: i for i, g in enumerate(sorted(rows, key=lambda g: g.rank))}
+    sections, families = [], []
+
+    def index(table, value):
+        if value not in table:
+            table.append(value)
+        return table.index(value)
+    data_rows = []
+    for g in rows:
+        limits = [u.limit for u in g.units if u.limit is not None]
+        # only rule rows: the page works out copies of identical English itself, as it is typed
+        now = g.final if g.final and g.source == "rule" else ""
+        places = "; ".join(u.where for u in g.units[:3]) + (" and %d more" % (len(g.units) - 3) if len(g.units) > 3 else "")
+        data_rows.append([g.english, index(sections, g.section), index(families, g.family), len(g.units), places,
+                          min(limits) if limits else None, tier_of(g), order[g.key], now, g.han or "",
+                          1 if in_plan(g) else 0])
+    data = {"sections": sections, "families": families, "rows": data_rows, "rules": [[k, v] for k, v in rules.items()],
+            "fixes": list(fixes), "english": sorted(english_words(groups))}
+    template = (Path(__file__).parent / "translator_template.html").read_text(encoding="utf-8")
+    blob = json.dumps(data, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
+    Path(path).write_text(template.replace("/*DATA*/", blob), encoding="utf-8")
+    return len(data_rows)
