+// Hän build: is there a warp (a door, a staircase, the edge mat of a building) on this tile? x and y are as the player's
+// coordinates are (with MAP_OFFSET). The follower must not stand on one.
+u8 HanWarpDistance(s16 x, s16 y)
+{
+    s32 i, d, best = 255;
+    const struct WarpEvent *warpEvent = gMapHeader.events->warps;
+
+    for (i = 0; i < gMapHeader.events->warpCount; i++, warpEvent++)
+    {
+        d = warpEvent->x - (x - MAP_OFFSET);
+        if (d < 0) d = -d;
+        {
+            s32 e = warpEvent->y - (y - MAP_OFFSET);
+            if (e < 0) e = -e;
+            d += e;
+        }
+        if (d < best)
+            best = d;
+    }
+    return best;
+}
+
+bool8 HanIsWarpTile(s16 x, s16 y)
+{
+    s32 i;
+    const struct WarpEvent *warpEvent = gMapHeader.events->warps;
+
+    for (i = 0; i < gMapHeader.events->warpCount; i++, warpEvent++)
+        if (warpEvent->x == x - MAP_OFFSET && warpEvent->y == y - MAP_OFFSET)
+            return TRUE;
+    return FALSE;
+}
