+// Hän build: the cheats on the title screen and the main menu (see main_menu.c).
+// A battle with CHAMPION JANE, or the twins' battle in the VIRIDIAN GYM, with the team from
+// GiveJaneCheatTeam. When it is over the game starts again from the top, so nothing that happened in it
+// reaches the save file.
+extern const u8 PokemonLeague_LancesRoom_Text_Defeat[];
+extern const u8 ViridianCity_Gym_Text_GiovanniDefeat[];
+extern const u8 FuchsiaCity_Gym_Text_KogaDefeat[];
+extern const u8 gNameChoice_Red[];
+extern const u8 gNameChoice_Green[];
+
+static void CB2_AfterJaneCheatBattle(void)
+{
+    gJaneCheatBattle = FALSE;
+    DoSoftReset();
+}
+
+// A name is set if it ends inside its field and is not empty. With no save file the save data is all
+// zeroes: the name is then eight spaces with no end, and printing it would run on through memory.
+static bool8 NameIsSet(const u8 *name)
+{
+    u32 i;
+
+    for (i = 0; i <= PLAYER_NAME_LENGTH; i++)
+    {
+        if (name[i] == EOS)
+            return i != 0;
+    }
+    return FALSE;
+}
+
+// The boss fights of the menu (CB2_InitBossMenu in main_menu.c), in the menu's order.
+extern const u8 CeruleanCity_Gym_Text_MistyDefeat[];
+extern const u8 VermilionCity_Gym_Text_LtSurgeDefeat[];
+extern const u8 CeladonCity_Gym_Text_ErikaDefeat[];
+extern const u8 SaffronCity_Gym_Text_SabrinaDefeat[];
+extern const u8 CinnabarIsland_Gym_Text_BlaineDefeat[];
+
+static const struct { u16 trainer; const u8 *defeat; } sCheatBosses[] =
+{
+    {TRAINER_ELITE_FOUR_LANCE, PokemonLeague_LancesRoom_Text_Defeat}, // CHAMPION JANE
+    {TRAINER_LEADER_GIOVANNI,  ViridianCity_Gym_Text_GiovanniDefeat}, // the twins, in their gym
+    {TRAINER_LEADER_KOGA,      FuchsiaCity_Gym_Text_KogaDefeat},      // BRANDON
+    {TRAINER_LEADER_MISTY,     CeruleanCity_Gym_Text_MistyDefeat},    // MANDI
+    {TRAINER_LEADER_LT_SURGE,  VermilionCity_Gym_Text_LtSurgeDefeat}, // JEM
+    {TRAINER_LEADER_ERIKA,     CeladonCity_Gym_Text_ErikaDefeat},
+    {TRAINER_LEADER_SABRINA,   SaffronCity_Gym_Text_SabrinaDefeat},   // TERESA
+    {TRAINER_LEADER_BLAINE,    CinnabarIsland_Gym_Text_BlaineDefeat}, // PROF. PAT
+};
+
+u8 CheatBossCount(void)
+{
+    return ARRAY_COUNT(sCheatBosses);
+}
+
+u16 CheatBossTrainer(u8 boss)
+{
+    return sCheatBosses[boss].trainer;
+}
+
+// Hän build: the highest level in a boss's party. The test team is made to fit it.
+static u8 BossTopLevel(u16 trainerNum)
+{
+    const struct Trainer *t = &gTrainers[trainerNum];
+    u8 top = 0, i, lvl = 0;
+
+    for (i = 0; i < t->partySize; i++)
+    {
+        switch (t->partyFlags)
+        {
+        case 0:
+            lvl = t->party.NoItemDefaultMoves[i].lvl;
+            break;
+        case F_TRAINER_PARTY_CUSTOM_MOVESET:
+            lvl = t->party.NoItemCustomMoves[i].lvl;
+            break;
+        case F_TRAINER_PARTY_HELD_ITEM:
+            lvl = t->party.ItemDefaultMoves[i].lvl;
+            break;
+        default:
+            lvl = t->party.ItemCustomMoves[i].lvl;
+            break;
+        }
+        if (lvl > top)
+            top = lvl;
+    }
+    return top;
+}
+
+void StartCheatBattle(u8 boss)
+{
+    if (boss >= ARRAY_COUNT(sCheatBosses))
+        boss = 0;
+    if (!NameIsSet(gSaveBlock2Ptr->playerName)) // no save file yet: as in a new game
+    {
+        StringCopy(gSaveBlock2Ptr->playerName, gNameChoice_Red);
+        gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_MID;
+    }
+    if (!NameIsSet(gSaveBlock1Ptr->rivalName)) // her last words name the rival
+        StringCopy(gSaveBlock1Ptr->rivalName, gNameChoice_Green);
+    GiveJaneCheatTeam(BossTopLevel(sCheatBosses[boss].trainer));
+
+    gJaneCheatBattle = TRUE; // the game starts again when the battle is over. JANE's is in her room: see battle_bg.c
+    gTrainerBattleOpponent_A = sCheatBosses[boss].trainer;
+    sTrainerADefeatSpeech = (u8 *)sCheatBosses[boss].defeat;
+    sTrainerBattleMode = TRAINER_BATTLE_SINGLE_NO_INTRO_TEXT;
+    sTrainerVictorySpeech = NULL;
+    sRivalBattleFlags = 0;
+    gBattleTypeFlags = BATTLE_TYPE_TRAINER;
+    gBattleTerrain = BATTLE_TERRAIN_BUILDING;
+    gMain.savedCallback = CB2_AfterJaneCheatBattle;
+    PlayMapChosenOrBattleBGM(0);
+    SetMainCallback2(CB2_InitBattle);
+}
