@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Checks that the game reads English words in syllabics as the list says.
+
+    python3 tools/han/han_english_check.py
+
+The game's own code for finding a word (src/han_english_core.h) is compiled for the
+computer (tools/han/english_test.c) and run on:
+  - every word of tools/han/english_sounds.txt, in small letters and in capitals:
+    the game must give exactly the glyphs of the word's sound in the list;
+  - every word with 's: the game must give the word's glyphs and what the rule adds
+    (POSSESSIVE in han_english_table.py), or the list's own line for WORD's if it has one;
+  - the words the table leaves out because they are Hän in the translation, and words
+    with a Hän letter in them: the game must read them as Hän, not as English;
+  - one letter alone at the end of a string, or before spacing, as on the keyboard for
+    typing a name: not a word.
+It needs gcc and the table src/data/han_english_sounds.h as the last build left it.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import han_english_table as T
+import han_syllabics as S
+
+
+def main():
+    codes = S.latin_codes()
+    number = T.glyph_numbers()
+    sounds = T.read_sounds()
+    left_out = T.left_out_now()
+    marks_shift = 9
+
+    def glyphs(pieces):
+        out = []
+        for piece in pieces:
+            g = number(piece)
+            out.append("E%d" % g if g < 1 << marks_shift else "E%d+%d" % (g & 511, g >> marks_shift))
+        return out
+
+    def expect_possessive(word):
+        if word + "'s" in sounds and word + "'s" not in left_out:
+            return glyphs(sounds[word + "'s"].split("."))
+        pieces = sounds[word].split(".")
+        drop, syllable, final = T.POSSESSIVE[T.possessive(pieces)]
+        pieces = pieces[:len(pieces) - drop] + ([syllable] if syllable else []) + [final]
+        return glyphs(pieces)
+
+    def encode(text):
+        return "".join("%02X" % codes[ch] for ch in text)
+
+    tests = []      # (what it is, text, what the game must print, or None when it must not be English)
+    for word in sorted(sounds):
+        if T.key_of(word) is None:
+            continue
+        if word in left_out:
+            tests.append(("left out", word + " x", None))
+            tests.append(("left out", word.upper() + " x", None))
+            continue
+        want = glyphs(sounds[word].split("."))
+        for form in (word, word.upper()):
+            tests.append(("word", form + " x", want))
+        tests.append(("'s", word.upper() + "’s x", expect_possessive(word)))
+    tests.append(("é", "POKéMON x", glyphs(sounds["pokemon"].split("."))))
+    tests.append(("a Hän letter", "trainerä x", None))
+    tests.append(("a Hän letter", "ätrainer x", None))
+    tests.append(("a Hän letter", "POKéMONł x", None))
+    tests.append(("not a word", "trainerzz x", None))
+    tests.append(("apostrophe first", "’trainer x", None))
+    lines = [encode(text) for _, text, _ in tests]
+    # one letter alone: the key B at the end of a string, and before the code that moves the pen
+    lines.append(encode("B"))
+    lines.append(encode("B") + "FC1106" + encode("C"))
+    lines.append(encode("B x"))
+
+    with tempfile.TemporaryDirectory() as work:
+        test = os.path.join(work, "english_test")
+        subprocess.run(["gcc", "-O1", "-o", test, str(HERE / "english_test.c")], check=True)
+        out = subprocess.run([test], input="\n".join(lines) + "\n", capture_output=True, text=True, check=True).stdout.splitlines()
+
+    bad = 0
+    counts = {}
+    for (kind, text, want), got in zip(tests, out):
+        first = got.split("|")[0].split()
+        counts[kind] = counts.get(kind, 0) + 1
+        if want is None:
+            # the x after the space is a word of its own; only the first word matters
+            ok = not any(piece.startswith("E") for piece in got.split(" L00 ")[0].split())
+        else:
+            ok = first == want
+        if not ok:
+            bad += 1
+            if bad <= 20:
+                print("WRONG (%s): %s  wanted %s  got %s" % (kind, text, want, got))
+    keys = out[len(tests):]
+    b = " ".join(glyphs(sounds["b"].split(".")))
+    english = [any(piece.startswith("E") for piece in line.split()) for line in keys]
+    alone_ok = not english[0] and not english[1] and keys[2].startswith(b + " |")
+    if not alone_ok:
+        bad += 1
+        print("WRONG (one letter alone): %s" % keys)
+    print(", ".join("%s %d" % kv for kv in sorted(counts.items())) + ", one letter alone 3")
+    print("all as the list says" if not bad else "%d wrong" % bad)
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
