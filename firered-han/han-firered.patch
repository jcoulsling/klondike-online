+// Hän build: the type that does the most against a target of these two types.
+// The UNOWN move takes this type. Ground is not picked against Levitate.
+// When several types are equally good, one of them is picked: at random if randomTie, else the first.
+u8 GetBestTypeAgainstTypes(u8 type1, u8 type2, u8 ability, bool8 foresight, bool8 randomTie)
+{
+    s32 i;
+    u8 type;
+    u8 best[NUMBER_OF_MON_TYPES];
+    u8 bestCount = 0;
+    u16 bestMultiplier = 0;
+
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        u16 multiplier = 100; // 100 is normal damage, 200 is super effective, 400 is twice super effective
+
+        if (type == TYPE_MYSTERY)
+            continue;
+        if (type == TYPE_GROUND && ability == ABILITY_LEVITATE)
+            multiplier = 0;
+        for (i = 0; TYPE_EFFECT_ATK_TYPE(i) != TYPE_ENDTABLE; i += 3)
+        {
+            if (TYPE_EFFECT_ATK_TYPE(i) == TYPE_FORESIGHT)
+            {
+                if (foresight)
+                    break;
+                continue;
+            }
+            if (TYPE_EFFECT_ATK_TYPE(i) != type)
+                continue;
+            if (TYPE_EFFECT_DEF_TYPE(i) == type1)
+                multiplier = multiplier * TYPE_EFFECT_MULTIPLIER(i) / 10;
+            if (TYPE_EFFECT_DEF_TYPE(i) == type2 && type1 != type2)
+                multiplier = multiplier * TYPE_EFFECT_MULTIPLIER(i) / 10;
+        }
+        if (multiplier > bestMultiplier)
+        {
+            bestMultiplier = multiplier;
+            bestCount = 0;
+        }
+        if (multiplier == bestMultiplier)
+            best[bestCount++] = type;
+    }
+
+    if (randomTie)
+        return best[Random() % bestCount];
+    return best[0];
+}
+
+u8 GetBestTypeAgainst(u8 defender, bool8 randomTie)
