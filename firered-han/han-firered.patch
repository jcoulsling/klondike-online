+    { .bg = 1, .tilemapLeft = 1, .tilemapTop = 17, .width = 20, .height = 2, .paletteNum = 15, .baseBlock = 1 },
+    { .bg = 1, .tilemapLeft = 17, .tilemapTop = 23, .width = 13, .height = 2, .paletteNum = 15, .baseBlock = 41 },
+    DUMMY_WIN_TEMPLATE
+};
+
+static const struct SpriteSheet sCursorSheet = { sCursorGfx, 0x80, 0x7A01 };
+static const struct SpritePalette sCursorSpritePal = { sCursorPal, 0x7A01 };
+static const struct OamData sCursorOam = { .shape = SPRITE_SHAPE(16x16), .size = SPRITE_SIZE(16x16), .priority = 0 };
+static const union AnimCmd sCursorAnim[] = { ANIMCMD_FRAME(0, 8), ANIMCMD_FRAME(4, 8), ANIMCMD_JUMP(0) };
+static const union AnimCmd *const sCursorAnims[] = { sCursorAnim };
+static const struct SpriteTemplate sCursorTemplate = {
