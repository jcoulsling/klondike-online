+
+<dialog id="rules">
+  <h2 style="margin-top:0">Word rules</h2>
+  <p class="note">A word rule swaps one English word for one Hän word wherever that word stands alone, matching its case. A row you typed always wins over a rule.</p>
+  <table><thead><tr><th>English word</th><th>Hän</th><th></th></tr></thead><tbody id="rulesBody"></tbody></table>
+  <div class="row"><button id="addRule">Add a rule</button><button class="primary" id="closeRules">Done</button></div>
+</dialog>
+
+<footer>
+  <p>Your work is kept in this browser as you type. Use <b>Save file</b> often: the file is your real copy, and it is what gets built into the game.</p>
+  <p>A line whose English is the same as one you already typed is filled for you, here and in the game. It only needs typing if that place should say something different.</p>
+  <p><b>What the game shows.</b> Where the English is in ALL CAPS, the Hän is shown in capitals, however it was typed. A letter typed twice in a row is shown once (aa as a, yy as y), and a vowel typed twice with different marks keeps the first one. tth stays tth. English words are left alone. What you typed is kept as it is; a row says so when the game will show it differently.</p>
+  <p><b>Copy English</b> puts the English into a line as it is, for a line that should stay English. It counts as typed.</p>
+  <p><b>The plan</b> is everything except side features, trainer classes and names, item names, Pokémon names, abilities and natures. Text outside the plan stays English unless you type it. It is listed only when it is typed, or when "Show text outside the plan" is ticked. Side features are the help system, Fame Checker, VS Seeker rematch lines, cable club and union room, trainer card, Teachy TV, mystery events, Trainer Tower, easy chat words, the quest log, and a few lists the game never shows.</p>
+  <p>How rows are ordered: text that is on screen all the time comes first (battle messages, menus, type and move names), then the story in play order, then descriptions, then side features. Within each group, a string used in more places comes first.</p>
+  <h2>A note on the use of an LLM (AI assistant)</h2>
+  <p>An AI assistant (Claude) wrote this tool and the ordering of the rows. It did not write any Hän. Every Hän word here was typed by a person. Lines marked "In the game now" are English with the word rules applied. Contact: jcouls.ling@gmail.com</p>
+</footer>
+
+<script id="data" type="application/json">/*DATA*/</script>
+<script>
+"use strict";
+const DATA = JSON.parse(document.getElementById("data").textContent);
+const ROWS = DATA.rows.map((r, i) => ({i, e: r[0], sec: DATA.sections[r[1]], fam: DATA.families[r[2]], used: r[3], where: r[4], limit: r[5], tier: r[6], order: r[7], now: r[8], base: r[9], plan: r[10] !== 0}));
+const KEY = r => r.fam + "\u0001" + r.e;
+const STORE = "han-firered-translator-v1";
+let typed = {};            // key -> Hän
+let rules = DATA.rules.map(r => ({e: r[0], h: r[1]}));
+let dirty = false, shown = 0, view = [];
+const PAGE = 40;
+
+ROWS.forEach(r => { if (r.base) typed[KEY(r)] = r.base; });
+try {
+  const saved = JSON.parse(localStorage.getItem(STORE) || "null");
+  if (saved && saved.typed) { Object.assign(typed, saved.typed); if (saved.rules) rules = saved.rules; dirty = !!saved.dirty; }
+} catch (e) {}
+// A page made from a corrected file carries the corrections. Where this browser
+// still holds the older text of a row, it takes the newer text. A row that was
+// changed since then is left as it is.
+for (const [fam, eng, was, now] of DATA.fixes || []) {
+  const k = fam + "\u0001" + eng;
+  if (typed[k] === was) { typed[k] = now; dirty = true; }
+}
+
+const $ = id => document.getElementById(id);
+const esc = s => s.replace(/[&<>]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;"}[c]));
+const showEnglish = s => esc(s).replace(/\{[^}]*\}/g, m => '<span class="tok">' + m + "</span>");
+const letters = s => Array.from(s.normalize("NFD")).filter(c => !/[̀-ͯ]/.test(c)).length;
+const loose = s => s.replace(/\{PARA\}|\{SCROLL\}|\n/g, " ").toLowerCase().replace(/[^a-z0-9{}_é]+/g, "");
+
+// ---- What the game shows for typed Hän. The build does the same, so keep the two alike.
+//   - a letter typed twice in a row is shown once; a vowel typed twice with
+//     different marks keeps the first; tth and ddh stay; English words are left alone
+//   - where the English is in ALL CAPS, the Hän is put in capitals
+const ENGLISH = new Set(DATA.english || []);
+const TOKEN_RE = /\{[^}]*\}/g;
+const WORD_RE = /(?:\p{L}\p{M}*)+(?:[’'ʼ\-](?:\p{L}\p{M}*)+)*/gu;
+const stripTokens = s => s.replace(TOKEN_RE, "");
+function outsideTokens(s, fn) {
+  let out = "", last = 0;
+  for (const m of s.matchAll(TOKEN_RE)) { out += fn(s.slice(last, m.index)) + m[0]; last = m.index + m[0].length; }
+  return out + fn(s.slice(last));
+}
+const wordKey = w => w.normalize("NFC").toLowerCase().replace(/[’ʼ]/g, "'");
+function clustersOf(s) {
+  const out = [];
+  for (const ch of s) { if (out.length && /\p{M}/u.test(ch)) out[out.length - 1] += ch; else out.push(ch); }
+  return out;
+}
+function clusterKey(c) {
+  const d = [...c.normalize("NFD").toLowerCase()];
+  return [d[0], [...new Set(d.slice(1))].sort().join("")];
+}
+function singleWord(word) {
+  const cl = clustersOf(word), keys = cl.map(clusterKey), out = [], outKeys = [];
+  for (let i = 0; i < cl.length; i++) {
+    const k = keys[i], last = outKeys[outKeys.length - 1];
+    if (last && /\p{L}/u.test(k[0]) && k[0] === last[0]) {
+      const same = k[1] === last[1];
+      if (same && "td".includes(k[0]) && !k[1] && i + 1 < cl.length && keys[i + 1][0] === "h") { /* tth, ddh: keep */ }
+      else if (same || "aeiou".includes(k[0])) continue;
+    }
+    out.push(cl[i]); outKeys.push(k);
+  }
+  return out.join("");
+}
+function isEnglishText(text) {
+  const words = (stripTokens(text).match(WORD_RE) || []).map(wordKey);
+  if (!words.length) return true;
+  const hits = words.filter(w => ENGLISH.has(w)).length;
+  return hits === words.length || (words.length >= 8 && hits / words.length >= 0.8);
+}
+function singleLetters(text) {
+  const changed = [];
+  if (!text || isEnglishText(text)) return {text, changed};
+  const out = outsideTokens(text, part => part.replace(WORD_RE, w => {
+    if (ENGLISH.has(wordKey(w))) return w;
+    const n = singleWord(w);
+    if (n !== w) changed.push([w, n]);
+    return n;
+  }));
+  return {text: out, changed};
+}
+const upperT = s => outsideTokens(s, t => t.toUpperCase().replace(/É/g, "é"));
+const lowerT = s => outsideTokens(s, t => t.toLowerCase());
+const asciiLetters = s => stripTokens(s).replace(/[^A-Za-z]/g, "");
+const isAllCaps = s => { const l = asciiLetters(s); return l.length >= 2 && l === l.toUpperCase(); };
+const firstOf = src => src.replace(/^[^A-Za-z{]+/, "").slice(0, 1);   // past any opening punctuation
+function gameForm(r, han) {
+  const single = singleLetters(han), src = r.e;
+  let out = single.text;
+  if (isAllCaps(src)) out = upperT(out);
+  else if (asciiLetters(src).length >= 2 && (out === lowerT(out) || out === upperT(out)) &&
+           firstOf(src) === firstOf(src).toUpperCase() && /[a-z]/.test(src) && out && out[0] !== "{")
+    out = out[0].toUpperCase() + out.slice(1);
+  return {text: out, changed: single.changed};
+}
+// A short note for the row when the game will not show the text exactly as typed.
+function gameNoteFor(r, han) {
+  if (!han || !han.trim() || han.trim() === "{NOTHING}") return "";
+  const g = gameForm(r, han);
+  if (isAllCaps(r.e)) return g.text !== han ? "In the game: " + g.text : "";
+  if (!g.changed.length) return "";
+  const seen = new Set(), pairs = [];
+  for (const [a, b] of g.changed) { if (!seen.has(a)) { seen.add(a); pairs.push(a + " > " + b); } }
+  return "In the game, double letters are single: " + pairs.join(", ");
+}
+const exactKey = s => s.replace(/\u2019/g, "'");
+const layoutKey = s => exactKey(s).replace(/\{PARA\}|\{SCROLL\}|\n/g, " ").replace(/\s+/g, " ").trim();
+const own = r => (typed[KEY(r)] || "").trim();
+
+// A line that has no Hän of its own takes the Hän typed for the same English
+// somewhere else: first an identical string, then the same words with different
+// line breaks. The build does exactly the same.
+let sameExact = new Map(), sameLayout = new Map();
+function rebuildSame() {
+  sameExact = new Map(); sameLayout = new Map();
+  const rows = ROWS.filter(own).sort((a, b) => a.order - b.order);
+  for (const r of rows) {
+    const k = exactKey(r.e), l = layoutKey(r.e);
+    if (!sameExact.has(k)) sameExact.set(k, r);
+    if (!sameLayout.has(l)) sameLayout.set(l, r);
+  }
+}
+function copiedFor(r) {
+  if (own(r)) return null;
+  const hit = sameExact.get(exactKey(r.e)) || sameLayout.get(layoutKey(r.e));
+  return hit && hit !== r ? hit : null;
+}
+const isDone = r => !!(own(r) || copiedFor(r));
+
+function persist() {
+  try { localStorage.setItem(STORE, JSON.stringify({typed, rules, dirty})); } catch (e) {}
+  $("status").innerHTML = dirty ? '<span class="unsaved">Not saved to a file yet</span>' : "Saved";
+}
+function progress() {
+  // counted against the plan; text outside the plan stays English unless it is typed
+  let mine = 0, copied = 0, rows = 0, places = 0, total = 0, extra = 0;
+  rebuildSame();
+  for (const r of ROWS) {
+    if (!r.plan) { if (own(r)) extra++; continue; }
+    rows++; total += r.used;
+    if (own(r)) { mine++; places += r.used; }
+    else if (copiedFor(r)) { copied++; places += r.used; }
+  }
+  const done = mine + copied;
+  $("progress").textContent = done + " of " + rows + " strings in the plan are done (" + (100 * done / rows).toFixed(1) + "%): " + mine + " typed, " + copied +
+    " filled because their English is the same. " + (rows - done) + " to go. They fill " + places + " of " + total + " places in the game." +
+    (extra ? " Outside the plan, " + extra + " more are typed." : "");
+  $("barfill").style.width = (100 * done / rows).toFixed(1) + "%";
+}
+function similarFor(r) {
+  const k = loose(r.e);
+  if (!k) return null;
+  const hit = looseIndex.get(k);
+  return hit && hit !== r && (typed[KEY(hit)] || "").trim() ? hit : null;
+}
+let looseIndex = new Map();
+function rebuildLoose() {
+  looseIndex = new Map();
+  for (const r of ROWS) if ((typed[KEY(r)] || "").trim()) { const k = loose(r.e); if (k && !looseIndex.has(k)) looseIndex.set(k, r); }
+}
+
+function refresh() {
+  const q = $("q").value.trim().toLowerCase(), show = $("show").value, sec = $("section").value, sort = $("sort").value;
+  const outside = $("outside").checked;
+  rebuildSame();
+  view = ROWS.filter(r => {
+    if (!r.plan && !outside && !own(r)) return false;      // outside the plan: listed only if typed, or on request
+    const src = copiedFor(r), h = own(r) || (src ? own(src) : "");
+    if (show === "todo" && h) return false;
+    if (show === "done" && !h) return false;
+    if (sec && r.fam !== sec) return false;
+    if (q && !(r.e.toLowerCase().includes(q) || h.toLowerCase().includes(q))) return false;
+    return true;
+  });
+  const cmp = {p: (a, b) => a.tier - b.tier || b.used - a.used || a.order - b.order || a.i - b.i,
+               u: (a, b) => b.used - a.used || a.tier - b.tier || a.order - b.order || a.i - b.i,
+               o: (a, b) => a.order - b.order || a.i - b.i}[sort];
+  view.sort(cmp);
+  rebuildLoose();
+  $("list").innerHTML = "";
+  painters.clear();
+  shown = 0;
+  more();
+  if (!view.length) $("list").innerHTML = '<p class="note">Nothing here.</p>';
+}
+function more() {
+  const frag = document.createDocumentFragment();
+  for (const r of view.slice(shown, shown + PAGE)) frag.appendChild(card(r, shown + 1 + frag.childNodes.length));
+  shown = Math.min(shown + PAGE, view.length);
+  $("list").appendChild(frag);
+  $("more").hidden = shown >= view.length;
+  $("more").textContent = "Show more (" + (view.length - shown) + " left)";
+}
+const painters = new Map();      // row number -> function that redraws that card's state
+function repaintSame(r) {
+  const k = exactKey(r.e), l = layoutKey(r.e);
+  for (const [i, fn] of painters) { const o = ROWS[i]; if (o !== r && (exactKey(o.e) === k || layoutKey(o.e) === l)) fn(); }
+}
+function card(r, n) {
+  const el = document.createElement("div");
+  const val = typed[KEY(r)] || "";
+  el.className = "item" + (val.trim() ? " done" : "");
+  const left = document.createElement("div"), right = document.createElement("div");
+  left.innerHTML = '<div class="meta"><span>#' + n + '</span><span class="chip' + (r.used > 1 ? " hot" : "") + '">fills ' + r.used + (r.used > 1 ? " places" : " place") +
+    '</span><span class="chip">' + esc(r.sec) + '</span>' + (r.plan ? "" : '<span class="chip">outside the plan</span>') + '<span title="' + esc(r.where) + '">' + esc(r.where.split("  (")[0]) + '</span></div><div class="en">' + showEnglish(r.e) + "</div>" +
+    (r.now ? '<div class="now">In the game now: ' + showEnglish(r.now) + "</div>" : "");
+  const ta = document.createElement("textarea");
+  ta.value = val; ta.spellcheck = false; ta.lang = "haa"; ta.rows = Math.min(6, Math.max(2, r.e.split("\n").length));
+  const under = document.createElement("div"); under.className = "under";
+  const count = document.createElement("span");
+  const copyNote = document.createElement("span");
+  const gameNote = document.createElement("span");
+  const useEn = document.createElement("button");
+  useEn.className = "small"; useEn.type = "button"; useEn.textContent = "Copy English";
+  useEn.title = "Keep the English for this line";
+  useEn.onclick = () => { ta.value = r.e; ta.dispatchEvent(new Event("input")); ta.focus(); };
+  const paint = () => {
+    const src = copiedFor(r), v = ta.value.trim() ? ta.value : (src ? typed[KEY(src)] : "");
+    el.classList.toggle("done", !!v.trim());
+    ta.placeholder = src ? typed[KEY(src)] : "";
+    useEn.hidden = !!ta.value.trim();
+    copyNote.textContent = src ? "Filled from the same English in " + src.sec + ". Type here only if this place needs something different." : "";
+    gameNote.textContent = gameNoteFor(r, v);
+    if (r.limit) { const n = letters(v.trim() ? gameForm(r, v).text : v); count.textContent = n + " of " + r.limit + " letters"; count.className = n > r.limit ? "over" : ""; }
+  };
+  painters.set(r.i, paint);
+  ta.addEventListener("input", () => {
+    if (ta.value.trim()) typed[KEY(r)] = ta.value;
+    else if (r.base) typed[KEY(r)] = "";            // remember that this one was cleared
+    else delete typed[KEY(r)];
+    dirty = true; persist(); progress(); paint(); repaintSame(r);
+  });
+  ta.addEventListener("focus", () => { lastField = ta; });
+  under.appendChild(useEn);
+  under.appendChild(count);
+  under.appendChild(gameNote);
+  under.appendChild(copyNote);
+  const sim = similarFor(r);
+  if (sim && !val.trim() && !copiedFor(r)) {
+    const hint = document.createElement("span");
+    hint.textContent = "You typed this for a similar line: " + typed[KEY(sim)].replace(/\n/g, " / ");
+    const use = document.createElement("button"); use.className = "small"; use.textContent = "Use it";
+    use.onclick = () => { ta.value = typed[KEY(sim)]; ta.dispatchEvent(new Event("input")); hint.remove(); use.remove(); };
+    under.appendChild(hint); under.appendChild(use);
+  }
+  right.appendChild(ta); right.appendChild(under);
+  el.appendChild(left); el.appendChild(right);
+  paint();
+  return el;
+}
+
+// letters that are slow to type
+let lastField = null;
+for (const ch of ["ą", "ę", "į", "ǫ", "ų", "ä", "ë", "ö", "ł", "Ł", "ǹ", "’", "̀", "̈", "̨"]) {
+  const b = document.createElement("button");
+  b.className = "small"; b.type = "button";
+  b.textContent = /[̀-ͯ]/.test(ch) ? "◌" + ch : ch;
+  b.title = {"̀": "low tone, goes on the letter before", "̈": "two dots, goes on the letter before", "̨": "nasal hook, goes on the letter before"}[ch] || "";
+  b.onmousedown = e => e.preventDefault();
+  b.onclick = () => {
+    if (!lastField) return;
+    const s = lastField.selectionStart, t = lastField.selectionEnd;
+    lastField.setRangeText(ch, s, t, "end");
+    lastField.dispatchEvent(new Event("input"));
+    lastField.focus();
+  };
+  $("keys").appendChild(b);
+}
+
+// files
+$("save").onclick = () => {
+  const rows = [];
+  for (const r of ROWS) { const h = (typed[KEY(r)] || "").trim(); if (h) rows.push({english: r.e, section: r.fam, han: typed[KEY(r)]}); }
+  const out = {format: "han-firered-translations", version: 1, saved: new Date().toISOString(), rows, rules: rules.filter(x => x.e && x.h).map(x => ({english: x.e, han: x.h}))};
+  const a = document.createElement("a");
+  a.href = URL.createObjectURL(new Blob([JSON.stringify(out, null, 1)], {type: "application/json"}));
+  a.download = "haa_firered-translations_coulson_" + new Date().toISOString().slice(0, 10) + ".json";
+  document.body.appendChild(a); a.click(); a.remove();
+  dirty = false; persist();
+};
+$("open").onclick = () => $("file").click();
+$("file").onchange = async e => {
+  const f = e.target.files[0];
+  if (!f) return;
+  try {
+    const d = JSON.parse(await f.text());
+    if (d.format !== "han-firered-translations") throw new Error("not a save file from this tool");
+    const byKey = new Map(ROWS.map(r => [KEY(r), r]));
+    let n = 0, lost = 0;
+    typed = {};
+    for (const row of d.rows) { const k = row.section + "\u0001" + row.english; if (byKey.has(k)) { typed[k] = row.han; n++; } else lost++; }
+    if (d.rules) rules = d.rules.map(x => ({e: x.english, h: x.han}));
+    dirty = false; persist(); progress(); refresh();
+    $("status").textContent = "Opened " + n + " rows" + (lost ? " (" + lost + " did not match this version of the game)" : "");
+  } catch (err) { $("status").textContent = "Could not open that file: " + err.message; }
+  e.target.value = "";
+};
+
+// rules
+function drawRules() {
+  const body = $("rulesBody"); body.innerHTML = "";
+  rules.forEach((r, i) => {
+    const tr = document.createElement("tr");
+    for (const k of ["e", "h"]) {
+      const td = document.createElement("td"), inp = document.createElement("input");
+      inp.value = r[k]; inp.oninput = () => { r[k] = inp.value; dirty = true; persist(); };
+      td.appendChild(inp); tr.appendChild(td);
+    }
+    const td = document.createElement("td"), del = document.createElement("button");
+    del.className = "small"; del.textContent = "Remove"; del.onclick = () => { rules.splice(i, 1); dirty = true; persist(); drawRules(); };
+    td.appendChild(del); tr.appendChild(td); body.appendChild(tr);
+  });
+}
+$("rulesBtn").onclick = () => { drawRules(); $("rules").showModal(); };
+$("addRule").onclick = () => { rules.push({e: "", h: ""}); drawRules(); };
+$("closeRules").onclick = () => $("rules").close();
+
+const fams = Array.from(new Set(ROWS.map(r => r.fam)));
+$("section").innerHTML = '<option value="">All kinds of text</option>' + fams.map(f => "<option>" + esc(f) + "</option>").join("");
+for (const id of ["q", "show", "section", "sort", "outside"]) $(id).addEventListener(id === "q" ? "input" : "change", refresh);
+$("more").onclick = more;
+window.addEventListener("beforeunload", e => { if (dirty) { e.preventDefault(); e.returnValue = ""; } });
+persist(); progress(); refresh();
+</script>
+</body>
+</html>
