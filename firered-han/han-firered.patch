+@ the game treats the player as having chosen the one that goes with it.
+PalletTown_ProfessorOaksLab_EventScript_NameStarterBall::
+	lock
+	faceplayer
+	specialvar PLAYER_STARTER_SPECIES, GetNameStarterSpecies
+	specialvar PLAYER_STARTER_NUM, GetNameStarterRivalChoice
+	call_if_eq PLAYER_STARTER_NUM, 0, PalletTown_ProfessorOaksLab_EventScript_RivalWillTakeCharmander
+	call_if_eq PLAYER_STARTER_NUM, 1, PalletTown_ProfessorOaksLab_EventScript_RivalWillTakeBulbasaur
+	call_if_eq PLAYER_STARTER_NUM, 2, PalletTown_ProfessorOaksLab_EventScript_RivalWillTakeSquirtle
