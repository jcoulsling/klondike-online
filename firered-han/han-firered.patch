+    if m:
+        name = m.group(1)
+        base = name.split("_")[0]
+        rank = 4000
+        for i, prefix in enumerate(STORY_ORDER):
+            if base == prefix:
+                rank = 1000 + i * 10
+                break
+        return "Map: " + name, rank
+    table = {
+        "src/data/text/species_names.h": ("Pokémon names", 9000),
+        "src/data/text/move_names.h": ("Move names", 9010),
+        "src/move_descriptions.c": ("Move descriptions", 9015),
