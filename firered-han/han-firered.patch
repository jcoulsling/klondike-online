+static const u8 sName_Tsa[]     = {CHAR_T, CHAR_S, CHAR_A, EOS};
+static const u8 sName_Laurie[]  = {CHAR_L, CHAR_A, CHAR_U, CHAR_R, CHAR_I, CHAR_E, EOS};
+static const u8 sName_Mandi[]   = {CHAR_M, CHAR_A, CHAR_N, CHAR_D, CHAR_I, EOS};
+static const u8 sName_Erika[]   = {CHAR_E, CHAR_R, CHAR_I, CHAR_K, CHAR_A, EOS};
+static const u8 sName_Allison[] = {CHAR_A, CHAR_L, CHAR_L, CHAR_I, CHAR_S, CHAR_O, CHAR_N, EOS};
+static const u8 sName_Allitsu[] = {CHAR_A, CHAR_L, CHAR_L, CHAR_I, CHAR_T, CHAR_S, CHAR_U, EOS};
+static const u8 sName_Jack[]    = {CHAR_J, CHAR_A, CHAR_C, CHAR_K, EOS};
