+def fd_tokens(source_text, cm):
+    """{VAR<n>} from the old tool -> the name the source uses for that fill-in."""
+    out = {}
+    for tok in cm.tokens(source_text):
+        if tok[0] == "b":
+            try:
+                data = cm.encode_token(tok)
+            except KeyError:
+                continue
+            if data[:1] == b"\xFD" and len(data) == 2:
+                out.setdefault(data[1], "{" + tok[1] + "}")
+    return out
+
+
+def modernise(han, group, cm):
+    table = fd_tokens(group.units[0].text, cm)
+
+    def repl(m):
+        n = int(m.group(1))
+        if n not in table:
+            raise ValueError("{VAR%d} is not in the English" % n)
+        return table[n]
+    return re.sub(r"\{VAR(\d+)\}", repl, han)
