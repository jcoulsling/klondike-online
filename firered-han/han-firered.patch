diff --git a/data/scripts/han_cheat.inc b/data/scripts/han_cheat.inc
new file mode 100644
index 0000000..dad0219
--- /dev/null
+++ b/data/scripts/han_cheat.inc
@@ -0,0 +1,15 @@
+@ Test builds (HAN_CHEAT in include/han_rowan.h): B+SELECT on the overworld becomes Rowan with the whole team. Does nothing in the real build.
+EventScript_HanCheat::
+	lockall
+	msgbox EventScript_HanCheat_Start, MSGBOX_DEFAULT
+	special HanCheatRowan
+	playse SE_EXP_MAX
+	msgbox EventScript_HanCheat_Text, MSGBOX_DEFAULT
+	releaseall
+	end
+
+EventScript_HanCheat_Text:
+	.string "ROWAN: team, badges and flags set.$"
+
+EventScript_HanCheat_Start:
+	.string "Setting up ROWAN...$"
diff --git a/data/scripts/han_hoenn.inc b/data/scripts/han_hoenn.inc
new file mode 100644
index 0000000..c9ef938
--- /dev/null
+++ b/data/scripts/han_hoenn.inc
@@ -0,0 +1,3113 @@
+@ Hän build: what the people and signs of Hoenn say until their lines are written in Hän (Jane).
+@ (generated place: hoenn/han_hoenn.inc)
+
+Hoenn_EventScript_Npc::
+	msgbox Hoenn_Text_Placeholder, MSGBOX_NPC
+	end
+
+Hoenn_EventScript_Sign::
+	msgbox Hoenn_Text_Placeholder, MSGBOX_SIGN
+	end
+
+Hoenn_Text_Placeholder:
+	.string "Han text to come.$"
+
+@ The Wild Area (src/han_wild.c): a Pokémon on the field was bumped into.
+HanWild_EventScript_Battle::
+	lockall
+	special HanWildStartBattle
+	dowildbattle
+	releaseall
+	end
+
+@ Surfing north off Route 124 into the Wild Area, and south off the island again (VAR_0x8005: 0 = in, 1 = out).
+HanWild_EventScript_SurfIn::
+	lockall
+	special HanWildEdgeX
+	warp MAP_HAN_WILD_AREA, 255, VAR_0x8004, 62
+	waitstate
+	end
+
+HanWild_EventScript_SurfOut::
+	lockall
+	warp MAP_ROUTE124, 255, 52, 1
+	waitstate
+	end
+
+@ A hole dug in the ice (DIG on the pond): the tile in front turns to water.
+HanWild_EventScript_DigIce::
+	lockall
+	special HanWildMakeHole
+	msgbox HanWild_Text_DugHole, MSGBOX_DEFAULT
+	releaseall
+	end
+
+HanWild_Text_DugHole:
+	.string "Han text to come.\n"
+	.string "The ice cracked open into water!$"
+
+@ Facing a hole in the ice: dive down to the sea floor, which leads out behind the north end of the island.
+HanWild_EventScript_Dive::
+	lockall
+	msgbox HanWild_Text_DiveAsk, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, HanWild_EventScript_DiveNo
+	warp MAP_HAN_WILD_UNDERWATER, 255, 16, 44
+	waitstate
+	end
+
+HanWild_EventScript_DiveNo::
+	releaseall
+	end
+
+HanWild_Text_DiveAsk:
+	.string "Han text to come.\n"
+	.string "The water is deep. Dive in?$"
+
+HanWild_EventScript_Surface::
+	lockall
+	warp MAP_HAN_WILD_AREA, 255, 15, 0
+	waitstate
+	end
+
+@ The cabin across the river: an old man with a different team every time. Always ready to battle again.
+HanWild_EventScript_OldMan::
+	lock
+	faceplayer
+	msgbox HanWild_Text_OldManIntro, MSGBOX_DEFAULT
+	trainerbattle_no_intro TRAINER_HAN_OLD_MAN, HanWild_Text_OldManDefeat
+	msgbox HanWild_Text_OldManAfter, MSGBOX_DEFAULT
+	cleartrainerflag TRAINER_HAN_OLD_MAN
+	release
+	end
+
+HanWild_Text_OldManIntro:
+	.string "Han text to come.\n"
+	.string "Ha! Few come this far. Let us battle!$"
+
+HanWild_Text_OldManDefeat:
+	.string "Han text to come.\n"
+	.string "Well fought!$"
+
+HanWild_Text_OldManAfter:
+	.string "Han text to come.\n"
+	.string "Come back any time.$"
+
+@ The ship from the Wild Area: a sailor on the dock takes you to any port.
+HanWild_EventScript_FerrySailor::
+	lock
+	faceplayer
+	message Text_WhereDoYouWantToSail
+	waitmessage
+	setvar VAR_0x8004, SEAGALLOP_WILD
+	goto EventScript_SeviiDestinationsPage1
+	end
+
+@ Mauville Game Corner: the coin clerk gives the COIN CASE first, then sells coins the way Celadon's does; the slot machines are Celadon's.
+Hoenn_GameCorner_Clerk::
+	goto_if_set FLAG_GOT_COIN_CASE, CeladonCity_GameCorner_EventScript_CoinsClerk
+	lock
+	faceplayer
+	msgbox Hoenn_GameCorner_Text_CoinCase, MSGBOX_DEFAULT
+	giveitem ITEM_COIN_CASE
+	setflag FLAG_GOT_COIN_CASE
+	release
+	end
+
+Hoenn_GameCorner_Text_CoinCase:
+	.string "Welcome to the GAME CORNER!\n"
+	.string "Please take this COIN CASE.$"
+
+@ The roulette tables: Emerald's roulette is its own program and has not been brought across.
+Hoenn_GameCorner_Roulette::
+	msgbox Hoenn_GameCorner_Text_RouletteClosed, MSGBOX_SIGN
+	end
+
+Hoenn_GameCorner_Text_RouletteClosed:
+	.string "The roulette table is closed.\n"
+	.string "Try the slot machines instead.$"
+
