+// ---------------------------------------------------------------------------
+// Hän build: a fourth starter for some player names.
+//
+// If the player's name is on this list, a fourth ball lies beside the table in
+// PROF. OAK's lab. Capitals and small letters count as the same, so JEM, Jem
+// and jem all match. A name can be 7 letters at most, so ALLITSUL is matched by
+// its first 7.
+//
+// The names are spelled out letter by letter on purpose: text written as _("...")
+// is picked up by the translation tool, and these must never be translated.
+// ---------------------------------------------------------------------------
+struct NameStarter
+{
+    const u8 *name;         // in capitals
+    u16 species;
+    u16 moves[2];           // more moves it starts with, or MOVE_NONE
+    u16 item;               // what it holds, or ITEM_NONE
+    u8 rivalChoice;         // the rival then takes: 0 CHARMANDER, 1 BULBASAUR, 2 SQUIRTLE
+    bool8 gift;             // shiny, female, the best hidden numbers, and marked: see NameStarter_HasBonus
+};
+
+// The mark is one of the four ribbon bits the game never uses. Bit 0 is the
+// Nuzlocke "dead" mark. A marked Pokémon has 50 more in every stat (see
+// CalculateMonStats) and its THUNDER never misses (see AccuracyCalcHelper).
+// The mark stays with it in the PC and when it evolves.
+#define NAME_STARTER_BONUS_MARK 2
+
+static const u8 sName_Jem[]     = {CHAR_J, CHAR_E, CHAR_M, EOS};
+static const u8 sName_Jane[]    = {CHAR_J, CHAR_A, CHAR_N, CHAR_E, EOS};
+static const u8 sName_Teresa[]  = {CHAR_T, CHAR_E, CHAR_R, CHAR_E, CHAR_S, CHAR_A, EOS};
+static const u8 sName_Tsa[]     = {CHAR_T, CHAR_S, CHAR_A, EOS};
+static const u8 sName_Laurie[]  = {CHAR_L, CHAR_A, CHAR_U, CHAR_R, CHAR_I, CHAR_E, EOS};
+static const u8 sName_Mandi[]   = {CHAR_M, CHAR_A, CHAR_N, CHAR_D, CHAR_I, EOS};
+static const u8 sName_Erika[]   = {CHAR_E, CHAR_R, CHAR_I, CHAR_K, CHAR_A, EOS};
+static const u8 sName_Allison[] = {CHAR_A, CHAR_L, CHAR_L, CHAR_I, CHAR_S, CHAR_O, CHAR_N, EOS};
+static const u8 sName_Allitsu[] = {CHAR_A, CHAR_L, CHAR_L, CHAR_I, CHAR_T, CHAR_S, CHAR_U, EOS};
+static const u8 sName_Jack[]    = {CHAR_J, CHAR_A, CHAR_C, CHAR_K, EOS};
+static const u8 sName_Owen[]    = {CHAR_O, CHAR_W, CHAR_E, CHAR_N, EOS};
+static const u8 sName_Rowan[]   = {CHAR_R, CHAR_O, CHAR_W, CHAR_A, CHAR_N, EOS};
+static const u8 sName_Yuhke[]   = {CHAR_Y, CHAR_U, CHAR_H, CHAR_K, CHAR_E, EOS};
+
+static const struct NameStarter sNameStarters[] =
+{
+    {sName_Jem,     SPECIES_WYNAUT,   {MOVE_CONFUSION,   MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Jane,    SPECIES_GASTLY,   {MOVE_DREAM_EATER, MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Teresa,  SPECIES_ABRA,     {MOVE_CONFUSION,   MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Tsa,     SPECIES_ABRA,     {MOVE_CONFUSION,   MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Laurie,  SPECIES_RALTS,    {MOVE_NONE,        MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Mandi,   SPECIES_DRATINI,  {MOVE_TWISTER,     MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Erika,   SPECIES_ODDISH,   {MOVE_BULLET_SEED, MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Allison, SPECIES_POLIWAG,  {MOVE_ICY_WIND,    MOVE_NONE}, ITEM_NONE,       1, FALSE},
+    {sName_Allitsu, SPECIES_POLIWAG,  {MOVE_ICY_WIND,    MOVE_NONE}, ITEM_NONE,       1, FALSE},
+    {sName_Jack,    SPECIES_TOTODILE, {MOVE_NONE,        MOVE_NONE}, ITEM_NONE,       1, FALSE},
+    {sName_Owen,    SPECIES_CLEFFA,   {MOVE_NONE,        MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Rowan,   SPECIES_PIKACHU,  {MOVE_THUNDER,     MOVE_SURF}, ITEM_LIGHT_BALL, 1, TRUE},
+    {sName_Yuhke,   SPECIES_AZURILL,  {MOVE_NONE,        MOVE_NONE}, ITEM_NONE,       0, FALSE},
