+#!/usr/bin/env python3
+"""Hän glyphs for pokefirered.
+
+Draws every Hän letter the stock game font lacks into the empty cells of the
+Latin fonts, updates the glyph width tables in src/text.c, and writes the
+matching charmap.txt entries.
+
+Every glyph is built from the game's own letterforms: the base letter and its
+grave / diaeresis come straight out of the stock font, and only the ogonek
+(nasal hook), the stroke on l, and the asterisk are new pixels.
+
+Run from the repo root:  python3 tools/han/han_font.py
+It is safe to run more than once.
+"""
+import re
+import sys
+import unicodedata
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+FONT_DIR = ROOT / "graphics" / "fonts"
+
+# palette indices used by the font PNGs
+OUT, INK, SHADOW, BG = 0, 1, 2, 3
+
+GRAVE, DIAERESIS, OGONEK = "̀", "̈", "̨"
+
+# stock glyph codes this script builds from
+STOCK = {
+    "a": dict(lc=0xD5, uc=0xBB, lc_grave=0x16, uc_grave=0x01, lc_dia=0xF4, uc_dia=0xF1),
+    "e": dict(lc=0xD9, uc=0xBF, lc_grave=0x1A, uc_grave=0x05, lc_dia=0x1D, uc_dia=0x08),
+    "i": dict(lc=0xDD, uc=0xC3, lc_grave=0x1E, uc_grave=0x09),
+    "o": dict(lc=0xE3, uc=0xC9, lc_grave=0x22, uc_grave=0x0D, lc_dia=0xF5, uc_dia=0xF2),
+    "u": dict(lc=0xE9, uc=0xCF, lc_grave=0x26, uc_grave=0x11),
+}
+L_LC, L_UC, N_LC, N_UC = 0xE0, 0xC6, 0xE2, 0xC8
+
+# ---------------------------------------------------------------------------
+# The glyph list: (code, text, recipe)
+#   recipe = (base letter, "lc"/"uc", diaeresis?, grave?, ogonek?)  or a name
+# ---------------------------------------------------------------------------
+def vowel_forms(letter, with_diaeresis):
+    forms = [(False, False, True), (False, True, True)]           # ą  ą̀
+    if with_diaeresis:
+        forms += [(True, True, False), (True, False, True), (True, True, True)]  # ä̀ ą̈ ą̈̀
+    return [(letter, d, g, o) for d, g, o in forms]
+
+def build_glyph_list():
+    out = []
+    lower = (vowel_forms("a", True) + vowel_forms("e", True) + vowel_forms("o", True)
+             + vowel_forms("i", False) + vowel_forms("u", False))
+    code = 0x37
+    for letter, d, g, o in lower:
+        out.append((code, letter, (letter, "lc", d, g, o)))
+        code += 1
+    out.append((code, "ł", "l_stroke_lc")); code += 1      # 0x4A
+    out.append((code, "ǹ", "n_grave_lc")); code += 1       # 0x4B
+    out.append((code, "*", "asterisk")); code += 1         # 0x4C
+    code = 0x87
+    for letter, d, g, o in lower:
+        out.append((code, letter.upper(), (letter, "uc", d, g, o)))
+        code += 1
+    out.append((code, "Ł", "l_stroke_uc")); code += 1      # 0x9A
+    out.append((code, "Ǹ", "n_grave_uc")); code += 1       # 0x9B
+    final = []
+    for code, base, recipe in out:
+        if isinstance(recipe, tuple):
+            _, _, d, g, o = recipe
+            text = base + (OGONEK if o else "") + (DIAERESIS if d else "") + (GRAVE if g else "")
+            text = unicodedata.normalize("NFC", text)
+        else:
+            text = base
+        final.append((code, text, recipe))
+    return final
+
+GLYPHS = build_glyph_list()
+
+# ---------------------------------------------------------------------------
+# Font geometry
+# ---------------------------------------------------------------------------
+class Font:
+    def __init__(self, kind):
+        self.kind = kind
+        if kind == "normal":
+            self.files = ["latin_normal", "latin_male", "latin_female"]
+            self.cw = 16                 # cell width in the sheet
+            self.rows = range(0, 14)     # rows the game draws
+            self.bg_rows = range(0, 14)  # rows painted as background inside the width
+            self.lc_mark_rows = (3, 4)   # where the stock lowercase accent sits
+            self.uc_mark_rows = (0, 1)   # where the stock capital accent sits
+            self.stack_grave_rows = (0, 1)
+            self.cap_rows = (3, 10)
+            self.ogonek_rows = (11, 12)
+            self.width_tables = ["sFontNormalCopy1LatinGlyphWidths", "sFontNormalLatinGlyphWidths",
+                                 "sFontMaleLatinGlyphWidths", "sFontFemaleLatinGlyphWidths"]
+        else:
+            self.files = ["latin_small"]
+            self.cw = 8
+            self.rows = range(0, 13)
+            self.bg_rows = range(1, 13)
+            self.lc_mark_rows = (3, 4)
+            self.uc_mark_rows = (1, 2)
+            self.stack_grave_rows = (1, 2)
+            self.cap_rows = (4, 10)
+            self.ogonek_rows = (11, 12)
+            self.width_tables = ["sFontSmallLatinGlyphWidths"]
+        self.cols = 256 // self.cw
+        self.img = Image.open(FONT_DIR / (self.files[0] + ".png"))
+        self.widths = None
+
+    def cell_origin(self, code):
+        return (code % self.cols) * self.cw, (code // self.cols) * 16
+
+    def read(self, code):
+        x0, y0 = self.cell_origin(code)
+        return [[self.img.getpixel((x0 + x, y0 + y)) for x in range(self.cw)] for y in range(16)]
+
+    def write(self, code, g):
+        x0, y0 = self.cell_origin(code)
+        for y in range(16):
+            for x in range(self.cw):
+                self.img.putpixel((x0 + x, y0 + y), g[y][x])
+
+# ---------------------------------------------------------------------------
+# Pixel helpers.  A glyph is a 16-row list of rows; ink is what matters,
+# shadow is the light grey the game paints right of and below each ink pixel.
+# ---------------------------------------------------------------------------
+def ink_pixels(g, rows=None):
+    return [(x, y) for y in (rows or range(16)) for x in range(len(g[0])) if g[y][x] == INK]
+
+def marks_only(g, rows):
+    """ink + shadow pixels in the given rows"""
+    return [(x, y, g[y][x]) for y in rows for x in range(len(g[0])) if g[y][x] in (INK, SHADOW)]
+
+def put_ink(g, pixels, font, shadow_below=True):
+    """Add ink pixels with the font's usual shadow (right, below, below-right)."""
+    last_row = font.rows[-1]
+    for x, y in pixels:
+        g[y][x] = INK
+    for x, y in pixels:
+        for dx, dy in ((1, 0), (0, 1), (1, 1)):
+            if dy and not shadow_below:
+                continue
+            sx, sy = x + dx, y + dy
+            if sy > last_row or sx >= len(g[0]):
+                continue
+            if g[sy][sx] != INK:
+                g[sy][sx] = SHADOW
+
+def set_width(g, width, font, extra_rows=()):
+    """Paint the background inside the advance width and blank everything outside it."""
+    for y in range(16):
+        inside_row = y in font.bg_rows or y in extra_rows
+        for x in range(len(g[0])):
+            if g[y][x] in (INK, SHADOW):
+                continue
+            g[y][x] = BG if (inside_row and x < width) else OUT
+    return g
+
+def needed_width(g, base_width):
+    xs = [x for x, _ in ink_pixels(g)]
+    return max(base_width, max(xs) + 2) if xs else base_width
+
+def shift_right(g, n=1):
+    return [[OUT] * n + row[:-n] for row in g]
+
+def clear_rows(g, rows):
+    for y in rows:
+        for x in range(len(g[0])):
+            if g[y][x] in (INK, SHADOW):
+                g[y][x] = BG
+
+# ---------------------------------------------------------------------------
+# Marks
+# ---------------------------------------------------------------------------
+# Column the ogonek hangs from, per letter.  The hook is an L: two pixels down
+# from the letter, then one to the right.
+OGONEK_COL = {
+    "normal": {"a": 3, "e": 3, "i": 1, "o": 2, "u": 3, "A": 3, "E": 3, "I": 2, "O": 2, "U": 3},
+    "small":  {"a": 2, "e": 2, "i": 1, "o": 2, "u": 2, "A": 2, "E": 2, "I": 1, "O": 2, "U": 2},
+}
+
+def add_ogonek(g, letter, font):
+    c = OGONEK_COL[font.kind][letter]
+    r0, r1 = font.ogonek_rows
+    put_ink(g, [(c, r0), (c, r1), (c + 1, r1)], font)
+
+# Which row of the capital to drop when it has to make room for two marks.
+# Always a plain stem row, so the letter keeps its shape and loses one pixel of height.
+CAP_DROP_ROW = {
+    "normal": {"a": 6, "e": 9, "o": 6},
+    "small":  {"a": 9, "e": 9, "o": 7},
+}
+
+def stacked_capital(font, letter):
+    """Capital + diaeresis + grave.  There is no room for two marks above a
+    full-height capital, so the letter is one row shorter and the marks sit in
+    the space that frees up."""
+    base = font.read(STOCK[letter]["uc"])
+    top, bottom = font.cap_rows
+    drop = CAP_DROP_ROW[font.kind][letter]
+    g = [row[:] for row in base]
+    letter_rows = [base[y] for y in range(top, bottom + 2) if y != drop]   # includes the shadow row
+    clear_rows(g, range(0, bottom + 2))
+    for i, row in enumerate(letter_rows):
+        g[top + 1 + i] = row[:]
+    # the dot positions come from the stock capital-with-diaeresis
+    dia = font.read(STOCK[letter]["uc_dia"])
+    dot_cols = sorted({x for x, y in ink_pixels(dia, range(font.uc_mark_rows[0], font.uc_mark_rows[1] + 1))})
+    if font.kind == "normal":
+        # rows: 0-1 grave, 2 dots, 3 dot shadow, 4-10 letter
+        put_ink(g, [(x, 2) for x in dot_cols], font)
+        mid = (dot_cols[0] + dot_cols[-1]) // 2
+        for x, y in ((mid - 1, 0), (mid, 1)):
+            g[y][x] = INK
+        for x, y in ((mid, 0), (mid + 1, 1)):
+            if g[y][x] != INK:
+                g[y][x] = SHADOW
+    else:
+        # rows: 0-1 grave, 2 gap, 3 dots, 4 gap, 5-10 letter
+        for x in dot_cols:
+            g[3][x] = INK
+            if g[3][x + 1] != INK:
+                g[3][x + 1] = SHADOW
+        for x, y in ((1, 0), (2, 1)):
+            g[y][x] = INK
+        for x, y in ((2, 0), (3, 1)):
+            if g[y][x] != INK:
+                g[y][x] = SHADOW
+    return g
+
+def compose_vowel(font, letter, case, dia, grave, ogonek):
+    s = STOCK[letter]
+    extra_rows = ()
+    if dia and grave:
+        if case == "lc":
+            g = font.read(s["lc_dia"])
+            src = font.read(s["lc_grave"])
+            a, b = font.lc_mark_rows
+            dy = font.stack_grave_rows[0] - a
+            for x, y, v in marks_only(src, range(a, b + 1)):
+                g[y + dy][x] = v
+        else:
+            g = stacked_capital(font, letter)
+            extra_rows = (0,)
+    elif dia:
+        g = font.read(s[case + "_dia"])
+    elif grave:
+        g = font.read(s[case + "_grave"])
+    else:
+        g = font.read(s[case])
+    if ogonek:
+        add_ogonek(g, letter.upper() if case == "uc" else letter, font)
+    return g, extra_rows
+
+def stem_col(g, row=8):
+    return min(x for x, y in ink_pixels(g, [row]))
+
+def compose_special(font, name):
+    w = font.widths
+    if name == "l_stroke_lc":
+        g = font.read(L_LC)
+        extra = 0
+        if stem_col(g) == 0:
+            g, extra = shift_right(g), 1
+        s = stem_col(g)
+        put_ink(g, [(s + 1, 6), (s - 1, 8)], font)
+        return g, w[L_LC] + extra
+    if name == "l_stroke_uc":
+        g = shift_right(font.read(L_UC))
+        s = stem_col(g)
+        put_ink(g, [(s + 1, 6), (s - 1, 8)], font)
+        return g, w[L_UC] + 1
+    if name == "n_grave_lc":
+        g = font.read(N_LC)
+        src = font.read(STOCK["a"]["lc_grave"])
+        a, b = font.lc_mark_rows
+        for x, y, v in marks_only(src, range(a, b + 1)):
+            g[y][x - 1 if font.kind == "normal" else x] = v
+        return g, w[N_LC]
+    if name == "n_grave_uc":
+        g = font.read(N_UC)
+        src = font.read(STOCK["a"]["uc_grave"])
+        a, b = font.uc_mark_rows
+        for x, y, v in marks_only(src, range(a, b + 1)):
+            g[y][x] = v
+        return g, w[N_UC]
+    if name == "asterisk":
+        g = [[OUT] * font.cw for _ in range(16)]
+        pattern = ["..#..", "#.#.#", ".###.", "#.#.#", "..#.."]
+        top = 4
+        put_ink(g, [(x, top + y) for y, row in enumerate(pattern) for x, ch in enumerate(row) if ch == "#"], font)
+        return g, 6
+    raise ValueError(name)
+
+# ---------------------------------------------------------------------------
+# Width tables in src/text.c
+# ---------------------------------------------------------------------------
+def read_widths(src, table):
+    m = re.search(r"static const u8 " + table + r"\[\]\s*=\s*\n?\{(.*?)\};", src, re.S)
+    return [int(v) for v in re.findall(r"\d+", m.group(1))], m
+
+def write_widths(src, table, values):
+    _, m = read_widths(src, table)
+    lines = []
+    for i in range(0, len(values), 14):
+        lines.append("    " + ", ".join("%2d" % v for v in values[i:i + 14]))
+    body = "\n" + ",\n".join(lines) + "\n"
+    return src[:m.start(1)] + body + src[m.end(1):]
+
+# ---------------------------------------------------------------------------
+def main():
+    text_c = ROOT / "src" / "text.c"
+    src = text_c.read_text()
+    report = []
+    for kind in ("normal", "small"):
+        font = Font(kind)
+        font.widths, _ = read_widths(src, font.width_tables[0])
+        new_widths = {}
+        for code, text, recipe in GLYPHS:
+            if isinstance(recipe, tuple):
+                letter, case, dia, grave, ogonek = recipe
+                g, extra_rows = compose_vowel(font, letter, case, dia, grave, ogonek)
+                base_w = font.widths[STOCK[letter][case]]
+            else:
+                g, base_w = compose_special(font, recipe)
+                extra_rows = ()
+            width = needed_width(g, base_w)
+            set_width(g, width, font, extra_rows)
+            font.write(code, g)
+            new_widths[code] = width
+            report.append((kind, code, text, width))
+        for name in font.files:
+            font.img.save(FONT_DIR / (name + ".png"), bits=2)
+        for table in font.width_tables:
+            values, _ = read_widths(src, table)
+            for code, width in new_widths.items():
+                values[code] = width
+            src = write_widths(src, table, values)
+    text_c.write_text(src)
+
+    # charmap.txt
+    charmap = ROOT / "charmap.txt"
+    cm = charmap.read_text(encoding="utf-8")
+    begin, end = "@ Hän letters (tools/han/han_font.py)\n", "@ end of Hän letters\n"
+    block = begin
+    for code, text, _ in GLYPHS:
+        block += "'%s' = %02X\n" % (text, code)
+    block += "'ʼ' = B4\n"      # modifier letter apostrophe, same glyph as ’
+    block += end
+    if begin in cm:
+        cm = cm[:cm.index(begin)] + block + cm[cm.index(end) + len(end):]
+    else:
+        anchor = "@ Arrows at F7-FA are duplicates"
+        i = cm.index(anchor)
+        cm = cm[:i] + block + cm[i:]
+    charmap.write_text(cm, encoding="utf-8")
+
+    by_code = {}
+    for kind, code, text, width in report:
+        by_code.setdefault(code, [text, None, None])[1 if kind == "normal" else 2] = width
+    for code in sorted(by_code):
+        text, wn, ws = by_code[code]
+        print("0x%02X  %-3s  width %d (normal)  %d (small)" % (code, text, wn, ws))
+    print("%d glyphs written to 4 font sheets" % len(by_code))
+
+if __name__ == "__main__":
+    main()
