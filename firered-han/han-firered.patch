+// ---------------------------------------------------------------------------
+// Hän build: in syllabics a proper name starts with an asterisk
+// ---------------------------------------------------------------------------
+// Proper names are people, Pokémon and places. The game knows a name when it is written exactly as
+// in one of its lists: the Pokémon names, the trainer names, the map names, the extra names in
+// data/han_syllabics.h, the player's and the rival's name, and the nicknames of the Pokémon on both
+// sides of a battle. Nothing is added to the text: the asterisk is only drawn.
+
+static EWRAM_DATA const u8 *sHanSylWordEnd = NULL;     // where the last letter drawn ended: text that goes on from there is inside a word
+static EWRAM_DATA const u8 *sHanSylNamePending = NULL; // the name whose asterisk is drawn and whose first letter is not yet
+static EWRAM_DATA const u8 *sHanSylNameBegin = NULL;   // the last name that got its asterisk: from here
+static EWRAM_DATA const u8 *sHanSylNameEnd = NULL;     // to here
+static EWRAM_DATA const u8 *sHanEngStart = NULL;       // the English word being drawn: the printer comes back to its first letter for each glyph
+static EWRAM_DATA u8 sHanEngIndex = 0;                 // which of its glyphs is drawn next
+
+struct HanSylWalk // the same, for measuring a string from start to end
+{
+    const u8 *wordEnd;
+    const u8 *nameEnd;
+};
+
+// A new string is about to be printed. Text buffers are used again and again, so what was noted
+// about the last string must not be read as being about this one.
+void HanSyl_ResetNames(void)
+{
+    sHanSylWordEnd = NULL;
+    sHanSylNamePending = NULL;
+    sHanSylNameBegin = NULL;
+    sHanSylNameEnd = NULL;
+    sHanEngStart = NULL;
+}
+
+// a to z or ł, with or without marks, in either case. Not the apostrophe.
+static bool8 HanSyl_IsLetter(u8 c)
+{
+    u8 letter = sHanSylLetters[c] & HAN_SYL_LETTER_MASK;
+
+    return letter != 0 && letter != HAN_SYL_APOSTROPHE;
+}
+
+static bool8 HanSyl_IsCapital(u8 c)
+{
+    return (c >= CHAR_A && c <= CHAR_Z)     // A to Z
+        || (c >= 0x87 && c <= 0x9B)         // the capitals added for Hän
+        || (c >= 0x01 && c <= 0x15)         // the game's own accented capitals
+        || (c >= 0xF1 && c <= 0xF3);
+}
+
+// The length of the name, if the text at s is that name and a word ends after it. Else 0.
+// A name ends at EOS or after max characters.
+static u32 HanSyl_NameMatch(const u8 *s, const u8 *name, u32 max)
+{
+    u32 i;
+    u8 next;
+
+    for (i = 0; i < max && name[i] != EOS; i++)
+    {
+        if (s[i] != name[i])
+            return 0;
+    }
+    if (i == 0)
+        return 0;
+    next = s[i];
+    if (HanSyl_IsLetter(next) || (next >= CHAR_0 && next <= CHAR_9))
+        return 0;
+    return i;
+}
+
+// TRUE if name is one of the names of a list in which each name ends with EOS, and so does the list.
+static bool8 HanSyl_InList(const u8 *list, const u8 *name, u32 max)
+{
+    u32 i;
+
+    while (*list != EOS)
+    {
+        for (i = 0; i < max && name[i] != EOS && list[i] == name[i]; i++)
+            ;
+        if (list[i] == EOS && (i == max || name[i] == EOS))
+            return TRUE;
+        while (*list++ != EOS)
+            ;
+    }
+    return FALSE;
+}
+
+// The length of the longest proper name that starts at s, or 0.
+static u32 HanSyl_NameLength(const u8 *s)
+{
+    u32 best = 0;
+    u32 length, i;
+    const u8 *name;
+    u8 first = *s;
+
+#define TRY_NAME(ptr, max)                    \
+    {                                         \
+        length = HanSyl_NameMatch(s, ptr, max); \
+        if (length > best)                    \
+            best = length;                    \
+    }
+
+    // names the player typed: any case
+    TRY_NAME(gSaveBlock2Ptr->playerName, PLAYER_NAME_LENGTH)
