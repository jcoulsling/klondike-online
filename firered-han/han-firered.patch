+#include "data/han_follow_ball.h"
+#include "palette.h"
+#include "sound.h"
+#include "util.h"
+#include "constants/songs.h"
+#include "field_control_avatar.h"
+
+// Hän build: a follower Pokémon (Jane, 22 November 2026).
+//
+// The first Pokémon of the party that can still fight is drawn behind the player, like the other players are in
+// src/han_multiplayer.c: a plain sprite, not an object event. So it cannot be talked to, blocks nothing, and is not
+// in the save; every map load destroys it and it is made again. It walks the way the player came, one tile behind.
+// The pictures are in ROM (sHanFollowSheets); only the table of nine frames and the palette are in RAM.
+
+#define FOLLOW_TAG 0x4B0F
+
+EWRAM_DATA struct SpriteFrameImage gHanFollowImages[9] = {0};
+EWRAM_DATA u16 gHanFollowPal[16] = {0};
+static EWRAM_DATA u8 sSpriteId = 0;   // the sprite plus 1; 0 for none
+static EWRAM_DATA u16 sSpecies = 0;   // what the frames and palette were last made for (bit 15: shiny)
+// The follower walks the player's own path, in pixels: the player's sprite position is written down every frame it
+// changes, and the follower stands where the player was 16 pixels (one tile) of walking ago. So it moves exactly when
+// the player moves, at the player's speed (walk, run, bike), round every corner, and stops one tile behind.
+#define TRAIL_N 20
+static EWRAM_DATA s16 sTrailX[TRAIL_N] = {0};   // newest at sTrailHead, going back
+static EWRAM_DATA s16 sTrailY[TRAIL_N] = {0};
+static EWRAM_DATA u8 sTrailHead = 0;
+static EWRAM_DATA u8 sTrailLen = 0;
+static EWRAM_DATA u8 sFacing = 0;
+
+// The Poké Ball (as in HeartGold and SoulSilver): after a door, stairs or any warp the follower is let out of a ball
+// beside the player (never on a door), and it goes back into its ball when the player steps into a warp, or when it would be
+// standing on a door. Crossing from one route to the next keeps it where it is, with no ball.
+enum { PH_NORMAL, PH_WAIT, PH_BALL, PH_FADEOUT, PH_DEAD };
+static EWRAM_DATA u8 sPhase = 0;
+static EWRAM_DATA u8 sTimer = 0;
+static EWRAM_DATA bool8 sWarped = FALSE;     // a warp happened since the follower was last made
+static EWRAM_DATA bool8 sRecallForWarp = FALSE;
+static EWRAM_DATA s16 sBallX = 0;
+static EWRAM_DATA s16 sBallY = 0;
+static EWRAM_DATA bool8 sPlaceFail = FALSE;
+
+void HanFollowerWarped(void)
+{
+    sWarped = TRUE;
+}
+
+// the player steps into a warp: the follower goes back into its ball while the screen fades
+void HanFollowerRecall(void)
+{
+    sWarped = TRUE;
+    if (sPhase == PH_NORMAL)
+    {
+        sPhase = PH_FADEOUT;
+        sTimer = 0;
+        sRecallForWarp = TRUE;
+    }
+}
+
+static void SpriteCB_Follower(struct Sprite *sprite)
+{
+}
+
+// The first Pokémon that is not an egg and can fight; 0 if there is none. Bit 15 is set if it is shiny.
+static u16 LeadSpecies(void)
+{
+    u8 i;
+    u16 species;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        species = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES);
+        if (species == SPECIES_NONE || GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            continue;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_HP) == 0)
+            continue;
+        if (species >= HAN_FOLLOW_SPECIES || sHanFollowIndex[species] == 0xFFFF)
+            return 0;
+        return species | (IsMonShiny(&gPlayerParty[i]) ? 0x8000 : 0);
+    }
+    return 0;
+}
+
+// Point the nine frames of a normal sprite sheet at the six of the picture, and the palette at its colours.
+static void MakeFrames(u16 what)
+{
+    const u8 *sheet = (const u8 *)sHanFollowSheets + sHanFollowIndex[what & 0x7FFF] * 6 * 0x200;
+    // frames: 0 south, 1 north, 2 west, then three pairs of walking frames
+    static const u8 order[9] = {0, 2, 4, 1, 1, 3, 3, 5, 5};
+    u8 i, idx;
+
+    for (i = 0; i < 9; i++)
+    {
+        gHanFollowImages[i].data = sheet + order[i] * 0x200;
+        gHanFollowImages[i].size = 0x200;
+    }
+    CpuCopy16(&sHanFollowPal[sHanFollowIndex[what & 0x7FFF] * 32 + ((what & 0x8000) ? 16 : 0)], gHanFollowPal, PLTT_SIZE_4BPP);
+    idx = IndexOfSpritePaletteTag(OBJ_EVENT_PAL_TAG_HAN_FOLLOWER);
+    if (idx != 0xFF)
+        LoadPalette(gHanFollowPal, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+    sSpecies = what;
+}
+
+static void Destroy(void)
+{
+    struct Sprite *sprite = &gSprites[sSpriteId - 1];
+
+    if (sSpriteId != 0 && sprite->inUse && sprite->data[7] == FOLLOW_TAG)
+        DestroySprite(sprite);
+    sSpriteId = 0;
+}
+
+static void PaletteIdx(u8 *idx)
+{
+    *idx = IndexOfSpritePaletteTag(OBJ_EVENT_PAL_TAG_HAN_FOLLOWER);
+}
+
+// the ball: its picture and colours instead of the Pokémon's
+static void ShowBall(struct Sprite *sprite)
+{
+    u8 idx;
+
+    gHanFollowImages[0].data = sHanBallFrame;
+    PaletteIdx(&idx);
+    if (idx != 0xFF)
+        LoadPalette(sHanBallPal, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+    StartSpriteAnim(sprite, GetFaceDirectionAnimNum(DIR_SOUTH));
+}
+
+// the Pokémon's own picture and colours again, the colours washed to white by coeff (16 is all white)
+static void ShowMon(struct Sprite *sprite, u8 coeff)
+{
+    u8 idx;
+
+    if (sSpecies != 0)
+    {
+        const u8 *sheet = (const u8 *)sHanFollowSheets + sHanFollowIndex[sSpecies & 0x7FFF] * 6 * 0x200;
+
+        gHanFollowImages[0].data = sheet;
+    }
+    PaletteIdx(&idx);
+    if (idx != 0xFF)
+    {
+        LoadPalette(gHanFollowPal, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+        if (coeff != 0)
+            BlendPalette(OBJ_PLTT_ID(idx), 16, coeff, RGB_WHITE);
+    }
+    StartSpriteAnim(sprite, GetFaceDirectionAnimNum(sFacing));
+}
+
+// Where the follower may be let out: one tile behind the player, and only when the player is at least two tiles from a
+// door (so the ball never lies on a door, nor next to one)
+static bool8 FindSpot(struct Sprite *player, s16 *ox, s16 *oy)
+{
+    s16 px, py, bx, by, ddx = 0, ddy = 0;
+
+    switch (GetPlayerFacingDirection())
+    {
+    case DIR_SOUTH: ddy = -1; break;
+    case DIR_NORTH: ddy = 1; break;
+    case DIR_WEST: ddx = 1; break;
+    default: ddx = -1; break;
+    }
+    PlayerGetDestCoords(&px, &py);
+    bx = px + ddx;
+    by = py + ddy;
+    if (HanWarpDistance(px, py) < 2 || HanWarpDistance(bx, by) < 1 || MapGridGetCollisionAt(bx, by) != 0)
+        return FALSE;
+    *ox = (player->x + player->x2) + ddx * 16;
+    *oy = (player->y + player->y2) + ddy * 16;
+    return TRUE;
+}
+
+// Called every frame with the follower's sprite and the player's.
+static void HanFollowTrail(struct Sprite *sprite, struct Sprite *player)
+{
+    s16 x = player->x + player->x2;
+    s16 y = player->y + player->y2;
+    s16 fx, fy, nx, ny, dx, dy, seg, left;
+    s16 ox, oy;
+    u8 i, idx, prev, dir;
+
+    if (sTrailLen != 0)
+    {
+        s16 hx = sTrailX[sTrailHead], hy = sTrailY[sTrailHead];
+
+        dx = x - hx;
+        dy = y - hy;
+        if (dx > 24 || dx < -24 || dy > 24 || dy < -24)
+            sTrailLen = 0; // a warp, or the map moved under us: come out from under the player again
+    }
+    if (sTrailLen == 0)
+    {
+        // a new map, or a warp: it is there at once, one tile behind the player (so that it does not blink out and in)
+        s16 bx = x, by = y;
+
+        switch (GetPlayerFacingDirection())
+        {
+        case DIR_SOUTH: by = y - 16; break;
+        case DIR_NORTH: by = y + 16; break;
+        case DIR_WEST: bx = x + 16; break;
+        default: bx = x - 16; break;
+        }
+        sFacing = GetPlayerFacingDirection();
+        sTrailX[0] = bx;
+        sTrailY[0] = by;
+        sTrailX[1] = x;
+        sTrailY[1] = y;
+        sTrailHead = 1;
+        sTrailLen = 2;
+        sprite->x = bx;
+        sprite->y = by;
+        sprite->invisible = FALSE;
+    }
+    else if (x != sTrailX[sTrailHead] || y != sTrailY[sTrailHead])
+    {
+        sTrailHead = (sTrailHead + 1) % TRAIL_N;
+        sTrailX[sTrailHead] = x;
+        sTrailY[sTrailHead] = y;
+        if (sTrailLen < TRAIL_N)
+            sTrailLen++;
+    }
+
+    // walk back along the path 16 pixels from the player; short of that, stand at the start of it
+    ox = sprite->x;
+    oy = sprite->y;
+    fx = x;
+    fy = y;
+    left = 16;
+    dir = sFacing;
+    idx = sTrailHead;
+    for (i = 1; i < sTrailLen && left > 0; i++)
+    {
+        prev = (idx + TRAIL_N - 1) % TRAIL_N;
+        nx = sTrailX[prev];
+        ny = sTrailY[prev];
+        dx = nx - sTrailX[idx];
+        dy = ny - sTrailY[idx];
+        seg = (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+        if (seg >= left)
+        {
+            fx = sTrailX[idx] + dx * left / seg;
+            fy = sTrailY[idx] + dy * left / seg;
+            left = 0;
+        }
+        else
+        {
+            fx = nx;
+            fy = ny;
+            left -= seg;
+        }
+        // the way the follower goes along this stretch is the way the player went: from the older point to the newer
+        if (dx != 0 || dy != 0)
+        {
+            if ((dx < 0 ? -dx : dx) >= (dy < 0 ? -dy : dy))
+                dir = dx < 0 ? DIR_EAST : DIR_WEST;
+            else
+                dir = dy < 0 ? DIR_SOUTH : DIR_NORTH;
+        }
+        idx = prev;
+    }
+    // (the loop went newest to oldest, so dir is the direction of the oldest stretch used; the follower is on it)
+    sprite->x = fx;
+    sprite->y = fy;
+    sprite->x2 = 0;
+    sprite->y2 = 0;
+    if (fx != ox || fy != oy)
+    {
+        sFacing = dir;
+        StartSpriteAnimIfDifferent(sprite, GetMoveDirectionAnimNum(dir));
+    }
+    else
+        StartSpriteAnimIfDifferent(sprite, GetFaceDirectionAnimNum(sFacing));
+    sprite->invisible = left > 8; // hidden until it is out from under the player
+    sprite->oam.priority = player->oam.priority;
+    // always on a layer above the player (a lower subpriority is drawn in front)
+    sprite->subpriority = player->subpriority > 0 ? player->subpriority - 1 : 0;
+}
+
+// The ball's effect is the one of the pack the pictures come from (pokeemerald-expansion, MovementAction_ExitPokeball and
+// EnterPokeball): 16 frames. Out: the ball for 9 frames, then the Pokémon, all white and squeezed thin, widening in 4 frames,
+// then its own colours. In: the Pokémon, then white and squeezed thin in 4 frames, then the ball. A sprite at 0x100 is as wide as it is.
+static const union AffineAnimCmd sAffineOut[] =
+{
+    AFFINEANIMCMD_FRAME(0x40, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0x80, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0xC0, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0x100, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd sAffineOutEast[] =
+{
+    AFFINEANIMCMD_FRAME(0xFFC0, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFF80, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0xFF40, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFF00, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd sAffineIn[] =
+{
+    AFFINEANIMCMD_FRAME(0x100, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xC0, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0x80, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0x40, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd sAffineInEast[] =
+{
+    AFFINEANIMCMD_FRAME(0xFF00, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFF40, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0xFF80, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFFC0, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd *const sAffineAnimsFollower[] = { sAffineOut, sAffineOutEast, sAffineIn, sAffineInEast };
+
+static void AffineOn(struct Sprite *sprite, u8 anim)
+{
+    sprite->affineAnims = sAffineAnimsFollower;
+    sprite->oam.affineMode = ST_OAM_AFFINE_NORMAL;
+    InitSpriteAffineAnim(sprite);
+    StartSpriteAffineAnim(sprite, anim + (sFacing == DIR_EAST ? 1 : 0));
+}
+
+static void AffineOff(struct Sprite *sprite)
+{
+    sprite->affineAnimEnded = TRUE;
+    FreeSpriteOamMatrix(sprite);
+    sprite->oam.affineMode = ST_OAM_AFFINE_OFF;
+}
+
+static void WhitePalette(void)
+{
+    u8 idx;
+
+    PaletteIdx(&idx);
+    if (idx != 0xFF)
+        BlendPalette(OBJ_PLTT_ID(idx), 16, 16, RGB_WHITE);
+}
+
+// The ball's part of each frame. TRUE when it has dealt with the sprite for this frame (the Pokémon is not walking).
+static bool8 PhaseFrame(struct Sprite *sprite, struct Sprite *player)
+{
+    switch (sPhase)
+    {
+    case PH_WAIT:
+        sprite->invisible = TRUE;
+        if (sTimer < 24)
+            sTimer++;
+        if (sTimer >= 24 && !gPaletteFade.active && gPlayerAvatar.tileTransitionState == T_NOT_MOVING)
+        {
+            s16 x, y;
+
+            if (!FindSpot(player, &x, &y))
+                return TRUE; // not yet two tiles from the door: it stays in its ball
+            sBallX = x;
+            sBallY = y;
+            sPhase = PH_BALL;
+            sTimer = 0;
+            sFacing = GetPlayerFacingDirection();
+            sprite->x = x;
+            sprite->y = y;
+            sprite->x2 = 0;
+            sprite->y2 = 0;
+            ShowBall(sprite);
+            sprite->invisible = FALSE;
+            PlaySE(SE_BALL_OPEN);
+        }
+        return TRUE;
+    case PH_BALL: // out of the ball
+        sprite->x = sBallX;
+        sprite->y = sBallY;
+        sprite->invisible = FALSE;
+        sprite->oam.priority = player->oam.priority;
+        sprite->subpriority = player->subpriority > 0 ? player->subpriority - 1 : 0;
+        sTimer++;
+        if (sTimer == 9)
+        {
+            ShowMon(sprite, 0);
+            WhitePalette();
+            AffineOn(sprite, 0);
+        }
+        else if (sTimer >= 13)
+        {
+            s16 px = player->x + player->x2, py = player->y + player->y2;
+
+            AffineOff(sprite);
+            ShowMon(sprite, 0);
+            // from here it follows the player from where the ball was
+            sTrailX[0] = sBallX;
+            sTrailY[0] = sBallY;
+            sTrailX[1] = px;
+            sTrailY[1] = py;
+            sTrailHead = 1;
+            sTrailLen = 2;
+            sPhase = PH_NORMAL;
+        }
+        return TRUE;
+    case PH_FADEOUT: // into the ball: the Pokémon goes on walking for 5 frames
+        sTimer++;
+        if (sTimer == 6)
+        {
+            sBallX = sprite->x;
+            sBallY = sprite->y;
+            WhitePalette();
+            AffineOn(sprite, 2);
+        }
+        else if (sTimer > 6)
+        {
+            sprite->x = sBallX;
+            sprite->y = sBallY;
+            if (sTimer == 10)
+            {
+                AffineOff(sprite);
+                ShowBall(sprite);
+                PlaySE(SE_BALL_OPEN);
+            }
+            else if (sTimer >= 17)
+            {
+                sprite->invisible = TRUE;
+                sPhase = sRecallForWarp ? PH_DEAD : PH_WAIT;
+                sTimer = 24;
+            }
+            return TRUE;
+        }
+        return FALSE;
+    case PH_DEAD:
+        sprite->invisible = TRUE;
+        return TRUE;
+    default:
+        // standing on a door (or any warp): back into the ball until the player has moved on
+        if (gPlayerAvatar.tileTransitionState == T_NOT_MOVING && !sprite->invisible)
+        {
+            s16 px, py;
+
+            PlayerGetDestCoords(&px, &py);
+            if (HanWarpDistance(px + ((sprite->x - (player->x + player->x2) + 8) >> 4), py + ((sprite->y - (player->y + player->y2) + 8) >> 4)) == 0)
+            {
+                sPhase = PH_FADEOUT;
+                sTimer = 0;
+                sRecallForWarp = FALSE;
+            }
+        }
+        return FALSE;
+    }
+}
+
+void HanFollowerFrame(void)
+{
+    struct Sprite *sprite, *player;
+    u16 want;
+
+    if (gPlayerAvatar.spriteId >= MAX_SPRITES)
+        return;
+    HanPlayerLookEnsure(); // a changed look shows at once
+    want = LeadSpecies();
+    if (want == 0 || (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER)))
+    {
+        Destroy();
+        sSpecies = 0;
+        return;
+    }
+    if (want != sSpecies)
+        MakeFrames(want);
+
+    sprite = &gSprites[sSpriteId - 1];
+    if (sSpriteId == 0 || !sprite->inUse || sprite->data[7] != FOLLOW_TAG)
+    {
+        // new map, or the first time: it starts on the player's tile and comes out from under the player
+        u8 id = CreateObjectGraphicsSprite(OBJ_EVENT_GFX_HAN_FOLLOWER, SpriteCB_Follower, 0, 0, 0);
+
+        if (id == MAX_SPRITES)
+        {
+            sSpriteId = 0;
+            return;
+        }
+        sSpriteId = id + 1;
+        if (IndexOfSpritePaletteTag(OBJ_EVENT_PAL_TAG_HAN_FOLLOWER) == 0xFF)
+        {
+            sprite = &gSprites[id];
+            sprite->data[7] = FOLLOW_TAG;
+            Destroy();
+            return;
+        }
+        sprite = &gSprites[id];
+        sprite->data[7] = FOLLOW_TAG;
+        sprite->coordOffsetEnabled = TRUE;
+        sprite->centerToCornerVecX = -16;
+        sprite->centerToCornerVecY = -16;
+        sprite->invisible = TRUE;
+        sprite->oam.priority = gSprites[gPlayerAvatar.spriteId].oam.priority;
+        sTrailHead = 0;
+        sTrailLen = 0;
+        sFacing = DIR_SOUTH;
+        // after a warp (a door, stairs) it is let out of its ball a moment later; after a route crossing it is simply there
+        sPhase = sWarped ? PH_WAIT : PH_NORMAL;
+        sTimer = 0;
+        sWarped = FALSE;
+        sRecallForWarp = FALSE;
+        StartSpriteAnim(sprite, GetFaceDirectionAnimNum(DIR_SOUTH));
+    }
+    player = &gSprites[gPlayerAvatar.spriteId];
+    if (PhaseFrame(sprite, player))
+        return;
+    HanFollowTrail(sprite, player);
+}
+
+// ---- the followers of the other players (src/han_multiplayer.c): a sprite made from the pictures in ROM, with its
+// own palette (tag), put one tile behind the other player's sprite by the caller.
+
+u16 HanFollowSpecies(void)
+{
+    return sSpecies;
+}
+
+void HanGhostFollowerDestroy(u8 id, u16 palTag)
+{
+    if (id != MAX_SPRITES && gSprites[id].inUse && gSprites[id].data[7] == FOLLOW_TAG)
+        DestroySprite(&gSprites[id]);
+    FreeSpritePaletteByTag(palTag);
+}
+
+// what: species (bit 15 shiny), as HanFollowSpecies gives it. MAX_SPRITES if it cannot be made.
+u8 HanGhostFollowerCreate(u16 what, u16 palTag)
+{
+    struct SpriteTemplate template;
+    const struct SubspriteTable *subs;
+    struct SpritePalette pal;
+    u8 id, idx;
+    u16 n = what & 0x7FFF;
+
+    if (n == 0 || n >= HAN_FOLLOW_SPECIES || sHanFollowIndex[n] == 0xFFFF)
+        return MAX_SPRITES;
+    CopyObjectGraphicsInfoToSpriteTemplate(OBJ_EVENT_GFX_HAN_FOLLOWER, SpriteCB_Follower, &template, &subs);
+    template.images = sHanFollowImg[sHanFollowIndex[n]];
+    template.paletteTag = TAG_NONE;
+    FreeSpritePaletteByTag(palTag);
+    pal.data = &sHanFollowPal[sHanFollowIndex[n] * 32 + ((what & 0x8000) ? 16 : 0)];
+    pal.tag = palTag;
+    idx = LoadSpritePalette(&pal);
+    if (idx == 0xFF)
+    {
+        // the four free sprite palettes are used by the weather, the follower, a ghost player and so on: borrow one of the
+        // palettes the game keeps for water reflections (6 to 9), which a map without reflections does not use
+        idx = 9 - (palTag & 3);
+        LoadPalette(pal.data, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+    }
+    id = CreateSprite(&template, 0, 0, 0);
+    if (id == MAX_SPRITES)
+    {
+        FreeSpritePaletteByTag(palTag);
+        return MAX_SPRITES;
+    }
+    gSprites[id].oam.paletteNum = idx;
+    if (subs != NULL)
+    {
+        SetSubspriteTables(&gSprites[id], subs);
+        gSprites[id].subspriteMode = SUBSPRITES_IGNORE_PRIORITY;
+    }
+    gSprites[id].data[7] = FOLLOW_TAG;
+    gSprites[id].coordOffsetEnabled = TRUE;
+    gSprites[id].centerToCornerVecX = -16;
+    gSprites[id].centerToCornerVecY = -16;
+    return id;
+}
