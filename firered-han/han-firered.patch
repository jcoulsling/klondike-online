+#!/usr/bin/env python3
+"""The player's other overworld pictures (bike, surf, fishing, item-get and VS Seeker) for every chosen character.
+
+    python3 tools/han/han_states.py       (han_custom.py runs it through states())
+
+FireRed draws these only for Red and Leaf. Jane asked (23 November 2026) that every player character has every
+overworld animation, so for each walking picture that a trainer picture uses, the game's own Red frames are redrawn:
+
+  * the head (hair, hat, glasses, face) is the chosen character's own, taken from its standing frames, facing the way
+    the Red frame faces, and set on the same chin line;
+  * the body, arms, legs, the bike and the rod stay Red's shapes, but are painted in that character's own colours
+    (hair, skin, the shirt and trousers it is wearing), so the same palette numbers apply and the palette the player
+    chose recolours them with the walking picture.
+
+It writes graphics/han_custom/st_NAME.bin (4bpp tiles, one frame after another, the sources one after another) and
+gives han_custom.py the table of which source each trainer picture uses (0xFF = the game's own frames).
+"""
+import sys
+from collections import Counter
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+PEOPLE = ROOT / "graphics/object_events/pics/people"
+OUT_DIR = ROOT / "graphics/han_custom"
+# state: (sheet, frame width, frames used, directions of those frames: S N W, or - for always south)
+STATES = {
+    "bike": ("bike", 32, 9, "SNWSSNNWW"),
+    "surf": ("surf_run", 16, 3, "SNW"),
+    "fish": ("fish", 32, 12, "WWWWNNNNSSSS"),
+    "item": ("item", 16, 9, "SSSSSSSSS"),
+    "vsbike": ("vs_seeker_bike", 32, 6, "SSSSSS"),
+}
+# Red's poses for everyone: Leaf's long hair got in the way of the new head. (Leaf's sheets and maps stay for a later try.)
+FEMALE_WORDS = ("lass", "woman", "beauty", "picnicker", "girl", "nurse", "may", "_f", "roxanne", "winona", "flannery",
+                "phoebe", "glacia", "misty", "erika", "sabrina", "agatha", "lorelei", "aqua_member_f", "magma_member_f")
+
+
+def is_female_png(png):
+    stem = png.stem.lower()
+    if stem.endswith("_m") or stem.endswith("m_land"):
+        return False
+    return any(w in stem for w in FEMALE_WORDS)
+OUT = 15                       # Red's outline
+RED_BODY_SKIN = (2, 3, 4)
+HEAD_COLOURS = {1, 2, 3, 4, 8, 9, 10, 11, 12, 15}
+
+
+def load_sheet(path, w, n):
+    from PIL import Image
+    im = Image.open(path)
+    px = im.load()
+    return [[[px[f * w + x, y] for x in range(w)] for y in range(32)] for f in range(n)]
+
+
+def lum(c):
+    return 0.3 * c[0] + 0.59 * c[1] + 0.11 * c[2]
+
+
+def comp_top(fr):
+    """The top row of the figure's biggest connected blob of colour (so a fishing rod does not count)."""
+    h, w = len(fr), len(fr[0])
+    seen = set()
+    best = []
+    for y in range(h):
+        for x in range(w):
+            if fr[y][x] and fr[y][x] not in (OUT, 5) and (x, y) not in seen:
+                stack = [(x, y)]
+                seen.add((x, y))
+                cur = []
+                while stack:
+                    cx, cy = stack.pop()
+                    cur.append((cx, cy))
+                    for dx in (-1, 0, 1):
+                        for dy in (-1, 0, 1):
+                            nx, ny = cx + dx, cy + dy
+                            if 0 <= nx < w and 0 <= ny < h and fr[ny][nx] and fr[ny][nx] not in (OUT, 5) and (nx, ny) not in seen:
+                                seen.add((nx, ny))
+                                stack.append((nx, ny))
+                if len(cur) > len(best):
+                    best = cur
+    return best
+
+
+def roles(frames, rgb, is_skin):
+    """The colours a character wears, as palette numbers: outline, skin light/mid/dark, hair, top, bottom, light."""
+    used = Counter(v for fr in frames for row in fr for v in row if v)
+    outline = min(used, key=lambda i: lum(rgb[i]))
+    skins = sorted((i for i in used if i != outline and is_skin(rgb[i])), key=lambda i: -lum(rgb[i]))
+    if not skins:
+        skins = [max(used, key=lambda i: lum(rgb[i]))]
+    skin = [skins[0], skins[len(skins) // 2], skins[-1]]
+    f = frames[0]
+    rows = [y for y in range(32) if any(f[y])]
+    top, bottom = rows[0], rows[-1]
+    skin_rows = [y for y in range(top, min(top + 14, bottom)) if sum(1 for v in f[y] if v in skins) >= 4]
+    chin = skin_rows[-1] if skin_rows else top + 10
+
+    def common(y0, y1, skip, n=2):
+        c = Counter(v for y in range(y0, y1) for v in f[y] if v and v not in skip)
+        out = [i for i, _ in c.most_common(n)]
+        return out or [None] * n
+
+    skip = set(skins) | {outline}
+    hair = common(top, top + 4, {outline} | set(skins))
+    topc = common(chin + 1, chin + 5, skip)
+    botc = common(bottom - 4, bottom, skip)
+    others = [i for i in used if i not in skip]
+    light = max(others, key=lambda i: lum(rgb[i])) if others else skin[0]
+    dark = min(others, key=lambda i: lum(rgb[i])) if others else outline
+
+    def pick(pair, fallback):
+        a = pair[0] if pair[0] is not None else fallback
+        b = pair[1] if len(pair) > 1 and pair[1] is not None else a
+        return a, b
+
+    h1, h2 = pick(hair, light)
+    t1, t2 = pick(topc, h1)
+    b1, b2 = pick(botc, t2)
+    return {"out": outline, "skin": skin, "hair": (h1, h2), "top": (t1, t2), "bot": (b1, b2), "light": light, "dark": dark}
+
+
+def leaf_map(r):
+    """Leaf's palette numbers -> the character's (her hair is brown, 4, and hangs down the back)."""
+    sk = r["skin"]
+    return {0: 0, 15: r["out"], 6: r["out"], 9: r["light"], 10: r["light"], 4: r["hair"][0], 1: r["hair"][0], 8: r["hair"][1],
+            2: sk[0], 3: sk[1], 11: r["top"][0], 12: r["top"][1], 13: r["top"][0], 14: r["top"][1], 5: r["bot"][0],
+            7: r["bot"][0]}
+
+
+def red_map(r):
+    """Red's palette numbers -> the character's."""
+    sk = r["skin"]
+    return {0: 0, 15: r["out"], 5: r["out"], 6: r["bot"][1], 7: r["bot"][0], 11: r["top"][0], 12: r["top"][1], 8: r["top"][1],
+            10: r["light"], 9: r["light"], 1: r["hair"][0], 2: sk[0], 3: sk[1], 4: sk[2], 13: r["top"][0], 14: r["top"][1]}
+
+
+def head_of(fr, chin_hint=None):
+    """(rows top..chin) of a standing frame: the head chunk as {(x, y-top): value}, the chin offset."""
+    rows = [y for y in range(32) if any(fr[y])]
+    top = rows[0]
+    return top
+
+
+def biggest(pts):
+    """The largest group of touching pixels (a rod's tip is a pixel of the hat's colour but not part of the hat)."""
+    left = set(pts)
+    best = []
+    while left:
+        stack = [left.pop()]
+        cur = list(stack)
+        while stack:
+            x, y = stack.pop()
+            for dx in (-1, 0, 1):
+                for dy in (-1, 0, 1):
+                    q = (x + dx, y + dy)
+                    if q in left:
+                        left.remove(q)
+                        stack.append(q)
+                        cur.append(q)
+        if len(cur) > len(best):
+            best = cur
+    return best
+
+
+CAPS = {"M": ({8, 11, 12}, 0), "F": ({9, 10}, 1)}      # the colours of the hat on top, and the row of outline above it
+FLAGGED = []
+
+
+def make_frames(red_frames, dirs, char_stand, rmap, r, sex, hc_char, hc_red=11, label=""):
+    """char_stand: {'S','N','W'} -> 16 x 32 frame. Returns the new frames. The head is found by the hat colours (a
+    rod or a bike wheel is not the head)."""
+    capset, capoff = CAPS[sex]
+    out = []
+    for fi, (fr, d) in enumerate(zip(red_frames, dirs)):
+        h, w = len(fr), len(fr[0])
+        new = [[rmap.get(v, v) for v in row] for row in fr]
+        pts = biggest([(x, y) for y in range(h) for x in range(w) if fr[y][x] in capset])
+        if not pts:
+            FLAGGED.append("%s frame %d: no hat found" % (label, fi))
+            out.append(new)
+            continue
+        top_r = min(y for _, y in pts) - capoff
+        chin_r = top_r + hc_red - 1
+        capx = [x for x, y in pts if y < top_r + capoff + 6]
+        x0, x1 = min(capx) - 2, max(capx) + 2
+        cx_r = (min(capx) + max(capx)) / 2
+        cs = char_stand[d]
+        rows = [y for y in range(32) if any(cs[y])]
+        top_c = rows[0]
+        chunk = [(x, y - top_c) for y in range(top_c, min(top_c + hc_char, 32)) for x in range(16) if cs[y][x]]
+        cx_c = (min(x for x, _ in chunk) + max(x for x, _ in chunk)) / 2
+        dx = int(round(cx_r - cx_c))
+        for y in range(max(0, top_r), chin_r + 1):
+            for x in range(max(0, x0), min(w, x1 + 1)):
+                if fr[y][x] in HEAD_COLOURS or fr[y][x] in (6, 7):
+                    new[y][x] = 0
+        base = chin_r - (hc_char - 1)
+        for x, yy in chunk:
+            X, Y = x + dx, base + yy
+            if 0 <= X < w and 0 <= Y < h:
+                new[Y][X] = cs[top_c + yy][x]
+        # audit: hat colours left above the chin line mean a second head
+        left = [(x, y) for x, y in pts if y <= chin_r and not (x0 <= x <= x1)]
+        left += [(x, y) for y in range(max(0, top_r - 3), top_r) for x in range(w) if fr[y][x] in capset and x0 <= x <= x1 and (x, y) not in pts]
+        if left:
+            FLAGGED.append("%s frame %d: %d hat pixels outside the head box" % (label, fi, len(left)))
+        out.append(new)
+    return out
+
+
+def pack(frames):
+    """4bpp tiles: each frame is (w/8) x 4 tiles, row after row, a tile's rows top to bottom, the left pixel low."""
+    b = bytearray()
+    for fr in frames:
+        w = len(fr[0])
+        for ty in range(4):
+            for tx in range(w // 8):
+                for y in range(8):
+                    for x in range(0, 8, 2):
+                        a = fr[ty * 8 + y][tx * 8 + x]
+                        c = fr[ty * 8 + y][tx * 8 + x + 1]
+                        b.append(a | (c << 4))
+    return bytes(b)
+
+
+def stand_frames(png):
+    """The three standing frames S, N, W of a nine-frame walking picture, or None if it is not one."""
+    from PIL import Image
+    im = Image.open(png)
+    if im.size[0] < 144 or im.size[1] != 32:
+        return None
+    px = im.load()
+    return [[[px[f * 16 + x, y] for x in range(16)] for y in range(32)] for f in range(3)]
+
+
+def head_height(stand, skins):
+    f = stand
+    rows = [y for y in range(32) if any(f[y])]
+    top = rows[0]
+    sk = [y for y in range(top, min(top + 14, rows[-1])) if sum(1 for v in f[y] if v in skins) >= 4]
+    return (sk[-1] - top + 1) if sk else 11
+
+
+def sources(consts, infos):
+    """-> for each distinct walking picture used: (gfx id, png path, base palette number). And per trainer picture the
+    index of its source, or 255."""
+    import re
+    import han_pics as P
+    import han_people
+    gi = (ROOT / "src/data/object_events/object_event_graphics_info.h").read_text()
+    pt = (ROOT / "src/data/object_events/object_event_pic_tables.h").read_text()
+    gg = (ROOT / "src/data/object_events/object_event_graphics.h").read_text()
+    norm = {k.replace("_", "").lower(): v for k, v in consts.items()}
+    idcamel = {}
+    for camel in infos:
+        if camel.lower() in norm:
+            idcamel[norm[camel.lower()]] = camel
+    hp = {v: k for k, v in han_people.ids().items()}
+
+    def png_of(gfx):
+        if gfx in hp:
+            return PEOPLE / "emerald_people" / (han_people.snake(hp[gfx]) + ".png")
+        camel = idcamel.get(gfx)
+        if camel is None:
+            return None
+        m = re.search(r"gObjectEventGraphicsInfo_%s = \{.*?\.images = (\w+)," % camel, gi, re.S)
+        if not m:
+            return None
+        t = re.search(r"%s\[\] = \{\s*overworld_frame\((\w+)," % m.group(1), pt)
+        if not t:
+            return None
+        s = re.search(r"%s\[\] = INCBIN_U16\(\"([^\"]+)\.4bpp\"" % t.group(1), gg)
+        return (ROOT / (s.group(1) + ".png")) if s else None
+
+    return png_of
+
+
+def build(consts, infos, owof, base_of, bases_rgb):
+    """-> (names of the blobs {state: bytes}, the source index of each trainer picture)"""
+    import han_pics as P
+    png_of = sources(consts, infos)
+    order = []
+    idx = []
+    blobs = {k: bytearray() for k in STATES}
+    sheets = {(sex, k): load_sheet(PEOPLE / (("green_" if sex == "F" else "red_") + v[0] + ".png"), v[1], v[2]) for k, v in STATES.items() for sex in "MF"}
+    seen = {}
+    for n, (gfx, _) in enumerate(owof):
+        if gfx in (0, 7):                 # the game's own Red and Leaf have their own
+            idx.append(255)
+            continue
+        base = base_of[n]
+        png = png_of(gfx)
+        sex = "M"      # Leaf's hair hides the new head, so Red's poses are used for everyone (Jane, 23 November 2026)
+        key = (gfx, base, sex)
+        if key in seen:
+            idx.append(seen[key])
+            continue
+        stand = stand_frames(png) if png and png.exists() else None
+        if stand is None:
+            idx.append(255)
+            seen[key] = 255
+            continue
+        rgb = bases_rgb[base]
+        r = roles(stand, rgb, P.is_skin)
+        rmap = leaf_map(r) if sex == "F" else red_map(r)
+        hc = head_height(stand[0], set(r["skin"]))
+        cs = {"S": stand[0], "N": stand[1], "W": stand[2]}
+        for k, (sheet, w, nf, dirs) in STATES.items():
+            blobs[k] += pack(make_frames(sheets[(sex, k)], dirs, cs, rmap, r, sex, hc, label="%s/%s gfx %d" % (k, sex, gfx)))
+        seen[key] = len(order)
+        idx.append(len(order))
+        order.append((gfx, base, sex))
+    return {k: bytes(v) for k, v in blobs.items()}, idx, order
+
+
+def write(blobs):
+    OUT_DIR.mkdir(parents=True, exist_ok=True)
+    for k, b in blobs.items():
+        p = OUT_DIR / ("st_%s.bin" % k)
+        if not p.exists() or p.read_bytes() != b:
+            p.write_bytes(b)
+
+
+def sizes():
+    """bytes of one source's frames in each state"""
+    return {k: (v[1] // 8 * 4 * 32) * v[2] for k, v in STATES.items()}
