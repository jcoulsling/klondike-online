+
+// Hän build: the cable of a link battle, replaced by the web page (Jane, 22 November 2026).
+//
+// The game's own link battle runs as it does over the cable. Only the bottom is changed: link.c asks this file for
+// the player number, sending a block, standing by and closing when gHanMailbox.link.on is set. A block that goes out
+// is copied to gBlockSendBuffer and the page takes it (txSeq / txAck). A block that comes in is written by the page to
+// gBlockRecvBuffer[the other player] and the game is told (rxSeq / rxSeen); the page does not write the next one before
+// the game has used this one (rxFull). Standing by and closing are counters the page passes on.
+
+extern void (*gLinkCallback)(void);
+extern u8 gBlockReceivedStatus[MAX_LINK_PLAYERS];
+
+static EWRAM_DATA u8 sStandbyDone = 0;
+static EWRAM_DATA u8 sAborted = 0;
+
+void HanLinkStart(u8 myId, u8 peer, const struct LinkPlayer *me, const struct LinkPlayer *other)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+    u8 i;
+
+    gLinkPlayers[myId] = *me;
+    gLinkPlayers[myId ^ 1] = *other;
+    for (i = 0; i < 2; i++)
+    {
+        gLinkPlayers[i].id = i;
+        gLinkPlayers[i].linkType = LINKTYPE_BATTLE;
+        gBlockReceivedStatus[i] = FALSE;
+    }
+    l->myId = myId;
+    l->peer = peer;
+    l->txAck = l->txSeq;
+    l->rxSeen = l->rxSeq;
+    l->rxFull = 0;
+    l->syncOut = 0;
+    l->syncIn = 0;
+    l->closeOut = 0;
+    l->closeIn = 0;
+    l->sendAddr = (u32)gBlockSendBuffer;
+    l->recvAddr = (u32)gBlockRecvBuffer[myId ^ 1];
+    l->mailAddr = (u32)&gHanMailbox;
+    sStandbyDone = 0;
+    sAborted = 0;
+    l->gone = 0;
+    gLinkCallback = NULL;
+    gReceivedRemoteLinkPlayers = TRUE;
+    l->on = 1;
+}
+
+bool8 HanLinkSend(const void *src, u16 size)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    if (size > BLOCK_BUFFER_SIZE || l->txAck != l->txSeq)
+        return FALSE;
+    CpuCopy16(src, gBlockSendBuffer, (size + 1) & ~1);
+    CpuCopy16(src, gBlockRecvBuffer[l->myId], (size + 1) & ~1);
+    gBlockReceivedStatus[l->myId] = TRUE;
+    l->txSize = size;
+    l->txSeq++;
+    return TRUE;
+}
+
+bool8 HanLinkSendDone(void)
+{
+    return gLinkCallback == NULL && gHanMailbox.link.txAck == gHanMailbox.link.txSeq;
+}
+
+static void CB_Standby(void)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    if (!sStandbyDone)
+    {
+        l->syncOut++;
+        sStandbyDone = 1;
+    }
+    if ((u8)(l->syncIn - l->syncOut) < 128)  // the other one has stood by as often as I have
+    {
+        sStandbyDone = 0;
+        gLinkCallback = NULL;
+    }
+}
+
+void HanLinkStandby(void)
+{
+    if (gLinkCallback == NULL)
+        gLinkCallback = CB_Standby;
+}
+
+static void CB_Close(void)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    l->closeOut = 1;
+    if (l->closeIn)
+    {
+        gBattleTypeFlags &= ~(BATTLE_TYPE_LINK_IN_BATTLE | 0xFFFF0000);
+        gReceivedRemoteLinkPlayers = FALSE;
+        l->on = 0;
+        l->closeIn = 0;   // closeOut stays 1 so that the page still tells the other game; HanLinkStart clears it
+        gLinkCallback = NULL;
+    }
+}
+
+void HanLinkCloseReady(void)
+{
+    if (gLinkCallback == NULL)
+        gLinkCallback = CB_Close;
+}
+
+// every frame
+void HanLinkFrame(void)
+{
+    struct HanLinkCtl *l = &gHanMailbox.link;
+
+    if (!l->on)
+        return;
+    if (l->gone && !sAborted)
+    {
+        // the other player is gone: nothing more will come, so end the battle (as a draw) and close
+        sAborted = 1;
+        l->closeIn = 1;
+        gLinkCallback = NULL;
+        if ((gBattleTypeFlags & BATTLE_TYPE_LINK) && gMain.inBattle)
+            HanLinkAbortBattle();
+    }
+    if (l->gone)
+        l->closeIn = 1;
+    if (l->rxSeen != l->rxSeq)
+    {
+        l->rxSeen = l->rxSeq;
+        gBlockReceivedStatus[l->myId ^ 1] = TRUE;
+    }
+    l->rxFull = gBlockReceivedStatus[l->myId ^ 1];
+    if (gLinkCallback != NULL)
+        gLinkCallback();
+}
diff --git a/src/han_multiplayer.c b/src/han_multiplayer.c
new file mode 100644
index 0000000..2d31104
--- /dev/null
+++ b/src/han_multiplayer.c
@@ -0,0 +1,303 @@
+#include "global.h"
+#include "gflib.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "han_multiplayer.h"
+#include "han_custom.h"
+#include "han_follower.h"
+#include "constants/event_objects.h"
+#include "main_menu.h"
+#include "sound.h"
+#include "constants/songs.h"
+
+// Hän build: other players on the overworld.
+//
+// The game has no way to the internet. The web page that runs it does: it finds the mailbox below in the
+// emulator's memory by its marker, and each frame it
+//   - reads "mine": where this player is (map, tile, facing, whether walking, which picture), and
+//   - writes "others": the same for up to four other players in the same room.
+// Here, every frame in the overworld, "mine" is written and each of "others" on the same map is drawn
+// as a sprite that walks towards the tile it was sent. Nothing else in the game is touched: the other
+// players cannot be talked to, stopped by, or battled from the map. The emulator on its own (no page)
+// never fills "others", so nothing is drawn.
+
+EWRAM_DATA struct HanMailbox gHanMailbox = {0};
+
+#define GHOST_TAG 0x4B0B
+#define GHOST_BODY_PAL 0x4C20   // palette tags, plus the slot
+#define GHOST_FOLLOW_PAL 0x4C30
+
+static void SpriteCB_Ghost(struct Sprite *sprite)
+{
+}
+
+static s16 StepTowards(s16 cur, s16 target, s16 speed)
+{
+    if (cur < target)
+        return (target - cur < speed) ? target : cur + speed;
+    if (cur > target)
+        return (cur - target < speed) ? target : cur - speed;
+    return cur;
+}
+
+// Which map this is, as two bytes. The group and number in the save block were seen to be 255 and 255 in a game
+// that was standing in Pallet Town (22 November 2026), so they are not trusted. The address of the map's event
+// list in the ROM is different for every map and the same in every copy of this ROM.
+static void MapId(u8 *hi, u8 *lo)
+{
+    u32 p = (u32)gMapHeader.events;
+    u16 id = (p >> 2) ^ (p >> 18);
+
+    *hi = id >> 8;
+    *lo = id & 0xFF;
+}
+
+static void WriteMine(void)
+{
+    struct HanPlayerState *me = &gHanMailbox.mine;
+    struct ObjectEvent *obj = &gObjectEvents[gPlayerAvatar.objectEventId];
+
+    me->active = TRUE;
+    MapId(&me->mapGroup, &me->mapNum);
+    me->facing = obj->facingDirection;
+    me->x = gSaveBlock1Ptr->pos.x;
+    me->y = gSaveBlock1Ptr->pos.y;
+    me->gfx = GetPlayerAvatarGraphicsIdByCurrentState();
+    me->walking = gPlayerAvatar.tileTransitionState != T_NOT_MOVING;
+    HanLookPicPal(&me->pic, &me->pal);
+    me->follow = HanFollowSpecies();
+    gHanMailbox.frame++;
+}
+
+static void UpdateGhost(u8 slot, struct HanPlayerState *they)
+{
+    u8 id = gHanMailbox.spriteIds[slot];
+    struct Sprite *sprite = &gSprites[id];
+    s16 targetX, targetY, wx, wy, tx, ty, dx, dy, speed;
+    u8 dir, mapHi, mapLo;
+    u16 owGfx, key, follow;
+    const u16 *owPal;
+
+    MapId(&mapHi, &mapLo);
+    if (!they->active || they->mapGroup != mapHi || they->mapNum != mapLo)
+    {
+        if (id != MAX_SPRITES && sprite->inUse && sprite->data[7] == GHOST_TAG)
+            DestroySprite(sprite);
+        gHanMailbox.spriteIds[slot] = MAX_SPRITES;
+        HanGhostFollowerDestroy(gHanMailbox.followIds[slot], GHOST_FOLLOW_PAL + slot);
+        gHanMailbox.followIds[slot] = MAX_SPRITES;
+        FreeSpritePaletteByTag(GHOST_BODY_PAL + slot);
+        return;
+    }
+    targetX = they->x * 16;
+    targetY = they->y * 16;
+    // a player walking on foot is drawn as their chosen character, in their palette
+    key = 0;
+    owPal = NULL;
+    if ((they->gfx == OBJ_EVENT_GFX_RED_NORMAL || they->gfx == OBJ_EVENT_GFX_GREEN_NORMAL)
+     && HanOwFor(they->pic, they->pal, &owGfx, &owPal))
+        key = they->pic | (they->pal << 8);
+    if (id == MAX_SPRITES || !sprite->inUse || sprite->data[7] != GHOST_TAG || sprite->data[6] != they->gfx || sprite->data[5] != key)
+    {
+        if (id != MAX_SPRITES && sprite->inUse && sprite->data[7] == GHOST_TAG)
+            DestroySprite(sprite);
+        // the player's own pictures are the customizer's look, which is for this game only: others are shown as
+        // a plain trainer of their kind
+        FreeSpritePaletteByTag(GHOST_BODY_PAL + slot);
+        id = CreateObjectGraphicsSprite(key ? owGfx
+                                      : they->gfx == OBJ_EVENT_GFX_RED_NORMAL ? OBJ_EVENT_GFX_YOUNGSTER
+                                      : they->gfx == OBJ_EVENT_GFX_GREEN_NORMAL ? OBJ_EVENT_GFX_LASS : they->gfx,
+                                        SpriteCB_Ghost, 0, 0, 0);
+        gHanMailbox.spriteIds[slot] = id;
+        if (id == MAX_SPRITES)
+            return;
+        sprite = &gSprites[id];
+        if (key)
+        {
+            struct SpritePalette pal;
+            u8 idx;
+
+            pal.data = owPal;
+            pal.tag = GHOST_BODY_PAL + slot;
+            idx = LoadSpritePalette(&pal);
+            if (idx != 0xFF)
+                sprite->oam.paletteNum = idx;
+        }
+        sprite->data[5] = key;
+        sprite->data[7] = GHOST_TAG;
+        sprite->data[6] = they->gfx;
+        sprite->data[0] = targetX;     // where it stands now, in pixels of the map
+        sprite->data[1] = targetY;
+        sprite->coordOffsetEnabled = TRUE;
+        sprite->centerToCornerVecX = -8;
+        sprite->centerToCornerVecY = -16;
+        sprite->oam.priority = gSprites[gPlayerAvatar.spriteId].oam.priority;
+    }
+    wx = sprite->data[0];
+    wy = sprite->data[1];
+    dx = targetX - wx;
+    dy = targetY - wy;
+    if (dx > 80 || dx < -80 || dy > 80 || dy < -80)
+    {
+        wx = targetX;
+        wy = targetY;
+        dx = dy = 0;
+    }
+    speed = 1;
+    if (dx > 20 || dx < -20 || dy > 20 || dy < -20)
+        speed = 2;
+    if (dx > 48 || dx < -48 || dy > 48 || dy < -48)
+        speed = 4;
+    if (they->walking && speed == 1)
+        speed = 1;
+    wx = StepTowards(wx, targetX, speed);
+    wy = StepTowards(wy, targetY, speed);
+    sprite->data[0] = wx;
+    sprite->data[1] = wy;
+
+    dir = they->facing;
+    if (wx != targetX || wy != targetY)
+    {
+        if ((dx < 0 ? -dx : dx) >= (dy < 0 ? -dy : dy))
+            dir = dx > 0 ? DIR_EAST : DIR_WEST;
+        else
+            dir = dy > 0 ? DIR_SOUTH : DIR_NORTH;
+        StartSpriteAnimIfDifferent(sprite, GetMoveDirectionAnimNum(dir));
+    }
+    else
+    {
+        StartSpriteAnimIfDifferent(sprite, GetFaceDirectionAnimNum(they->facing));
+    }
+
+    tx = (wx >> 4) + MAP_OFFSET;
+    ty = (wy >> 4) + MAP_OFFSET;
+    SetSpritePosToMapCoords(tx, ty, &sprite->x, &sprite->y);
+    sprite->x += (wx & 15) + 8;
+    sprite->y += (wy & 15) + 16 + sprite->centerToCornerVecY;
+    sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority;
+    // their follower, one tile behind them
+    follow = they->follow;
+    id = gHanMailbox.followIds[slot];
+    if (follow == 0)
+    {
+        if (id != MAX_SPRITES)
+            HanGhostFollowerDestroy(id, GHOST_FOLLOW_PAL + slot);
+        gHanMailbox.followIds[slot] = MAX_SPRITES;
+    }
+    else
+    {
+        struct Sprite *fs = &gSprites[id];
+
+        if (id == MAX_SPRITES || !fs->inUse || fs->data[6] != follow)
+        {
+            HanGhostFollowerDestroy(id, GHOST_FOLLOW_PAL + slot);
+            id = HanGhostFollowerCreate(follow, GHOST_FOLLOW_PAL + slot);
+            gHanMailbox.followIds[slot] = id;
+            if (id != MAX_SPRITES)
+                gSprites[id].data[6] = follow;
+        }
+        if (id != MAX_SPRITES)
+        {
+            fs = &gSprites[id];
+            tx = wx;
+            ty = wy;
+            switch (they->facing)
+            {
+            case DIR_SOUTH: ty -= 16; break;
+            case DIR_NORTH: ty += 16; break;
+            case DIR_WEST: tx += 16; break;
+            default: tx -= 16; break;
+            }
+            SetSpritePosToMapCoords((tx >> 4) + MAP_OFFSET, (ty >> 4) + MAP_OFFSET, &fs->x, &fs->y);
+            fs->x += (tx & 15) + 8;
+            fs->y += (ty & 15) + 16 + fs->centerToCornerVecY;
+            fs->oam.priority = sprite->oam.priority;
+            if (fs->x != fs->data[4] || fs->y != fs->data[5])
+                StartSpriteAnimIfDifferent(fs, GetMoveDirectionAnimNum(they->facing)); // walking: it walks behind them
+            else
+                StartSpriteAnimIfDifferent(fs, GetFaceDirectionAnimNum(they->facing));
+            fs->data[4] = fs->x;
+            fs->data[5] = fs->y;
+        }
+    }
+    if (wy > gSaveBlock1Ptr->pos.y * 16)
+        sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority - 1; // in front of this player
+    else
+        sprite->subpriority = gSprites[gPlayerAvatar.spriteId].subpriority + 1;
+    // their follower is on a layer above every player
+    if (gHanMailbox.followIds[slot] != MAX_SPRITES)
+    {
+        u8 low = sprite->subpriority < gSprites[gPlayerAvatar.spriteId].subpriority ? sprite->subpriority : gSprites[gPlayerAvatar.spriteId].subpriority;
+
+        gSprites[gHanMailbox.followIds[slot]].subpriority = low > 0 ? low - 1 : 0;
+    }
+}
+
+// Whether another player stands on this map tile (x and y as the game's own object events have them, with MAP_OFFSET), so
+// that the player cannot walk through them. They hold the tile they have been sent, and the tile they are still walking
+// away from.
+bool8 HanPlayerAt(s16 x, s16 y)
+{
+    u8 i, mapHi, mapLo;
+
+    MapId(&mapHi, &mapLo);
+    x -= MAP_OFFSET;
+    y -= MAP_OFFSET;
+    for (i = 0; i < HAN_OTHERS; i++)
+    {
+        struct HanPlayerState *they = &gHanMailbox.others[i];
+        struct Sprite *sprite;
+        u8 id = gHanMailbox.spriteIds[i];
+
+        if (!they->active || they->mapGroup != mapHi || they->mapNum != mapLo)
+            continue;
+        if (they->x == x && they->y == y)
+            return TRUE;
+        if (id < MAX_SPRITES)
+        {
+            sprite = &gSprites[id];
+            if (sprite->inUse && sprite->data[7] == GHOST_TAG)
+            {
+                // still on its way: it holds the tiles its picture is on
+                if ((sprite->data[0] >> 4) == x && (sprite->data[1] >> 4) == y)
+                    return TRUE;
+                if (((sprite->data[0] + 15) >> 4) == x && ((sprite->data[1] + 15) >> 4) == y)
+                    return TRUE;
+            }
+        }
+    }
+    return FALSE;
+}
+
+// Called every frame the overworld runs, after the camera has moved.
+void HanMultiplayerFrame(void)
+{
+    u8 i;
+
+    // Jane asked (22 November 2026): the code for syllabics also works while walking around, so that
+    // they can be turned off again without going back to the title screen.
+    if (CheatCodeEntered() == CHEAT_SYLLABICS)
+    {
+        gHanSyllabics ^= TRUE;
+        PlaySE(SE_SUCCESS);
+    }
+    if (gHanMailbox.magic[0] == 0)
+    {
+        // One letter at a time: a string would also stand in the ROM, and the page must find only this one.
+        gHanMailbox.magic[0] = 'K';
+        gHanMailbox.magic[1] = 'L';
+        gHanMailbox.magic[2] = 'N';
+        gHanMailbox.magic[3] = 'D';
+        gHanMailbox.magic[4] = 'K';
+        gHanMailbox.magic[5] = 'M';
+        gHanMailbox.magic[6] = 'B';
+        gHanMailbox.magic[7] = 'X';
+        for (i = 0; i < HAN_OTHERS; i++)
+            gHanMailbox.spriteIds[i] = MAX_SPRITES, gHanMailbox.followIds[i] = MAX_SPRITES;
+    }
+    WriteMine();
+    HanTradeFrame();
+    for (i = 0; i < HAN_OTHERS; i++)
+        UpdateGhost(i, &gHanMailbox.others[i]);
+}
diff --git a/src/han_rowan.c b/src/han_rowan.c
new file mode 100644
index 0000000..43aa465
--- /dev/null
+++ b/src/han_rowan.c
@@ -0,0 +1,143 @@
+#include "global.h"
+#include "han_rowan.h"
+#include "event_data.h"
+#include "han_custom.h"
+#include "overworld.h"
+#include "constants/heal_locations.h"
+#include "pokemon.h"
+#include "random.h"
+#include "string_util.h"
+#include "constants/flags.h"
+#include "constants/items.h"
+#include "constants/maps.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+
+// Hän build: a player called ROWAN starts in Pallet Town with all eight badges and a team of six at level 100,
+// each with a competitive Gen 3 set (Jane, 24 November 2026). The TRAINER TOWER needs nothing more: the attendant
+// upstairs in every POKéMON CENTER offers it. The web page also keeps a save for each name, so this happens once, for a new game.
+
+static const u8 sName1[] = _("ROWAN");
+static const u8 sName2[] = _("Rowan");
+
+struct RowanMon
+{
+    u16 species;
+    u8 nature;
+    u8 ability;      // 0 or 1
+    u16 item;
+    u16 moves[4];
+    u8 ev[6];        // HP, Atk, Def, Spe, SpA, SpD
+    u8 iv[6];
+};
+
+#define IV_ALL {31, 31, 31, 31, 31, 31}
+
+static const struct RowanMon sTeam[] =
+{
+    // Snorlax: physical tank and sweeper (Curse)
+    { SPECIES_SNORLAX, NATURE_ADAMANT, 0, ITEM_LEFTOVERS,
+      {MOVE_CURSE, MOVE_BODY_SLAM, MOVE_EARTHQUAKE, MOVE_REST}, {252, 252, 0, 0, 0, 6}, IV_ALL },
+    // Ho-Oh: special attacker and flyer (it can use FLY in the field), Sacred Fire and Recover
+    { SPECIES_HO_OH, NATURE_MODEST, 0, ITEM_CHARCOAL,
+      {MOVE_SACRED_FIRE, MOVE_EARTHQUAKE, MOVE_RECOVER, MOVE_TOXIC}, {252, 0, 0, 6, 252, 0}, IV_ALL },
+    // Starmie: fast special attacker and utility (Rapid Spin)
+    { SPECIES_STARMIE, NATURE_TIMID, 0, ITEM_MYSTIC_WATER,
+      {MOVE_SURF, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_RAPID_SPIN}, {6, 0, 0, 252, 252, 0}, IV_ALL },
+    // Nidoking: wallbreaker and status absorber (Lum Berry)
+    { SPECIES_NIDOKING, NATURE_NAIVE, 0, ITEM_LUM_BERRY,
+      {MOVE_EARTHQUAKE, MOVE_MEGAHORN, MOVE_ICE_BEAM, MOVE_THUNDERBOLT}, {0, 252, 0, 6, 252, 0}, IV_ALL },
+    // Aerodactyl: fast lead and revenge killer
+    { SPECIES_AERODACTYL, NATURE_JOLLY, 0, ITEM_FOCUS_BAND,
+      {MOVE_ROCK_SLIDE, MOVE_EARTHQUAKE, MOVE_AERIAL_ACE, MOVE_HIDDEN_POWER}, {6, 252, 0, 252, 0, 0}, IV_ALL },
+    // Chansey: special wall and support
+    { SPECIES_CHANSEY, NATURE_BOLD, 0, ITEM_SITRUS_BERRY,
+      {MOVE_SOFT_BOILED, MOVE_SEISMIC_TOSS, MOVE_THUNDER_WAVE, MOVE_TOXIC}, {252, 0, 6, 0, 0, 252}, IV_ALL },
+};
+
+static const u16 sFlyTowns[] =
+{
+    FLAG_WORLD_MAP_PALLET_TOWN, FLAG_WORLD_MAP_VIRIDIAN_CITY, FLAG_WORLD_MAP_PEWTER_CITY, FLAG_WORLD_MAP_CERULEAN_CITY,
+    FLAG_WORLD_MAP_LAVENDER_TOWN, FLAG_WORLD_MAP_VERMILION_CITY, FLAG_WORLD_MAP_CELADON_CITY, FLAG_WORLD_MAP_FUCHSIA_CITY,
+    FLAG_WORLD_MAP_CINNABAR_ISLAND, FLAG_WORLD_MAP_INDIGO_PLATEAU_EXTERIOR, FLAG_WORLD_MAP_SAFFRON_CITY,
+    FLAG_WORLD_MAP_ONE_ISLAND, FLAG_WORLD_MAP_TWO_ISLAND, FLAG_WORLD_MAP_THREE_ISLAND, FLAG_WORLD_MAP_FOUR_ISLAND,
+    FLAG_WORLD_MAP_FIVE_ISLAND, FLAG_WORLD_MAP_SEVEN_ISLAND, FLAG_WORLD_MAP_SIX_ISLAND,
+};
+
+static void GiveMon(u8 slot, const struct RowanMon *r)
+{
+    struct Pokemon *mon = &gPlayerParty[slot];
+    u8 i;
+    u32 hp; // SetMonData reads two bytes for HP, and 524 does not fit in a byte
+    u8 level = 100;
+
+    // a personality with the nature wanted
+    do
+    {
+        CreateMon(mon, r->species, level, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+    } while (GetNature(mon) != r->nature);
+    for (i = 0; i < 4; i++)
+        SetMonMoveSlot(mon, r->moves[i], i);
+    SetMonData(mon, MON_DATA_HELD_ITEM, &r->item);
+    SetMonData(mon, MON_DATA_HP_EV, &r->ev[0]);
+    SetMonData(mon, MON_DATA_ATK_EV, &r->ev[1]);
+    SetMonData(mon, MON_DATA_DEF_EV, &r->ev[2]);
+    SetMonData(mon, MON_DATA_SPEED_EV, &r->ev[3]);
+    SetMonData(mon, MON_DATA_SPATK_EV, &r->ev[4]);
+    SetMonData(mon, MON_DATA_SPDEF_EV, &r->ev[5]);
+    SetMonData(mon, MON_DATA_HP_IV, &r->iv[0]);
+    SetMonData(mon, MON_DATA_ATK_IV, &r->iv[1]);
+    SetMonData(mon, MON_DATA_DEF_IV, &r->iv[2]);
+    SetMonData(mon, MON_DATA_SPEED_IV, &r->iv[3]);
+    SetMonData(mon, MON_DATA_SPATK_IV, &r->iv[4]);
+    SetMonData(mon, MON_DATA_SPDEF_IV, &r->iv[5]);
+    CalculateMonStats(mon);
+    hp = 0;
+    hp = GetMonData(mon, MON_DATA_MAX_HP);
+    SetMonData(mon, MON_DATA_HP, &hp);
+}
+
+// Called at the end of a new game's set-up. Does nothing for any other name.
+void HanRowanStart(void)
+{
+    u8 i;
+
+    if (StringCompare(gSaveBlock2Ptr->playerName, sName1) != 0 && StringCompare(gSaveBlock2Ptr->playerName, sName2) != 0)
+        return;
+
+    // Rowan is a girl, drawn as the LASS (picture 85 is the trainer picture number plus one) in palette 3
+    gSaveBlock2Ptr->playerGender = FEMALE;
+    HanLookDefault();
+    gSaveBlock2Ptr->hanLook[HAN_LOOK_SET] = 2;
+    gSaveBlock2Ptr->hanLook[HAN_LOOK_PIC] = 85;
+    gSaveBlock2Ptr->hanLook[HAN_LOOK_PAL] = 3;
+
+    for (i = 0; i < 8; i++)
+        FlagSet(FLAG_BADGE01_GET + i);
+    FlagSet(FLAG_SYS_POKEMON_GET);
+    FlagSet(FLAG_SYS_POKEDEX_GET);
+    FlagSet(FLAG_SYS_SEVII_MAP_123); // the Sevii maps on the fly map (Seven Island is on the last one)
+    FlagSet(FLAG_SYS_SEVII_MAP_4567);
+    FlagSet(FLAG_OPENED_START_MENU);
+    FlagSet(FLAG_HIDE_OAK_IN_PALLET_TOWN);
+    VarSet(VAR_MAP_SCENE_PALLET_TOWN_OAK, 3);
+    VarSet(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 6);
+    VarSet(VAR_MAP_SCENE_VIRIDIAN_CITY_MART, 2);
+    VarSet(VAR_MAP_SCENE_VIRIDIAN_CITY_OLD_MAN, 1);
+    VarSet(VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 1);
+    VarSet(VAR_MAP_SCENE_ROUTE22, 1);
+    for (i = 0; i < ARRAY_COUNT(sFlyTowns); i++)
+        FlagSet(sFlyTowns[i]);
+
+    ZeroPlayerPartyMons();
+    for (i = 0; i < ARRAY_COUNT(sTeam); i++)
+        GiveMon(i, &sTeam[i]);
+    gPlayerPartyCount = ARRAY_COUNT(sTeam);
+
+    // outside the player's house, in Pallet Town
+    SetWarpDestination(MAP_GROUP(MAP_PALLET_TOWN), MAP_NUM(MAP_PALLET_TOWN), -1, 6, 8);
+    WarpIntoMap();
+    // the heal place is Pallet Town too, so a white-out comes back here
+    SetLastHealLocationWarp(HEAL_LOCATION_PALLET_TOWN);
+}
diff --git a/src/han_syllabics_core.h b/src/han_syllabics_core.h
new file mode 100644
index 0000000..4828587
--- /dev/null
+++ b/src/han_syllabics_core.h
@@ -0,0 +1,206 @@
+// Hän build: turns Latin Hän text into Jane's Hän syllabics, a syllable at a time.
+//
+// It follows the converter in her word processor (han-word-processor.html: tokenize,
+// eaglePreprocess, matchV), set as that page starts: the Eagle way of writing finals,
+// and a letter y between a consonant and its vowel shown as a dot.
+// Two things differ on purpose:
+//  - The end of a string counts as the end of a word. The word processor treats the very
+//    end of its text as a consonant still waiting for a vowel, which only suits typing.
+//  - th, dh, tth, ddh, sr, zr, tr, dr and zh have no final in her font, so here they have none.
+//
+// This file has no game code in it, so the same lines can be compiled on a computer and
+// checked against the word processor (tools/han/syllabics_test.c).
+// It needs u8, u16, bool8, TRUE and FALSE, and the tables in data/han_syllabics.h.
+
+#define HAN_SYL_NONE   0 // not syllabics: show the character the usual way
+#define HAN_SYL_GLYPH  1
+#define HAN_SYL_SKIP   2 // shows nothing
+
+#define HAN_SYL_MARK_NASAL  1
+#define HAN_SYL_MARK_TONE   2
+#define HAN_SYL_MARK_DOT    4
+
+#define HAN_SYL_ONSET_COUNT (sizeof(sHanSylOnsets) / sizeof(sHanSylOnsets[0]))
+#define HAN_SYL_PRENASAL_COUNT (sizeof(sHanSylPrenasal) / sizeof(sHanSylPrenasal[0]))
+
+static u8 HanSyl_Letter(const u8 *s)
+{
+    return sHanSylLetters[*s] & HAN_SYL_LETTER_MASK;
+}
+
+static bool8 HanSyl_VowelAt(const u8 *s)
+{
+    switch (HanSyl_Letter(s))
+    {
+    case HAN_SYL_L_A:
+    case HAN_SYL_L_E:
+    case HAN_SYL_L_I:
+    case HAN_SYL_L_O:
+    case HAN_SYL_L_U:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// The letters at s spell this onset.
+static bool8 HanSyl_Match(const u8 *s, const u8 *letters, u8 length)
+{
+    u8 i;
+
+    for (i = 0; i < length; i++)
+    {
+        if (HanSyl_Letter(s + i) != letters[i])
+            return FALSE;
+    }
+    return TRUE;
+}
+
+// Reads the vowel at s. Gives its column in the grid and its marks. Returns how many characters it took:
+// two when the vowel is written twice, which counts as one and keeps the marks of the first.
+static u8 HanSyl_ReadVowel(const u8 *s, u8 *column, u8 *marks)
+{
+    u8 info = sHanSylLetters[*s];
+    u8 letter = info & HAN_SYL_LETTER_MASK;
+    bool8 dots = (info & HAN_SYL_DIAERESIS) != 0;
+
+    switch (letter)
+    {
+    case HAN_SYL_L_A:
+        *column = dots ? 0 : 1;
+        break;
+    case HAN_SYL_L_E:
+        *column = dots ? 2 : 3;
+        break;
+    case HAN_SYL_L_I:
+        *column = 4;
+        break;
+    case HAN_SYL_L_O:
+        *column = dots ? 2 : 5; // ö is written as ë
+        break;
+    default:
+        *column = 6;
+        break;
+    }
+    if (info & HAN_SYL_NASAL_HOOK)
+        *marks |= HAN_SYL_MARK_NASAL;
+    if (info & HAN_SYL_GRAVE)
+        *marks |= HAN_SYL_MARK_TONE;
+    return HanSyl_Letter(s + 1) == letter ? 2 : 1;
+}
+
+// Reads the next piece of the text at s. For HAN_SYL_GLYPH it gives the glyph and the marks that follow it.
+// used is how many characters of the text the piece took.
+static u8 HanSyl_Next(const u8 *s, u16 *glyph, u8 *used, u8 *marks)
+{
+    const struct HanSylOnset *onset;
+    u8 letter = HanSyl_Letter(s);
+    u8 next, column, i;
+    bool8 dot;
+
+    *marks = 0;
+    *used = 1;
+    if (letter == 0)
+        return HAN_SYL_NONE;
+
+    // An apostrophe that is not part of t', k' and the like is the glottal stop.
+    if (letter == HAN_SYL_APOSTROPHE)
+    {
+        *glyph = HAN_SYL_FINALS_BASE + HAN_SYL_FINAL_GLOTTAL;
+        return HAN_SYL_GLYPH;
+    }
+
+    // n, l, w, y and r at the end of a syllable, the Eagle way: n, nn and nh are all one n final.
+    if (letter == HAN_SYL_L_N || letter == HAN_SYL_L_L || letter == HAN_SYL_L_W || letter == HAN_SYL_L_Y || letter == HAN_SYL_L_R)
+    {
+        next = HanSyl_Letter(s + 1);
+        if ((next == letter || next == HAN_SYL_L_H) && !HanSyl_VowelAt(s + 2))
+        {
+            *used = 2;
+            if (next == letter && letter != HAN_SYL_L_N && letter != HAN_SYL_L_R
+             && HanSyl_Letter(s + 2) == letter && !HanSyl_VowelAt(s + 3))
+                *used = 3;
+            for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+            {
+                onset = &sHanSylOnsets[i];
+                if (onset->length == 1 && onset->letters[0] == letter)
+                    break;
+            }
+            *glyph = HAN_SYL_FINALS_BASE + onset->final;
+            if (sHanSylLetters[*s] & HAN_SYL_GRAVE)
+                *marks = HAN_SYL_MARK_TONE;
+            return HAN_SYL_GLYPH;
+        }
+    }
+
+    // nd, mb, nj, ng and ndz before a vowel: an n final, then the syllable.
+    for (i = 0; i < HAN_SYL_PRENASAL_COUNT; i++)
+    {
+        if (HanSyl_Match(s, &sHanSylPrenasal[i][1], sHanSylPrenasal[i][0]) && HanSyl_VowelAt(s + sHanSylPrenasal[i][0]))
+        {
+            *glyph = HAN_SYL_FINALS_BASE + HAN_SYL_FINAL_N;
+            return HAN_SYL_GLYPH;
+        }
+    }
+
+    // A consonant and a vowel, with or without a y between them.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (!HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        dot = HanSyl_Letter(s + onset->length) == HAN_SYL_L_Y && HanSyl_VowelAt(s + onset->length + 1);
+        if (!dot && !HanSyl_VowelAt(s + onset->length))
+            continue;
+        if (onset->lead != HAN_SYL_NO) // tth is a t final and then th
+        {
+            *glyph = HAN_SYL_FINALS_BASE + onset->lead;
+            return HAN_SYL_GLYPH;
+        }
+        if (onset->row == HAN_SYL_NO)  // r and ng have no syllables
+            return HAN_SYL_NONE;
+        *used = onset->length + dot;
+        *used += HanSyl_ReadVowel(s + *used, &column, marks);
+        if (dot)
+            *marks |= HAN_SYL_MARK_DOT;
+        *glyph = onset->row * HAN_SYL_VOWELS + column;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A vowel with no consonant.
+    if (HanSyl_VowelAt(s))
+    {
+        *used = HanSyl_ReadVowel(s, &column, marks);
+        *glyph = HAN_SYL_ROW_VOWEL * HAN_SYL_VOWELS + column;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A consonant with no vowel after it: its final, if it has one.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (onset->final == HAN_SYL_NO || !HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        if (onset->ejectiveBase && HanSyl_Letter(s + onset->length) == HAN_SYL_APOSTROPHE)
+            break;
+        *used = onset->length;
+        *glyph = HAN_SYL_FINALS_BASE + onset->final;
+        if (sHanSylLetters[*s] & HAN_SYL_GRAVE)
+            *marks = HAN_SYL_MARK_TONE;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A consonant that has no final. The word processor leaves it out, unless its last letter can stand as a final.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (!HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        if (HanSyl_Letter(s + onset->length) != HAN_SYL_APOSTROPHE && !onset->endsInFinal)
+        {
+            *used = onset->length;
+            return HAN_SYL_SKIP;
+        }
+        break;
+    }
+    return HAN_SYL_NONE;
+}
diff --git a/src/han_tower.c b/src/han_tower.c
new file mode 100644
index 0000000..60bd5b6
--- /dev/null
+++ b/src/han_tower.c
@@ -0,0 +1,156 @@
+#include "global.h"
+#include "han_tower.h"
+#include "battle.h"
+#include "event_data.h"
+#include "field_player_avatar.h"
+#include "load_save.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "random.h"
+#include "constants/flags.h"
+#include "constants/maps.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+#include "constants/trainers.h"
+
+// Hän build: the TRAINER TOWER from the POKéMON CENTER. The nurse offers a way in, and at the lobby counter the
+// team is chosen: your own at level 50 (raised or lowered to it), or one of three rental teams. One of the
+// three has a one in three chance to be BRANDON's team instead. The real party is kept in the saved copy
+// (gSaveBlock1Ptr->playerParty) the whole time, and saving does not overwrite it while FLAG_HAN_TOWER_TEMP_PARTY
+// is up, so a reset or a save in the middle of a challenge never costs anyone their own team.
+
+#define TOWER_LEVEL 50
+
+struct HanRental
+{
+    u16 species;
+    u16 moves[MAX_MON_MOVES];
+};
+
+static const struct HanRental sRentals[3][PARTY_SIZE] = {
+    { // A: all round
+        { SPECIES_SNORLAX,   { MOVE_BODY_SLAM, MOVE_EARTHQUAKE, MOVE_SHADOW_BALL, MOVE_REST } },
+        { SPECIES_GENGAR,    { MOVE_SHADOW_BALL, MOVE_THUNDERBOLT, MOVE_ICE_PUNCH, MOVE_HYPNOSIS } },
+        { SPECIES_STARMIE,   { MOVE_SURF, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_RECOVER } },
+        { SPECIES_DRAGONITE, { MOVE_DRAGON_CLAW, MOVE_EARTHQUAKE, MOVE_FIRE_PUNCH, MOVE_THUNDER_WAVE } },
+        { SPECIES_ALAKAZAM,  { MOVE_PSYCHIC, MOVE_SHADOW_BALL, MOVE_THUNDER_WAVE, MOVE_RECOVER } },
+        { SPECIES_GYARADOS,  { MOVE_SURF, MOVE_EARTHQUAKE, MOVE_ICE_BEAM, MOVE_DRAGON_DANCE } },
+    },
+    { // B: hard hitters and walls
+        { SPECIES_CHARIZARD, { MOVE_FLAMETHROWER, MOVE_EARTHQUAKE, MOVE_DRAGON_CLAW, MOVE_ROCK_SLIDE } },
+        { SPECIES_VENUSAUR,  { MOVE_SLEEP_POWDER, MOVE_GIGA_DRAIN, MOVE_SLUDGE_BOMB, MOVE_SYNTHESIS } },
+        { SPECIES_BLASTOISE, { MOVE_SURF, MOVE_ICE_BEAM, MOVE_EARTHQUAKE, MOVE_REST } },
+        { SPECIES_SCIZOR,    { MOVE_SWORDS_DANCE, MOVE_STEEL_WING, MOVE_BRICK_BREAK, MOVE_QUICK_ATTACK } },
+        { SPECIES_SKARMORY,  { MOVE_DRILL_PECK, MOVE_STEEL_WING, MOVE_TOXIC, MOVE_ROAR } },
+        { SPECIES_TYRANITAR, { MOVE_CRUNCH, MOVE_EARTHQUAKE, MOVE_ROCK_SLIDE, MOVE_FIRE_BLAST } },
+    },
+    { // C: fast and tricky
+        { SPECIES_JOLTEON,   { MOVE_THUNDERBOLT, MOVE_SHADOW_BALL, MOVE_THUNDER_WAVE, MOVE_SUBSTITUTE } },
+        { SPECIES_MACHAMP,   { MOVE_CROSS_CHOP, MOVE_EARTHQUAKE, MOVE_ROCK_SLIDE, MOVE_FIRE_PUNCH } },
+        { SPECIES_LAPRAS,    { MOVE_SURF, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_CONFUSE_RAY } },
+        { SPECIES_AERODACTYL,{ MOVE_ROCK_SLIDE, MOVE_EARTHQUAKE, MOVE_AERIAL_ACE, MOVE_TAKE_DOWN } },
+        { SPECIES_GARDEVOIR, { MOVE_PSYCHIC, MOVE_THUNDERBOLT, MOVE_CALM_MIND, MOVE_SHADOW_BALL } },
+        { SPECIES_ARCANINE,  { MOVE_FLAMETHROWER, MOVE_EXTREME_SPEED, MOVE_EARTHQUAKE, MOVE_ROAR } },
+    },
+};
+
+static EWRAM_DATA bool8 sBrandonOffered = FALSE;
+
+static void SetMonToTowerLevel(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u32 exp = gExperienceTables[gSpeciesInfo[species].growthRate][TOWER_LEVEL];
+
+    SetMonData(mon, MON_DATA_EXP, &exp);
+    CalculateMonStats(mon);
+}
+
+static void BuildRentalTeam(u8 team)
+{
+    u8 i, j, count = 0;
+    u8 ivs = 31;
+
+    ZeroPlayerPartyMons();
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        const struct HanRental *r = &sRentals[team][i];
+        u8 evs = 85;
+
+        CreateMon(&gPlayerParty[i], r->species, TOWER_LEVEL, ivs, FALSE, 0, OT_ID_PLAYER_ID, 0);
+        for (j = 0; j < MAX_MON_MOVES; j++)
+        {
+            SetMonData(&gPlayerParty[i], MON_DATA_MOVE1 + j, &r->moves[j]);
+            SetMonData(&gPlayerParty[i], MON_DATA_PP1 + j, &gBattleMoves[r->moves[j]].pp);
+        }
+        for (j = 0; j < NUM_STATS; j++)
+            SetMonData(&gPlayerParty[i], MON_DATA_HP_EV + j, &evs);
+        CalculateMonStats(&gPlayerParty[i]);
+        count++;
+    }
+    gPlayerPartyCount = count;
+}
+
+// 1 when BRANDON's team takes the place of rental team C in this offer
+u8 HanTowerRollSpecial(void)
+{
+    sBrandonOffered = (Random() % 3) == 0;
+    return sBrandonOffered;
+}
+
+// the nurse has offered the way in
+void HanTowerSetReturn(void)
+{
+    FlagSet(FLAG_HAN_TOWER_FROM_CENTER);
+}
+
+// every time the lobby loads: where its door leads. From a POKéMON CENTER it is the last place healed (the same
+// place a white out goes to), otherwise Seven Island, as in the original game.
+void HanTowerApplyReturn(void)
+{
+    if (FlagGet(FLAG_HAN_TOWER_FROM_CENTER))
+    {
+        struct WarpData *w = &gSaveBlock1Ptr->lastHealLocation;
+
+        SetDynamicWarpWithCoords(0, w->mapGroup, w->mapNum, -1, w->x, w->y);
+    }
+    else
+        SetDynamicWarpWithCoords(0, MAP_GROUP(MAP_SEVEN_ISLAND_TRAINER_TOWER), MAP_NUM(MAP_SEVEN_ISLAND_TRAINER_TOWER), -1, 58, 8);
+}
+
+// gSpecialVar_0x8004: 0 your own team, 1 to 3 the rental teams (3 is BRANDON's when he was offered). FALSE: not possible.
+bool8 HanTowerBuildTeam(void)
+{
+    u8 choice = gSpecialVar_0x8004;
+    u8 i;
+
+    if (choice == 0)
+    {
+        // your own team needs a Pokémon that can fight (the tower heals it first)
+        SavePlayerParty();
+        FlagSet(FLAG_HAN_TOWER_TEMP_PARTY);
+        for (i = 0; i < gPlayerPartyCount; i++)
+            SetMonToTowerLevel(&gPlayerParty[i]);
+        return TRUE;
+    }
+    SavePlayerParty();
+    FlagSet(FLAG_HAN_TOWER_TEMP_PARTY);
+    if (choice == 3 && sBrandonOffered)
+    {
+        HanTowerCopyTrainerTeam(TRAINER_LEADER_KOGA); // BRANDON
+        for (i = 0; i < gPlayerPartyCount; i++)
+            SetMonToTowerLevel(&gPlayerParty[i]);
+        return TRUE;
+    }
+    BuildRentalTeam(choice - 1);
+    return TRUE;
+}
+
+// the lobby is where every challenge ends: the player's own team comes back
+void HanTowerRestoreParty(void)
+{
+    if (FlagGet(FLAG_HAN_TOWER_TEMP_PARTY))
+    {
+        LoadPlayerParty();
+        FlagClear(FLAG_HAN_TOWER_TEMP_PARTY);
+    }
+}
diff --git a/src/han_trade.c b/src/han_trade.c
new file mode 100644
index 0000000..d240834
--- /dev/null
+++ b/src/han_trade.c
@@ -0,0 +1,383 @@
+#include "global.h"
+#include "gflib.h"
+#include "battle.h"
+#include "load_save.h"
+#include "main.h"
+#include "overworld.h"
+#include "link.h"
+#include "constants/cable_club.h"
+#include "constants/trainers.h"
+#include "event_data.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "han_custom.h"
+#include "han_multiplayer.h"
+#include "pokedex.h"
+#include "pokemon.h"
+#include "script.h"
+#include "string_util.h"
+#include "constants/songs.h"
+#include "constants/species.h"
+#include "sound.h"
+
+// Hän build: trading Pokémon with another player of the room (Jane, 22 November 2026).
+//
+// Face another player and press A. They are asked, each picks a Pokémon, each sees what the other offers, and if both
+// say yes the two Pokémon swap places in the parties. The messages go through the page like the positions do
+// (struct HanTradeBox in han_multiplayer.h):
+//   A: OFFER(monA) -> B: shows it, B picks monB, COUNTER(monB) -> A: shows it, A says yes, ACCEPT, A swaps at once
+//   B: gets ACCEPT, swaps. Either side can CANCEL, and each gives up after about 20 seconds without an answer.
+// If the connection drops between A's swap and B's, A has both Pokémon: this is for friends.
+
+extern const u8 Han_Trade_Initiate[];
+extern const u8 Han_Trade_Incoming[];
+extern const u8 Han_Battle_Incoming[];
+
+static EWRAM_DATA u8 sPeer = 0;        // the other player's slot
+static EWRAM_DATA u8 sMySlot = 0;      // my party slot that is offered
+static EWRAM_DATA u8 sBusy = 0;        // 1 I started, 2 someone started
+static EWRAM_DATA u8 sLastIn = 0;      // in.seq already looked at
+static EWRAM_DATA u8 sGot = 0;         // 0 nothing yet, 1 counter or accept came, 2 cancel came
+static EWRAM_DATA u8 sKind = 0;
+static EWRAM_DATA u8 sRemoteDone = 0;
+
+static void Send(u8 kind, const struct BoxPokemon *mon)
+{
+    struct HanTradeBox *o = &gHanMailbox.out;
+
+    o->kind = kind;
+    o->slot = sPeer;
+    if (mon != NULL)
+        CpuCopy16(mon, o->mon, sizeof(struct BoxPokemon));
+    o->seq++;
+}
+
+// A Pokémon can go if it is not the last one that is left to fight and is not an egg that would leave only eggs.
+static bool8 CanSend(u8 slot)
+{
+    u8 i, others = 0;
+
+    if (slot >= PARTY_SIZE || GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES) == SPECIES_NONE)
+        return FALSE;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (i != slot && GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE
+         && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG) && GetMonData(&gPlayerParty[i], MON_DATA_HP) > 0)
+            others++;
+    return others > 0 && !GetMonData(&gPlayerParty[slot], MON_DATA_IS_EGG);
+}
+
+static void Swap(const struct BoxPokemon *incoming)
+{
+    struct Pokemon *mon = &gPlayerParty[sMySlot];
+    u32 zero = 0;
+    u8 level;
+    u16 hp, species;
+
+    ZeroMonData(mon);
+    mon->box = *incoming;
+    SetMonData(mon, MON_DATA_STATUS, &zero);
+    level = GetLevelFromBoxMonExp(&mon->box);
+    SetMonData(mon, MON_DATA_LEVEL, &level);
+    CalculateMonStats(mon);
+    hp = GetMonData(mon, MON_DATA_MAX_HP);
+    SetMonData(mon, MON_DATA_HP, &hp);
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_SEEN);
+    GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_CAUGHT);
+    PlaySE(SE_SUCCESS);
+}
+
+// ---- specials, called from the scripts in data/scripts/han_trade.inc
+
+// my chosen Pokémon is gSpecialVar_0x8004; FALSE if it cannot go
+u16 HanTradeOffer(void)
+{
+    if (!CanSend(gSpecialVar_0x8004))
+        return FALSE;
+    sMySlot = gSpecialVar_0x8004;
+    sGot = 0;
+    Send(HAN_T_OFFER, &gPlayerParty[sMySlot].box);
+    return TRUE;
+}
+
+// B has chosen (gSpecialVar_0x8004) after an offer: send the counter
+u16 HanTradeCounter(void)
+{
+    if (!CanSend(gSpecialVar_0x8004))
+        return FALSE;
+    sMySlot = gSpecialVar_0x8004;
+    sGot = 0;
+    Send(HAN_T_COUNTER, &gPlayerParty[sMySlot].box);
+    return TRUE;
+}
+
+// 0 nothing yet, 1 the answer came (a counter for A, an accept for B), 2 the other side said no
+u16 HanTradePoll(void)
+{
+    struct HanTradeBox *in = &gHanMailbox.in;
+
+    if (in->seq != sLastIn)
+    {
+        sLastIn = in->seq;
+        if (in->slot == sPeer)
+        {
+            if (in->kind == HAN_T_CANCEL)
+                sGot = 2;
+            else if ((sBusy == 1 && in->kind == HAN_T_COUNTER) || (sBusy == 2 && in->kind == HAN_T_ACCEPT))
+            {
+                sGot = 1;
+                sKind = in->kind;
+            }
+        }
+    }
+    return sGot;
+}
+
+// names for the messages: {STR_VAR_1} the Pokémon coming in, {STR_VAR_2} mine that goes
+void HanTradeNames(void)
+{
+    GetSpeciesName(gStringVar1, GetBoxMonData((struct BoxPokemon *)gHanMailbox.in.mon, MON_DATA_SPECIES));
+    GetSpeciesName(gStringVar2, GetMonData(&gPlayerParty[sMySlot], MON_DATA_SPECIES));
+}
+
+// B is shown the offer before choosing
+void HanTradeNameIn(void)
+{
+    GetSpeciesName(gStringVar1, GetBoxMonData((struct BoxPokemon *)gHanMailbox.in.mon, MON_DATA_SPECIES));
+}
+
+// A says yes: swap, and tell B
+void HanTradeAccept(void)
+{
+    Swap((const struct BoxPokemon *)gHanMailbox.in.mon);
+    Send(HAN_T_ACCEPT, NULL);
+    sBusy = 0;
+}
+
+// B's side after the accept came: A's offer, still in the buffer (accept and cancel carry no Pokémon), comes
+void HanTradeApply(void)
+{
+    Swap((const struct BoxPokemon *)gHanMailbox.in.mon);
+    sBusy = 0;
+}
+
+void HanTradeCancel(void)
+{
+    if (sBusy)
+        Send(HAN_T_CANCEL, NULL);
+    sBusy = 0;
+}
+
+void HanTradeDone(void)
+{
+    sBusy = 0;
+}
+
+
+// ---- battling: the game's own link battle, with the page as the cable (src/han_link.c)
+
+static void BuildLinkPlayer(struct LinkPlayer *lp)
+{
+    u8 *b = (u8 *)lp;
+    u8 i;
+
+    for (i = 0; i < sizeof(*lp); i++)
+        b[i] = 0;
+    lp->trainerId = gSaveBlock2Ptr->playerTrainerId[0] | (gSaveBlock2Ptr->playerTrainerId[1] << 8)
+                  | (gSaveBlock2Ptr->playerTrainerId[2] << 16) | (gSaveBlock2Ptr->playerTrainerId[3] << 24);
+    StringCopy(lp->name, gSaveBlock2Ptr->playerName);
+    lp->gender = gSaveBlock2Ptr->playerGender;
+    lp->linkType = LINKTYPE_BATTLE;
+    lp->language = gGameLanguage;
+    lp->version = gGameVersion + 0x4000;
+    lp->lp_field_2 = 0x8000;
+    HanLookPicPal(&lp->neverRead, &lp->progressFlagsCopy); // the chosen picture and palette go with it
+}
+
+static const u8 gText_HanDouble[] = _("double");
+static const u8 gText_HanSingle[] = _("single");
+static EWRAM_DATA u8 sDouble = 0;   // the battle that was asked for is a double battle
+
+// at least `need` Pokémon that can fight (2 for a double battle)
+static bool8 CanBattle(u8 need)
+{
+    u8 i, n = 0;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP) > 0)
+            n++;
+    return n >= need;
+}
+
+// A asks (gSpecialVar_0x8004 is 1 for a double battle): FALSE if I have too few that can fight
+u16 HanBattleChallenge(void)
+{
+    struct LinkPlayer lp;
+
+    sDouble = gSpecialVar_0x8004 != 0;
+    if (!CanBattle(sDouble ? 2 : 1))
+        return FALSE;
+    BuildLinkPlayer(&lp);
+    lp.id = sDouble;   // (the id is set again when the link starts)
+    CpuCopy16(&lp, gHanMailbox.out.mon, sizeof(struct LinkPlayer));
+    Send(HAN_T_CHALLENGE, NULL);
+    sGot = 0;
+    return TRUE;
+}
+
+// 0 nothing yet, 1 yes, 2 no
+u16 HanBattlePoll(void)
+{
+    struct HanTradeBox *in = &gHanMailbox.in;
+
+    if (in->seq != sLastIn)
+    {
+        sLastIn = in->seq;
+        if (in->slot == sPeer)
+        {
+            if (in->kind == HAN_T_BATTLE_OK)
+            {
+                sGot = 1;
+                sRemoteDone = 1;
+            }
+            else if (in->kind == HAN_T_BATTLE_NO || in->kind == HAN_T_CANCEL)
+                sGot = 2;
+        }
+    }
+    return sGot;
+}
+
+// B is shown the challenge: {STR_VAR_1} is "single" or "double"
+void HanBattleKindName(void)
+{
+    struct LinkPlayer theirs;
+
+    CpuCopy16(gHanMailbox.in.mon, &theirs, sizeof(struct LinkPlayer));
+    StringCopy(gStringVar1, theirs.id != 0 ? gText_HanDouble : gText_HanSingle);
+}
+
+// B says yes: the link starts as player 1, and A is told
+u16 HanBattleAccept(void)
+{
+    struct LinkPlayer mine, theirs;
+
+    CpuCopy16(gHanMailbox.in.mon, &theirs, sizeof(struct LinkPlayer));
+    sDouble = theirs.id != 0;
+    if (!CanBattle(sDouble ? 2 : 1))
+        return FALSE;
+    BuildLinkPlayer(&mine);
+    HanLinkStart(1, sPeer, &mine, &theirs);
+    CpuCopy16(&mine, gHanMailbox.out.mon, sizeof(struct LinkPlayer));
+    Send(HAN_T_BATTLE_OK, NULL);
+    return TRUE;
+}
+
+void HanBattleRefuse(void)
+{
+    Send(HAN_T_BATTLE_NO, NULL);
+    sBusy = 0;
+}
+
+static void CB2_HanBattleReturn(void)
+{
+    switch (gMain.state)
+    {
+    case 0:
+        gBattleTypeFlags &= ~BATTLE_TYPE_LINK_IN_BATTLE;
+        LoadPlayerParty();
+        if (gHanMailbox.link.on)
+            SetCloseLinkCallback();
+        gMain.state++;
+        break;
+    case 1:
+        if (!gHanMailbox.link.on && IsLinkTaskFinished())
+            SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+        break;
+    }
+}
+
+// both players: go into the battle. A (player 0) has its answer in in.mon, B has already started the link.
+void HanBattleLaunch(void)
+{
+    struct LinkPlayer mine, theirs;
+
+    if (sBusy == 1)
+    {
+        BuildLinkPlayer(&mine);
+        CpuCopy16(gHanMailbox.in.mon, &theirs, sizeof(struct LinkPlayer));
+        HanLinkStart(0, sPeer, &mine, &theirs);
+    }
+    sBusy = 0;
+    SavePlayerParty();
+    gLinkType = LINKTYPE_BATTLE;
+    gSpecialVar_0x8004 = sDouble ? USING_DOUBLE_BATTLE : USING_SINGLE_BATTLE;
+    gBattleTypeFlags = BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK | (sDouble ? BATTLE_TYPE_DOUBLE : 0);
+    PlayMapChosenOrBattleBGM(MUS_RS_VS_TRAINER);
+    CleanupOverworldWindowsAndTilemaps();
+    gTrainerBattleOpponent_A = TRAINER_LINK_OPPONENT;
+    gMain.savedCallback = CB2_HanBattleReturn;
+    SetMainCallback2(CB2_InitBattle);
+}
+
+// ---- every frame in the overworld
+
+static bool8 FrontPlayer(u8 *slot)
+{
+    s16 x, y;
+    u8 i;
+
+    GetXYCoordsOneStepInFrontOfPlayer(&x, &y);
+    x -= MAP_OFFSET;
+    y -= MAP_OFFSET;
+    for (i = 0; i < HAN_OTHERS; i++)
+    {
+        if (gHanMailbox.others[i].active && gHanMailbox.spriteIds[i] != MAX_SPRITES
+         && gHanMailbox.others[i].x == x && gHanMailbox.others[i].y == y)
+        {
+            *slot = i;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+void HanTradeFrame(void)
+{
+    struct HanTradeBox *in = &gHanMailbox.in;
+    u8 slot;
+
+    if (sBusy || ArePlayerFieldControlsLocked())
+    {
+        return;
+    }
+    if (in->seq != sLastIn && in->kind == HAN_T_OFFER)
+    {
+        // someone offers a trade
+        sLastIn = in->seq;
+        sPeer = in->slot;
+        sBusy = 2;
+        sGot = 0;
+        ScriptContext_SetupScript(Han_Trade_Incoming);
+        return;
+    }
+    if (in->seq != sLastIn && in->kind == HAN_T_CHALLENGE)
+    {
+        sLastIn = in->seq;
+        sPeer = in->slot;
+        sBusy = 2;
+        sGot = 0;
+        ScriptContext_SetupScript(Han_Battle_Incoming);
+        return;
+    }
+    if (in->seq != sLastIn)
+        sLastIn = in->seq; // a message for a trade that is over
+    if (JOY_NEW(A_BUTTON) && gPlayerAvatar.tileTransitionState == T_NOT_MOVING && FrontPlayer(&slot))
+    {
+        sPeer = slot;
+        sBusy = 1;
+        sGot = 0;
+        ScriptContext_SetupScript(Han_Trade_Initiate);
+    }
+}
