+// Hän build: which POKéMON a trainer sends next. The game's own choice, with two things Jane asked for:
+//  - CHAMPION JANE sends the UNOWN half of the time, if it can still fight;
+//  - BRANDON does not send PILOSWINE while it hails, if he has another: its SNOW WARNING would do nothing.
+static bool8 HanCanSend(u32 slot)
+{
+    struct Pokemon *mon = &gEnemyParty[slot];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES_OR_EGG);
+
+    return species != SPECIES_NONE && species != SPECIES_EGG && GetMonData(mon, MON_DATA_HP) != 0
+        && slot != gBattlerPartyIndexes[gActiveBattler];
+}
+
+u8 GetMostSuitableMonToSwitchInto(void)
+{
+    u32 i;
+    u8 pick;
+
+    if (*(gBattleStruct->monToSwitchIntoId + gActiveBattler) != PARTY_SIZE)
+        return *(gBattleStruct->monToSwitchIntoId + gActiveBattler);
+    if ((gBattleTypeFlags & BATTLE_TYPE_TRAINER) && !(gBattleTypeFlags & (BATTLE_TYPE_DOUBLE | BATTLE_TYPE_LINK))
+     && GetBattlerSide(gActiveBattler) == B_SIDE_OPPONENT)
+    {
+        if (IsJaneBattle() && (Random() & 1))
+        {
+            for (i = 0; i < PARTY_SIZE; i++)
+            {
+                if (GetMonData(&gEnemyParty[i], MON_DATA_SPECIES) == SPECIES_UNOWN && HanCanSend(i))
+                    return i;
+            }
+        }
+        pick = GameMostSuitableMonToSwitchInto();
+        if (gTrainerBattleOpponent_A == TRAINER_LEADER_KOGA && (gBattleWeather & B_WEATHER_HAIL)
+         && pick < PARTY_SIZE && GetMonData(&gEnemyParty[pick], MON_DATA_SPECIES) == SPECIES_PILOSWINE)
+        {
+            for (i = 0; i < PARTY_SIZE; i++)
+            {
+                if (i != pick && HanCanSend(i))
+                    return i;
+            }
+        }
+        return pick;
+    }
+    return GameMostSuitableMonToSwitchInto();
+}
