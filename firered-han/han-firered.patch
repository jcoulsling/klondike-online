+def read_book(path, groups, cm, rom=None):
+    """Returns (typed translations by group key, rules, rows that found no place)."""
+    if str(path).lower().endswith(".json"):          # saved by the HTML translator
+        saved = json.loads(Path(path).read_text(encoding="utf-8"))
+        manual, problems, rules = {}, [], OrderedDict()
+        lookup = {(g.family, g.english): g for g in groups.values()}
+        for row in saved.get("rows", []):
+            han = str(row.get("han", ""))
+            if not han.strip():
+                continue
+            group = lookup.get((row.get("section"), row.get("english")))
+            if group is None:
+                problems.append(("", row.get("english"), han, "this row does not match this version of the game"))
+                continue
+            try:
+                manual[group.key] = modernise(han, group, cm)
+            except ValueError as e:
+                problems.append(("", group.english, han, str(e)))
+        for rule in saved.get("rules", []):
+            if rule.get("english") and rule.get("han"):
+                rules[str(rule["english"])] = str(rule["han"])
+        return manual, rules, problems
+    import openpyxl
+    wb = openpyxl.load_workbook(path)
+    ws = wb["Strings"]
+    header = [str(c.value or "").strip() for c in ws[1]]
+    manual, problems = {}, []
+    rules = OrderedDict()
+    if "Rules" in wb.sheetnames:
+        for row in wb["Rules"].iter_rows(min_row=2, values_only=True):
+            if row and len(row) >= 3 and row[1] and row[2]:
+                rules[str(row[1])] = str(row[2])
+    by_data = defaultdict(list)
+    for g in groups.values():
+        by_data[g.data].append(g)
+    if "Offset" in header:                       # exported by Han_FireRed_Tool.html
+        table = json.loads(OLD_OFFSETS.read_text()) if OLD_OFFSETS.exists() else {}
+        by_first_unit = {(g.units[0].path, g.units[0].context, g.units[0].pos): g for g in groups.values()}
+        rom_bytes = Path(rom).read_bytes() if rom else None
+        learned = {}
+        col = {name: header.index(name) for name in ("Offset", "English", "Hän")}
+        cat_col = header.index("Category") if "Category" in header else None
+        for row in ws.iter_rows(min_row=2, values_only=True):
+            offset, han = str(row[col["Offset"]]), row[col["Hän"]]
+            category = row[cat_col] if cat_col is not None else None
+            group = None
+            if rom_bytes is not None:
