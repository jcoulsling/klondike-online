diff --git a/data/maps/SafariZone_IceCave/scripts.inc b/data/maps/SafariZone_IceCave/scripts.inc
new file mode 100644
index 0000000..25ee2c5
--- /dev/null
+++ b/data/maps/SafariZone_IceCave/scripts.inc
@@ -0,0 +1,49 @@
+@ Hän build: an ice cave in the SAFARI ZONE, with a MIGHTYENA standing in it. Jane asked for it (17 November 2026).
+@ The room is the back room of ICEFALL CAVE: the map uses that room's layout and has its own people and doors.
+SafariZone_IceCave_MapScripts::
+	map_script MAP_SCRIPT_ON_RESUME, SafariZone_IceCave_OnResume
+	.byte 0
+
+@ As in the POWER PLANT: when the MIGHTYENA has been caught, take it off the map as the map comes back.
+SafariZone_IceCave_OnResume::
+	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, SafariZone_IceCave_EventScript_TryRemoveMightyena
+	end
+
+SafariZone_IceCave_EventScript_TryRemoveMightyena::
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_Return
+	removeobject VAR_LAST_TALKED
+	return
+
+@ The MIGHTYENA is fought like the game's other standing POKéMON (the ELECTRODE in the POWER PLANT), not with
+@ SAFARI BALLS. It has SLUSH RUSH: see CreateScriptedWildMon.
+SafariZone_IceCave_EventScript_Mightyena::
+	goto_if_questlog EventScript_ReleaseEnd
+	lock
+	faceplayer
+	setwildbattle SPECIES_MIGHTYENA, 35
+	waitse
+	playmoncry SPECIES_MIGHTYENA, CRY_MODE_ENCOUNTER
+	delay 40
+	waitmoncry
+	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
+	dowildbattle
+	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
+	special QuestLog_CutRecording
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_eq VAR_RESULT, B_OUTCOME_WON, SafariZone_IceCave_EventScript_FoughtMightyena
+	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, SafariZone_IceCave_EventScript_MightyenaStays
+	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, SafariZone_IceCave_EventScript_MightyenaStays
+	setflag FLAG_HIDE_SAFARI_ICE_CAVE_MIGHTYENA @ caught
+	release
+	end
+
+@ If the player runs, it is still there. (The POWER PLANT's ELECTRODE is gone for good; this is the only one of its kind.)
+SafariZone_IceCave_EventScript_MightyenaStays::
+	release
+	end
+
+SafariZone_IceCave_EventScript_FoughtMightyena::
+	setflag FLAG_HIDE_SAFARI_ICE_CAVE_MIGHTYENA
+	goto EventScript_RemoveStaticMon
+	end
