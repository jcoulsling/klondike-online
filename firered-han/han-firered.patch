+// Hän build: level caps. A gym leader will not battle a trainer whose party holds a Pokémon above the cap for the number of
+// badges that trainer has from the leader's own region (Kanto or Hoenn). The cap is the level of the leader's strongest Pokémon.
+static const u8 sHanKantoCaps[9] = {14, 21, 24, 29, 43, 43, 47, 50, 100};
+static const u8 sHanHoennCaps[9] = {15, 19, 24, 29, 31, 33, 42, 46, 100};
+
+static bool8 HanIsLeader(u16 id)
+{
+    switch (id)
+    {
+    case TRAINER_LEADER_BROCK: case TRAINER_LEADER_MISTY: case TRAINER_LEADER_LT_SURGE: case TRAINER_LEADER_ERIKA:
+    case TRAINER_LEADER_KOGA: case TRAINER_LEADER_SABRINA: case TRAINER_LEADER_BLAINE: case TRAINER_LEADER_GIOVANNI:
+    case TRAINER_HOENN_ROXANNE_1: case TRAINER_HOENN_BRAWLY_1: case TRAINER_HOENN_WATTSON_1: case TRAINER_HOENN_FLANNERY_1:
+    case TRAINER_HOENN_NORMAN_1: case TRAINER_HOENN_WINONA_1: case TRAINER_HOENN_TATE_AND_LIZA_1: case TRAINER_HOENN_JUAN_1:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// TRUE (and gStringVar1 = the cap) if the party is over the cap for a gym leader
+static bool8 HanOverLevelCap(u16 id)
+{
+    u8 i, level, cap, badges = 0, top = 0;
+    bool8 hoenn = id >= MAX_TRAINERS_COUNT;
+
+    if (!HanIsLeader(id))
+        return FALSE;
+    if (hoenn)
+        badges = HanHoennBadgeCount();
+    else
+        for (i = 0; i < 8; i++)
+            if (FlagGet(FLAG_BADGE01_GET + i))
+                badges++;
+    cap = hoenn ? sHanHoennCaps[badges] : sHanKantoCaps[badges];
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            continue;
+        level = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+        if (level > top)
+            top = level;
+    }
+    if (top <= cap)
+        return FALSE;
+    ConvertIntToDecimalStringN(gStringVar1, cap, STR_CONV_MODE_LEFT_ALIGN, 3);
+    return TRUE;
+}
