+def write_book(path, groups, rules, problems=()):
+    import openpyxl
+    from openpyxl.styles import Alignment, Font, PatternFill
+    from openpyxl.utils import get_column_letter
+    wb = openpyxl.Workbook()
+    ws = wb.active
+    ws.title = "Strings"
+    cols = ["English", "Hän", "In game", "Source", "Used", "Section", "Similar", "Notes", "Where"]
+    ws.append(cols)
+    rows = [g for g in groups.values() if is_translatable(g.english)]
+    rows.sort(key=lambda g: (g.rank, g.section))
+    wrap = Alignment(wrap_text=True, vertical="top")
+    for g in rows:
+        places = "; ".join(u.where for u in g.units[:4]) + (" ... and %d more" % (len(g.units) - 4) if len(g.units) > 4 else "")
+        shown = "(nothing)" if g.final == "" else (g.final or "")
+        ws.append([g.english, g.han or "", shown, g.source, len(g.units), g.section, g.similar,
+                   "; ".join(g.notes), places])
+    head_fill = PatternFill("solid", fgColor="DDDDDD")
+    for c in ws[1]:
+        c.font = Font(bold=True)
+        c.fill = head_fill
+    for i, w in enumerate([52, 52, 52, 12, 7, 26, 44, 44, 60], 1):
+        ws.column_dimensions[get_column_letter(i)].width = w
+    for row in ws.iter_rows(min_row=2, max_col=3):
+        for c in row:
+            c.alignment = wrap
+            if isinstance(c.value, str) and c.value.startswith("="):
+                c.data_type = "s"            # text, not a formula
+    han_fill = PatternFill("solid", fgColor="FFF8DC")
+    for row in ws.iter_rows(min_row=2, min_col=2, max_col=2):
+        row[0].fill = han_fill
+    ws.freeze_panes = "B2"
+    ws.auto_filter.ref = "A1:%s%d" % (get_column_letter(len(cols)), ws.max_row)
+
+    wr = wb.create_sheet("Rules")
+    wr.append(["Type", "English", "Hän"])
+    for k, v in rules.items():
+        wr.append(["word", k, v])
+    for c in wr[1]:
+        c.font = Font(bold=True)
+    wr.column_dimensions["B"].width = 40
+    wr.column_dimensions["C"].width = 40
+
+    if problems:
+        wp = wb.create_sheet("Not placed")
+        wp.append(["Old offset", "English", "Hän", "Why"])
+        for p in problems:
+            wp.append(list(p))
+        for c in wp[1]:
+            c.font = Font(bold=True)
+        for col in "BCD":
+            wp.column_dimensions[col].width = 50
+
+    wm = wb.create_sheet("Read me")
+    for line in README:
+        wm.append([line])
+    wm.column_dimensions["A"].width = 130
+    for row in wm.iter_rows():
+        row[0].alignment = Alignment(wrap_text=True, vertical="top")
+    wm["A1"].font = Font(bold=True, size=14)
+    wm["A%d" % (README.index("A note on the use of an LLM (AI assistant)") + 1)].font = Font(bold=True)
+    wb.save(path)
+    return len(rows)
