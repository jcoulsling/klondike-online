+#!/usr/bin/env python3
+"""The title screen of Hän FireRed: "POKéMON KLONDIKE VERSION", with an UNOWN D where the CHARIZARD stood.
+
+    python3 tools/han/han_klondike.py        at each build (han_emerald.py runs it)
+
+Jane asked for this on 22 November 2026. Both pictures are made from the games' art, so they are made at
+build time from the game's own files in the source folder and kept out of git and the patch
+(graphics/title_screen/klondike/ is in .gitignore):
+
+  game_title_logo.*   The POKéMON logo as it is. The words FIRERED VERSION are taken out and
+                      KLONDIKE VERSION is drawn in their place, white with a black edge. The letters are
+                      drawn by this script from small bitmaps below (K L O N D I E V R S). It is not a font.
+  box_art_mon.*       The CHARIZARD is taken out and four UNOWN pictures of the game (D E N E, two by two) are put on the lower right.
+
+Safe to run again.
+"""
+import struct
+import sys
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+SRC = ROOT / "graphics/title_screen/firered"
+OUT = ROOT / "graphics/title_screen/klondike"
+UNOWN = str(ROOT) + "/graphics/pokemon/unown/%s/front.png"
+WORD = ["DE", "NE"]      # four UNOWN stacked two by two, reading DENE (Jane, 23 November 2026)
+
+GLYPHS = {   # five wide, seven high
+    "K": ["#...#", "#..#.", "#.#..", "##...", "#.#..", "#..#.", "#...#"],
+    "L": ["#....", "#....", "#....", "#....", "#....", "#....", "#####"],
+    "O": [".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."],
+    "N": ["#...#", "##..#", "#.#.#", "#..##", "#...#", "#...#", "#...#"],
+    "D": ["####.", "#...#", "#...#", "#...#", "#...#", "#...#", "####."],
+    "I": ["#####", "..#..", "..#..", "..#..", "..#..", "..#..", "#####"],
+    "E": ["#####", "#....", "#....", "####.", "#....", "#....", "#####"],
+    "V": ["#...#", "#...#", "#...#", "#...#", ".#.#.", ".#.#.", "..#.."],
+    "R": ["####.", "#...#", "#...#", "####.", "#.#..", "#..#.", "#...#"],
+    "S": [".####", "#....", "#....", ".###.", "....#", "....#", "####."],
+    "6": [".###.", "#....", "#....", "####.", "#...#", "#...#", ".###."],
+    "7": ["#####", "....#", "...#.", "..#..", ".#...", ".#...", ".#..."],
+    ".": [".", ".", ".", ".", ".", ".", "#"],
+    " ": ["..", "..", "..", "..", "..", "..", ".."],
+}
+VERSION = "VER .67"      # the patch number, shown small under KLONDIKE VERSION on the title screen
+BLACK, WHITE, GREY = 206, 207, 205     # entries of the logo's own palette
+
+
+def put(path, data):
+    if not path.exists() or path.read_bytes() != data:
+        path.write_bytes(data)
+
+
+def jasc(rgb):
+    return ("JASC-PAL\r\n0100\r\n%d\r\n" % len(rgb) + "".join("%d %d %d\r\n" % c for c in rgb)).encode()
+
+
+def tiles_of(img, w_tiles, h_tiles, depth):
+    """Cut an indexed picture into 8x8 tiles; returns the list of distinct tiles (first is blank) and the map."""
+    px = img.load()
+    uniq, index, tmap = [tuple([0] * 64)], {tuple([0] * 64): 0}, []
+    for ty in range(h_tiles):
+        for tx in range(w_tiles):
+            t = tuple(px[tx * 8 + x, ty * 8 + y] for y in range(8) for x in range(8))
+            if t not in index:
+                index[t] = len(uniq)
+                uniq.append(t)
+            tmap.append(index[t])
+    return uniq, tmap
+
+
+def sheet(uniq, per_row, palette):
+    rows = (len(uniq) + per_row - 1) // per_row
+    im = Image.new("P", (per_row * 8, rows * 8), 0)
+    im.putpalette(palette)
+    px = im.load()
+    for n, t in enumerate(uniq):
+        ox, oy = (n % per_row) * 8, (n // per_row) * 8
+        for i, v in enumerate(t):
+            px[ox + i % 8, oy + i // 8] = v
+    return im
+
+
+def draw_line(px, text, centre_x, top):
+    """White letters with a black edge, 14 rows high. Returns nothing; draws into px (a 256x160 picture)."""
+    adv = 12
+    width = adv * len(text) - 1
+    x0 = centre_x - width // 2
+    fill = set()
+    for n, ch in enumerate(text):
+        g = GLYPHS[ch]
+        for gy in range(7):
+            for gx in range(5):
+                if g[gy][gx] == "#":
+                    for dx in (0, 1, 2):                    # a stroke three wide
+                        for dy in (0, 1, 2):                # and three high
+                            fill.add((x0 + n * adv + gx * 2 + dx, top + gy * 2 + dy))
+    edge = {(x + dx, y + dy) for (x, y) in fill for dx in (-1, 0, 1) for dy in (-1, 0, 1)} - fill
+    for (x, y) in edge:
+        px[x, y] = BLACK
+    for (x, y) in fill:
+        px[x, y] = WHITE if y - top < 10 else GREY
+
+
+def draw_small(px, text, right_x, top):
+    """The version number: small white letters, one pixel a stroke, with a black edge, ending at right_x."""
+    cols = []
+    for ch in text:
+        cols += [GLYPHS[ch]] + [None]
+    width = sum((len(g[0]) if g else 1) for g in cols)
+    x = right_x - width + 1
+    fill = set()
+    for g in cols:
+        if g is None:
+            x += 1
+            continue
+        for gy in range(7):
+            for gx in range(len(g[0])):
+                if g[gy][gx] == "#":
+                    fill.add((x + gx, top + gy))
+        x += len(g[0])
+    edge = {(a + dx, b + dy) for (a, b) in fill for dx in (-1, 0, 1) for dy in (-1, 0, 1)} - fill
+    for (a, b) in edge:
+        px[a, b] = BLACK
+    for (a, b) in fill:
+        px[a, b] = WHITE
+
+
+def logo():
+    t = (SRC / "game_title_logo.8bpp").read_bytes()
+    m = struct.unpack("<640H", (SRC / "game_title_logo.bin").read_bytes())
+    pal = struct.unpack("<256H", (SRC / "game_title_logo.gbapal").read_bytes())
+    rgb = [((c & 31) * 8, ((c >> 5) & 31) * 8, ((c >> 10) & 31) * 8) for c in pal]
+    img = Image.new("P", (256, 160), 0)
+    px = img.load()
+    for ty in range(20):
+        for tx in range(32):
+            e = m[ty * 32 + tx]
+            ti, hf, vf = e & 0x3FF, (e >> 10) & 1, (e >> 11) & 1
+            for y in range(8):
+                for x in range(8):
+                    sx = 7 - x if hf else x
+                    sy = 7 - y if vf else y
+                    px[tx * 8 + x, ty * 8 + y] = t[ti * 64 + sy * 8 + sx]
+    for y in range(52, 100):                                # FIRERED VERSION: the grey and white and black
+        for x in range(40, 136):
+            c = rgb[px[x, y]]
+            if px[x, y] and c[0] == c[1] == c[2]:
+                px[x, y] = 0
+    draw_line(px, "KLONDIKE", 87, 59)
+    draw_line(px, "VERSION", 87, 77)
+    draw_small(px, VERSION, 128, 94)
+    uniq, tmap = tiles_of(img, 32, 20, 8)
+    if len(uniq) > 256:
+        sys.exit("han_klondike.py: the logo needs %d tiles, the game has room for 256" % len(uniq))
+    palette = [v for c in rgb for v in c]
+    put(OUT / "game_title_logo.png", png_bytes(sheet(uniq, 32, palette)))
+    put(OUT / "game_title_logo.pal", jasc(rgb))
+    put(OUT / "game_title_logo.bin", struct.pack("<640H", *tmap))
+    print("han_klondike.py: the logo: KLONDIKE VERSION, %d tiles" % len(uniq))
+
+
+def png_bytes(im):
+    import io
+    b = io.BytesIO()
+    im.save(b, "PNG")
+    return b.getvalue()
+
+
+def box_art():
+    u = Image.open(UNOWN % "d")
+    pal = u.getpalette()[:48]
+    rgb = [tuple(pal[i * 3:i * 3 + 3]) for i in range(16)]
+    screen = Image.new("P", (256, 160), 0)
+    screen.putpalette(pal)
+    left, top = 154, 54                                     # the lower right, clear of the START line and the footer
+    cell = 40
+    for r, row in enumerate(WORD):
+        for c, ch in enumerate(row):
+            g = Image.open(UNOWN % ch.lower())
+            g = g.crop(g.convert("RGBA").getbbox() if g.mode != "P" else Image.eval(g, lambda v: 255 if v else 0).getbbox())
+            k = min((cell - 2) / g.width, (cell - 2) / g.height)
+            g = g.resize((max(1, round(g.width * k)), max(1, round(g.height * k))), Image.NEAREST)
+            screen.paste(g, (left + c * cell + (cell - g.width) // 2, top + r * cell + (cell - g.height) // 2))
+    uniq, tmap = tiles_of(screen, 32, 20, 4)
+    full = [0xD000 | n for n in tmap]                       # palette 13, as the CHARIZARD's
+    put(OUT / "box_art_mon.png", png_bytes(sheet(uniq, 16, pal)))
+    put(OUT / "box_art_mon.pal", jasc(rgb))
+    put(OUT / "box_art_mon.bin", struct.pack("<640H", *full))
+    print("han_klondike.py: the UNOWN D: %d tiles" % len(uniq))
+
+
+def main(argv):
+    OUT.mkdir(parents=True, exist_ok=True)
+    logo()
+    box_art()
+
+
+if __name__ == "__main__":
+    main(sys.argv)
