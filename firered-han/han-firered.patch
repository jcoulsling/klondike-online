+    r"^What will\n", r"^Go! ", r"would like to battle!", r"^Wild \{B_OPPONENT_MON1_NAME\} appeared!",
+    r"It's super effective!", r"It's not very effective", r"^A critical hit!", r"attack missed!",
+    r"^\{B_(ATK|DEF)_NAME_WITH_PREFIX\}\nfainted!", r"gained\{B_BUFF2\}", r"grew to\nLV", r"^Got away safely!",
+    r"^(Foe|Wild) $", r"sent\nout \{B_", r"^Player defeated\n", r"is trying to\nlearn", r"learned\n\{B_BUFF2\}",
+    r"^But it failed!", r"^But nothing happened!", r"^Can't escape!", r"is paralyzed!", r"fell asleep!",
+    r"was poisoned!", r"was burned!", r"is fast\nasleep", r"woke up!", r"is confused!", r"hurt by", r"^It doesn't affect",
+    r"'s \{B_BUFF1\}\n(rose|fell|sharply)", r"^FIGHT$", r"FIGHT\{CLEAR_TO", r"^(YES|NO|BAG|POKéMON|RUN|CANCEL|EXIT|SAVE|OPTION|POKéDEX|SUMMARY|SWITCH|ITEM|USE|GIVE|TOSS|SHIFT|TAKE|OK)$",
+    r"^(PP|TYPE/|POWER|ACCURACY|EFFECT|HP|ATTACK|DEFENSE|SP\. ATK|SP\. DEF|SPEED|EXP\.|NEXT LV\.|Lv|LV\.)$",
+    r"^\{PLAYER\} (obtained|found|put)", r"^Would you like to save", r"saved the game", r"^Choose a POKéMON",
+    r"^Do what with", r"healed your POKéMON", r"^We hope to see you again", r"^Welcome to our POKéMON CENTER", r"^May I help you",
+    r"^Hi, there!\nMay I help you",
+)]
+TIERS = {"Type names": 0, "Battle messages": 1, "Menus and system": 1, "Move names": 1, "Dialogue": 2, "Item names": 2,
+         "Abilities": 2, "Pokémon names": 2, "Map names": 2, "Trainer classes": 2, "Move descriptions": 3,
+         "Item descriptions": 3, "Pokédex": 3, "Trainer names": 3, "Natures": 3}
