+def is_translatable(english):
+    plain = strip_tokens(english)
+    if not re.search(r"[A-Za-z]", plain):
+        return False
+    return not re.search(r"[\u3040-\u30ff\u4e00-\u9fff\uff00-\uffef]", plain)
