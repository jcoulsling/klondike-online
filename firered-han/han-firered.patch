diff --git a/src/han_custom.c b/src/han_custom.c
new file mode 100644
index 0000000..aef2c70
--- /dev/null
+++ b/src/han_custom.c
@@ -0,0 +1,786 @@
+#include "global.h"
+#include "link.h"
+#include "gflib.h"
+#include "malloc.h"
+#include "random.h"
+#include "han_custom.h"
+#include "graphics.h"
+#include "constants/trainers.h"
+#include "data/han_custom_data.h"
+
+// Hän build: puts the player's overworld pictures together from layers, as the pack's own sprite maker does, but while
+// the game runs. See tools/han/han_custom.py for the data. A layer is a picture of roles, not colours; here a role becomes
+// a colour from the look's swatches, the layers are laid over each other, the colours are cut down to the 15 a sprite
+// may have, and the result is written as the 4-bit pictures the game's own table points to.
+
+EWRAM_DATA u16 gHanPlayerPal[16] = {0};
+EWRAM_DATA u16 gHanPlayerReflPal[16] = {0};
+EWRAM_DATA bool8 gHanQuick = FALSE; // TRUE while the customizer is open: only the three standing pictures are made
+
+#if HAN_CUSTOM_AVAILABLE
+
+#define N_COLS 64
+
+struct HanMade
+{
+    u8 frames[HAN_N_FRAMES][256]; // first: the game copies these with 4-byte moves, so they must be 4-byte aligned
+    u16 pal[16];
+    u16 reflPal[16];
+    u8 sig[HAN_LOOK_SIZE + 2];
+};
+
+struct HanTemp
+{
+    u16 cols[N_COLS];
+    u32 use[N_COLS];
+    u8 remap[N_COLS];
+    u8 prot[N_COLS]; // 1: eye colours, joined last when the colours are cut down
+    u8 ncols; // colours so far; a pixel holds the colour's number + 1, 0 is clear
+    u8 px[HAN_N_FRAMES][512]; // last: the big pictures only need the first two frames, so less is allocated
+};
+
+static EWRAM_DATA struct HanMade *sMade = NULL;
+static EWRAM_DATA bool8 sTried = FALSE;
+
+static const u8 sMax[HAN_ROWS + 1] = {
+    0, 3, 8, HAN_N_HAIR + 1, HAN_N_HAT + 1, 3, HAN_N_SKIN, HAN_N_HAIRCOL, HAN_N_EYECOL, HAN_N_CLOTHCOL, HAN_N_CLOTHCOL, HAN_N_CLOTHCOL, HAN_N_PIC, HAN_N_PAL
+};
+
+void HanCustomHeapReset(void)
+{
+    sMade = NULL;
+    sTried = FALSE;
+}
+
+// the next picture (dir +1 or -1) that can be chosen for this gender, wrapping round; 0 is the game's own and fits both.
+// They go in the order of sHanPicAt: the game's own, the ordinary player characters, then all the others.
+u8 HanPicStep(u8 pic, s8 dir, u8 gender)
+{
+    u8 i, pos = sHanPicPos[pic];
+
+    for (i = 0; i < HAN_N_PIC; i++)
+    {
+        pos = (pos + HAN_N_PIC + dir) % HAN_N_PIC;
+        pic = sHanPicAt[pos];
+        if (sHanPicSex[pic] == 2 || sHanPicSex[pic] == gender)
+            return pic;
+    }
+    return 0;
+}
+
+// the number shown for a picture in the customizer
+// counted among the pictures that suit the player's gender, so the number goes up by one with each press
+u8 HanPicNumber(u8 pic)
+{
+    u8 i, n = 0, pos, g = gSaveBlock2Ptr->playerGender;
+
+    if (pic >= HAN_N_PIC)
+        return 0;
+    pos = sHanPicPos[pic];
+    for (i = 0; i < pos; i++)
+        if (sHanPicSex[sHanPicAt[i]] == 2 || sHanPicSex[sHanPicAt[i]] == g)
+            n++;
+    return n;
+}
+
+u8 HanPicFits(u8 pic, u8 gender)
+{
+    return pic < HAN_N_PIC && (sHanPicSex[pic] == 2 || sHanPicSex[pic] == gender);
+}
+
+u8 HanLookMax(u8 part)
+{
+    return part >= 1 && part <= HAN_ROWS ? sMax[part] : 0;
+}
+
+void HanLookDefault(void)
+{
+    u8 *l = gSaveBlock2Ptr->hanLook;
+
+    l[HAN_LOOK_SET] = 1;
+    l[HAN_LOOK_HEAD] = 0;
+    l[HAN_LOOK_EYES] = 0;
+    l[HAN_LOOK_HAIR] = gSaveBlock2Ptr->playerGender == MALE ? 1 : 16; // anime, ponytail
+    l[HAN_LOOK_HAT] = 0;
+    l[HAN_LOOK_OUTFIT] = 0;
+    l[HAN_LOOK_SKIN] = 0;
+    l[HAN_LOOK_HAIRCOL] = 2;
+    l[HAN_LOOK_EYECOL] = 0;
+    l[HAN_LOOK_COL_A] = 3;
+    l[HAN_LOOK_COL_B] = 1;
+    l[HAN_LOOK_COL_C] = 0;
+    l[HAN_LOOK_PIC] = 0;
+    l[HAN_LOOK_PAL] = 0;
+}
+
+void HanLookRandom(void)
+{
+    u8 *l = gSaveBlock2Ptr->hanLook;
+    u8 i;
+
+    l[HAN_LOOK_SET] = 2; // 2: made by the player or by chance, so a change of gender keeps it
+    for (i = 1; i <= HAN_ROWS; i++)
+        l[i] = Random() % sMax[i];
+    if (Random() & 1)
+        l[HAN_LOOK_HAT] = 0; // most are bareheaded
+    if (Random() % 3 != 0)
+        l[HAN_LOOK_OUTFIT] = 0;
+    // PICTURE and PALETTE stay as drawn above: any of the pictures (0 is the game's own Red or Leaf) in any palette
+}
+
+static void FixLook(u8 *l)
+{
+    u8 i;
+
+    for (i = 1; i <= HAN_ROWS; i++)
+        if (l[i] >= sMax[i])
+            l[i] = 0;
+}
+
+static u16 ReflectionOf(u16 c)
+{
+    u16 r = c & 31, g = (c >> 5) & 31, b = (c >> 10) & 31;
+
+    return (r / 2) | ((g * 5 / 8) << 5) | (((b * 3 / 4) + 4) << 10);
+}
+
+// ---- colours
+
+static u8 ColourNumber(struct HanTemp *t, u16 c)
+{
+    u8 i;
+
+    for (i = 0; i < t->ncols; i++)
+        if (t->cols[i] == c)
+            return i + 1;
+    if (t->ncols >= N_COLS)
+        return N_COLS;
+    t->cols[t->ncols] = c;
+    t->use[t->ncols] = 0;
+    t->ncols++;
+    return t->ncols;
+}
+
+// For one layer: role -> colour number, found the first time a role is drawn. csw: the swatch of each of the
+// layer's own colour sets.
+struct HanRole
+{
+    u8 map[64];
+    u8 csw[4];
+};
+
+static void InitRole(struct HanRole *r, u8 a, u8 b, u8 c, u8 d)
+{
+    u8 i;
+
+    for (i = 0; i < 64; i++)
+        r->map[i] = 0xFF;
+    r->csw[0] = a;
+    r->csw[1] = b;
+    r->csw[2] = c;
+    r->csw[3] = d;
+}
+
+static u8 Resolve(struct HanTemp *t, struct HanRole *r, const u8 *look, u8 id)
+{
+    u8 fam, sw;
+    u16 c;
+
+    if (id >= 40)
+    {
+        c = sHanLiteral[id - 40 < 24 ? id - 40 : 23];
+    }
+    else
+    {
+        fam = id >> 2;
+        if (fam == 1 || fam == 2)
+            sw = look[HAN_LOOK_SKIN];
+        else if (fam == 3)
+            sw = look[HAN_LOOK_HAIRCOL];
+        else if (fam == 4)
+            sw = look[HAN_LOOK_EYECOL];
+        else if (fam >= 6 && fam <= 9)
+            sw = r->csw[fam - 6];
+        else
+            sw = 0;
+        c = sHanRoleColour[id][sw];
+    }
+    r->map[id] = ColourNumber(t, c);
+    if (id < 40 && ((id >> 2) == 4 || (id >> 2) == 5) && r->map[id] != N_COLS)
+        t->prot[r->map[id] - 1] = 1;
+    return r->map[id];
+}
+
+// Lays a layer of w x h roles over frame f at (dx, dy). skip: where it is not 0, nothing is drawn.
+static void DrawLayer(struct HanTemp *t, u8 f, const u8 *src, u8 w, u8 h, s16 dx, s16 dy, struct HanRole *role, const u8 *look, const u8 *skip)
+{
+    s16 x, y, px, py;
+    u8 v, n;
+
+    for (y = 0; y < h; y++)
+    {
+        py = y + dy;
+        if (py < 0 || py >= 32)
+            continue;
+        for (x = 0; x < w; x++)
+        {
+            px = x + dx;
+            if (px < 0 || px >= 16)
+                continue;
+            v = src[y * w + x] & 63;
+            if (v == 0 || (skip != NULL && skip[y * w + x] != 0))
+                continue;
+            n = role->map[v];
+            if (n == 0xFF)
+                n = Resolve(t, role, look, v);
+            t->px[f][py * 16 + px] = n;
+        }
+    }
+}
+
+static void CutColours(struct HanTemp *t, u32 first, u32 count)
+{
+    u8 i, j, best, bestTo, merged;
+    u32 least, d, bd;
+    s16 dr, dg, db;
+    u16 a, b;
+    u32 f, p;
+
+    for (i = 0; i < t->ncols; i++)
+        t->use[i] = 0;
+    for (f = first; f < first + count; f++)
+        for (p = 0; p < 512; p++)
+            if (t->px[f][p] != 0)
+                t->use[t->px[f][p] - 1]++;
+    for (i = 0; i < t->ncols; i++)
+        t->remap[i] = i + 1;
+    // colours that are not used at all are dropped; then the least used is joined to the nearest until 15 are left
+    for (;;)
+    {
+        merged = 0;
+        for (i = 0; i < t->ncols; i++)
+            if (t->remap[i] == i + 1 && t->use[i] != 0)
+                merged++;
+        if (merged <= 15)
+            break;
+        least = 0xFFFFFFFF;
+        best = 0;
+        for (i = 0; i < t->ncols; i++)
+        {
+            if (t->remap[i] == i + 1 && t->use[i] != 0 && t->use[i] + (t->prot[i] ? 4000 : 0) < least)
+            {
+                least = t->use[i] + (t->prot[i] ? 4000 : 0);
+                best = i;
+            }
+        }
+        bd = 0xFFFFFFFF;
+        bestTo = best;
+        a = t->cols[best];
+        for (j = 0; j < t->ncols; j++)
+        {
+            if (j == best || t->remap[j] != j + 1 || t->use[j] == 0)
+                continue;
+            b = t->cols[j];
+            dr = (a & 31) - (b & 31);
+            dg = ((a >> 5) & 31) - ((b >> 5) & 31);
+            db = ((a >> 10) & 31) - ((b >> 10) & 31);
+            d = dr * dr + dg * dg + db * db;
+            if (d < bd)
+            {
+                bd = d;
+                bestTo = j;
+            }
+        }
+        t->remap[best] = bestTo + 1;
+        t->use[bestTo] += t->use[best];
+        t->use[best] = 0;
+    }
+    // those that were joined follow the one they joined (it may itself have been joined later)
+    for (i = 0; i < t->ncols; i++)
+    {
+        j = t->remap[i];
+        while (j != 0 && t->remap[j - 1] != j)
+            j = t->remap[j - 1];
+        t->remap[i] = j;
+    }
+}
+
+static void WriteTiles(struct HanMade *m, struct HanTemp *t, const u8 *palIndex)
+{
+    u32 f, ty, tx, row, col, p, left, right;
+    u8 *out;
+
+    for (f = 0; f < HAN_N_FRAMES; f++)
+    {
+        out = m->frames[f];
+        for (ty = 0; ty < 4; ty++)
+        {
+            for (tx = 0; tx < 2; tx++)
+            {
+                for (row = 0; row < 8; row++)
+                {
+                    for (col = 0; col < 8; col += 2)
+                    {
+                        p = (ty * 8 + row) * 16 + tx * 8 + col;
+                        left = t->px[f][p] ? palIndex[t->px[f][p] - 1] : 0;
+                        right = t->px[f][p + 1] ? palIndex[t->px[f][p + 1] - 1] : 0;
+                        *out++ = left | (right << 4);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static const u8 *HeadLayer(u8 layer, u8 cell)
+{
+    return sHanHead + ((u32)layer * 5 + cell) * 400;
+}
+
+static const u8 *BodyLayer(u8 layer, u8 frame)
+{
+    return sHanBody + ((u32)layer * HAN_N_FRAMES + frame) * 512;
+}
+
+static void MakeFrames(struct HanTemp *t, const u8 *look, u8 female, u8 nFrames)
+{
+    struct HanRole plain, top, bot, shoe, trio;
+    u8 f, hair, hat, hx, outfit, base;
+    s16 dx, dy;
+
+    hair = look[HAN_LOOK_HAIR];
+    hat = look[HAN_LOOK_HAT];
+    outfit = look[HAN_LOOK_OUTFIT];
+    base = female ? 1 : 0;
+
+    InitRole(&plain, 0, 0, 0, 0);
+    InitRole(&top, look[HAN_LOOK_COL_A], 0, 0, 0);
+    InitRole(&bot, look[HAN_LOOK_COL_B], 0, 0, 0);
+    InitRole(&shoe, look[HAN_LOOK_COL_C], 0, 0, 0);
+    // outfits, hats and hair accessories: their first, second and third colour set follow colours A, B and C
+    InitRole(&trio, look[HAN_LOOK_COL_A], look[HAN_LOOK_COL_B], look[HAN_LOOK_COL_C], look[HAN_LOOK_COL_A]);
+
+    for (f = 0; f < nFrames; f++)
+    {
+        hx = sHanFrameHead[f][0];
+        dx = sHanFrameHead[f][1];
+        dy = sHanFrameHead[f][2];
+        // behind the body: the hair that hangs down, and the back of the hat
+        if (hair != 0)
+            DrawLayer(t, f, HeadLayer(HAN_L_HAIRB + hair - 1, hx), 20, 20, dx, dy, &trio, look, hat != 0 ? HeadLayer(HAN_L_HATBM + hat - 1, hx) : NULL);
+        if (hat != 0)
+            DrawLayer(t, f, HeadLayer(HAN_L_HATB + hat - 1, hx), 20, 20, dx, dy, &trio, look, NULL);
+        // the body, and what is worn
+        DrawLayer(t, f, BodyLayer(base, f), 16, 32, 0, 0, &plain, look, NULL);
+        if (outfit != 0)
+        {
+            DrawLayer(t, f, BodyLayer(8 + base * 2 + outfit - 1, f), 16, 32, 0, 0, &trio, look, NULL);
+        }
+        else
+        {
+            DrawLayer(t, f, BodyLayer(2 + base * 3, f), 16, 32, 0, 0, &top, look, NULL);
+            DrawLayer(t, f, BodyLayer(3 + base * 3, f), 16, 32, 0, 0, &bot, look, NULL);
+            DrawLayer(t, f, BodyLayer(4 + base * 3, f), 16, 32, 0, 0, &shoe, look, NULL);
+        }
+        // the head
+        DrawLayer(t, f, HeadLayer(HAN_L_HEAD + look[HAN_LOOK_HEAD], hx), 20, 20, dx, dy, &plain, look, NULL);
+        DrawLayer(t, f, HeadLayer(HAN_L_EYES + look[HAN_LOOK_EYES], hx), 20, 20, dx, dy, &plain, look, NULL);
+        if (hair != 0)
+            DrawLayer(t, f, HeadLayer(HAN_L_HAIR + hair - 1, hx), 20, 20, dx, dy, &trio, look, hat != 0 ? HeadLayer(HAN_L_HATM + hat - 1, hx) : NULL);
+        if (hat != 0)
+            DrawLayer(t, f, HeadLayer(HAN_L_HAT + hat - 1, hx), 20, 20, dx, dy, &trio, look, NULL);
+        if (hair != 0)
+            DrawLayer(t, f, HeadLayer(HAN_L_HAIRF + hair - 1, hx), 20, 20, dx, dy, &trio, look, NULL);
+    }
+}
+
+// The colour sets of a hair's accessories and of a hat follow the look's three colours.
+// (BuildRoleMap above gives every layer the same set of colours A, B and C; a layer only uses the sets it has.)
+
+bool8 HanCustomMake(void)
+{
+    u8 look[HAN_LOOK_SIZE + 2];
+    struct HanTemp *t;
+    u8 i, n, palIndex[N_COLS];
+    bool8 same;
+
+    if (!sTried)
+    {
+        sTried = TRUE;
+        sMade = Alloc(sizeof(struct HanMade));
+        if (sMade != NULL)
+            for (i = 0; i < HAN_LOOK_SIZE + 2; i++)
+                sMade->sig[i] = 0xFF;
+    }
+    if (sMade == NULL)
+        return FALSE;
+    for (i = 0; i < HAN_LOOK_SIZE; i++)
+        look[i] = gSaveBlock2Ptr->hanLook[i];
+    if (look[HAN_LOOK_SET] == 0)
+    {
+        HanLookDefault();
+        for (i = 0; i < HAN_LOOK_SIZE; i++)
+            look[i] = gSaveBlock2Ptr->hanLook[i];
+    }
+    FixLook(look);
+    look[HAN_LOOK_SIZE] = gSaveBlock2Ptr->playerGender;
+    look[HAN_LOOK_SIZE + 1] = gHanQuick;
+    same = TRUE;
+    for (i = 0; i < HAN_LOOK_SIZE + 2; i++)
+        if (sMade->sig[i] != look[i])
+            same = FALSE;
+    if (same)
+        return FALSE;
+    t = AllocZeroed(sizeof(struct HanTemp));
+    if (t == NULL)
+        return FALSE;
+    MakeFrames(t, look, look[HAN_LOOK_SIZE] != MALE, gHanQuick ? 3 : HAN_N_FRAMES);
+    CutColours(t, 0, HAN_N_FRAMES);
+    // palette numbers: the colours that are left, in order, from 1
+    n = 0;
+    for (i = 0; i < t->ncols; i++)
+        palIndex[i] = 0;
+    for (i = 0; i < t->ncols; i++)
+    {
+        if (t->remap[i] == i + 1 && t->use[i] != 0)
+            palIndex[i] = ++n;
+    }
+    for (i = 0; i < t->ncols; i++)
+        if (t->remap[i] != i + 1)
+            palIndex[i] = palIndex[t->remap[i] - 1];
+    for (i = 0; i < 16; i++)
+        sMade->pal[i] = 0;
+    for (i = 0; i < t->ncols; i++)
+        if (t->remap[i] == i + 1 && t->use[i] != 0)
+            sMade->pal[palIndex[i]] = t->cols[i];
+    for (i = 0; i < 16; i++)
+        sMade->reflPal[i] = i == 0 ? 0 : ReflectionOf(sMade->pal[i]);
+    WriteTiles(sMade, t, palIndex);
+    Free(t);
+    for (i = 0; i < HAN_LOOK_SIZE + 2; i++)
+        sMade->sig[i] = look[i];
+    return TRUE;
+}
+
+const u8 *HanCustomFrames(void)
+{
+    return sMade != NULL && sMade->sig[0] != 0xFF ? &sMade->frames[0][0] : NULL;
+}
+
+const u16 *HanCustomPalette(void)
+{
+    return sMade->pal;
+}
+
+const u16 *HanCustomReflPalette(void)
+{
+    return sMade->reflPal;
+}
+
+
+// ---- the big pictures: the front picture (trainer card, naming, Hall of Fame...) and the back picture (battle) are
+// the game's own Red and Leaf pictures; only their palettes change, by the look's skin, hair and colours A, B and C
+// (tables sHanBigFam and sHanBigCol, from tools/han/han_custom.py). The shapes (hair, hat, outfit) stay the game's.
+
+// The look, made safe.
+static void GetLook(u8 *look)
+{
+    u8 i;
+
+    for (i = 0; i < HAN_LOOK_SIZE; i++)
+        look[i] = gSaveBlock2Ptr->hanLook[i];
+    if (look[HAN_LOOK_SET] == 0)
+    {
+        HanLookDefault();
+        for (i = 0; i < HAN_LOOK_SIZE; i++)
+            look[i] = gSaveBlock2Ptr->hanLook[i];
+    }
+    FixLook(look);
+    // PICTURE 0 is the game's own Red or Leaf picture, which is trainer picture 135 or 136 (plus 1) with a palette too
+    if (look[HAN_LOOK_PIC] == 0)
+        look[HAN_LOOK_PIC] = (gSaveBlock2Ptr->playerGender != MALE ? TRAINER_PIC_LEAF : TRAINER_PIC_RED) + 1;
+}
+
+// The walking picture of the player: the overworld graphics for the chosen character (gfx) with the palette of the
+// chosen palette (pal, in ROM). key says whether it changed. FALSE if the look is not made here.
+bool8 HanOwLook(u16 *gfx, const u16 **pal, u16 *key)
+{
+    u8 look[HAN_LOOK_SIZE];
+    u8 pic;
+
+    GetLook(look);
+    pic = look[HAN_LOOK_PIC] - 1;
+    *gfx = sHanOwOf[pic][0];
+    *pal = sHanOwPal[sHanOwOf[pic][1]][look[HAN_LOOK_PAL]];
+    *key = 1 + (gSaveBlock2Ptr->playerGender != MALE) + 2 * (pic + 160 * look[HAN_LOOK_PAL]);
+    return TRUE;
+}
+
+// The player's bike, surf, fishing, item and VS Seeker frames drawn for the chosen character (tools/han/han_states.py).
+// kind: 0 bike, 1 surf, 2 fishing, 3 item (field moves and the VS Seeker), 4 VS Seeker bike. Fills 12 entries; FALSE
+// when this character has none drawn (the game's own Red or Leaf), then the game's own frames stay.
+bool8 HanStateFrames(u8 kind, struct SpriteFrameImage *out)
+{
+    static const u8 sCount[5] = {9, 3, 12, 9, 6};
+    static const u16 sSize[5] = {512, 256, 512, 256, 512};
+    static const u32 *const sBase[5] = {sHanSt_bike, sHanSt_surf, sHanSt_fish, sHanSt_item, sHanSt_vsbike};
+    u8 look[HAN_LOOK_SIZE];
+    u8 i, src, f;
+
+    GetLook(look);
+    src = sHanStIdx[look[HAN_LOOK_PIC] - 1];
+    if (src == 255 || kind > 4)
+        return FALSE;
+    for (i = 0; i < 12; i++)
+    {
+        f = i < sCount[kind] ? i : 0;
+        out[i].data = (const u8 *)sBase[kind] + (src * sCount[kind] + f) * sSize[kind];
+        out[i].size = sSize[kind];
+    }
+    return TRUE;
+}
+
+// The player's PICTURE and PALETTE as they are used (picture 0 is already Red or Leaf), for others to be drawn the same.
+void HanLookPicPal(u8 *pic, u8 *pal)
+{
+    u8 look[HAN_LOOK_SIZE];
+
+    GetLook(look);
+    *pic = look[HAN_LOOK_PIC];
+    *pal = look[HAN_LOOK_PAL];
+}
+
+// The walking picture of another player's PICTURE and PALETTE: the object graphics id and the colours (in ROM).
+bool8 HanOwFor(u8 pic, u8 pal, u16 *gfx, const u16 **colours)
+{
+    if (pic == 0 || pic > HAN_N_PIC - 1 || pal >= HAN_N_PAL)
+        return FALSE;
+    *gfx = sHanOwOf[pic - 1][0];
+    *colours = sHanOwPal[sHanOwOf[pic - 1][1]][pal];
+    return TRUE;
+}
+
+void HanReflectionOf(const u16 *pal, u16 *out)
+{
+    u8 i;
+
+    for (i = 0; i < 16; i++)
+        out[i] = ReflectionOf(pal[i]);
+}
+
+// The battle sprite of a chosen picture: its front picture, uncompressed in ROM, for all five frames.
+static EWRAM_DATA struct SpriteFrameImage sBackImg[5] = {0};
+
+static const u8 sBlankBack[0x800] = {0};
+
+const struct SpriteFrameImage *HanBackImages(void)
+{
+    u8 look[HAN_LOOK_SIZE];
+    u8 i, pic;
+
+    GetLook(look);
+    if (look[HAN_LOOK_PIC] == 0)
+        return NULL;
+    pic = look[HAN_LOOK_PIC] - 1;
+    if (pic == TRAINER_PIC_RED || pic == TRAINER_PIC_LEAF
+     || pic == TRAINER_PIC_RS_BRENDAN_1 || pic == TRAINER_PIC_RS_BRENDAN_2
+     || pic == TRAINER_PIC_RS_MAY_1 || pic == TRAINER_PIC_RS_MAY_2)
+        return NULL; // the game has a back picture for these
+    // no back picture exists for this character: show a blank one
+    for (i = 0; i < 5; i++)
+    {
+        sBackImg[i].data = sBlankBack;
+        sBackImg[i].size = 0x800;
+    }
+    return sBackImg;
+}
+
+// The other player's chosen picture in a battle over the page: it came in struct LinkPlayer (neverRead is PIC, progressFlagsCopy
+// is PAL). Returns the TRAINER_PIC id, or 0xFFFF for the game's own Red or Leaf.
+u16 HanLinkOppPic(void)
+{
+    const struct LinkPlayer *lp = &gLinkPlayers[GetMultiplayerId() ^ 1];
+
+    if (lp->linkType != LINKTYPE_BATTLE || lp->neverRead >= HAN_N_PIC || lp->progressFlagsCopy >= HAN_N_PAL)
+        return 0xFFFF;
+    if (lp->neverRead == 0)
+        return lp->progressFlagsCopy == 0 ? 0xFFFF : (lp->gender != MALE ? TRAINER_PIC_LEAF : TRAINER_PIC_RED);
+    return lp->neverRead - 1;
+}
+
+void HanLinkOppPalette(u8 paletteNum)
+{
+    const struct LinkPlayer *lp = &gLinkPlayers[GetMultiplayerId() ^ 1];
+    u16 pic = HanLinkOppPic();
+
+    if (pic != 0xFFFF && lp->progressFlagsCopy < HAN_N_PAL)
+        LoadPalette(sHanPicPal[pic][lp->progressFlagsCopy], 0x100 + paletteNum * 16, 32);
+}
+
+// src is something the game is about to decompress. If it is the player's own front picture or the palette of their
+// front or back picture, what the look says is written to dest (a chosen character's picture, or a palette) and TRUE
+// is returned.
+// The player's back picture in battle: the game has one for Red, Leaf, Brendan and May (the Ruby and Sapphire ones), so a
+// player who chose one of those is shown from behind as that character. Any other picture is shown as Red or Leaf (as
+// before), in the chosen palette.
+u8 HanBackPicId(void)
+{
+    u8 look[HAN_LOOK_SIZE];
+    u8 pic;
+
+    GetLook(look);
+    pic = look[HAN_LOOK_PIC];
+    if (pic != 0)
+    {
+        pic--;
+        if (pic == TRAINER_PIC_RED)
+            return TRAINER_BACK_PIC_RED;
+        if (pic == TRAINER_PIC_LEAF)
+            return TRAINER_BACK_PIC_LEAF;
+        if (pic == TRAINER_PIC_RS_BRENDAN_1 || pic == TRAINER_PIC_RS_BRENDAN_2)
+            return TRAINER_BACK_PIC_RUBY_SAPPHIRE_BRENDAN;
+        if (pic == TRAINER_PIC_RS_MAY_1 || pic == TRAINER_PIC_RS_MAY_2)
+            return TRAINER_BACK_PIC_RUBY_SAPPHIRE_MAY;
+    }
+    return gSaveBlock2Ptr->playerGender;
+}
+
+// The palette of the Brendan or May back picture, recoloured like the chosen picture. FALSE for the others (Red and
+// Leaf are done in HanCustomPicData).
+bool8 HanBackPalette(u8 id, u16 offset)
+{
+    u8 look[HAN_LOOK_SIZE];
+
+    if (id != TRAINER_BACK_PIC_RUBY_SAPPHIRE_BRENDAN && id != TRAINER_BACK_PIC_RUBY_SAPPHIRE_MAY)
+        return FALSE;
+    GetLook(look);
+    if (look[HAN_LOOK_PIC] == 0 || HanBackPicId() != id)
+        return FALSE;
+    LoadPalette(sHanPicPal[look[HAN_LOOK_PIC] - 1][look[HAN_LOOK_PAL]], offset, PLTT_SIZE_4BPP);
+    if (id == TRAINER_BACK_PIC_RUBY_SAPPHIRE_MAY && look[HAN_LOOK_PAL] == 6)
+    {
+        // the collar of her shirt (colours 5 and 6 of the back picture) is the trans flag's light blue
+        static const u16 sCollar[2] = {RGB(11, 25, 31), RGB(8, 19, 23)};
+
+        LoadPalette(sCollar, offset + 5, sizeof(sCollar));
+    }
+    if (id == TRAINER_BACK_PIC_RUBY_SAPPHIRE_BRENDAN && look[HAN_LOOK_PAL] == 6)
+    {
+        // his red (colours 12 and 13 of the back picture, kept red in the front picture for the Poké Ball) is the flag's pink
+        static const u16 sRed[2] = {RGB(30, 21, 23), RGB(23, 16, 17)};
+
+        LoadPalette(sRed, offset + 12, sizeof(sRed));
+    }
+    return TRUE;
+}
+
+bool8 HanCustomPicData(const void *src, void *dest)
+{
+    bool8 female = gSaveBlock2Ptr->playerGender != MALE;
+    u8 look[HAN_LOOK_SIZE];
+    u8 kind, i, fam, sw, pic;
+    u16 *pal = dest;
+
+    if (src != (female ? gTrainerFrontPic_Leaf : gTrainerFrontPic_Red)
+     && src != (female ? gTrainerPalette_Leaf : gTrainerPalette_Red)
+     && src != (female ? gTrainerPalette_LeafBackPic : gTrainerPalette_RedBackPic))
+        return FALSE;
+    GetLook(look);
+    pic = look[HAN_LOOK_PIC];
+    if (src == (female ? gTrainerFrontPic_Leaf : gTrainerFrontPic_Red))
+    {
+        if (pic == 0)
+            return FALSE;
+        CpuCopy32(&sHanPics[(pic - 1) * 0x200], dest, 0x800);
+        return TRUE;
+    }
+    if (pic != 0)
+    {
+        // the battle shows the game's own back picture (Red or Leaf), in the chosen PALETTE
+        if (src == (female ? gTrainerPalette_LeafBackPic : gTrainerPalette_RedBackPic))
+            pic = (female ? TRAINER_PIC_LEAF : TRAINER_PIC_RED) + 1;
+        CpuCopy16(sHanPicPal[pic - 1][look[HAN_LOOK_PAL]], dest, 32);
+        return TRUE;
+    }
+    if (src == (female ? gTrainerPalette_Leaf : gTrainerPalette_Red))
+        kind = female ? 1 : 0;
+    else
+        kind = 2 + (female ? 1 : 0);
+    LZ77UnCompWram(src, dest);
+    for (i = 1; i < 16; i++)
+    {
+        fam = sHanBigFam[kind][i];
+        if (fam == 0)
+            continue;
+        sw = fam == 1 ? look[HAN_LOOK_SKIN] : fam == 2 ? look[HAN_LOOK_HAIRCOL] : fam == 3 ? look[HAN_LOOK_COL_A] : fam == 4 ? look[HAN_LOOK_COL_B] : look[HAN_LOOK_COL_C];
+        pal[i] = sHanBigCol[kind][i][sw];
+    }
+    return TRUE;
+}
+
+// The player's picture on the Oak speech screens (the boy or girl choice, the name): when a character or a palette was
+// chosen, its big picture (64 by 64) is put into the 64 by 96, 256 colour tile data of the screen, standing at the bottom,
+// with its palette; dest is the video memory for the tiles. FALSE (nothing done) for the game's own Red or Leaf picture.
+bool8 HanOakPic(u8 *dest)
+{
+    u8 look[HAN_LOOK_SIZE];
+    u8 *buf;
+    u16 pic, pal;
+    u32 t, p, x, v;
+    const u8 *src;
+    u8 *out;
+
+    if (gSaveBlock2Ptr->hanLook[HAN_LOOK_SET] == 0 || (gSaveBlock2Ptr->hanLook[HAN_LOOK_PIC] == 0 && gSaveBlock2Ptr->hanLook[HAN_LOOK_PAL] == 0))
+        return FALSE;
+    GetLook(look);
+    pic = look[HAN_LOOK_PIC] - 1;
+    pal = look[HAN_LOOK_PAL];
+    buf = AllocZeroed(0x1800);
+    if (buf == NULL)
+        return FALSE;
+    for (t = 32; t < 96; t++)       // the first four rows of tiles stay empty
+    {
+        src = (const u8 *)&sHanPics[pic * 0x200] + (t - 32) * 32;
+        out = buf + t * 64;
+        for (p = 0; p < 32; p++)
+        {
+            for (x = 0; x < 2; x++)
+            {
+                v = x == 0 ? (src[p] & 15) : (src[p] >> 4);
+                out[p * 2 + x] = v != 0 ? 64 + v : 0;
+            }
+        }
+    }
+    CpuCopy32(buf, dest, 0x1800);
+    Free(buf);
+    LoadPalette(sHanPicPal[pic][pal], BG_PLTT_ID(4), 32);
+    return TRUE;
+}
+
+#else // no pack: the game keeps its own pictures
+
+void HanCustomHeapReset(void) {}
+u8 HanLookMax(u8 part) { return 0; }
+u8 HanPicStep(u8 pic, s8 dir, u8 gender) { return pic; }
+u8 HanPicFits(u8 pic, u8 gender) { return TRUE; }
+u8 HanPicNumber(u8 pic) { return pic; }
+void HanLookDefault(void) {}
+void HanLookRandom(void) {}
+bool8 HanCustomMake(void) { return FALSE; }
+const u8 *HanCustomFrames(void) { return NULL; }
+const u16 *HanCustomPalette(void) { return NULL; }
+const u16 *HanCustomReflPalette(void) { return NULL; }
+bool8 HanCustomPicData(const void *src, void *dest) { return FALSE; }
+u8 HanBackPicId(void) { return gSaveBlock2Ptr->playerGender; }
+bool8 HanBackPalette(u8 id, u16 offset) { return FALSE; }
+bool8 HanOakPic(u8 *dest) { return FALSE; }
+const struct SpriteFrameImage *HanBackImages(void) { return NULL; }
+u16 HanLinkOppPic(void) { return 0xFFFF; }
+void HanLinkOppPalette(u8 paletteNum) {}
+bool8 HanOwLook(u16 *gfx, const u16 **pal, u16 *key) { return FALSE; }
+void HanReflectionOf(const u16 *pal, u16 *out) {}
+void HanLookPicPal(u8 *pic, u8 *pal) { *pic = 0; *pal = 0; }
+bool8 HanOwFor(u8 pic, u8 pal, u16 *gfx, const u16 **colours) { return FALSE; }
+bool8 HanStateFrames(u8 kind, struct SpriteFrameImage *out) { return FALSE; }
+
+#endif
diff --git a/src/han_english_core.h b/src/han_english_core.h
new file mode 100644
index 0000000..10a53be
--- /dev/null
+++ b/src/han_english_core.h
@@ -0,0 +1,129 @@
+// Hän build: in syllabics an English word is spelled by its sound.
+//
+// Read letter by letter, as Hän is, an English word comes out wrong. So the words of the game's
+// English text are in a table with their sound written in syllables (data/han_english_sounds.h,
+// made from tools/han/english_sounds.txt when the game is built). This is English, not Hän.
+//
+// A word is looked up when all of it is plain a to z, in either case. é counts as e, and there
+// may be apostrophes inside it. A word with any other letter in it is Hän. A word that is not in
+// the table is read letter by letter, as before. The build leaves out of the table the words that
+// are Hän words in the translation (tools/han/han_english_table.py).
+//
+// This file has no game code in it, so the same lines can be compiled on a computer and checked
+// against the list (tools/han/english_test.c). It needs u8, u16, u32, s32, bool8, TRUE, FALSE,
+// CHAR_A, CHAR_z, CHAR_SGL_QUOTE_RIGHT, EOS and EXT_CTRL_CODE_BEGIN, the letter table of
+// data/han_syllabics.h, and data/han_english_sounds.h.
+
+#define HAN_ENG_COUNT_MASK ((1 << HAN_ENG_COUNT_BITS) - 1)
+#define HAN_ENG_GLYPH_MASK ((1 << HAN_ENG_GLYPH_BITS) - 1)
+#define HAN_ENG_L_S        19
+
+struct HanEngWord
+{
+    const u8 *glyphs;   // its glyphs in the table: two bytes each, low byte first
+    u16 added[2];       // the glyphs that 's adds
+    u8 count;           // how many of the table's glyphs are drawn
+    u8 total;           // with the added ones
+    u8 length;          // how many characters of the text the word takes
+};
+
+static bool8 HanEng_IsPlain(u8 c)
+{
+    return (c >= CHAR_A && c <= CHAR_z) || c == CHAR_SGL_QUOTE_RIGHT || c == 0x1B || c == 0x06; // 1B and 06: é and É
+}
+
+// How many characters the word at s has, when all of it is plain. Else 0.
+// A word goes on to the first character that is no letter. Apostrophes at its end are not part of it.
+static u32 HanEng_WordLength(const u8 *s)
+{
+    u32 n = 0;
+
+    if (*s == CHAR_SGL_QUOTE_RIGHT)
+        return 0;
+    while (sHanSylLetters[s[n]] != 0)
+    {
+        if (!HanEng_IsPlain(s[n]))
+            return 0;
+        n++;
+    }
+    while (n != 0 && s[n - 1] == CHAR_SGL_QUOTE_RIGHT)
+        n--;
+    // One letter with nothing after it, or only spacing, is a key of a keyboard or a letter of a
+    // name being typed. It is not a word.
+    if (n == 1 && (s[1] == EOS || s[1] == EXT_CTRL_CODE_BEGIN))
+        return 0;
+    return n;
+}
+
+// The table's entry for the length letters at s, from its count byte on. NULL: the table does not have the word.
+static const u8 *HanEng_Search(const u8 *s, u32 length)
+{
+    s32 low = 0;
+    s32 high = HAN_ENG_WORD_COUNT - 1;
+
+    if (length == 0 || length > HAN_ENG_MAX_WORD)
+        return NULL;
+    while (low <= high)
+    {
+        s32 mid = (low + high) / 2;
+        const u8 *entry = &sHanEngData[sHanEngOffsets[mid]];
+        s32 diff;
+        u32 i;
+
+        for (i = 0; ; i++)
+        {
+            u8 mine = i < length ? (sHanSylLetters[s[i]] & HAN_SYL_LETTER_MASK) : 0;
+
+            diff = mine - entry[i];
+            if (diff != 0 || mine == 0)
+                break;
+        }
+        if (diff == 0)
+            return entry + i + 1;
+        if (diff < 0)
+            high = mid - 1;
+        else
+            low = mid + 1;
+    }
+    return NULL;
+}
+
+// TRUE if an English word of the table starts at s. NAME's is found when the table has NAME.
+static bool8 HanEng_Find(const u8 *s, struct HanEngWord *word)
+{
+    u32 length = HanEng_WordLength(s);
+    const u8 *entry;
+    const u16 *rule;
+
+    if (length == 0)
+        return FALSE;
+    word->length = length;
+    entry = HanEng_Search(s, length);
+    if (entry != NULL)
+    {
+        word->glyphs = entry + 1;
+        word->count = word->total = entry[0] & HAN_ENG_COUNT_MASK;
+        return TRUE;
+    }
+    if (length < 3 || s[length - 2] != CHAR_SGL_QUOTE_RIGHT
+     || (sHanSylLetters[s[length - 1]] & HAN_SYL_LETTER_MASK) != HAN_ENG_L_S)
+        return FALSE;
+    entry = HanEng_Search(s, length - 2);
+    if (entry == NULL)
+        return FALSE;
+    rule = sHanEngPossessive[entry[0] >> HAN_ENG_COUNT_BITS];
+    word->glyphs = entry + 1;
+    word->count = word->total = (entry[0] & HAN_ENG_COUNT_MASK) - rule[0];
+    if (rule[1] != HAN_ENG_NONE)
+        word->added[word->total++ - word->count] = rule[1];
+    word->added[word->total++ - word->count] = rule[2];
+    return TRUE;
+}
+
+// The word's glyph number i: its number in the font, plus its marks times 512.
+static u16 HanEng_Glyph(const struct HanEngWord *word, u32 i)
+{
+    if (i < word->count)
+        return word->glyphs[2 * i] | (word->glyphs[2 * i + 1] << 8);
+    return word->added[i - word->count];
+}
diff --git a/src/han_follower.c b/src/han_follower.c
new file mode 100644
index 0000000..3c816bd
--- /dev/null
+++ b/src/han_follower.c
@@ -0,0 +1,619 @@
+#include "global.h"
+#include "gflib.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "han_follower.h"
+#include "event_object_movement.h"
+#include "pokemon.h"
+#include "constants/event_objects.h"
+#include "constants/species.h"
+#include "data/han_follow_data.h"
+#include "data/han_follow_ball.h"
+#include "palette.h"
+#include "sound.h"
+#include "util.h"
+#include "constants/songs.h"
+#include "field_control_avatar.h"
+
+// Hän build: a follower Pokémon (Jane, 22 November 2026).
+//
+// The first Pokémon of the party that can still fight is drawn behind the player, like the other players are in
+// src/han_multiplayer.c: a plain sprite, not an object event. So it cannot be talked to, blocks nothing, and is not
+// in the save; every map load destroys it and it is made again. It walks the way the player came, one tile behind.
+// The pictures are in ROM (sHanFollowSheets); only the table of nine frames and the palette are in RAM.
+
+#define FOLLOW_TAG 0x4B0F
+
+EWRAM_DATA struct SpriteFrameImage gHanFollowImages[9] = {0};
+EWRAM_DATA u16 gHanFollowPal[16] = {0};
+static EWRAM_DATA u8 sSpriteId = 0;   // the sprite plus 1; 0 for none
+static EWRAM_DATA u16 sSpecies = 0;   // what the frames and palette were last made for (bit 15: shiny)
+// The follower walks the player's own path, in pixels: the player's sprite position is written down every frame it
+// changes, and the follower stands where the player was 16 pixels (one tile) of walking ago. So it moves exactly when
+// the player moves, at the player's speed (walk, run, bike), round every corner, and stops one tile behind.
+#define TRAIL_N 20
+static EWRAM_DATA s16 sTrailX[TRAIL_N] = {0};   // newest at sTrailHead, going back
+static EWRAM_DATA s16 sTrailY[TRAIL_N] = {0};
+static EWRAM_DATA u8 sTrailHead = 0;
+static EWRAM_DATA u8 sTrailLen = 0;
+static EWRAM_DATA u8 sFacing = 0;
+
+// The Poké Ball (as in HeartGold and SoulSilver): after a door, stairs or any warp the follower is let out of a ball
+// beside the player (never on a door), and it goes back into its ball when the player steps into a warp, or when it would be
+// standing on a door. Crossing from one route to the next keeps it where it is, with no ball.
+enum { PH_NORMAL, PH_WAIT, PH_BALL, PH_FADEOUT, PH_DEAD };
+static EWRAM_DATA u8 sPhase = 0;
+static EWRAM_DATA u8 sTimer = 0;
+static EWRAM_DATA bool8 sWarped = FALSE;     // a warp happened since the follower was last made
+static EWRAM_DATA bool8 sRecallForWarp = FALSE;
+static EWRAM_DATA s16 sBallX = 0;
+static EWRAM_DATA s16 sBallY = 0;
+static EWRAM_DATA bool8 sPlaceFail = FALSE;
+
+void HanFollowerWarped(void)
+{
+    sWarped = TRUE;
+}
+
+// the player steps into a warp: the follower goes back into its ball while the screen fades
+void HanFollowerRecall(void)
+{
+    sWarped = TRUE;
+    if (sPhase == PH_NORMAL)
+    {
+        sPhase = PH_FADEOUT;
+        sTimer = 0;
+        sRecallForWarp = TRUE;
+    }
+}
+
+static void SpriteCB_Follower(struct Sprite *sprite)
+{
+}
+
+// The first Pokémon that is not an egg and can fight; 0 if there is none. Bit 15 is set if it is shiny.
+static u16 LeadSpecies(void)
+{
+    u8 i;
+    u16 species;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        species = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES);
+        if (species == SPECIES_NONE || GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            continue;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_HP) == 0)
+            continue;
+        if (species >= HAN_FOLLOW_SPECIES || sHanFollowIndex[species] == 0xFFFF)
+            return 0;
+        return species | (IsMonShiny(&gPlayerParty[i]) ? 0x8000 : 0);
+    }
+    return 0;
+}
+
+// Point the nine frames of a normal sprite sheet at the six of the picture, and the palette at its colours.
+static void MakeFrames(u16 what)
+{
+    const u8 *sheet = (const u8 *)sHanFollowSheets + sHanFollowIndex[what & 0x7FFF] * 6 * 0x200;
+    // frames: 0 south, 1 north, 2 west, then three pairs of walking frames
+    static const u8 order[9] = {0, 2, 4, 1, 1, 3, 3, 5, 5};
+    u8 i, idx;
+
+    for (i = 0; i < 9; i++)
+    {
+        gHanFollowImages[i].data = sheet + order[i] * 0x200;
+        gHanFollowImages[i].size = 0x200;
+    }
+    CpuCopy16(&sHanFollowPal[sHanFollowIndex[what & 0x7FFF] * 32 + ((what & 0x8000) ? 16 : 0)], gHanFollowPal, PLTT_SIZE_4BPP);
+    idx = IndexOfSpritePaletteTag(OBJ_EVENT_PAL_TAG_HAN_FOLLOWER);
+    if (idx != 0xFF)
+        LoadPalette(gHanFollowPal, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+    sSpecies = what;
+}
+
+static void Destroy(void)
+{
+    struct Sprite *sprite = &gSprites[sSpriteId - 1];
+
+    if (sSpriteId != 0 && sprite->inUse && sprite->data[7] == FOLLOW_TAG)
+        DestroySprite(sprite);
+    sSpriteId = 0;
+}
+
+static void PaletteIdx(u8 *idx)
+{
+    *idx = IndexOfSpritePaletteTag(OBJ_EVENT_PAL_TAG_HAN_FOLLOWER);
+}
+
+// the ball: its picture and colours instead of the Pokémon's
+static void ShowBall(struct Sprite *sprite)
+{
+    u8 idx;
+
+    gHanFollowImages[0].data = sHanBallFrame;
+    PaletteIdx(&idx);
+    if (idx != 0xFF)
+        LoadPalette(sHanBallPal, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+    StartSpriteAnim(sprite, GetFaceDirectionAnimNum(DIR_SOUTH));
+}
+
+// the Pokémon's own picture and colours again, the colours washed to white by coeff (16 is all white)
+static void ShowMon(struct Sprite *sprite, u8 coeff)
+{
+    u8 idx;
+
+    if (sSpecies != 0)
+    {
+        const u8 *sheet = (const u8 *)sHanFollowSheets + sHanFollowIndex[sSpecies & 0x7FFF] * 6 * 0x200;
+
+        gHanFollowImages[0].data = sheet;
+    }
+    PaletteIdx(&idx);
+    if (idx != 0xFF)
+    {
+        LoadPalette(gHanFollowPal, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+        if (coeff != 0)
+            BlendPalette(OBJ_PLTT_ID(idx), 16, coeff, RGB_WHITE);
+    }
+    StartSpriteAnim(sprite, GetFaceDirectionAnimNum(sFacing));
+}
+
+// Where the follower may be let out: one tile behind the player, and only when the player is at least two tiles from a
+// door (so the ball never lies on a door, nor next to one)
+static bool8 FindSpot(struct Sprite *player, s16 *ox, s16 *oy)
+{
+    s16 px, py, bx, by, ddx = 0, ddy = 0;
+
+    switch (GetPlayerFacingDirection())
+    {
+    case DIR_SOUTH: ddy = -1; break;
+    case DIR_NORTH: ddy = 1; break;
+    case DIR_WEST: ddx = 1; break;
+    default: ddx = -1; break;
+    }
+    PlayerGetDestCoords(&px, &py);
+    bx = px + ddx;
+    by = py + ddy;
+    if (HanWarpDistance(px, py) < 2 || HanWarpDistance(bx, by) < 1 || MapGridGetCollisionAt(bx, by) != 0)
+        return FALSE;
+    *ox = (player->x + player->x2) + ddx * 16;
+    *oy = (player->y + player->y2) + ddy * 16;
+    return TRUE;
+}
+
+// Called every frame with the follower's sprite and the player's.
+static void HanFollowTrail(struct Sprite *sprite, struct Sprite *player)
+{
+    s16 x = player->x + player->x2;
+    s16 y = player->y + player->y2;
+    s16 fx, fy, nx, ny, dx, dy, seg, left;
+    s16 ox, oy;
+    u8 i, idx, prev, dir;
+
+    if (sTrailLen != 0)
+    {
+        s16 hx = sTrailX[sTrailHead], hy = sTrailY[sTrailHead];
+
+        dx = x - hx;
+        dy = y - hy;
+        if (dx > 24 || dx < -24 || dy > 24 || dy < -24)
+            sTrailLen = 0; // a warp, or the map moved under us: come out from under the player again
+    }
+    if (sTrailLen == 0)
+    {
+        // a new map, or a warp: it is there at once, one tile behind the player (so that it does not blink out and in)
+        s16 bx = x, by = y;
+
+        switch (GetPlayerFacingDirection())
+        {
+        case DIR_SOUTH: by = y - 16; break;
+        case DIR_NORTH: by = y + 16; break;
+        case DIR_WEST: bx = x + 16; break;
+        default: bx = x - 16; break;
+        }
+        sFacing = GetPlayerFacingDirection();
+        sTrailX[0] = bx;
+        sTrailY[0] = by;
+        sTrailX[1] = x;
+        sTrailY[1] = y;
+        sTrailHead = 1;
+        sTrailLen = 2;
+        sprite->x = bx;
+        sprite->y = by;
+        sprite->invisible = FALSE;
+    }
+    else if (x != sTrailX[sTrailHead] || y != sTrailY[sTrailHead])
+    {
+        sTrailHead = (sTrailHead + 1) % TRAIL_N;
+        sTrailX[sTrailHead] = x;
+        sTrailY[sTrailHead] = y;
+        if (sTrailLen < TRAIL_N)
+            sTrailLen++;
+    }
+
+    // walk back along the path 16 pixels from the player; short of that, stand at the start of it
+    ox = sprite->x;
+    oy = sprite->y;
+    fx = x;
+    fy = y;
+    left = 16;
+    dir = sFacing;
+    idx = sTrailHead;
+    for (i = 1; i < sTrailLen && left > 0; i++)
+    {
+        prev = (idx + TRAIL_N - 1) % TRAIL_N;
+        nx = sTrailX[prev];
+        ny = sTrailY[prev];
+        dx = nx - sTrailX[idx];
+        dy = ny - sTrailY[idx];
+        seg = (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+        if (seg >= left)
+        {
+            fx = sTrailX[idx] + dx * left / seg;
+            fy = sTrailY[idx] + dy * left / seg;
+            left = 0;
+        }
+        else
+        {
+            fx = nx;
+            fy = ny;
+            left -= seg;
+        }
+        // the way the follower goes along this stretch is the way the player went: from the older point to the newer
+        if (dx != 0 || dy != 0)
+        {
+            if ((dx < 0 ? -dx : dx) >= (dy < 0 ? -dy : dy))
+                dir = dx < 0 ? DIR_EAST : DIR_WEST;
+            else
+                dir = dy < 0 ? DIR_SOUTH : DIR_NORTH;
+        }
+        idx = prev;
+    }
+    // (the loop went newest to oldest, so dir is the direction of the oldest stretch used; the follower is on it)
+    sprite->x = fx;
+    sprite->y = fy;
+    sprite->x2 = 0;
+    sprite->y2 = 0;
+    if (fx != ox || fy != oy)
+    {
+        sFacing = dir;
+        StartSpriteAnimIfDifferent(sprite, GetMoveDirectionAnimNum(dir));
+    }
+    else
+        StartSpriteAnimIfDifferent(sprite, GetFaceDirectionAnimNum(sFacing));
+    sprite->invisible = left > 8; // hidden until it is out from under the player
+    sprite->oam.priority = player->oam.priority;
+    // always on a layer above the player (a lower subpriority is drawn in front)
+    sprite->subpriority = player->subpriority > 0 ? player->subpriority - 1 : 0;
+}
+
+// The ball's effect is the one of the pack the pictures come from (pokeemerald-expansion, MovementAction_ExitPokeball and
+// EnterPokeball): 16 frames. Out: the ball for 9 frames, then the Pokémon, all white and squeezed thin, widening in 4 frames,
+// then its own colours. In: the Pokémon, then white and squeezed thin in 4 frames, then the ball. A sprite at 0x100 is as wide as it is.
+static const union AffineAnimCmd sAffineOut[] =
+{
+    AFFINEANIMCMD_FRAME(0x40, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0x80, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0xC0, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0x100, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd sAffineOutEast[] =
+{
+    AFFINEANIMCMD_FRAME(0xFFC0, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFF80, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0xFF40, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFF00, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd sAffineIn[] =
+{
+    AFFINEANIMCMD_FRAME(0x100, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xC0, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0x80, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0x40, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd sAffineInEast[] =
+{
+    AFFINEANIMCMD_FRAME(0xFF00, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFF40, 0x100, 0, 0),
+    AFFINEANIMCMD_FRAME(0xFF80, 0x100, 0, 0), AFFINEANIMCMD_FRAME(0xFFC0, 0x100, 0, 0), AFFINEANIMCMD_END,
+};
+static const union AffineAnimCmd *const sAffineAnimsFollower[] = { sAffineOut, sAffineOutEast, sAffineIn, sAffineInEast };
+
+static void AffineOn(struct Sprite *sprite, u8 anim)
+{
+    sprite->affineAnims = sAffineAnimsFollower;
+    sprite->oam.affineMode = ST_OAM_AFFINE_NORMAL;
+    InitSpriteAffineAnim(sprite);
+    StartSpriteAffineAnim(sprite, anim + (sFacing == DIR_EAST ? 1 : 0));
+}
+
+static void AffineOff(struct Sprite *sprite)
+{
+    sprite->affineAnimEnded = TRUE;
+    FreeSpriteOamMatrix(sprite);
+    sprite->oam.affineMode = ST_OAM_AFFINE_OFF;
+}
+
+static void WhitePalette(void)
+{
+    u8 idx;
+
+    PaletteIdx(&idx);
+    if (idx != 0xFF)
+        BlendPalette(OBJ_PLTT_ID(idx), 16, 16, RGB_WHITE);
+}
+
+// The ball's part of each frame. TRUE when it has dealt with the sprite for this frame (the Pokémon is not walking).
+static bool8 PhaseFrame(struct Sprite *sprite, struct Sprite *player)
+{
+    switch (sPhase)
+    {
+    case PH_WAIT:
+        sprite->invisible = TRUE;
+        if (sTimer < 24)
+            sTimer++;
+        if (sTimer >= 24 && !gPaletteFade.active && gPlayerAvatar.tileTransitionState == T_NOT_MOVING)
+        {
+            s16 x, y;
+
+            if (!FindSpot(player, &x, &y))
+                return TRUE; // not yet two tiles from the door: it stays in its ball
+            sBallX = x;
+            sBallY = y;
+            sPhase = PH_BALL;
+            sTimer = 0;
+            sFacing = GetPlayerFacingDirection();
+            sprite->x = x;
+            sprite->y = y;
+            sprite->x2 = 0;
+            sprite->y2 = 0;
+            ShowBall(sprite);
+            sprite->invisible = FALSE;
+            PlaySE(SE_BALL_OPEN);
+        }
+        return TRUE;
+    case PH_BALL: // out of the ball
+        sprite->x = sBallX;
+        sprite->y = sBallY;
+        sprite->invisible = FALSE;
+        sprite->oam.priority = player->oam.priority;
+        sprite->subpriority = player->subpriority > 0 ? player->subpriority - 1 : 0;
+        sTimer++;
+        if (sTimer == 9)
+        {
+            ShowMon(sprite, 0);
+            WhitePalette();
+            AffineOn(sprite, 0);
+        }
+        else if (sTimer >= 13)
+        {
+            s16 px = player->x + player->x2, py = player->y + player->y2;
+
+            AffineOff(sprite);
+            ShowMon(sprite, 0);
+            // from here it follows the player from where the ball was
+            sTrailX[0] = sBallX;
+            sTrailY[0] = sBallY;
+            sTrailX[1] = px;
+            sTrailY[1] = py;
+            sTrailHead = 1;
+            sTrailLen = 2;
+            sPhase = PH_NORMAL;
+        }
+        return TRUE;
+    case PH_FADEOUT: // into the ball: the Pokémon goes on walking for 5 frames
+        sTimer++;
+        if (sTimer == 6)
+        {
+            sBallX = sprite->x;
+            sBallY = sprite->y;
+            WhitePalette();
+            AffineOn(sprite, 2);
+        }
+        else if (sTimer > 6)
+        {
+            sprite->x = sBallX;
+            sprite->y = sBallY;
+            if (sTimer == 10)
+            {
+                AffineOff(sprite);
+                ShowBall(sprite);
+                PlaySE(SE_BALL_OPEN);
+            }
+            else if (sTimer >= 17)
+            {
+                sprite->invisible = TRUE;
+                sPhase = sRecallForWarp ? PH_DEAD : PH_WAIT;
+                sTimer = 24;
+            }
+            return TRUE;
+        }
+        return FALSE;
+    case PH_DEAD:
+        sprite->invisible = TRUE;
+        return TRUE;
+    default:
+        // standing on a door (or any warp): back into the ball until the player has moved on
+        if (gPlayerAvatar.tileTransitionState == T_NOT_MOVING && !sprite->invisible)
+        {
+            s16 px, py;
+
+            PlayerGetDestCoords(&px, &py);
+            if (HanWarpDistance(px + ((sprite->x - (player->x + player->x2) + 8) >> 4), py + ((sprite->y - (player->y + player->y2) + 8) >> 4)) == 0)
+            {
+                sPhase = PH_FADEOUT;
+                sTimer = 0;
+                sRecallForWarp = FALSE;
+            }
+        }
+        return FALSE;
+    }
+}
+
+void HanFollowerFrame(void)
+{
+    struct Sprite *sprite, *player;
+    u16 want;
+
+    if (gPlayerAvatar.spriteId >= MAX_SPRITES)
+        return;
+    HanPlayerLookEnsure(); // a changed look shows at once
+    want = LeadSpecies();
+    if (want == 0 || (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER)))
+    {
+        Destroy();
+        sSpecies = 0;
+        return;
+    }
+    if (want != sSpecies)
+        MakeFrames(want);
+
+    sprite = &gSprites[sSpriteId - 1];
+    if (sSpriteId == 0 || !sprite->inUse || sprite->data[7] != FOLLOW_TAG)
+    {
+        // new map, or the first time: it starts on the player's tile and comes out from under the player
+        u8 id = CreateObjectGraphicsSprite(OBJ_EVENT_GFX_HAN_FOLLOWER, SpriteCB_Follower, 0, 0, 0);
+
+        if (id == MAX_SPRITES)
+        {
+            sSpriteId = 0;
+            return;
+        }
+        sSpriteId = id + 1;
+        if (IndexOfSpritePaletteTag(OBJ_EVENT_PAL_TAG_HAN_FOLLOWER) == 0xFF)
+        {
+            sprite = &gSprites[id];
+            sprite->data[7] = FOLLOW_TAG;
+            Destroy();
+            return;
+        }
+        sprite = &gSprites[id];
+        sprite->data[7] = FOLLOW_TAG;
+        sprite->coordOffsetEnabled = TRUE;
+        sprite->centerToCornerVecX = -16;
+        sprite->centerToCornerVecY = -16;
+        sprite->invisible = TRUE;
+        sprite->oam.priority = gSprites[gPlayerAvatar.spriteId].oam.priority;
+        sTrailHead = 0;
+        sTrailLen = 0;
+        sFacing = DIR_SOUTH;
+        // after a warp (a door, stairs) it is let out of its ball a moment later; after a route crossing it is simply there
+        sPhase = sWarped ? PH_WAIT : PH_NORMAL;
+        sTimer = 0;
+        sWarped = FALSE;
+        sRecallForWarp = FALSE;
+        StartSpriteAnim(sprite, GetFaceDirectionAnimNum(DIR_SOUTH));
+    }
+    player = &gSprites[gPlayerAvatar.spriteId];
+    if (PhaseFrame(sprite, player))
+        return;
+    HanFollowTrail(sprite, player);
+}
+
+// ---- the followers of the other players (src/han_multiplayer.c): a sprite made from the pictures in ROM, with its
+// own palette (tag), put one tile behind the other player's sprite by the caller.
+
+u16 HanFollowSpecies(void)
+{
+    return sSpecies;
+}
+
+void HanGhostFollowerDestroy(u8 id, u16 palTag)
+{
+    if (id != MAX_SPRITES && gSprites[id].inUse && gSprites[id].data[7] == FOLLOW_TAG)
+        DestroySprite(&gSprites[id]);
+    FreeSpritePaletteByTag(palTag);
+}
+
+// what: species (bit 15 shiny), as HanFollowSpecies gives it. MAX_SPRITES if it cannot be made.
+u8 HanGhostFollowerCreate(u16 what, u16 palTag)
+{
+    struct SpriteTemplate template;
+    const struct SubspriteTable *subs;
+    struct SpritePalette pal;
+    u8 id, idx;
+    u16 n = what & 0x7FFF;
+
+    if (n == 0 || n >= HAN_FOLLOW_SPECIES || sHanFollowIndex[n] == 0xFFFF)
+        return MAX_SPRITES;
+    CopyObjectGraphicsInfoToSpriteTemplate(OBJ_EVENT_GFX_HAN_FOLLOWER, SpriteCB_Follower, &template, &subs);
+    template.images = sHanFollowImg[sHanFollowIndex[n]];
+    template.paletteTag = TAG_NONE;
+    FreeSpritePaletteByTag(palTag);
+    pal.data = &sHanFollowPal[sHanFollowIndex[n] * 32 + ((what & 0x8000) ? 16 : 0)];
+    pal.tag = palTag;
+    idx = LoadSpritePalette(&pal);
+    if (idx == 0xFF)
+    {
+        // the four free sprite palettes are used by the weather, the follower, a ghost player and so on: borrow one of the
+        // palettes the game keeps for water reflections (6 to 9), which a map without reflections does not use
+        idx = 9 - (palTag & 3);
+        LoadPalette(pal.data, OBJ_PLTT_ID(idx), PLTT_SIZE_4BPP);
+    }
+    id = CreateSprite(&template, 0, 0, 0);
+    if (id == MAX_SPRITES)
+    {
+        FreeSpritePaletteByTag(palTag);
+        return MAX_SPRITES;
+    }
+    gSprites[id].oam.paletteNum = idx;
+    if (subs != NULL)
+    {
+        SetSubspriteTables(&gSprites[id], subs);
+        gSprites[id].subspriteMode = SUBSPRITES_IGNORE_PRIORITY;
+    }
+    gSprites[id].data[7] = FOLLOW_TAG;
+    gSprites[id].coordOffsetEnabled = TRUE;
+    gSprites[id].centerToCornerVecX = -16;
+    gSprites[id].centerToCornerVecY = -16;
+    return id;
+}
+
+// The Wild Area's Pokémon (src/han_wild.c): a sprite like a ghost's follower, but the Pokémon of one species share a palette.
+// load: make the palette (palTag) and give its slot back in *palIdx; otherwise use the slot in *palIdx.
+bool8 HanWildHasSprite(u16 n)
+{
+    return n != 0 && n < HAN_FOLLOW_SPECIES && sHanFollowIndex[n] != 0xFFFF;
+}
+
+// n: species, plus 0x8000 for a shiny one (its palette is the second of the species' two), plus 0x4000 if the palette must not be borrowed from the
+// water reflections: if no slot is free, the sprite is not made, so that the caller can use the usual colours.
+u8 HanWildSpriteCreate(u16 n, u16 palTag, u8 *palIdx, bool8 load)
+{
+    struct SpriteTemplate template;
+    const struct SubspriteTable *subs;
+    struct SpritePalette pal;
+    bool8 shiny = (n & 0x8000) != 0;
+    u8 id;
+
+    n &= 0x3FFF;
+    if (n == 0 || n >= HAN_FOLLOW_SPECIES || sHanFollowIndex[n] == 0xFFFF)
+        return MAX_SPRITES;
+    CopyObjectGraphicsInfoToSpriteTemplate(OBJ_EVENT_GFX_HAN_FOLLOWER, SpriteCB_Follower, &template, &subs);
+    template.images = sHanFollowImg[sHanFollowIndex[n]];
+    template.paletteTag = TAG_NONE;
+    if (load)
+    {
+        pal.data = &sHanFollowPal[sHanFollowIndex[n] * 32 + (shiny ? 16 : 0)];
+        pal.tag = palTag;
+        FreeSpritePaletteByTag(palTag);
+        *palIdx = LoadSpritePalette(&pal);
+        if (*palIdx == 0xFF)
+        {
+            // only a few sprite palettes are free: the rest go into slots of the reflection and special-NPC palettes, which nothing here needs
+            static const u8 sBorrow[] = {11, 10, 9, 8, 7, 6, 3, 2};
+
+            *palIdx = sBorrow[(palTag & 15) % ARRAY_COUNT(sBorrow)];
+            LoadPalette(pal.data, OBJ_PLTT_ID(*palIdx), PLTT_SIZE_4BPP);
+        }
+    }
+    if (*palIdx == 0xFF)
+        return MAX_SPRITES;
+    id = CreateSprite(&template, 0, 0, 0);
+    if (id == MAX_SPRITES)
+        return MAX_SPRITES;
+    gSprites[id].oam.paletteNum = *palIdx;
+    if (subs != NULL)
+    {
+        SetSubspriteTables(&gSprites[id], subs);
+        gSprites[id].subspriteMode = SUBSPRITES_IGNORE_PRIORITY;
+    }
+    gSprites[id].coordOffsetEnabled = TRUE;
+    gSprites[id].centerToCornerVecX = -16;
+    gSprites[id].centerToCornerVecY = -16;
+    return id;
+}
diff --git a/src/han_hoenn.c b/src/han_hoenn.c
new file mode 100644
index 0000000..2be09a4
--- /dev/null
+++ b/src/han_hoenn.c
@@ -0,0 +1,40 @@
+#include "global.h"
+#include "han_hoenn.h"
+#include "event_data.h"
+
+// Hän build: Hoenn's trainers and badges have their own bits, because the Kanto flag space is full.
+
+bool8 HanHoennFlagGet(u16 index)
+{
+    if (index >= HAN_HOENN_FLAG_COUNT)
+        return FALSE;
+    return (gSaveBlock1Ptr->hanHoenn[index / 8] >> (index % 8)) & 1;
+}
+
+void HanHoennFlagSet(u16 index)
+{
+    if (index < HAN_HOENN_FLAG_COUNT)
+        gSaveBlock1Ptr->hanHoenn[index / 8] |= 1 << (index % 8);
+}
+
+void HanHoennFlagClear(u16 index)
+{
+    if (index < HAN_HOENN_FLAG_COUNT)
+        gSaveBlock1Ptr->hanHoenn[index / 8] &= ~(1 << (index % 8));
+}
+
+void HanHoennBadge(void)
+{
+    if (gSpecialVar_0x8004 < 8)
+        HanHoennFlagSet(HAN_HOENN_BADGE_FLAG + gSpecialVar_0x8004);
+}
+
+u8 HanHoennBadgeCount(void)
+{
+    u8 i, n = 0;
+
+    for (i = 0; i < 8; i++)
+        if (HanHoennFlagGet(HAN_HOENN_BADGE_FLAG + i))
+            n++;
+    return n;
+}
