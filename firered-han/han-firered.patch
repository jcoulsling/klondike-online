+++ b/tools/han/han_follow.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Follower Pokémon pictures (Jane, 22 November 2026).
+
+Makes graphics/han_follow/sheets.bin and src/data/han_follow_data.h from the overworld pictures of the
+pokeemerald-expansion project (github.com/rh-hideout/pokeemerald-expansion, graphics/pokemon/<species>/overworld.png:
+32 x 32, 6 frames: south, south, north, north, west, west; east is west turned round; colour 0 is clear).
+Those pictures are other people's art, so the generated files are in the patch but this script needs the folder:
+
+    python3 tools/han/han_follow.py PATH_TO/pokeemerald-expansion
+
+One picture per species (Gen 1 to 3): 6 frames of 0x200 bytes (each in the tile order a 32 x 32 sprite wants),
+then the normal and the shiny palette (16 x u16 each) in pal.bin.
+"""
+import re
+import sys
+from pathlib import Path
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "graphics" / "han_follow"
+SPECIAL = {"NIDORAN_F": "nidoran_f", "NIDORAN_M": "nidoran_m", "MR_MIME": "mr_mime", "HO_OH": "ho_oh",
+           "FARFETCHD": "farfetchd"}
+
+
+def species():
+    out = {}
+    for m in re.finditer(r"#define SPECIES_(\w+)\s+(\d+)\s", (ROOT / "include/constants/species.h").read_text()):
+        n = int(m.group(2))
+        if 1 <= n <= 251 or 277 <= n <= 411:
+            out[n] = m.group(1)
+    out[252] = "SYLVEON"
+    return out
+
+
+def c555(rgb):
+    return (rgb[0] >> 3) | ((rgb[1] >> 3) << 5) | ((rgb[2] >> 3) << 10)
+
+
+def pal_of(path):
+    """A JASC .pal file -> 16 colours (BGR555)."""
+    lines = path.read_text().split()
+    nums = list(map(int, lines[3:]))
+    cols = [c555(nums[i * 3:i * 3 + 3]) for i in range(len(nums) // 3)]
+    return (cols + [0] * 16)[:16]
+
+
+def shrink(im):
+    """A 384 x 64 picture (six 64 x 64 frames, the big Pokémon) -> 192 x 32: each 2 x 2 block becomes its most common
+    colour, clear if most of it is."""
+    src = im.load()
+    out = Image.new("P", (192, 32))
+    out.putpalette(im.getpalette())
+    dst = out.load()
+    for y in range(32):
+        for x in range(192):
+            blk = [src[x * 2 + i, y * 2 + j] & 15 for i in (0, 1) for j in (0, 1)]
+            if blk.count(0) >= 3:
+                dst[x, y] = 0
+            else:
+                dst[x, y] = max((c for c in blk if c), key=lambda c: blk.count(c))
+    return out
+
+
+def sheet(im):
+    """P image 192 x 32 (or wider: the first 6 frames count) -> 6 frames of 512 bytes."""
+    px = im.load()
+    out = bytearray()
+    for f in range(6):
+        for ty in range(4):
+            for tx in range(4):
+                for y in range(8):
+                    for x in range(0, 8, 2):
+                        a = px[f * 32 + tx * 8 + x, ty * 8 + y] & 15
+                        b = px[f * 32 + tx * 8 + x + 1, ty * 8 + y] & 15
+                        out.append(a | (b << 4))
+    return out
+
+
+def main(folder):
+    base = Path(folder) / "graphics" / "pokemon"
+    OUT.mkdir(parents=True, exist_ok=True)
+    sp = species()
+    sheets, pals, index, missing, big = bytearray(), bytearray(), {}, [], []
+    for sid in sorted(sp):
+        name = SPECIAL.get(sp[sid], sp[sid].lower())
+        d = base / name
+        png = d / "overworld.png"
+        if not png.exists():
+            missing.append(sp[sid])
+            continue
+        im = Image.open(png)
+        assert im.mode == "P" and im.size in ((192, 32), (256, 32), (384, 64)), (name, im.mode, im.size)
+        if im.size == (384, 64):
+            im = shrink(im)
+            big.append(sp[sid])
+        n = len(index)
+        index[sid] = n
+        sheets += sheet(im)
+        normal = pal_of(d / "overworld_normal.pal") if (d / "overworld_normal.pal").exists() else None
+        if normal is None:
+            p = im.getpalette()[:48]
+            normal = [c555(p[i * 3:i * 3 + 3]) for i in range(16)]
+        shiny = pal_of(d / "overworld_shiny.pal") if (d / "overworld_shiny.pal").exists() else normal
+        for c in normal + shiny:
+            pals += c.to_bytes(2, "little")
+    (OUT / "sheets.bin").write_bytes(bytes(sheets))
+    (OUT / "pal.bin").write_bytes(bytes(pals))
+    top = max(sp) + 1
+    tab = [index.get(i, 0xFFFF) for i in range(top)]
+    h = ["// Written by tools/han/han_follow.py. Follower Pokémon pictures: %d species." % len(index),
+         "#define HAN_FOLLOW_SPECIES %d" % top,
+         "static const u16 sHanFollowIndex[HAN_FOLLOW_SPECIES] = {" + ", ".join("0x%04X" % t for t in tab) + "};",
+         'static const u32 sHanFollowSheets[%d] = INCBIN_U32("graphics/han_follow/sheets.bin"); // 6 x 0x200 bytes each' % (len(sheets) // 4),
+         'static const u16 sHanFollowPal[%d] = INCBIN_U16("graphics/han_follow/pal.bin"); // normal, shiny: 16 colours each' % (len(pals) // 2)]
+    # the nine frames of a normal sprite sheet for each picture, in ROM (other players' followers are made from these)
+    h.append("#define FI(i, f) {(const u8 *)sHanFollowSheets + ((i) * 6 + (f)) * 0x200, 0x200}")
+    order = [0, 2, 4, 1, 1, 3, 3, 5, 5]
+    h.append("static const struct SpriteFrameImage sHanFollowImg[%d][9] = {" % len(index) + ", ".join("{" + ", ".join("FI(%d, %d)" % (n, f) for f in order) + "}" for n in range(len(index))) + "};")
+    (ROOT / "src" / "data" / "han_follow_data.h").write_text("\n".join(h) + "\n")
+    print("%d species, %d bytes of pictures; missing: %s; shrunk from 64 x 64: %s" % (len(index), len(sheets), ", ".join(missing) or "none", ", ".join(big)))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1] if len(sys.argv) > 1 else "/tmp/fx/exp")
