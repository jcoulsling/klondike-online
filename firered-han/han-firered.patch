+#define HAN_SYL_VOWELS          7   // columns of the grid: ä a ë e i o u
+#define HAN_SYL_ROW_VOWEL       38   // the row for a vowel with no consonant
+#define HAN_SYL_FINALS_BASE     273   // first glyph of the finals
+#define HAN_SYL_FINAL_N         5
+#define HAN_SYL_FINAL_GLOTTAL   19
