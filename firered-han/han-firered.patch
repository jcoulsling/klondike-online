+#!/usr/bin/env python3
+"""Build-time data for the character customizer (Jane, 22 November 2026).
+
+Reads the "Pokémon Gen 3 Trainer" pack (Jordan Bunke; someone else's art, so it is NOT in git, the patch or the zip) and
+writes, for the game to put a character together while it runs:
+
+  graphics/han_custom/body.bin   12 body-type layers x 18 frames x (16 x 32) bytes
+  graphics/han_custom/head.bin   149 head layers x 5 cells x (20 x 20) bytes
+  src/data/han_custom_data.h     counts, the frame table, and the colour tables
+
+A byte in a layer is not a colour but a ROLE: family * 4 + shade (1..39), or 40 + n for a colour that is always the same
+(black, white and so on), or 0 for clear. The game turns a role into a colour from the look's swatches, which are the
+pack's own (han_pok3.py), so the colours match what the pack would make. The 16 x 32 frames are cut from the pack's
+40 x 40 cells at (12, 4), the size of the game's own player frames: only the widest hair (afro) loses a few pixels.
+
+Without the pack folder the header says HAN_CUSTOM_AVAILABLE 0 and the game keeps its own player pictures.
+
+    python3 tools/han/han_custom.py [PACK_FOLDER]
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import han_pok3 as H  # noqa: E402
+
+ROOT = H.ROOT
+OUT_DIR = ROOT / "graphics" / "han_custom"
+OUT_H = ROOT / "src" / "data" / "han_custom_data.h"
+
+CROP = (12, 4, 28, 36)
+FAM_SKIN, FAM_OUTLINE, FAM_HAIR, FAM_IRIS, FAM_WHITE, FAM_CLOTH0 = 1, 2, 3, 4, 5, 6
+LITERAL_BASE = 40
+NSWATCH = 12
+
+SKIN_LIST = [(0xb8, 0xf8, 0xb8), (0x98, 0xe8, 0x98), (0x70, 0xd8, 0x70)]
+OUTLINE_LIST = [(0x55, 0x78, 0x40), (0x36, 0x40, 0x30)]
+HAIR_LIST = [(0xb0, 0xb0, 0xf8), (0x80, 0x80, 0xf0), (0x48, 0x48, 0xc8), (0x30, 0x30, 0x70)]
+IRIS_LIST = [(0xff, 0x00, 0x00), (0x88, 0x48, 0x48)]
+WHITE_LIST = [(0x00, 0xff, 0xff), (0xa8, 0xd8, 0xd8)]
+CLOTH_LIST = [
+    [(0xf0, 0x80, 0x80), (0xf8, 0xb0, 0xb0), (0xc8, 0x48, 0x48), (0x70, 0x30, 0x30)],
+    [(0xf0, 0xb8, 0x80), (0xf8, 0xd4, 0xb0), (0xc8, 0x88, 0x48), (0x70, 0x50, 0x30)],
+    [(0xf0, 0xf0, 0x80), (0xf8, 0xf8, 0xb0), (0xc8, 0xc8, 0x48), (0x70, 0x70, 0x30)],
+    [(0xb8, 0xf0, 0x80), (0xd4, 0xf8, 0xb0), (0x88, 0xc8, 0x48), (0x50, 0x70, 0x30)],
+]
+WHITE_FINAL = [(0xf8, 0xf8, 0xf8), (0xc8, 0xd0, 0xd8)]
+
+# the game's frame table order: (direction row, pack column, animation, frame, head cell)
+# rows in the pack: S 0, W 1, E 2, N 3
+FRAMES = []
+for d, row in (("S", 0), ("N", 3), ("W", 1)):  # the three standing frames
+    FRAMES.append((d, row, 1, "idle", 0))
+for d, row in (("S", 0), ("N", 3), ("W", 1)):  # walking: first and second step
+    FRAMES.append((d, row, 0, "walk", 0))
+    FRAMES.append((d, row, 2, "walk", 2))
+for d, row in (("S", 0), ("N", 3), ("W", 1)):  # running: stand, first and second step
+    FRAMES.append((d, row, 4, "run", 1))
+    FRAMES.append((d, row, 3, "run", 0))
+    FRAMES.append((d, row, 5, "run", 2))
+NFRAMES = len(FRAMES)  # 18
+
+
+def snap555(c):
+    return ((c[0] >> 3) | ((c[1] >> 3) << 5) | ((c[2] >> 3) << 10))
+
+
+def role_table():
+    """role id -> list of NSWATCH colours (r, g, b) for every swatch of the family."""
+    tab = {}
+    sw = {FAM_SKIN: H.SKIN_SWATCHES, FAM_OUTLINE: H.SKIN_SWATCHES, FAM_HAIR: H.HAIR_SWATCHES, FAM_IRIS: H.EYE_SWATCHES}
+    for fam, lst, base, outline in ((FAM_SKIN, SKIN_LIST, H.BASE_SKIN, False), (FAM_OUTLINE, OUTLINE_LIST, H.BASE_SKIN, True),
+                                    (FAM_HAIR, HAIR_LIST, H.BASE_HAIR, False), (FAM_IRIS, IRIS_LIST, H.BASE_IRIS, False)):
+        for k, px in enumerate(lst):
+            row = [H.derive(px, base, s, outline=outline) for s in sw[fam]]
+            tab[fam * 4 + k] = (row + [row[-1]] * NSWATCH)[:NSWATCH]
+    for k, px in enumerate(WHITE_LIST):
+        tab[FAM_WHITE * 4 + k] = [WHITE_FINAL[k]] * NSWATCH
+    for i in range(4):
+        for k, px in enumerate(CLOTH_LIST[i]):
+            row = [H.derive(px, H.BASE_CLOTH[i], s) for s in H.CLOTHES_SWATCHES]
+            tab[(FAM_CLOTH0 + i) * 4 + k] = (row + [row[-1]] * NSWATCH)[:NSWATCH]
+    return tab
+
+
+ROLE_OF = {}
+for fam, lst in ((FAM_SKIN, SKIN_LIST), (FAM_OUTLINE, OUTLINE_LIST), (FAM_HAIR, HAIR_LIST), (FAM_IRIS, IRIS_LIST), (FAM_WHITE, WHITE_LIST)):
+    for k, px in enumerate(lst):
+        ROLE_OF[px] = fam * 4 + k
+for i in range(4):
+    for k, px in enumerate(CLOTH_LIST[i]):
+        ROLE_OF[px] = (FAM_CLOTH0 + i) * 4 + k
+
+
+class Literals:
+    def __init__(self):
+        self.list = []
+
+    def role(self, rgb):
+        if rgb in ROLE_OF:
+            return ROLE_OF[rgb]
+        c = (rgb[0] & 0xF8, rgb[1] & 0xF8, rgb[2] & 0xF8)
+        if c not in self.list:
+            self.list.append(c)
+        n = self.list.index(c)
+        if n >= 24:
+            raise SystemExit("han_custom.py: more than 24 fixed colours")
+        return LITERAL_BASE + n
+
+
+def roles_of(im, lit, box, size):
+    """box: crop box in im; returns bytes of size[0] * size[1] roles."""
+    c = im.crop(box)
+    out = bytearray()
+    px = c.load()
+    for y in range(c.height):
+        for x in range(c.width):
+            r, g, b, a = px[x, y]
+            out.append(lit.role((r, g, b)) if a else 0)
+    assert len(out) == size[0] * size[1]
+    return bytes(out)
+
+
+def blank_sheet(w, h):
+    from PIL import Image
+    return Image.new("RGBA", (w, h))
+
+
+# The big pictures (trainer card, battle): the game's own trainer pictures, recoloured. The player's picture is the
+# game's Red or Leaf, or any of the donors below (the customizer's PICTURE row), and a battle (back) picture is chosen
+# to go with it. A picture's palette entries are given a family (0 none, 1 skin, 2 hair, 3 colour A, 4 colour B,
+# 5 colour C); the colour for each swatch is worked out here as the pack does for the small sprites (the chosen
+# colour, shaded as the entry differs from the family's main entry, the first of its list).
+def _sp(skin=(2, 1, 3), hair=(), A=(), B=(), C=()):
+    return {1: list(skin), 2: list(hair), 3: list(A), 4: list(B), 5: list(C)}
+
+
+# name, front picture symbol, palette symbol (without the gTrainerFrontPic_ / gTrainerPalette_), file, spec
+BIG_FRONT = [
+    ("red", None, None, "front_pics/red_front_pic.png", _sp(hair=[4], A=[13, 12], B=[6, 5, 7], C=[11, 10])),
+    ("leaf", None, None, "front_pics/leaf_front_pic.png", _sp(hair=[4], A=[6, 5, 7], B=[13, 12], C=[10])),
+]
+# the battle pictures: the game's Red, Leaf, RS Brendan, RS May and the Pokedude; file, spec
+BIG_BACK = [
+    ("red", "back_pics/red_back_pic.png", _sp((2, 3), [4, 8], [11, 12], [], [14, 13])),
+    ("leaf", "back_pics/leaf_back_pic.png", _sp((2, 3), [4, 8], [6, 7], [12, 11], [14, 13, 1])),
+]
+
+
+def big_tables():
+    from PIL import Image
+    sw = {1: H.SKIN_SWATCHES, 2: H.HAIR_SWATCHES, 3: H.CLOTHES_SWATCHES, 4: H.CLOTHES_SWATCHES, 5: H.CLOTHES_SWATCHES}
+    kinds = [(f[3], f[4]) for f in BIG_FRONT] + [(b[1], b[2]) for b in BIG_BACK]
+    fams, cols = [], []
+    for file, spec in kinds:
+        pal = Image.open(ROOT / "graphics" / "trainers" / file).getpalette()[:48]
+        rgb = [tuple(pal[i * 3:i * 3 + 3]) for i in range(16)]
+        f, c = [0] * 16, []
+        for i in range(16):
+            row = [(0, 0, 0)] * NSWATCH
+            for fam, lst in spec.items():
+                if i in lst:
+                    f[i] = fam
+                    row = [H.derive(rgb[i], rgb[lst[0]], s) for s in sw[fam]]
+                    row = (row + [row[-1]] * NSWATCH)[:NSWATCH]
+            c.append(row)
+        fams.append(f)
+        cols.append(c)
+    return fams, cols
+
+
+def main(argv):
+    folder = Path(argv[1]) if len(argv) > 1 else H.pack_dir()
+    OUT_H.parent.mkdir(parents=True, exist_ok=True)
+    OUT_DIR.mkdir(parents=True, exist_ok=True)
+    if not folder:
+        OUT_H.write_text("// Written by tools/han/han_custom.py. The pack was not found: no customizer in this build.\n"
+                         "#define HAN_CUSTOM_AVAILABLE 0\n")
+        print("han_custom.py: no pack folder, customizer left out")
+        return
+    pack = H.Pack(folder)
+    lit = Literals()
+
+    # body-type layers
+    body_files = [("body", "default-male"), ("body", "default-female")]
+    for pre in ("dm", "df"):
+        for part, name in (("top", "t-shirt"), ("bottom", "pants"), ("shoes", "simple")):
+            body_files.append(("%s-%s" % (pre, part), name))
+    for pre in ("dm", "df"):
+        for name in ("gi", "dress-with-apron"):
+            body_files.append(("%s-outfit" % pre, name))
+    assert len(body_files) == 12
+    body = bytearray()
+    for layer, name in body_files:
+        im = pack.image(layer, name)
+        for d, row, col, anim, f in FRAMES:
+            x0, y0 = col * 40, row * 40
+            body += roles_of(im, lit, (x0 + CROP[0], y0 + CROP[1], x0 + CROP[2], y0 + CROP[3]), (16, 32))
+    (OUT_DIR / "body.bin").write_bytes(bytes(body))
+
+    # head layers
+    heads = pack.names("head")
+    eyes = pack.names("eyes")
+    hairs = pack.names("hair")
+    hats = pack.names("hat")
+    assert (len(heads), len(eyes), len(hairs), len(hats)) == (3, 8, 30, 12), (len(heads), len(eyes), len(hairs), len(hats))
+
+    def sheet5(layer, name, four=False):
+        from PIL import Image
+        p = folder / "bases" / layer / (name + ".png")
+        if not p.exists():
+            return blank_sheet(100, 20)
+        im = Image.open(p).convert("RGBA")
+        if four:
+            o = blank_sheet(100, 20)
+            o.alpha_composite(im, (0, 0))
+            o.alpha_composite(im.crop((0, 0, 20, 20)), (80, 0))
+            return o
+        return im
+
+    head = bytearray()
+
+    def add(layer, names, four=False, mask=False):
+        for n in names:
+            im = sheet5(layer, n, four)
+            for cell in range(5):
+                if mask:
+                    c = im.crop((cell * 20, 0, cell * 20 + 20, 20))
+                    head.extend(1 if p[3] else 0 for p in (c.get_flattened_data() if hasattr(c, 'get_flattened_data') else c.getdata()))
+                else:
+                    head.extend(roles_of(im, lit, (cell * 20, 0, cell * 20 + 20, 20), (20, 20)))
+
+    add("head", heads)
+    add("eyes", eyes, four=True)
+    add("hair", hairs)
+    add("hair-front", hairs)
+    add("hair-back", hairs)
+    add("hat", hats)
+    add("hat-back", hats)
+    add("hat-mask", hats, mask=True)
+    add("hat-back-mask", hats, mask=True)
+    (OUT_DIR / "head.bin").write_bytes(bytes(head))
+    nlayers = len(head) // 2000
+    assert nlayers == 149, nlayers
+
+    # frame table: head cell, offset in the 16 x 32 frame
+    fr = []
+    for d, row, col, anim, f in FRAMES:
+        hx = {"S": 0, "W": 1, "N": 3}[d]
+        if d == "S" and anim == "run":
+            hx = 4
+        ox, oy = H.head_offset(d, anim if anim != "idle" else "idle", f)
+        fr.append((hx, ox - (CROP[0] - 10), oy - (CROP[1] - 10)))
+
+    tab = role_table()
+    L = []
+    L.append("// Written by tools/han/han_custom.py from the pack. Not in git, the patch or the zip.")
+    L.append("#define HAN_CUSTOM_AVAILABLE 1")
+    L.append("#define HAN_N_FRAMES %d" % NFRAMES)
+    L.append("#define HAN_N_HEAD 3\n#define HAN_N_EYES 8\n#define HAN_N_HAIR 30\n#define HAN_N_HAT 12")
+    L.append("#define HAN_N_SKIN %d\n#define HAN_N_HAIRCOL %d\n#define HAN_N_EYECOL %d\n#define HAN_N_CLOTHCOL %d" %
+             (len(H.SKIN_SWATCHES), len(H.HAIR_SWATCHES), len(H.EYE_SWATCHES), len(H.CLOTHES_SWATCHES)))
+    L.append("#define HAN_NSWATCH %d" % NSWATCH)
+    L.append("#define HAN_L_HEAD 0\n#define HAN_L_EYES 3\n#define HAN_L_HAIR 11\n#define HAN_L_HAIRF 41\n#define HAN_L_HAIRB 71")
+    L.append("#define HAN_L_HAT 101\n#define HAN_L_HATB 113\n#define HAN_L_HATM 125\n#define HAN_L_HATBM 137")
+    L.append('static const u8 sHanBody[12 * HAN_N_FRAMES * 512] = INCBIN_U8("graphics/han_custom/body.bin");')
+    L.append('static const u8 sHanHead[149 * 5 * 400] = INCBIN_U8("graphics/han_custom/head.bin");')
+    L.append("// head cell, x and y of the head in the 16 x 32 frame, for each frame")
+    L.append("static const s8 sHanFrameHead[HAN_N_FRAMES][3] = {" + ", ".join("{%d, %d, %d}" % t for t in fr) + "};")
+    hair_acc = [pack.counts("hair").get(n, 0) for n in hairs]
+    hat_sets = [pack.counts("hat").get(n, 0) for n in hats]
+    L.append("static const u8 sHanHairAcc[HAN_N_HAIR] = {" + ", ".join(map(str, hair_acc)) + "};")
+    L.append("static const u8 sHanHatSets[HAN_N_HAT] = {" + ", ".join(map(str, hat_sets)) + "};")
+    L.append("// colours: role -> swatch -> BGR555")
+    rows = []
+    for rid in range(40):
+        cols = tab.get(rid, [(0, 0, 0)] * NSWATCH)
+        rows.append("{" + ", ".join("0x%04X" % snap555(c) for c in cols) + "}")
+    L.append("static const u16 sHanRoleColour[40][HAN_NSWATCH] = {\n    " + ",\n    ".join(rows) + "\n};")
+    litc = lit.list + [(0, 0, 0)] * (24 - len(lit.list))
+    L.append("static const u16 sHanLiteral[24] = {" + ", ".join("0x%04X" % snap555(c) for c in litc) + "};")
+    fams, bigc = big_tables()
+    import han_pics as P
+    blob, pals, _pd = P.build()
+    # who a picture can be chosen by: 0 boy, 1 girl, 2 either (pairs, twins and the game's own default)
+    _fem = {"RS_AROMA_LADY", "HEX_MANIAC", "RS_LADY", "RS_BEAUTY", "RS_PSYCHIC_F", "ELITE_FOUR_PHOEBE", "LEADER_ROXANNE",
+            "BATTLE_GIRL", "PARASOL_LADY", "RS_PICNICKER", "RS_MAY_1", "RS_MAY_2", "RS_LASS", "LEADER_FLANNERY", "LEADER_WINONA",
+            "ELITE_FOUR_GLACIA", "LASS", "PICNICKER", "BEAUTY", "ELITE_FOUR_LORELEI", "ELITE_FOUR_AGATHA", "LEADER_ERIKA",
+            "LEADER_MISTY", "LEADER_SABRINA", "CRUSH_GIRL", "AROMA_LADY", "LADY", "LEAF", "POKEMON_BREEDER"}
+    _both = {"LEADER_TATE_AND_LIZA", "SR_AND_JR", "OLD_COUPLE", "RS_YOUNG_COUPLE", "RS_SIS_AND_BRO", "RS_TWINS", "TWINS",
+             "COOL_COUPLE", "YOUNG_COUPLE", "CRUSH_KIN", "SIS_AND_BRO"}
+    _sx = [2]
+    for _d in _pd:
+        n_ = _d[0] if _d else ""
+        _sx.append(2 if n_ in _both else (1 if (n_ in _fem or n_.endswith("_F")) else 0))
+    L.append("static const u8 sHanPicSex[%d] = {" % len(_sx) + ", ".join(map(str, _sx)) + "};")
+    # the order the customizer steps through: the game's own, then the ordinary player characters, then the rest
+    _first = ["RED", "LEAF", "RS_BRENDAN_1", "RS_MAY_1", "RS_BRENDAN_2", "RS_MAY_2"]
+    _names = [""] + [(_d[0] if _d else "") for _d in _pd]
+    _at = [0] + [_names.index(n_) for n_ in _first if n_ in _names]
+    _at += [i_ for i_ in range(1, len(_sx)) if i_ not in _at]
+    _pos = [0] * len(_sx)
+    for _k, _i in enumerate(_at):
+        _pos[_i] = _k
+    L.append("static const u8 sHanPicAt[%d] = {" % len(_sx) + ", ".join(map(str, _at)) + "};")
+    L.append("static const u8 sHanPicPos[%d] = {" % len(_sx) + ", ".join(map(str, _pos)) + "};")
+    (OUT_DIR / "pics.bin").write_bytes(bytes(blob))
+    L.append("#define HAN_N_PIC %d // values: 0 the game's own Red or Leaf, then the game's trainer pictures in order" % (len(pals) + 1))
+    L.append("#define HAN_N_PAL %d // palettes: the original, 7 rainbow colours, black, white, 2 that suit the picture" % P.N_VARIANTS)
+    L.append("// the colour tables of the player's own Red and Leaf pictures: kinds 0 and 1 front, 2 and 3 back")
+    L.append("static const u8 sHanBigFam[%d][16] = {" % len(fams) + ", ".join("{" + ", ".join(map(str, f)) + "}" for f in fams) + "};")
+    L.append("static const u16 sHanBigCol[%d][16][HAN_NSWATCH] = {" % len(fams) + ", ".join("{" + ", ".join("{" + ", ".join("0x%04X" % snap555(c) for c in e) + "}" for e in k) + "}" for k in bigc) + "};")
+    import re as _re
+    gi = (ROOT / "src/data/object_events/object_event_graphics_info.h").read_text()
+    infos = {m.group(1): _re.search(r"\.paletteTag = (\w+)", m.group(2)).group(1) for m in _re.finditer(r"const struct ObjectEventGraphicsInfo gObjectEventGraphicsInfo_(\w+) = \{(.*?)\n\};", gi, _re.S)}
+    gc = (ROOT / "include/constants/event_objects.h").read_text()
+    consts = {m.group(1): int(m.group(2)) for m in _re.finditer(r"#define OBJ_EVENT_GFX_(\w+)\s+(\d+)", gc)}
+    owbases, owof = P.ow_tables(consts, infos)
+    L.append("// the walking pictures: for each trainer picture the object graphics id and which palette it uses")
+    L.append("static const u8 sHanOwOf[%d][2] = {" % len(owof) + ", ".join("{%d, %d}" % o for o in owof) + "};")
+    L.append("static const u16 sHanOwPal[%d][HAN_N_PAL][16] = {" % len(owbases) + ", ".join("{" + ", ".join("{" + ", ".join("0x%04X" % c for c in v) + "}" for v in b) + "}" for b in owbases) + "};")
+    import han_states
+    blobs, stidx, storder = han_states.build(consts, infos, owof, P.OW_BASE_OF, P.OW_RGB)
+    han_states.write(blobs)
+    L.append("// bike, surf, fishing, item and VS Seeker frames drawn for each walking picture (tools/han/han_states.py); 255 = the game's own")
+    L.append("static const u8 sHanStIdx[%d] = {" % len(stidx) + ", ".join(map(str, stidx)) + "};")
+    for k in han_states.STATES:
+        L.append('static const u32 sHanSt_%s[] = INCBIN_U32("graphics/han_custom/st_%s.bin");' % (k, k))
+    print("han_custom.py: %d walking pictures have their own bike, surf, fishing and item frames" % len(storder))
+    L.append('static const u32 sHanPics[%d * 0x200] = INCBIN_U32("graphics/han_custom/pics.bin"); // every trainer picture, uncompressed' % len(pals))
+    L.append("static const u16 sHanPicPal[%d][HAN_N_PAL][16] = {" % len(pals) + ", ".join("{" + ", ".join("{" + ", ".join("0x%04X" % c for c in v) + "}" for v in pp) + "}" for pp in pals) + "};")
+    OUT_H.write_text("\n".join(L) + "\n")
+    print("han_custom.py: wrote %s bytes of body, %s of head, %d fixed colours, %d frames" % (len(body), len(head), len(lit.list), NFRAMES))
+
+
+if __name__ == "__main__":
+    main(sys.argv)
