diff --git a/data/scripts/han_tower.inc b/data/scripts/han_tower.inc
new file mode 100644
index 0000000..3373d4e
--- /dev/null
+++ b/data/scripts/han_tower.inc
@@ -0,0 +1,64 @@
+@ Hän build: the TRAINER TOWER from the POKéMON CENTER, and the choice of team at the lobby counter.
+
+Han_Tower_NurseOffer::
+	specialvar VAR_RESULT, IsPlayerNotInTrainerTowerLobby
+	goto_if_eq VAR_RESULT, FALSE, Han_Tower_NurseOfferEnd
+	msgbox Han_Tower_Text_Offer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Han_Tower_NurseOfferEnd
+	special HanTowerSetReturn
+	closemessage
+	warp MAP_TRAINER_TOWER_LOBBY, 9, 14
+	waitstate
+Han_Tower_NurseOfferEnd::
+	return
+
+@ the TRAINER TOWER from upstairs in every POKéMON CENTER, with any number of badges
+Han_Tower_Attendant::
+	lock
+	faceplayer
+	msgbox Han_Tower_Text_Hello
+	call Han_Tower_NurseOffer
+	release
+	end
+
+@ VAR_RESULT: TRUE a team is ready, FALSE the player backed out
+Han_Tower_ChooseTeam::
+	specialvar VAR_RESULT, HanTowerRollSpecial
+	goto_if_eq VAR_RESULT, TRUE, Han_Tower_ChooseTeamBrandon
+	message Han_Tower_Text_WhichTeam
+	waitmessage
+	multichoice 11, 3, MULTICHOICE_HAN_TOWER_TEAM, FALSE
+	goto Han_Tower_TeamPicked
+
+Han_Tower_ChooseTeamBrandon::
+	message Han_Tower_Text_WhichTeamSpecial
+	waitmessage
+	multichoice 11, 3, MULTICHOICE_HAN_TOWER_TEAM_BRANDON, FALSE
+Han_Tower_TeamPicked::
+	switch VAR_RESULT
+	case 0, Han_Tower_TeamOk
+	case 1, Han_Tower_TeamOk
+	case 2, Han_Tower_TeamOk
+	case 3, Han_Tower_TeamOk
+	setvar VAR_RESULT, FALSE
+	return
+
+Han_Tower_TeamOk::
+	copyvar VAR_0x8004, VAR_RESULT
+	specialvar VAR_RESULT, HanTowerBuildTeam
+	return
+
+Han_Tower_Text_Hello:
+	.string "Welcome! I look after the\n"
+	.string "TRAINER TOWER.$"
+
+Han_Tower_Text_Offer:
+	.string "Would you like to go to the\n"
+	.string "TRAINER TOWER?$"
+
+Han_Tower_Text_WhichTeam:
+	.string "Which team will you take in?$"
+
+Han_Tower_Text_WhichTeamSpecial:
+	.string "Which team? BRANDON's team is on\n"
+	.string "loan today!$"
diff --git a/data/scripts/han_trade.inc b/data/scripts/han_trade.inc
new file mode 100644
index 0000000..4b152dc
--- /dev/null
+++ b/data/scripts/han_trade.inc
@@ -0,0 +1,189 @@
+@ Hän build: trading with another player (src/han_trade.c). Jane, 22 November 2026.
+
+Han_Trade_Initiate::
+	lockall
+	msgbox Han_Battle_Text_Ask, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, YES, Han_Battle_Initiate
+	msgbox Han_Trade_Text_Ask, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Han_Trade_End
+	special ChoosePartyMon
+	waitstate
+	goto_if_ge VAR_0x8004, PARTY_SIZE, Han_Trade_Cancel
+	specialvar VAR_RESULT, HanTradeOffer
+	goto_if_eq VAR_RESULT, FALSE, Han_Trade_CannotSend
+	message Han_Trade_Text_Waiting
+	waitmessage
+	setvar VAR_0x8008, 0
+Han_Trade_WaitCounter::
+	delay 30
+	specialvar VAR_RESULT, HanTradePoll
+	goto_if_eq VAR_RESULT, 1, Han_Trade_GotCounter
+	goto_if_eq VAR_RESULT, 2, Han_Trade_Refused
+	addvar VAR_0x8008, 1
+	goto_if_lt VAR_0x8008, 40, Han_Trade_WaitCounter
+	goto Han_Trade_TimedOut
+
+Han_Trade_GotCounter::
+	special HanTradeNames
+	msgbox Han_Trade_Text_ConfirmA, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Han_Trade_Cancel
+	special HanTradeAccept
+	msgbox Han_Trade_Text_Done
+	releaseall
+	end
+
+Han_Trade_Incoming::
+	lockall
+	special HanTradeNameIn
+	msgbox Han_Trade_Text_Offered, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Han_Trade_Cancel
+	special ChoosePartyMon
+	waitstate
+	goto_if_ge VAR_0x8004, PARTY_SIZE, Han_Trade_Cancel
+	specialvar VAR_RESULT, HanTradeCounter
+	goto_if_eq VAR_RESULT, FALSE, Han_Trade_CannotSend
+	message Han_Trade_Text_Waiting
+	waitmessage
+	setvar VAR_0x8008, 0
+Han_Trade_WaitAccept::
+	delay 30
+	specialvar VAR_RESULT, HanTradePoll
+	goto_if_eq VAR_RESULT, 1, Han_Trade_GotAccept
+	goto_if_eq VAR_RESULT, 2, Han_Trade_Refused
+	addvar VAR_0x8008, 1
+	goto_if_lt VAR_0x8008, 80, Han_Trade_WaitAccept
+	goto Han_Trade_TimedOut
+
+Han_Trade_GotAccept::
+	special HanTradeApply
+	msgbox Han_Trade_Text_Done
+	releaseall
+	end
+
+Han_Trade_CannotSend::
+	special HanTradeCancel
+	msgbox Han_Trade_Text_CannotSend
+	releaseall
+	end
+
+Han_Trade_Refused::
+	special HanTradeDone
+	msgbox Han_Trade_Text_Refused
+	releaseall
+	end
+
+Han_Trade_TimedOut::
+	special HanTradeCancel
+	msgbox Han_Trade_Text_TimedOut
+	releaseall
+	end
+
+Han_Trade_Cancel::
+	special HanTradeCancel
+Han_Trade_End::
+	releaseall
+	end
+
+Han_Battle_Initiate::
+	setvar VAR_0x8004, 0
+Han_Battle_Ask2::
+	specialvar VAR_RESULT, HanBattleChallenge
+	goto_if_eq VAR_RESULT, FALSE, Han_Battle_CannotFight
+	message Han_Trade_Text_Waiting
+	waitmessage
+	setvar VAR_0x8008, 0
+Han_Battle_WaitOk::
+	delay 30
+	specialvar VAR_RESULT, HanBattlePoll
+	goto_if_eq VAR_RESULT, 1, Han_Battle_Go
+	goto_if_eq VAR_RESULT, 2, Han_Battle_Refused
+	addvar VAR_0x8008, 1
+	goto_if_lt VAR_0x8008, 40, Han_Battle_WaitOk
+	goto Han_Trade_TimedOut
+
+Han_Battle_Go::
+	closemessage
+	special HanBattleLaunch
+	waitstate
+	releaseall
+	end
+
+Han_Battle_Incoming::
+	lockall
+	special HanBattleKindName
+	msgbox Han_Battle_Text_Offered, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Han_Battle_Decline
+	specialvar VAR_RESULT, HanBattleAccept
+	goto_if_eq VAR_RESULT, FALSE, Han_Battle_CannotFight2
+	special HanBattleLaunch
+	waitstate
+	releaseall
+	end
+
+Han_Battle_Decline::
+	special HanBattleRefuse
+	releaseall
+	end
+
+Han_Battle_CannotFight2::
+	special HanBattleRefuse
+Han_Battle_CannotFight::
+	msgbox Han_Battle_Text_CannotFight
+	releaseall
+	end
+
+Han_Battle_Refused::
+	special HanTradeDone
+	msgbox Han_Battle_Text_Refused
+	releaseall
+	end
+
+Han_Battle_SetDouble::
+	setvar VAR_0x8004, 1
+	goto Han_Battle_Ask2
+
+Han_Battle_Text_Double:
+	.string "A double battle?\n"
+	.string "(Ëh’ë: double, Ënä: single)$"
+
+Han_Battle_Text_Ask:
+	.string "Yä̀ä łëtr’ubàa nindhän?$" @ Jane's line, Hän build
+
+Han_Battle_Text_Offered:
+	.string "Yä̀ä łëtr’ubàa nindhän?$"
+
+Han_Battle_Text_CannotFight:
+	.string "You need a POKéMON that can fight.$"
+
+Han_Battle_Text_Refused:
+	.string "The other player does not want\n"
+	.string "to battle.$"
+
+Han_Trade_Text_Ask:
+	.string "Do you want to trade POKéMON with\n"
+	.string "this player?$"
+
+Han_Trade_Text_Waiting:
+	.string "Waiting for the other player…$"
+
+Han_Trade_Text_ConfirmA:
+	.string "Trade your {STR_VAR_2} for their\n"
+	.string "{STR_VAR_1}?$"
+
+Han_Trade_Text_Offered:
+	.string "Another player offers a {STR_VAR_1}.\n"
+	.string "Trade with them?$"
+
+Han_Trade_Text_Done:
+	.string "The trade is done!$"
+
+Han_Trade_Text_CannotSend:
+	.string "That POKéMON cannot be traded.\n"
+	.string "You need another one that can fight.$"
+
+Han_Trade_Text_Refused:
+	.string "The other player does not want\n"
+	.string "to trade.$"
+
+Han_Trade_Text_TimedOut:
+	.string "There was ënä answer.$"
