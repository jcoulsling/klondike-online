+}
+
+// Hän build: two moves that a trainer's POKéMON does not choose the way it chooses the others.
+//   The UNOWN's move: used 55 times in 100.
+//   The ODDISH's move: used 75 times in 100 until it has been used once, and never after that.
+// And one more rule for a POKéMON that knows the ODDISH's move: it uses SOLAR BEAM whenever the sun is
+// out and its SP. ATK is raised. See WantsSolarBeam.
+// aiChoice is the slot the AI chose. Returns the slot to use.
+#define UNOWN_MOVE_CHANCE 55
+#define ODDISH_MOVE_CHANCE 75
+
+static u8 FindUsableMoveSlot(u8 battler, u16 move, u8 unusable)
+{
+    u8 i;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (gBattleMons[battler].moves[i] == move && !(unusable & gBitTable[i]))
+            return i;
+    }
+    return MAX_MON_MOVES;
+}
+
+// The AI's choice if it is another move. If not, the other move the AI scored highest, a tie settled at random.
+static u8 BestMoveOtherThan(u8 battler, u8 slot, u8 aiChoice, u8 unusable)
+{
+    u8 best[MAX_MON_MOVES];
+    u8 count = 0, i;
+    s8 bestScore = -1;
+
+    if (aiChoice != slot)
+        return aiChoice;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        s8 score = gBattleResources->ai->score[i];
+
+        if (i == slot || gBattleMons[battler].moves[i] == MOVE_NONE || unusable & gBitTable[i])
+            continue;
+        if (score > bestScore)
+        {
+            bestScore = score;
+            count = 0;
+        }
+        if (score == bestScore)
+            best[count++] = i;
+    }
+    if (count == 0)
+        return slot; // it has nothing else it can use
+    return best[Random() % count];
+}
+
+// The slot of SOLAR BEAM if the sun is out, the user's SP. ATK is above normal, and the move can do
+// something to the foe in front of it. MAX_MON_MOVES if not.
+// The ODDISH's own move raises its SP. ATK two steps, and it is used once, so this is how high it gets.
+static u8 WantsSolarBeam(u8 battler, u8 unusable)
+{
+    u8 slot, foe;
+
+    if (!(gBattleWeather & B_WEATHER_SUN) || !WEATHER_HAS_EFFECT)
+        return MAX_MON_MOVES;
+    if (gBattleMons[battler].statStages[STAT_SPATK] <= DEFAULT_STAT_STAGE)
+        return MAX_MON_MOVES;
+    slot = FindUsableMoveSlot(battler, MOVE_SOLAR_BEAM, unusable);
+    if (slot == MAX_MON_MOVES)
+        return MAX_MON_MOVES;
+    foe = GetBattlerAtPosition(BATTLE_OPPOSITE(GetBattlerPosition(battler)));
+    if (!(gAbsentBattlerFlags & gBitTable[foe])
+     && AI_TypeCalc(MOVE_SOLAR_BEAM, gBattleMons[foe].species, gBattleMons[foe].ability) & MOVE_RESULT_DOESNT_AFFECT_FOE)
+        return MAX_MON_MOVES; // a foe it cannot hurt, such as one with WONDER GUARD
+    return slot;
+}
+
+u8 HanAI_ChooseOwnMove(u8 battler, u8 aiChoice)
+{
+    u8 unusable, slot;
+
+    if (aiChoice >= MAX_MON_MOVES || GetBattlerSide(battler) != B_SIDE_OPPONENT)
+        return aiChoice;
+    unusable = CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL); // no PP left, and the like
+
+    slot = FindUsableMoveSlot(battler, MOVE_UNOWN_STRIKES, unusable);
+    if (slot != MAX_MON_MOVES)
+    {
+        if (Random() % 100 < UNOWN_MOVE_CHANCE)
+            return slot;
+        return BestMoveOtherThan(battler, slot, aiChoice, unusable);
+    }
+
+    if (FindUsableMoveSlot(battler, MOVE_ODDISH_SMOKE, 0) != MAX_MON_MOVES) // it knows the ODDISH's move
+    {
+        slot = WantsSolarBeam(battler, unusable);
+        if (slot != MAX_MON_MOVES)
+            return slot;
+    }
+
+    slot = FindUsableMoveSlot(battler, MOVE_ODDISH_SMOKE, unusable);
+    if (slot != MAX_MON_MOVES)
+    {
+        if (gBattleMons[battler].pp[slot] >= gBattleMoves[MOVE_ODDISH_SMOKE].pp // full PP: it has not used the move yet
+         && Random() % 100 < ODDISH_MOVE_CHANCE)
+            return slot;
+        return BestMoveOtherThan(battler, slot, aiChoice, unusable);
+    }
+    return aiChoice;
+}
