+// ---------------------------------------------------------------------------
+// Hän build: a fourth starter for some player names.
+//
+// If the player's name is on this list, a fourth ball lies beside the table in
+// PROF. OAK's lab. Capitals and small letters count as the same, so JEM, Jem
+// and jem all match. A name can be 7 letters at most, so ALLITSUL is matched by
+// its first 7.
+//
+// The names are spelled out letter by letter on purpose: text written as _("...")
+// is picked up by the translation tool, and these must never be translated.
+// ---------------------------------------------------------------------------
+struct NameStarter
+{
+    const u8 *name;         // in capitals
+    u16 species;
+    u16 moves[2];           // more moves it starts with, or MOVE_NONE
+    u16 item;               // what it holds, or ITEM_NONE
+    u8 rivalChoice;         // the rival then takes: 0 CHARMANDER, 1 BULBASAUR, 2 SQUIRTLE
+    bool8 gift;             // shiny, female, the best hidden numbers, and marked: see NameStarter_HasBonus
+};
+
+// The mark is one of the four ribbon bits the game never uses. Bit 0 is the
+// Nuzlocke "dead" mark. A marked Pokémon has 50 more in every stat (see
+// CalculateMonStats) and its THUNDER never misses (see AccuracyCalcHelper).
+// The mark stays with it in the PC and when it evolves.
+#define NAME_STARTER_BONUS_MARK 2
+
