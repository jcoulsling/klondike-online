+    {sName_Erika,   SPECIES_ODDISH,   {MOVE_BULLET_SEED, MOVE_NONE}, ITEM_NONE,       0, FALSE},
+    {sName_Allison, SPECIES_POLIWAG,  {MOVE_ICY_WIND,    MOVE_NONE}, ITEM_NONE,       1, FALSE},
+    {sName_Allitsu, SPECIES_POLIWAG,  {MOVE_ICY_WIND,    MOVE_NONE}, ITEM_NONE,       1, FALSE},
