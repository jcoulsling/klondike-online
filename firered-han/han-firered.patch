+// TRUE, once, when a proper name starts at s: the asterisk is drawn now and the printer comes back to s.
+static bool8 HanSyl_NameStartsAt(const u8 *s)
+{
+    u32 length;
+
+    if (s == sHanSylNamePending)
+    {
+        sHanSylNamePending = NULL;
+        return FALSE;
+    }
+    if (s == sHanSylWordEnd || (s > sHanSylNameBegin && s < sHanSylNameEnd) || !HanSyl_IsLetter(*s))
+        return FALSE;
+    length = HanSyl_NameLength(s);
+    if (length == 0)
+        return FALSE;
+    sHanSylNamePending = s;
+    sHanSylNameBegin = s;
+    sHanSylNameEnd = s + length;
+    return TRUE;
+}
