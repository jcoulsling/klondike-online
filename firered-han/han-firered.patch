diff --git a/include/han_multiplayer.h b/include/han_multiplayer.h
new file mode 100644
index 0000000..887fe06
--- /dev/null
+++ b/include/han_multiplayer.h
@@ -0,0 +1,93 @@
+#ifndef GUARD_HAN_MULTIPLAYER_H
+#define GUARD_HAN_MULTIPLAYER_H
+
+#include "link.h"
+
+#define HAN_OTHERS 4
+
+struct HanPlayerState
+{
+    u8 active;
+    u8 mapGroup;
+    u8 mapNum;
+    u8 facing;     // DIR_SOUTH 1, DIR_NORTH 2, DIR_WEST 3, DIR_EAST 4
+    s16 x;         // tile, as gSaveBlock1Ptr->pos
+    s16 y;
+    u8 gfx;        // an OBJ_EVENT_GFX_ number
+    u8 walking;
+    u8 pic;        // the player's PICTURE (0 the game's own) and PALETTE, so that others can be drawn the same
+    u8 pal;
+    u16 follow;    // the follower's species, bit 15 set if shiny; 0 for none
+    u8 pad[2];
+};
+
+// A trade message: kind HAN_T_*, the other player's slot, and the Pokémon (a BoxPokemon, 80 bytes). seq goes up by one
+// for each new message; the page sends a message when out.seq changed, and writes in and goes up in.seq.
+#define HAN_T_OFFER   1   // A to B: I offer this
+#define HAN_T_COUNTER 2   // B to A: then I offer this
+#define HAN_T_ACCEPT  3   // A to B: done, swap
+#define HAN_T_CANCEL  4   // either: no
+#define HAN_T_CHALLENGE 5 // A to B: a battle? mon holds A's struct LinkPlayer
+#define HAN_T_BATTLE_OK 6 // B to A: yes, mon holds B's struct LinkPlayer
+#define HAN_T_BATTLE_NO 7 // B to A: no
+struct HanTradeBox
+{
+    u8 seq;
+    u8 kind;
+    u8 slot;       // out: the slot of the player it goes to; in: the slot it came from
+    u8 pad;
+    u8 mon[80];
+};
+
+// Battling: the game's own link-battle code runs, with the cable replaced by this (src/han_link.c). The page moves the
+// blocks of gBlockSendBuffer / gBlockRecvBuffer between the two games. Every field is written by one side only.
+struct HanLinkCtl
+{
+    u8 on;        // game: 1 while a link battle is on
+    u8 myId;      // game: 0 for the player who challenged, 1 for the other
+    u8 peer;      // game: the other player's slot (the page sends to it)
+    u8 txSeq;     // game: goes up for each new block in gBlockSendBuffer
+    u8 txAck;     // page: txSeq it has taken
+    u8 rxSeq;     // page: goes up for each block it wrote to recvAddr
+    u8 rxSeen;    // game: rxSeq already looked at
+    u8 rxFull;    // game: 1 while a received block is still waiting to be used (the page waits)
+    u8 syncOut;   // game: how many times this game stood by (LinkStandby)
+    u8 syncIn;    // page: the other game's syncOut
+    u8 closeOut;  // game: 1 when ready to close
+    u8 closeIn;   // page: the other game's closeOut
+    u16 txSize;   // game
+    u8 gone;      // page: 1 when the other player has left (the battle is ended)
+    u8 pad;
+    u32 sendAddr; // game: address of gBlockSendBuffer (the page reads txSize bytes)
+    u32 recvAddr; // game: address where the page writes the other player's block
+    u32 mailAddr; // game: address of the mailbox itself, so that the page can turn the two addresses above into its own
+};
+
+// Found by the web page by its marker. 268 + 28 = 296 bytes.
+struct HanMailbox
+{
+    char magic[8];
+    u32 frame;
+    struct HanPlayerState mine;
+    struct HanPlayerState others[HAN_OTHERS];
+    u8 spriteIds[HAN_OTHERS];
+    u8 followIds[HAN_OTHERS];  // the sprites of their followers
+    struct HanTradeBox out;    // what this game sends (the page passes it to the player in outTo)
+    struct HanTradeBox in;     // what came from the player in slot inFrom
+    struct HanLinkCtl link;
+};
+
+extern struct HanMailbox gHanMailbox;
+
+void HanMultiplayerFrame(void);
+bool8 HanPlayerAt(s16 x, s16 y); // another player is on this tile (the player cannot walk onto it)
+void HanTradeFrame(void);
+void HanLinkFrame(void);    // src/han_link.c, every frame
+void HanLinkStart(u8 myId, u8 peer, const struct LinkPlayer *me, const struct LinkPlayer *other);
+bool8 HanLinkSend(const void *src, u16 size);
+bool8 HanLinkSendDone(void);
+void HanLinkStandby(void);
+void HanLinkCloseReady(void);
+void HanLinkAbortBattle(void); // src/battle_main.c: the other player is gone, end the battle as a draw // src/han_trade.c, every overworld frame
+
+#endif // GUARD_HAN_MULTIPLAYER_H
