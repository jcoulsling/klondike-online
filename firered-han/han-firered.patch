+C_LITERAL = re.compile(r'(?<![A-Za-z0-9_])_\(\s*((?:"(?:[^"\\]|\\.)*"\s*)+)\)')
+C_STRING = re.compile(r'"((?:[^"\\]|\\.)*)"')
+C_ARRAY = re.compile(r"\b([A-Za-z_]\w*)\s*\[[^\]]*\]\s*\[([^\]]+)\]\s*=\s*\{")
+C_NAME = re.compile(r"(?:\.([A-Za-z_]\w*)|\[([A-Za-z_]\w*)\]|\b([A-Za-z_]\w*)\s*(?:\[[^\]]*\]\s*)*)\s*=\s*$")
