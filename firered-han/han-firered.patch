diff --git a/tools/preproc/utf8.cpp b/tools/preproc/utf8.cpp
index 7facfd4..37599c4 100644
--- a/tools/preproc/utf8.cpp
+++ b/tools/preproc/utf8.cpp
@@ -90,3 +90,75 @@ UnicodeChar DecodeUtf8(const char* s)
 
     return unicodeChar;
 }
+
+enum
+{
+    MARK_GRAVE = 1,
+    MARK_DIAERESIS = 2,
+    MARK_OGONEK = 4,
+};
+
+struct PrecomposedLetter
+{
+    std::int32_t code;
+    char base;
+    unsigned marks;
+};
+
+static const PrecomposedLetter sPrecomposedLetters[] =
+{
+    { 0xE0, 'a', MARK_GRAVE }, { 0xE8, 'e', MARK_GRAVE }, { 0xEC, 'i', MARK_GRAVE }, { 0xF2, 'o', MARK_GRAVE }, { 0xF9, 'u', MARK_GRAVE },
+    { 0xC0, 'A', MARK_GRAVE }, { 0xC8, 'E', MARK_GRAVE }, { 0xCC, 'I', MARK_GRAVE }, { 0xD2, 'O', MARK_GRAVE }, { 0xD9, 'U', MARK_GRAVE },
+    { 0xE4, 'a', MARK_DIAERESIS }, { 0xEB, 'e', MARK_DIAERESIS }, { 0xEF, 'i', MARK_DIAERESIS }, { 0xF6, 'o', MARK_DIAERESIS }, { 0xFC, 'u', MARK_DIAERESIS },
+    { 0xC4, 'A', MARK_DIAERESIS }, { 0xCB, 'E', MARK_DIAERESIS }, { 0xCF, 'I', MARK_DIAERESIS }, { 0xD6, 'O', MARK_DIAERESIS }, { 0xDC, 'U', MARK_DIAERESIS },
+    { 0x105, 'a', MARK_OGONEK }, { 0x119, 'e', MARK_OGONEK }, { 0x12F, 'i', MARK_OGONEK }, { 0x1EB, 'o', MARK_OGONEK }, { 0x173, 'u', MARK_OGONEK },
+    { 0x104, 'A', MARK_OGONEK }, { 0x118, 'E', MARK_OGONEK }, { 0x12E, 'I', MARK_OGONEK }, { 0x1EA, 'O', MARK_OGONEK }, { 0x172, 'U', MARK_OGONEK },
+    { 0x1F9, 'n', MARK_GRAVE }, { 0x1F8, 'N', MARK_GRAVE },
+};
+
+UnicodeChar DecodeUtf8WithMarks(const char* s)
+{
+    UnicodeChar first = DecodeUtf8(s);
+
+    if (first.code == -1)
+        return first;
+
+    std::int32_t base = first.code;
+    unsigned marks = 0;
+
+    for (const PrecomposedLetter& letter : sPrecomposedLetters)
+    {
+        if (letter.code == first.code)
+        {
+            base = letter.base;
+            marks = letter.marks;
+            break;
+        }
+    }
+
+    int length = first.encodingLength;
+
+    for (;;)
+    {
+        UnicodeChar next = DecodeUtf8(s + length);
+        unsigned mark = 0;
+
+        if (next.code == 0x300)
+            mark = MARK_GRAVE;
+        else if (next.code == 0x308)
+            mark = MARK_DIAERESIS;
+        else if (next.code == 0x328)
+            mark = MARK_OGONEK;
+
+        if (mark == 0)
+            break;
+
+        marks |= mark;
+        length += next.encodingLength;
+    }
+
+    UnicodeChar result;
+    result.encodingLength = length;
+    result.code = (marks != 0) ? (kMarkedLetterFlag | (marks << 16) | (base & 0xFFFF)) : first.code;
+    return result;
+}
