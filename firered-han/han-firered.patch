+// ---------------------------------------------------------------------------
+// Hän build: in syllabics an English word is spelled by its sound
+// ---------------------------------------------------------------------------
+// The table of words is made when the game is built. How a word is found in it is in han_english_core.h.
+
+#include "data/han_english_sounds.h"
+#include "han_english_core.h"
+
+// A syllable with marks is one picture: the marks sit on top of it, in the same cell.
+static void DecompressGlyph_HanSyllabics(u16 glyph, u8 marks)
+{
+    const u16 *glyphs = sFontHanSyllabicsGlyphs + (0x20 * HAN_SYL_CELL(glyph, marks));
+
+    DecompressGlyphTile(glyphs, (u16 *)gGlyphInfo.pixels);
+    DecompressGlyphTile(glyphs + 0x8, (u16 *)(gGlyphInfo.pixels + 0x20));
+    DecompressGlyphTile(glyphs + 0x10, (u16 *)(gGlyphInfo.pixels + 0x40));
+    DecompressGlyphTile(glyphs + 0x18, (u16 *)(gGlyphInfo.pixels + 0x60));
+    gGlyphInfo.width = sHanSylGlyphWidths[glyph];
+    gGlyphInfo.height = HAN_SYL_GLYPH_HEIGHT;
+}
+
+// Draws the piece of text that starts at the character RenderText has just read, as syllabics.
+// FALSE: it is not a letter that turns into syllabics, and RenderText draws it the usual way.
+// The asterisk of a proper name is drawn on a visit of its own: the printer then comes back
+// to the same character. So is each glyph of an English word.
+static bool8 RenderHanSyllabics(struct TextPrinter *textPrinter, u16 *result)
+{
+    const u8 *start = textPrinter->printerTemplate.currentChar - 1;
+    struct HanEngWord word;
+    u16 glyph;
+    u8 used, marks;
+    s32 width;
+
+    if (start != sHanEngStart && HanSyl_NameStartsAt(start))
+    {
+        DecompressGlyph_HanSyllabics(HAN_SYL_ASTERISK, 0);
+        textPrinter->printerTemplate.currentChar = start;
+    }
+    else if ((start == sHanEngStart || start != sHanSylWordEnd) && HanEng_Find(start, &word))
+    {
+        // An English word: one of its glyphs on each visit. The printer stays on the word's
+        // first letter until the last one is drawn.
+        if (start != sHanEngStart || sHanEngIndex >= word.total)
+        {
+            sHanEngStart = start;
+            sHanEngIndex = 0;
+        }
+        glyph = HanEng_Glyph(&word, sHanEngIndex++);
+        DecompressGlyph_HanSyllabics(glyph & HAN_ENG_GLYPH_MASK, glyph >> HAN_ENG_GLYPH_BITS);
+        if (sHanEngIndex >= word.total)
+        {
+            sHanEngStart = NULL;
+            sHanSylWordEnd = start + word.length;
+            textPrinter->printerTemplate.currentChar = start + word.length;
+        }
+        else
+        {
+            textPrinter->printerTemplate.currentChar = start;
+        }
+    }
+    else
+    {
+        switch (HanSyl_Next(start, &glyph, &used, &marks))
+        {
+        case HAN_SYL_NONE:
+            if (HanSyl_IsLetter(*start))
+                sHanSylWordEnd = start + 1;
+            return FALSE;
+        case HAN_SYL_SKIP:
+            sHanSylWordEnd = start + used;
+            textPrinter->printerTemplate.currentChar = start + used;
+            *result = RENDER_REPEAT;
+            return TRUE;
+        }
+        sHanSylWordEnd = start + used;
+        DecompressGlyph_HanSyllabics(glyph, glyph < HAN_SYL_FINALS_BASE ? marks : 0);
+        textPrinter->printerTemplate.currentChar = start + used;
+    }
+
+    CopyGlyphToWindow(textPrinter);
+    textPrinter->printerTemplate.currentX += gGlyphInfo.width;
+    if (textPrinter->minLetterSpacing)
+    {
+        width = textPrinter->minLetterSpacing - gGlyphInfo.width;
+        if (width > 0)
+        {
+            ClearTextSpan(textPrinter, width);
+            textPrinter->printerTemplate.currentX += width;
+        }
+    }
+    *result = RENDER_PRINT;
+    return TRUE;
+}
+
+// The width of the syllabics piece at *str. Leaves *str on its last character.
+// FALSE: it is not a letter that turns into syllabics, and the caller measures it the usual way.
+// Either way *width holds what this function has counted: with FALSE that is the asterisk
+// of a proper name that starts here, or nothing. Marks add no width.
+static bool8 HanSyllabicsWidth(const u8 **str, int *width, struct HanSylWalk *walk)
+{
+    const u8 *s = *str;
+    struct HanEngWord word;
+    u16 glyph;
+    u8 used, marks;
+    u8 type;
+    u32 i;
+
+    *width = 0;
+    if (s != walk->wordEnd && !(s < walk->nameEnd) && HanSyl_IsLetter(*s))
+    {
+        u32 length = HanSyl_NameLength(s);
+
+        if (length != 0)
+        {
+            *width = sHanSylGlyphWidths[HAN_SYL_ASTERISK];
+            walk->nameEnd = s + length;
+        }
+    }
+    if (s != walk->wordEnd && HanEng_Find(s, &word))
+    {
+        for (i = 0; i < word.total; i++)
+            *width += sHanSylGlyphWidths[HanEng_Glyph(&word, i) & HAN_ENG_GLYPH_MASK];
+        walk->wordEnd = s + word.length;
+        *str += word.length - 1;
+        return TRUE;
+    }
+    type = HanSyl_Next(s, &glyph, &used, &marks);
+    if (type == HAN_SYL_NONE)
+    {
+        if (HanSyl_IsLetter(*s))
+            walk->wordEnd = s + 1;
+        return FALSE;
+    }
+    walk->wordEnd = s + used;
+    *str += used - 1;
+    if (type == HAN_SYL_GLYPH)
+        *width += sHanSylGlyphWidths[glyph];
+    return TRUE;
+}
