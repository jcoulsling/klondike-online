+
+static bool8 IsPlayerAt(s16 tx, s16 ty)
+{
+    s16 px, py;
+
+    PlayerGetDestCoords(&px, &py);
+    return px - MAP_OFFSET == tx && py - MAP_OFFSET == ty;
+}
+
+// the land the player can walk to from where they stand (so a Pokémon is never shut in behind a fence, trees or water)
+static u8 sReach[MAP_H * MAP_W / 8];
+static u8 sReachDone;
+
+static bool8 ReachGet(s16 tx, s16 ty)
+{
+    u16 i = ty * MAP_W + tx;
+
+    return (sReach[i >> 3] >> (i & 7)) & 1;
+}
+
+static void ReachSet(s16 tx, s16 ty)
+{
+    u16 i = ty * MAP_W + tx;
+
+    sReach[i >> 3] |= 1 << (i & 7);
+}
+
+static bool8 ReachWalkable(s16 tx, s16 ty)
+{
+    if (tx < 0 || ty < 0 || tx >= MAP_W || ty >= MAP_H)
+        return FALSE;
+    if (MapGridGetCollisionAt(tx + MAP_OFFSET, ty + MAP_OFFSET) != 0)
+        return FALSE;
+    return !MetatileBehavior_IsSurfableAndNotWaterfall(MapGridGetMetatileBehaviorAt(tx + MAP_OFFSET, ty + MAP_OFFSET));
+}
+
+static u8 sWalk[MAP_H * MAP_W / 8];
+
+static bool8 WalkGet(s16 tx, s16 ty)
+{
+    u16 i = ty * MAP_W + tx;
+
+    return (sWalk[i >> 3] >> (i & 7)) & 1;
+}
+
+static bool8 ReachNear(s16 x, s16 y)
+{
+    return (x > 0 && ReachGet(x - 1, y)) || (x < MAP_W - 1 && ReachGet(x + 1, y)) || (y > 0 && ReachGet(x, y - 1)) || (y < MAP_H - 1 && ReachGet(x, y + 1));
+}
+
+static void ComputeReach(void)
+{
+    s16 px, py, x, y;
+    u8 changed, rounds = 0;
+
+    memset(sReach, 0, sizeof(sReach));
+    memset(sWalk, 0, sizeof(sWalk));
+    for (y = 0; y < MAP_H; y++)
+        for (x = 0; x < MAP_W; x++)
+            if (ReachWalkable(x, y))
+                sWalk[(y * MAP_W + x) >> 3] |= 1 << ((y * MAP_W + x) & 7);
+    PlayerGetDestCoords(&px, &py);
+    px -= MAP_OFFSET;
+    py -= MAP_OFFSET;
+    if (px < 0 || py < 0 || px >= MAP_W || py >= MAP_H || !WalkGet(px, py))
+    {
+        px = 5; // surfing: the dock
+        py = 54;
+    }
+    ReachSet(px, py);
+    do
+    {
+        changed = FALSE;
+        for (y = 0; y < MAP_H; y++)
+            for (x = 0; x < MAP_W; x++)
+                if (WalkGet(x, y) && !ReachGet(x, y) && ReachNear(x, y))
+                {
+                    ReachSet(x, y);
+                    changed = TRUE;
+                }
+        for (y = MAP_H - 1; y >= 0; y--)
+            for (x = MAP_W - 1; x >= 0; x--)
+                if (WalkGet(x, y) && !ReachGet(x, y) && ReachNear(x, y))
+                {
+                    ReachSet(x, y);
+                    changed = TRUE;
+                }
+    } while (changed && ++rounds < 60);
+    sReachDone = TRUE;
+}
+
+// land: the snowfield, not ice, not water
+static bool8 TileFree(s16 tx, s16 ty)
+{
+    u8 b;
+
+    if (tx < LAND_L + 2 || ty < LAND_T || tx >= LAND_R - 1 || ty >= LAND_B - 1)
+        return FALSE;
+    if (MapGridGetCollisionAt(tx + MAP_OFFSET, ty + MAP_OFFSET) != 0)
+        return FALSE;
+    b = MapGridGetMetatileBehaviorAt(tx + MAP_OFFSET, ty + MAP_OFFSET);
+    if (b == MB_ICE || MetatileBehavior_IsSurfableAndNotWaterfall(b))
+        return FALSE;
+    if (sReachDone && !ReachGet(tx, ty))
+        return FALSE;
+    return !IsPlayerAt(tx, ty);
+}
+
+// water: the sea south of the island
+static bool8 WaterFree(s16 tx, s16 ty)
+{
+    if (tx < 1 || tx > 30 || ty < WATER_T || ty > WATER_B)
+        return FALSE;
+    if (!MetatileBehavior_IsSurfableAndNotWaterfall(MapGridGetMetatileBehaviorAt(tx + MAP_OFFSET, ty + MAP_OFFSET)))
+        return FALSE;
+    return !IsPlayerAt(tx, ty);
+}
+
+// the sea floor: anywhere that can be walked
+static bool8 UnderFree(s16 tx, s16 ty)
+{
+    if (tx < 1 || tx > 30 || ty < 1 || ty > 46)
+        return FALSE;
+    if (MapGridGetCollisionAt(tx + MAP_OFFSET, ty + MAP_OFFSET) != 0)
+        return FALSE;
+    return !IsPlayerAt(tx, ty);
+}
+
+static bool8 FreeFor(u16 sp, s16 tx, s16 ty)
+{
+    if (InUnder())
+        return UnderFree(tx, ty);
+    return IsWaterOnly(sp) ? WaterFree(tx, ty) : TileFree(tx, ty);
+}
+
+static void Place(struct Sprite *s)
+{
+    s16 wx = s->data[0], wy = s->data[1];
+
+    SetSpritePosToMapCoords((wx >> 4) + MAP_OFFSET, (wy >> 4) + MAP_OFFSET, &s->x, &s->y);
+    s->x += (wx & 15) + 8;
+    s->y += (wy & 15) + 16 + s->centerToCornerVecY;
+    // the screen's sprite coordinates wrap around at 256, so a Pokémon far away would show up on the other side of the screen
+    s->invisible = (s->x < -48 || s->x > 288 || s->y < -48 || s->y > 208);
+}
+
+static void SpriteCB_Roamer(struct Sprite *s)
+{
+    struct Sprite *player = &gSprites[gPlayerAvatar.spriteId];
+    u8 dir = s->data[3];
+
+    if (s->data[6] > 0)
+    {
+        s->data[6]--; // in half pixels: one pixel every second frame
+        if ((s->data[6] & 1) == 0)
+        {
+            switch (dir)
+            {
+            case DIR_SOUTH: s->data[1]++; break;
+            case DIR_NORTH: s->data[1]--; break;
+            case DIR_WEST: s->data[0]--; break;
+            default: s->data[0]++; break;
+            }
+        }
+        StartSpriteAnimIfDifferent(s, GetMoveDirectionAnimNum(dir));
+    }
+    else
+    {
+        StartSpriteAnimIfDifferent(s, GetFaceDirectionAnimNum(dir));
+        if (s->data[4] > 0)
+        {
+            s->data[4]--;
+        }
+        else
+        {
+            s16 tx = s->data[0] >> 4, ty = s->data[1] >> 4;
+
+            dir = 1 + (Random() & 3);
+            s->data[3] = dir;
+            s->data[4] = 40 + (Random() & 63);
+            switch (dir)
+            {
+            case DIR_SOUTH: ty++; break;
+            case DIR_NORTH: ty--; break;
+            case DIR_WEST: tx--; break;
+            default: tx++; break;
+            }
+            if (FreeFor(s->data[2], tx, ty))
+                s->data[6] = 32;
+        }
+    }
+    Place(s);
+    s->oam.priority = player->oam.priority;
+    s->subpriority = (s->y < player->y + player->y2) ? player->subpriority + 1 : (player->subpriority > 0 ? player->subpriority - 1 : 0);
+}
+
+static void SpriteCB_Static(struct Sprite *s)
+{
+    struct Sprite *player = &gSprites[gPlayerAvatar.spriteId];
+
+    Place(s);
+    s->oam.priority = player->oam.priority;
+    s->subpriority = (s->y < player->y + player->y2) ? player->subpriority + 1 : (player->subpriority > 0 ? player->subpriority - 1 : 0);
+}
+
+extern const struct Evolution gEvolutionTable[][EVOS_PER_MON];
+
+static s32 Bst(u16 species)
+{
+    const struct SpeciesInfo *b = &gSpeciesInfo[species];
+
+    return b->baseHP + b->baseAttack + b->baseDefense + b->baseSpeed + b->baseSpAttack + b->baseSpDefense;
+}
+
+static bool8 InParty(u16 species)
+{
+    u8 i;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) == species && species != SPECIES_NONE)
+            return TRUE;
+    return FALSE;
+}
+
+// Rarity: the higher a species' base stat total, the smaller its weight, but never below 1.
+// weight = ((720 - BST) / 10)^2, at least 1 (BST 200 -> 2704, BST 300 -> 1764, BST 500 -> 484, BST 600 -> 144, BST 680 -> 16).
+// Then, for this player: a species in the party is four times as likely, one caught before (and not in the party) half as likely.
+static u32 WeightOf(u16 species)
+{
+    s32 bst = Bst(species);
+    s32 t = (720 - bst) / 10;
+    u32 w;
+
+    if (t < 1)
+        t = 1;
+    w = t * t;
+    // a final stage (nothing to evolve into) with a total under 350 is 5% rarer still
+    if (bst < 350 && gEvolutionTable[species][0].method == 0)
+        w = w * 95 / 100;
+    if (w < 1)
+        w = 1;
+    if (InParty(species))
+        w *= 4;
+    else if (GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_GET_CAUGHT))
+        w = w / 2 < 1 ? 1 : w / 2;
+    return w;
+}
+
+#define POOL_SIZE (ARRAY_COUNT(sPool) + ARRAY_COUNT(sLegend) + ARRAY_COUNT(sFish))
+
+static u16 PoolAt(u32 i)
+{
+    if (i < ARRAY_COUNT(sPool))
+        return sPool[i];
+    i -= ARRAY_COUNT(sPool);
+    if (i < ARRAY_COUNT(sLegend))
+        return sLegend[i];
+    return sFish[i - ARRAY_COUNT(sLegend)];
+}
+
+static u16 PickSpecies(bool8 noLegend)
+{
+    u32 total = 0, roll, i;
+
+    for (i = 0; i < POOL_SIZE; i++)
+        if (!(noLegend && IsLegend(PoolAt(i))))
+            total += WeightOf(PoolAt(i));
+    roll = Random32() % total;
+    for (i = 0; i < POOL_SIZE; i++)
+    {
+        u16 sp = PoolAt(i);
+        u32 w;
+
+        if (noLegend && IsLegend(sp))
+            continue;
+        w = WeightOf(sp);
+        if (roll < w)
+            return sp;
+        roll -= w;
+    }
+    return SPECIES_MAGIKARP;
+}
+
+// the building: any Pokémon with a total of 350 or more (and a picture), on the same scale
+static bool8 StaticOk(u16 sp)
+{
+    return sp != SPECIES_NONE && sp != SPECIES_EGG && HanWildHasSprite(sp) && Bst(sp) >= 350;
+}
+
+static u16 PickStatic(void)
+{
+    u32 total = 0, roll;
+    u16 i;
+
+    for (i = 1; i < NUM_SPECIES; i++)
+        if (StaticOk(i))
+            total += WeightOf(i);
+    roll = Random32() % total;
+    for (i = 1; i < NUM_SPECIES; i++)
+    {
+        u32 w;
+
+        if (!StaticOk(i))
+            continue;
+        w = WeightOf(i);
+        if (roll < w)
+            return i;
+        roll -= w;
+    }
+    return SPECIES_MEW;
+}
+
+static bool8 HasCharm(void)
+{
+    return CheckBagHasItem(ITEM_SHINY_CHARM, 1);
+}
+
+// Shiny in the Wild Area: one in 8192, or one in five with the charm
+static bool8 ShinyRoll(void)
+{
+    return Random() % (HasCharm() ? 5 : 8192) == 0;
+}
+
+// The same Pokémon, shiny or not (a Pokémon's colours are in its personality and the trainer ID, and the stored data depends on the personality,
+// so it is made again with another personality that keeps the nature and the low half, which sets gender and ability).
+void HanMonMakeShiny(struct Pokemon *mon, bool8 shiny)
+{
+    u32 pers, otId, np = 0, cand;
+    u16 species, lo, base;
+    u8 level, k, start, nature;
+    bool8 found = FALSE;
+
+    if ((IsMonShiny(mon) != FALSE) == (shiny != FALSE))
+        return;
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    level = GetMonData(mon, MON_DATA_LEVEL);
+    pers = GetMonData(mon, MON_DATA_PERSONALITY);
+    otId = GetMonData(mon, MON_DATA_OT_ID);
+    nature = pers % NUM_NATURES;
+    lo = pers & 0xFFFF;
+    base = HIHALF(otId) ^ LOHALF(otId) ^ lo;
+    if (shiny)
+    {
+        start = Random() & 7;
+        for (k = 0; k < 8; k++)
+        {
+            cand = ((u32)(base ^ ((start + k) & 7)) << 16) | lo;
+            if (!found)
+            {
+                np = cand;
+                found = TRUE;
+            }
+            if (cand % NUM_NATURES == nature)
+            {
+                np = cand;
+                break;
+            }
+        }
+    }
+    else
+    {
+        for (k = 0; k < 200; k++)
+        {
+            u16 hi = Random();
+
+            cand = ((u32)hi << 16) | lo;
+            if ((base ^ hi) >= 8 && (cand % NUM_NATURES == nature || k == 199))
+            {
+                np = cand;
+                break;
+            }
+        }
+    }
+    CreateMon(mon, species, level, USE_RANDOM_IVS, TRUE, np, OT_ID_PLAYER_ID, 0);
+}
+
+// any other wild Pokémon (grass, water, fishing, scripted): the charm makes one in five shiny
+void HanMonCharmRoll(struct Pokemon *mon)
+{
+    if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_UNOWN || !HasCharm())
+        return;
+    HanMonMakeShiny(mon, Random() % 5 == 0);
+}
+
+// the OLD MAN's team: as many Pokémon as the player has (3 to 6), at the level of the player's team on average, picked at random from the
+// Wild Area Pokémon whose total is nearest to the average total of the player's team
+u8 HanWildOldManParty(struct Pokemon *party)
+{
+    u16 nearest[12];
+    bool8 used[POOL_SIZE];
+    s32 sum = 0, lvlSum = 0, n = 0, target, size, count, i, j;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        u16 sp = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES_OR_EGG);
+
+        if (sp != SPECIES_NONE && sp != SPECIES_EGG)
+        {
+            sum += Bst(sp);
+            lvlSum += GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+            n++;
+        }
+    }
+    if (n == 0)
+        n = 1;
+    target = sum / n;
+    lvlSum = lvlSum / n;
+    if (lvlSum < 5)
+        lvlSum = 5;
+    size = gPlayerPartyCount < 3 ? 3 : (gPlayerPartyCount > 6 ? 6 : gPlayerPartyCount);
+    count = size * 2;
+    for (i = 0; i < POOL_SIZE; i++)
+        used[i] = FALSE;
+    for (j = 0; j < count; j++)
+    {
+        s32 best = -1, bestD = 0x7FFFFFFF;
+
+        for (i = 0; i < POOL_SIZE; i++)
+        {
+            s32 d = Bst(PoolAt(i)) - target;
+
+            if (d < 0)
+                d = -d;
+            if (!used[i] && d < bestD)
+            {
+                bestD = d;
+                best = i;
+            }
+        }
+        used[best] = TRUE;
+        nearest[j] = PoolAt(best);
+    }
+    ZeroEnemyPartyMons();
+    for (i = 0; i < size; i++)
+    {
+        u16 pick;
+
+        do
+            pick = Random() % count;
+        while (nearest[pick] == SPECIES_NONE);
+        CreateMon(&party[i], nearest[pick], lvlSum, 24, FALSE, 0, OT_ID_RANDOM_NO_SHINY, 0);
+        nearest[pick] = SPECIES_NONE;
+    }
+    return size;
+}
+
+// A new draw of the Pokémon on the island: kinds of three (a legendary or mythical one alone) until there are WILD_COUNT of them
+static void DrawRoster(void)
+{
+    struct HanWildSave *s = Save();
+    u16 kinds[WILD_COUNT];
+    u8 n = 0, nk = 0, i, j;
+
+    s->stamp = NowMinutes();
+    s->shiny = 0;
+    s->staticReady = 0;
+    for (i = 0; i < WILD_COUNT; i++)
+        s->species[i] = SPECIES_NONE;
+    while (n < WILD_COUNT)
+    {
+        u16 sp;
+        bool8 dup;
+        u8 cnt;
+
+        do
+        {
+            sp = PickSpecies(FALSE);
+            dup = FALSE;
+            for (j = 0; j < nk; j++)
+                if (kinds[j] == sp)
+                    dup = TRUE;
+        } while (dup);
+        kinds[nk++] = sp;
+        cnt = IsLegend(sp) ? 1 : PER_KIND;
+        if (cnt > WILD_COUNT - n)
+            cnt = WILD_COUNT - n;
+        for (j = 0; j < cnt; j++)
+        {
+            s->species[n] = sp;
+            if (ShinyRoll())
+                s->shiny |= 1 << n;
+            n++;
+        }
+    }
+}
+
+static void EnsureRoster(void)
+{
+    struct HanWildSave *s = Save();
+    u32 now = NowMinutes();
+
+    if (s->stamp == 0 || s->species[0] == SPECIES_NONE || now < s->stamp || now - s->stamp >= 60)
+        DrawRoster();
+}
+
+// a legendary or mythical Pokémon has been met: some other Pokémon takes its place
+static void ReplaceRoamer(u8 idx)
+{
+    struct HanWildSave *s = Save();
+
+    s->species[idx] = PickSpecies(TRUE);
+    s->shiny &= ~(1 << idx);
+    if (ShinyRoll())
+        s->shiny |= 1 << idx;
+}
+
+static void ApplyHoles(void)
+{
+    struct HanWildSave *s = Save();
+    u8 i;
+    bool8 any = FALSE;
+
+    for (i = 0; i < HOLES; i++)
+    {
+        if (s->holes[i][0] == 0 && s->holes[i][1] == 0)
+            continue;
+        MapGridSetMetatileIdAt(s->holes[i][0] + MAP_OFFSET, s->holes[i][1] + MAP_OFFSET, HOLE_ID);
+        any = TRUE;
+    }
+    if (any)
+        DrawWholeMapView();
+}
+
+static u8 MakeSprite(u16 sp, bool8 shiny, u8 kind, u8 *palIdx, u16 *loaded)
+{
+    u8 slot = kind * 2 + (shiny ? 1 : 0), id;
+    bool8 noBorrow = shiny || kind >= 2;
+
+    id = HanWildSpriteCreate(sp | (shiny ? 0x8000 : 0) | (noBorrow ? 0x4000 : 0), WILD_PAL + slot, &palIdx[slot], !(*loaded & (1 << slot)));
+    if (id != MAX_SPRITES)
+        *loaded |= 1 << slot;
+    return id;
+}
+
+static bool8 Spawn(void)
+{
+    struct HanWildSave *sv = Save();
+    u16 kindSp[WILD_COUNT], loaded = 0;
+    u8 palIdx[WILD_COUNT * 2];
+    u8 nk = 0, i, k, tries, top = 5, lvl;
+    s16 px, py;
+
+    // level: about that of the player's best Pokémon
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) > top)
+            top = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+
+    PlayerGetDestCoords(&px, &py);
+    px -= MAP_OFFSET;
+    py -= MAP_OFFSET;
+    for (i = 0; i < WILD_COUNT; i++)
+    {
+        u16 sp = sv->species[i];
+        bool8 shiny = (sv->shiny >> i) & 1, water;
+        u8 id;
+        s16 tx = 0, ty = 0;
+
+        if (sp == SPECIES_NONE)
+            continue;
+        water = IsWaterOnly(sp);
+        for (tries = 0; tries < 60; tries++)
+        {
+            if (water)
+            {
+                tx = 1 + Random() % 30;
+                ty = WATER_T + Random() % (WATER_B - WATER_T + 1);
+            }
+            else
+            {
+                tx = LAND_L + 3 + Random() % (LAND_R - LAND_L - 6);
+                ty = LAND_T + Random() % (LAND_B - LAND_T - 3);
+            }
+            if (FreeFor(sp, tx, ty) && (tx > px ? tx - px : px - tx) + (ty > py ? ty - py : py - ty) >= 7)
+                break;
+        }
+        if (tries == 60)
+            continue;
+        for (k = 0; k < nk; k++)
+            if (kindSp[k] == sp)
+                break;
+        if (k == nk)
+            kindSp[nk++] = sp;
+        lvl = top - 3 + Random() % 5;
+        if (lvl < 5)
+            lvl = 5;
+        if (lvl > 70)
+            lvl = 70;
+        id = MAX_SPRITES;
+        if (shiny)
+            id = MakeSprite(sp, TRUE, k, palIdx, &loaded);
+        if (id == MAX_SPRITES) // no shiny palette to spare: this one is drawn in the usual colours, and is not shiny
+        {
+            shiny = FALSE;
+            id = MakeSprite(sp, FALSE, k, palIdx, &loaded);
+        }
+        if (id == MAX_SPRITES)
+            continue;
+        gSprites[id].data[0] = tx * 16;
+        gSprites[id].data[1] = ty * 16;
+        gSprites[id].data[2] = sp;
+        gSprites[id].data[3] = 1 + (Random() & 3);
+        gSprites[id].data[4] = Random() & 63;
+        gSprites[id].data[5] = lvl | (shiny ? SHINY_BIT : 0) | (i << 9);
+        gSprites[id].data[6] = 0;
+        gSprites[id].data[7] = WILD_TAG;
+        gSprites[id].callback = SpriteCB_Roamer;
+        Place(&gSprites[id]);
+        if (sFirst == 0)
+            sFirst = id + 1;
+    }
+    ApplyHoles();
+    return sFirst != 0;
+}
+
+static const u16 sUnder[] = {
+    SPECIES_TENTACOOL, SPECIES_MAGIKARP, SPECIES_GOLDEEN, SPECIES_HORSEA, SPECIES_STARYU, SPECIES_SHELLDER,
+    SPECIES_REMORAID, SPECIES_QWILFISH, SPECIES_CORSOLA, SPECIES_WAILMER, SPECIES_LUVDISC, SPECIES_LAPRAS,
+};
+
+// the sea floor: a handful of the water Pokémon swim about, met by touching them
+static void SpawnUnder(void)
+{
+    u16 kindSp[WILD_COUNT], loaded = 0;
+    u8 palIdx[WILD_COUNT * 2];
+    u8 nk = 0, i, k, tries, top = 5, lvl, id;
+    s16 px, py;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) > top)
+            top = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+    PlayerGetDestCoords(&px, &py);
+    px -= MAP_OFFSET;
+    py -= MAP_OFFSET;
+    for (i = 0; i < 14; i++)
+    {
+        u16 sp = sUnder[Random() % ARRAY_COUNT(sUnder)];
+        s16 tx = 0, ty = 0;
+
+        for (tries = 0; tries < 60; tries++)
+        {
+            tx = 1 + Random() % 30;
+            ty = 1 + Random() % 46;
+            if (UnderFree(tx, ty) && (tx > px ? tx - px : px - tx) + (ty > py ? ty - py : py - ty) >= 5)
+                break;
+        }
+        if (tries == 60)
+            continue;
+        for (k = 0; k < nk; k++)
+            if (kindSp[k] == sp)
+                break;
+        if (k == nk)
+        {
+            if (nk >= WILD_COUNT)
+                continue;
+            kindSp[nk++] = sp;
+        }
+        lvl = top - 3 + Random() % 5;
+        if (lvl < 5)
+            lvl = 5;
+        if (lvl > 70)
+            lvl = 70;
+        id = MakeSprite(sp, FALSE, k, palIdx, &loaded);
+        if (id == MAX_SPRITES)
+            continue;
+        gSprites[id].data[0] = tx * 16;
+        gSprites[id].data[1] = ty * 16;
+        gSprites[id].data[2] = sp;
+        gSprites[id].data[3] = 1 + (Random() & 3);
+        gSprites[id].data[4] = Random() & 63;
+        gSprites[id].data[5] = lvl;
+        gSprites[id].data[6] = 0;
+        gSprites[id].data[7] = WILD_TAG;
+        gSprites[id].callback = SpriteCB_Roamer;
+        Place(&gSprites[id]);
+        if (sFirst == 0)
+            sFirst = id + 1;
+    }
+}
+
+// the building's one Pokémon: stands still in the middle of the room
+static void SpawnStatic(void)
+{
+    struct HanWildSave *sv = Save();
+    u8 palIdx = 0, id, top = 5, i;
+    u16 sp;
+    bool8 shiny;
+
+    if (!sv->staticReady)
+    {
+        sv->staticSpecies = PickStatic();
+        sv->staticShiny = ShinyRoll();
+        sv->staticReady = 1;
+    }
+    sp = sv->staticSpecies;
+    shiny = sv->staticShiny;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && GetMonData(&gPlayerParty[i], MON_DATA_LEVEL) > top)
+            top = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);
+    if (top > 70)
+        top = 70;
+    id = HanWildSpriteCreate(sp | (shiny ? 0x8000 : 0), STATIC_PAL, &palIdx, TRUE);
+    if (id == MAX_SPRITES)
+        return;
+    gSprites[id].data[0] = 7 * 16;
+    gSprites[id].data[1] = 8 * 16;
+    gSprites[id].data[2] = sp;
+    gSprites[id].data[3] = DIR_NORTH;
+    gSprites[id].data[4] = 0;
+    gSprites[id].data[5] = top | (shiny ? SHINY_BIT : 0);
+    gSprites[id].data[6] = 0;
+    gSprites[id].data[7] = WILD_TAG;
+    gSprites[id].callback = SpriteCB_Static;
+    StartSpriteAnimIfDifferent(&gSprites[id], GetFaceDirectionAnimNum(DIR_NORTH));
+    Place(&gSprites[id]);
+    sFirst = id + 1;
+}
+
+// every frame of the overworld
+void HanWildFrame(void)
+{
+    bool8 temple = InTemple();
+    bool8 under = InUnder();
+
+    if (!InWildArea() && !temple && !under)
+    {
+        sFirst = 0;
+        return;
+    }
+    if (gPlayerAvatar.spriteId >= MAX_SPRITES)
+        return;
+    if (sFirst != 0 && (!gSprites[sFirst - 1].inUse || gSprites[sFirst - 1].data[7] != WILD_TAG))
+        sFirst = 0;
+    if (sFirst == 0)
+    {
+        if (under)
+        {
+            SpawnUnder();
+            return;
+        }
+        EnsureRoster();
+        if (temple)
+            SpawnStatic();
+        else
+        {
+            ComputeReach();
+            Spawn();
+        }
+        return;
+    }
+    // a Pokémon reached while the player's controls are busy (ice, current, surfing in): the usual input check does not run then
+    if (!ScriptContext_IsEnabled() && (gPlayerAvatar.flags & PLAYER_AVATAR_FLAG_FORCED) != 0)
+        HanWildCollision();
+}
+
+// called where the player can act: a roamer on the player's tile starts a battle
+bool8 HanWildCollision(void)
+{
+    struct Sprite *player;
+    u8 i;
+    s16 r;
+
+    if (sFirst == 0 || (!InWildArea() && !InTemple() && !InUnder()))
+        return FALSE;
+    player = &gSprites[gPlayerAvatar.spriteId];
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        struct Sprite *s = &gSprites[i];
+        s16 dx, dy;
+
+        if (!s->inUse || s->data[7] != WILD_TAG || (s->callback != SpriteCB_Roamer && s->callback != SpriteCB_Static) || s->invisible)
+            continue;
+        dx = s->x - (player->x + player->x2);
+        dy = s->y - (player->y + player->y2);
+        r = IsWaterOnly(s->data[2]) ? 23 : 17; // water ones can be reached from the shore; the rest when you are next to them
+        if (dx < r && dx > -r && dy < r && dy > -r)
+        {
+            sBattleSpecies = s->data[2];
+            sBattleLevel = s->data[5] & 0xFF;
+            sBattleShiny = (s->data[5] & SHINY_BIT) != 0;
+            if (s->callback == SpriteCB_Static)
+                Save()->staticReady = 0; // met: the next visit has another
+            else if (IsLegend(sBattleSpecies))
+                ReplaceRoamer((s->data[5] >> 9) & 15);
+            ScriptContext_SetupScript(HanWild_EventScript_Battle);
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+void HanWildStartBattle(void)
+{
+    CreateScriptedWildMon(sBattleSpecies, sBattleLevel, ITEM_NONE);
+    HanMonMakeShiny(&gEnemyParty[0], sBattleShiny); // what the sprite showed
+}
+
+// Surfing in from Route 124 to the Wild Area's south edge: VAR_0x8004 gets the column to arrive at
+void HanWildEdgeX(void)
+{
+    s16 x, y;
+
+    PlayerGetDestCoords(&x, &y);
+    x -= MAP_OFFSET;
+    x -= 24;
+    gSpecialVar_0x8004 = x < 2 ? 2 : (x > 29 ? 29 : x);
+}
+
+// The player faces a hole in the ice and presses A: an offer to dive (x, y: the tile in front)
+bool8 HanWildDiveCheck(s16 x, s16 y)
+{
+    if (!InWildArea() || (MapGridGetMetatileIdAt(x, y) & 0x3FF) != HOLE_ID)
+        return FALSE;
+    ScriptContext_SetupScript(HanWild_EventScript_Dive);
+    return TRUE;
+}
+
+// DIG from the party menu on the ice of the Wild Area, facing more ice: the tile in front becomes water (a hole to dive into).
+// TRUE if that is where the player is; HanWildDigIceActive then says so to the party menu
+bool8 HanWildDigIce(void)
+{
+    s16 px, py, fx, fy;
+
+    sDigIce = FALSE;
+    if (!InWildArea())
+        return FALSE;
+    PlayerGetDestCoords(&px, &py);
+    if (MapGridGetMetatileBehaviorAt(px, py) != MB_ICE)
+        return FALSE;
+    GetXYCoordsOneStepInFrontOfPlayer(&fx, &fy);
+    if (MapGridGetMetatileBehaviorAt(fx, fy) != MB_ICE || GetObjectEventIdByXY(fx, fy) != OBJECT_EVENTS_COUNT)
+        return FALSE;
+    sDigIce = TRUE;
+    return TRUE;
+}
+
+bool8 HanWildDigIceActive(void)
+{
+    return sDigIce;
+}
+
+void HanWildMakeHole(void)
+{
+    struct HanWildSave *s = Save();
+    s16 fx, fy;
+
+    sDigIce = FALSE;
+    GetXYCoordsOneStepInFrontOfPlayer(&fx, &fy);
+    MapGridSetMetatileIdAt(fx, fy, HOLE_ID);
+    s->holes[s->holeNext % HOLES][0] = fx - MAP_OFFSET;
+    s->holes[s->holeNext % HOLES][1] = fy - MAP_OFFSET;
+    s->holeNext++;
+    DrawWholeMapView();
+    PlaySE(SE_ICE_BREAK);
+}
