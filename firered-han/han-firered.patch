+// Hän build: TRUE while a Pokémon's picture is still doing its entrance animation. The animation
+// is over when the picture's callback is SpriteCallbackDummy again. Ten seconds is the most this
+// waits, whatever happens to a picture.
+static bool8 AnyMonEntranceAnim(void)
+{
+    u8 battler;
+
+    if (sMonEntranceAnims == 0)
+        return FALSE;
+    if (++sMonEntranceAnimFrames > 600)
+        sMonEntranceAnims = 0;
+    for (battler = 0; battler < MAX_BATTLERS_COUNT; battler++)
+    {
+        if (sMonEntranceAnims & gBitTable[battler])
+        {
+            struct Sprite *sprite = &gSprites[gBattlerSpriteIds[battler]];
+
+            if (!sprite->inUse || sprite->callback == SpriteCallbackDummy)
+                sMonEntranceAnims &= ~gBitTable[battler];
+        }
+    }
+    return sMonEntranceAnims != 0;
+}
