+# Said letter by letter.
+SPELLED = {"tm", "hm", "pc", "hp", "pp", "id", "tv", "vs", "ko", "ok", "ss", "sp", "ot", "dx", "gba", "abc", "abcde",
+           "abcdef", "abcdefg", "tmhm", "pkmn", "pk", "mn", "hq", "pko"}
+ENDINGS = [("'s", None), ("s'", None), ("es", "IH0 Z"), ("s", None), ("ed", None), ("ing", "IH0 NG"), ("ly", "L IY0"),
+           ("er", "ER0"), ("est", "IH0 S T"), ("'ll", "L"), ("'d", "D"), ("'ve", "V"), ("'re", "R"), ("n't", "N T")]
+VOICELESS = {"P", "T", "K", "F", "TH", "S", "SH", "CH", "HH"}
+SIBILANT = {"S", "Z", "SH", "ZH", "CH", "JH"}
+
+ONSET = {"P": "b", "B": "b", "T": "t", "D": "d", "K": "k", "G": "g", "CH": "ch", "JH": "j", "F": "hw", "V": "w",
+         "TH": "th", "DH": "dh", "S": "s", "Z": "z", "SH": "sh", "ZH": "zh", "HH": "h", "M": "m", "N": "n",
+         "L": "l", "R": "zr", "W": "w", "Y": "y"}
+FINAL = {"P": ["b"], "B": ["b"], "T": ["t"], "D": ["t"], "K": ["k"], "G": ["g"], "CH": ["t", "sh"], "JH": ["t", "sh"],
+         "F": ["h"], "V": ["w"], "TH": ["t"], "DH": ["t"], "S": ["s"], "Z": ["z"], "SH": ["sh"], "ZH": ["sh"],
+         "HH": ["h"], "M": ["m"], "N": ["n"], "NG": ["ng"], "L": ["l"], "R": ["r"], "W": ["w"], "Y": ["y"]}
+PAIRS = {("T", "R"): "tr", ("D", "R"): "dr", ("T", "S"): "ts", ("D", "Z"): "dz", ("HH", "W"): "hw"}
+# vowel > (letter, the consonant that follows it as a glide)
+VOWEL = {"AA": ("a", None), "AE": ("ä", None), "AH": ("ë", None), "AO": ("o", None), "AW": ("a", "W"),
+         "AY": ("a", "Y"), "EH": ("e", None), "ER": ("ë", "R"), "EY": ("e", "Y"), "IH": ("i", None),
+         "IY": ("i", None), "OW": ("o", None), "OY": ("o", "Y"), "UH": ("u", None), "UW": ("u", None)}
+
+
+def units(phones):
+    """The sounds of a word as syllables and finals: ['tre', 'y', 'në', 'r']."""
+    out, waiting = [], []
+    for ph in phones:
+        base = ph.rstrip("012")
+        if base not in VOWEL:
+            waiting.append(base)
+            continue
+        letter, glide = VOWEL[base]
+        onset, dot = "", False
+        if waiting:
+            if waiting[-1] == "NG":                       # sing-ing: the ng stays a final
+                pass
+            elif len(waiting) >= 2 and tuple(waiting[-2:]) in PAIRS:
+                onset = PAIRS[tuple(waiting[-2:])]
+                waiting = waiting[:-2]
+            elif waiting[-1] == "Y" and len(waiting) >= 2 and waiting[-2] in ONSET and waiting[-2] not in ("Y", "W", "R"):
+                onset, dot = ONSET[waiting[-2]], True
+                waiting = waiting[:-2]
+            else:
+                onset = ONSET[waiting[-1]]
+                waiting = waiting[:-1]
+        for c in waiting:
+            out.extend(FINAL[c])
+        waiting = [glide] if glide else []
+        out.append(onset + ("y" if dot else "") + letter)
+    for c in waiting:
+        out.extend(FINAL[c])
+    return out
+
+
+class Guesser:
+    """The letter-to-sound model of g2p_en, run from its checkpoint with numpy alone."""
+    GRAPHEMES = ["<pad>", "<unk>", "</s>"] + list("abcdefghijklmnopqrstuvwxyz")
+    PHONEMES = ["<pad>", "<unk>", "<s>", "</s>"] + [
+        "AA0", "AA1", "AA2", "AE0", "AE1", "AE2", "AH0", "AH1", "AH2", "AO0", "AO1", "AO2", "AW0", "AW1", "AW2",
+        "AY0", "AY1", "AY2", "B", "CH", "D", "DH", "EH0", "EH1", "EH2", "ER0", "ER1", "ER2", "EY0", "EY1", "EY2",
+        "F", "G", "HH", "IH0", "IH1", "IH2", "IY0", "IY1", "IY2", "JH", "K", "L", "M", "N", "NG", "OW0", "OW1",
+        "OW2", "OY0", "OY1", "OY2", "P", "R", "S", "SH", "T", "TH", "UH0", "UH1", "UH2", "UW", "UW0", "UW1", "UW2",
+        "V", "W", "Y", "Z", "ZH"]
+
+    def __init__(self, path):
+        import numpy as np
+        self.np = np
+        v = np.load(path)
+        self.v = {k: v[k] for k in v.files}
+        self.g2idx = {g: i for i, g in enumerate(self.GRAPHEMES)}
+
+    def cell(self, x, h, w_ih, w_hh, b_ih, b_hh):
+        np = self.np
+        a = np.matmul(x, w_ih.T) + b_ih
+        b = np.matmul(h, w_hh.T) + b_hh
+        n = a.shape[-1] * 2 // 3
+        rz = 1 / (1 + np.exp(-(a[:, :n] + b[:, :n])))
+        r, z = np.split(rz, 2, -1)
+        return (1 - z) * np.tanh(a[:, n:] + r * b[:, n:]) + z * h
+
+    def __call__(self, word):
+        np, v = self.np, self.v
+        x = [self.g2idx.get(c, 1) for c in list(word) + ["</s>"]]
+        x = np.take(v["enc_emb"], np.expand_dims(x, 0), axis=0)
+        h = np.zeros((1, v["enc_w_hh"].shape[-1]), np.float32)
+        for t in range(x.shape[1]):
+            h = self.cell(x[:, t, :], h, v["enc_w_ih"], v["enc_w_hh"], v["enc_b_ih"], v["enc_b_hh"])
+        dec = np.take(v["dec_emb"], [2], axis=0)
+        out = []
+        for _ in range(20):
+            h = self.cell(dec, h, v["dec_w_ih"], v["dec_w_hh"], v["dec_b_ih"], v["dec_b_hh"])
+            pred = int((np.matmul(h, v["fc_w"].T) + v["fc_b"]).argmax())
+            if pred == 3:
+                break
+            out.append(self.PHONEMES[pred])
+            dec = np.take(v["dec_emb"], [pred], axis=0)
+        return [p for p in out if not p.startswith("<")]
+
+
+def game_words():
+    """Every word of the game's English text, as the game's own word breaks give them, in small letters."""
+    import han_text as H
+    _, _, groups, _ = H.load()
+    words = set()
+    for g in groups.values():
+        text = re.sub(r"\{[^}]*\}", " ", g.english).replace("é", "e").replace("É", "e")
+        text = text.replace("’", "'").replace("ʼ", "'")
+        for w in re.findall(r"[A-Za-z]+(?:'[A-Za-z]+)*", text):
+            words.add(w.lower())
+    return words - NOT_WORDS
+
+
+def translator_words(translations, game, cmu):
+    """The English words of the rows that the translator wrote in English, in small letters.
+
+    translations: the file the translator page saves. Only words that the dictionary or the
+    lists in this script know are taken, so that no Hän word can get into the list this way.
+    """
+    import json
+    import han_english_table as T
+    words = set()
+    for row in json.loads(Path(translations).read_text(encoding="utf-8"))["rows"]:
+        han = row.get("han") or ""
+        if T.english_prose(han, game):
+            words |= {w for w in T.words_of(han) if w in cmu or w in FIXES or w in WORDS or w in POKEMON}
+    return words - game - NOT_WORDS
+
+
+def sound(word, cmu, guess):
+    """(the word's sounds, where they came from)"""
+    if word in FIXES:
+        return FIXES[word].split(), "fixed"
+    if word in POKEMON:
+        return POKEMON[word].split(), "fixed"
+    if word in WORDS:
+        return WORDS[word].split(), "fixed"
+    if len(word) == 1 or word in SPELLED or not re.search(r"[aeiouy]", word):
+        return [p for c in word if c in LETTER_NAMES for p in LETTER_NAMES[c].split()], "letters"
+    if word in cmu:
+        return cmu[word][0], "dictionary"
+    plain = word.replace("'", "")
+    for ending, extra in ENDINGS:
+        stem = word[:-len(ending)]
+        if not word.endswith(ending) or stem not in cmu or len(stem) < 2:
+            continue
+        base = list(cmu[stem][0])
+        last = base[-1].rstrip("012")
+        if ending in ("'s", "s'", "s"):
+            extra = "IH0 Z" if last in SIBILANT else "S" if last in VOICELESS else "Z"
+        if ending == "ed":
+            extra = "IH0 D" if last in ("T", "D") else "T" if last in VOICELESS else "D"
+        return base + extra.split(), "dictionary, with its ending"
+    if word.endswith("'s") and len(word) > 3:
+        base, source = sound(word[:-2], cmu, guess)
+        last = base[-1].rstrip("012")
+        return list(base) + ("IH0 Z" if last in SIBILANT else "S" if last in VOICELESS else "Z").split(), source
+    return guess(plain), "guess"
+
+
+def main():
+    if len(sys.argv) not in (2, 3):
+        sys.exit(__doc__)
+    import cmudict
+    cmu = cmudict.dict()
+    guess = Guesser(sys.argv[1])
+    kept = {}
+    if OUT.exists():
+        for line in OUT.read_text(encoding="utf-8").splitlines():
+            parts = line.split("\t")
+            if len(parts) == 3 and parts[2] == "hand":
+                kept[parts[0]] = parts[1]
+    lines, counts = [], {}
+    words = game_words()
+    if len(sys.argv) == 3:
+        added = translator_words(sys.argv[2], words, cmu)
+        print("from the translator's own English rows: %s" % (", ".join(sorted(added)) or "nothing"))
+        words |= added
+    for word in sorted(words):
+        if word in kept:
+            spelled, source = kept[word], "hand"
+        else:
+            phones, source = sound(word, cmu, guess)
+            spelled = ".".join(units(phones))
+        if not spelled:
+            continue
+        counts[source] = counts.get(source, 0) + 1
+        lines.append("%s\t%s\t%s" % (word, spelled, source))
+    head = ["# English words of the game, spelled by their sound in the letters of Jane's syllabics.",
+            "# Made by tools/han/han_english_sounds.py: see there for what each letter stands for.",
+            "# This is English, not Hän. word <tab> sound <tab> where the sound came from.",
+            "# In the sound, a dot parts the pieces: a piece that ends in a vowel is a syllable, any other is a final.",
+            "# To change a word, change its sound and put hand in the third column.",
+            "# Sounds marked dictionary are from the CMU Pronouncing Dictionary, (c) 1993-2015 Carnegie Mellon University.",
+            "# Its licence is in cmudict_LICENSE.txt, next to this file, and must stay with this list.",
+            "# Sounds marked guess are from the letter-to-sound model of g2p_en (Park and Kim, Apache licence 2.0)."]
+    OUT.write_text("\n".join(head + lines) + "\n", encoding="utf-8")
+    print("wrote %s: %d words. %s" % (OUT.name, len(lines), ", ".join("%s %d" % kv for kv in sorted(counts.items()))))
+
+
+if __name__ == "__main__":
+    main()
