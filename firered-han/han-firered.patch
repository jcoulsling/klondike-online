+<body>
+<header>
+  <h1>Hän FireRed translator</h1>
+  <div class="note" id="progress"></div>
+  <div class="bar"><i id="barfill"></i></div>
+  <div class="row">
+    <input type="search" id="q" placeholder="Search English or Hän">
