+        [OBJ_EVENT_GFX_GREEN_FISH] = 3, [OBJ_EVENT_GFX_GREEN_VS_SEEKER] = 4, [OBJ_EVENT_GFX_GREEN_VS_SEEKER_BIKE] = 5,
+    };
+    u8 id;
+
+    for (id = OBJ_EVENT_GFX_RED_BIKE; id <= OBJ_EVENT_GFX_GREEN_VS_SEEKER_BIKE; id++)
