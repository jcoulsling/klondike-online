diff --git a/data/maps/DewfordTown/scripts.inc b/data/maps/DewfordTown/scripts.inc
new file mode 100644
index 0000000..0b203ea
--- /dev/null
+++ b/data/maps/DewfordTown/scripts.inc
@@ -0,0 +1,130 @@
+DewfordTown_MapScripts::
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, DewfordTown_OnFrame
+	.byte 0
+
+DewfordTown_OnFrame:
+	map_script_2 VAR_0x40FF, 0, DewfordTown_EventScript_BirchArrival
+	.2byte 0
+
+@ The ship from Dewford: the same ship and scene as the Seagallop, to every port.
+DewfordTown_EventScript_FerrySailor::
+	lock
+	faceplayer
+	message Text_WhereDoYouWantToSail
+	waitmessage
+	setvar VAR_0x8004, SEAGALLOP_DEWFORD
+	goto EventScript_SeviiDestinationsPage1
+	end
+
+@ The Battle Frontier: a sailor at the reception gate takes you to any port.
+BattleFrontier_EventScript_FerrySailor::
+	lock
+	faceplayer
+	message Text_WhereDoYouWantToSail
+	waitmessage
+	setvar VAR_0x8004, SEAGALLOP_FRONTIER
+	goto EventScript_SeviiDestinationsPage1
+	end
+
+@ Arrival in Hoenn: Professor Birch walks up to the player on the pier, offers the three POKé BALLS (Emerald's choosing screen),
+@ then flies away.
+DewfordTown_EventScript_BirchArrival::
+	lockall
+	msgbox DewfordTown_Text_BirchHey, MSGBOX_DEFAULT
+	closemessage
+	setvar VAR_0x8004, 5
+	special HanBirchCome
+	goto_if_eq VAR_RESULT, 0, DewfordTown_EventScript_BirchTalk
+	applymovement 5, DewfordTown_Movement_BirchWalkUp
+	waitmovement 0
+DewfordTown_EventScript_BirchTalk::
+	applymovement 5, Common_Movement_WalkInPlaceFasterRight
+	waitmovement 0
+	msgbox DewfordTown_Text_BirchHello, MSGBOX_DEFAULT
+	closemessage
+	special HanChooseStarter
+	waitstate
+	switch VAR_RESULT
+	case 0, DewfordTown_EventScript_BirchTreecko
+	case 1, DewfordTown_EventScript_BirchTorchic
+	case 2, DewfordTown_EventScript_BirchMudkip
+	goto DewfordTown_EventScript_BirchTreecko
+	end
+
+DewfordTown_Movement_BirchWalkUp:
+	walk_right
+	walk_right
+	walk_right
+	step_end
+
+DewfordTown_EventScript_BirchTreecko::
+	givemon SPECIES_TREECKO, 14
+	bufferspeciesname STR_VAR_1, SPECIES_TREECKO
+	goto DewfordTown_EventScript_BirchGiven
+	end
+
+DewfordTown_EventScript_BirchTorchic::
+	givemon SPECIES_TORCHIC, 14
+	bufferspeciesname STR_VAR_1, SPECIES_TORCHIC
+	goto DewfordTown_EventScript_BirchGiven
+	end
+
+DewfordTown_EventScript_BirchMudkip::
+	givemon SPECIES_MUDKIP, 14
+	bufferspeciesname STR_VAR_1, SPECIES_MUDKIP
+	goto DewfordTown_EventScript_BirchGiven
+	end
+
+DewfordTown_EventScript_BirchGiven::
+	playfanfare MUS_OBTAIN_ITEM
+	msgbox DewfordTown_Text_BirchGaveMon, MSGBOX_DEFAULT
+	waitfanfare
+	additem ITEM_GREAT_BALL, 10
+	msgbox DewfordTown_Text_BirchGaveBalls, MSGBOX_DEFAULT
+	msgbox DewfordTown_Text_BirchWildArea, MSGBOX_DEFAULT
+	msgbox DewfordTown_Text_BirchBye, MSGBOX_DEFAULT
+	closemessage
+	setvar VAR_0x40FF, 1
+	setvar VAR_0x8004, 5
+	special HanBirchFlyAway
+	waitfieldeffect FLDEFF_NPCFLY_OUT
+	removeobject 5
+	setflag 0x2000 + 500
+	releaseall
+	end
+
+DewfordTown_EventScript_Birch::
+	msgbox DewfordTown_Text_BirchAgain, MSGBOX_NPC
+	end
+
+DewfordTown_Text_BirchHey:
+	.string "PROF. BIRCH: Hey! Over here!$"
+
+DewfordTown_Text_BirchHello:
+	.string "PROF. BIRCH: Welcome to HOENN!\n"
+	.string "I study POKéMON out here.\p"
+	.string "A trainer needs a partner from this\n"
+	.string "region. Please take one of mine.$"
+
+DewfordTown_Text_BirchGaveMon:
+	.string "{PLAYER} received {STR_VAR_1}!$"
+
+DewfordTown_Text_BirchGaveBalls:
+	.string "Here, take these GREAT BALLS too.\n"
+	.string "{PLAYER} received 10 GREAT BALLS!$"
+
+DewfordTown_Text_BirchWildArea:
+	.string "Far to the north-east there is the\n"
+	.string "WILD AREA, a snowy island.\p"
+	.string "POKéMON live there that you will not\n"
+	.string "meet anywhere else, and they wander\l"
+	.string "around in the open.\p"
+	.string "Take the ferry from any port, FLY\n"
+	.string "there, or SURF north from ROUTE 124.$"
+
+DewfordTown_Text_BirchBye:
+	.string "I have research waiting for me.\n"
+	.string "Good luck out there!$"
+
+DewfordTown_Text_BirchAgain:
+	.string "PROF. BIRCH: Try the WILD AREA!$"
