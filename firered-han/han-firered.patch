+        {
+            for (i = 0; i < PARTY_SIZE; i++)
+            {
+                if (GetMonData(&gEnemyParty[i], MON_DATA_SPECIES) == SPECIES_UNOWN && HanCanSend(i))
+                    return i;
+            }
+        }
+        pick = GameMostSuitableMonToSwitchInto();
+        if (gTrainerBattleOpponent_A == TRAINER_LEADER_KOGA && (gBattleWeather & B_WEATHER_HAIL)
+         && pick < PARTY_SIZE && GetMonData(&gEnemyParty[pick], MON_DATA_SPECIES) == SPECIES_PILOSWINE)
+        {
+            for (i = 0; i < PARTY_SIZE; i++)
+            {
+                if (i != pick && HanCanSend(i))
+                    return i;
+            }
+        }
+        return pick;
+    }
+    return GameMostSuitableMonToSwitchInto();
+}
