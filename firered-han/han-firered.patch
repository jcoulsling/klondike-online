+// Hän build: which POKéMON a trainer sends next. The game's own choice, with two things Jane asked for:
+//  - CHAMPION JANE sends the UNOWN half of the time, if it can still fight;
+//  - BRANDON does not send PILOSWINE while it hails, if he has another: its SNOW WARNING would do nothing.
+static bool8 HanCanSend(u32 slot)
+{
+    struct Pokemon *mon = &gEnemyParty[slot];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES_OR_EGG);
+
+    return species != SPECIES_NONE && species != SPECIES_EGG && GetMonData(mon, MON_DATA_HP) != 0
