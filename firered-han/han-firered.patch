+# ---------------------------------------------------------------------------
+# Putting text into the source files
+# ---------------------------------------------------------------------------
+def split_breaks(source_text):
+    """Cut after every \\n, \\p, \\l so each line of text is its own source line."""
+    pieces, cur, i = [], "", 0
+    while i < len(source_text):
+        if source_text[i] == "\\" and i + 1 < len(source_text):
+            cur += source_text[i:i + 2]
+            if source_text[i + 1] in "npl":
+                pieces.append(cur)
+                cur = ""
+            i += 2
+        else:
+            cur += source_text[i]
+            i += 1
+    if cur or not pieces:
+        pieces.append(cur)
+    return pieces
+
+
+MANIFEST = ORIG / "MANIFEST.json"
+
+
+def file_hash(path):
+    import hashlib
+    return hashlib.sha1(Path(path).read_bytes()).hexdigest()
+
+
+def restore():
+    """Put the English files back. Returns (files restored, files that somebody
+    edited while the Hän text was in place). Such an edit would be lost, so the
+    edited file is first set aside next to the original as *.edited."""
+    if not ORIG.exists():
+        return 0, []
+    written = json.loads(MANIFEST.read_text()) if MANIFEST.exists() else {}
+    n, edited = 0, []
+    for f in sorted(ORIG.rglob("*")):
+        if f.is_file() and f != MANIFEST:
+            rel = str(f.relative_to(ORIG))
+            target = ROOT / rel
+            if rel in written and target.exists() and file_hash(target) != written[rel]:
+                shutil.copyfile(target, str(target) + ".edited")
+                edited.append(rel)
+            shutil.copyfile(f, target)
+            n += 1
+    shutil.rmtree(ORIG)
+    return n, edited
+
+
+EDITED_HELP = """
+These files were changed by hand while the Hän text was in place:
+  %s
+The English files are back, and each hand-changed file was set aside with
+.edited on the end of its name. Copy your change from there into the English
+file, delete the .edited file, and run this again.
+To change code safely: run 'restore' first, change the code, then 'build'."""
+
+
+def apply(groups):
+    """Write every resolved row into the source files. Returns counts and, for C
+    files, where each string ended up, so a compiler complaint can be traced."""
+    edits = defaultdict(list)
+    for g in groups.values():
+        if g.final is None:
+            continue
+        source_text = to_source(g.final)
+        for u in g.fit_units:
+            edits[u.path].append((u, source_text))
+    _, edited = restore()
+    if edited:
+        sys.exit(EDITED_HELP % "\n  ".join(edited))
+    changed, placed, written = 0, {}, {}
+    for path, items in edits.items():
+        original = (ROOT / path).read_text(encoding="utf-8")
+        text = original
+        kind = items[0][0].kind
+        ordered = sorted(items, key=lambda it: -it[0].span[0])
+        if kind == "asm":
+            lines = text.split("\n")
+            for u, new in ordered:
+                block = ['%s.string "%s"' % (u.indent, piece) for piece in split_breaks(new)]
+                block[-1] = block[-1][:-1] + '$"'
+                lines[u.span[0]:u.span[1] + 1] = block
+            text = "\n".join(lines)
+        elif kind == "c":
+            for u, new in ordered:
+                pieces = split_breaks(new)
+                body = ('"\n' + u.indent + '"').join(pieces) if u.multi and len(pieces) > 1 else new
+                text = text[:u.span[0]] + '_("' + body + '")' + text[u.span[1]:]
+            # the k-th _() of the new file is the k-th _() of the old one
+            before = [m.start() for m in C_LITERAL.finditer(original)]
+            after = [(text.count("\n", 0, m.start()) + 1, text.count("\n", 0, m.end()) + 1) for m in C_LITERAL.finditer(text)]
+            index = {pos: i for i, pos in enumerate(before)}
+            placed[path] = [(after[index[u.span[0]]], u) for u, _ in items if u.span[0] in index and len(after) == len(before)]
+        else:
+            for u, new in ordered:
+                text = text[:u.span[0]] + json.dumps(new, ensure_ascii=False)[1:-1] + text[u.span[1]:]
+        if text != original:
+            backup = ORIG / path
+            backup.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(ROOT / path, backup)
+            (ROOT / path).write_text(text, encoding="utf-8")
+            written[path] = file_hash(ROOT / path)
+            changed += 1
+    # the type labels are pictures: redraw them from the type names
+    names = {}
+    for g in groups.values():
+        if g.family == "Type names" and g.final:
+            for u in g.fit_units:
+                m = re.search(r"gTypeNames\[(TYPE_\w+)\]", u.context)
+                if m:
+                    names[m.group(1)] = g.final
+    if names:
+        import han_labels
+        backup = ORIG / han_labels.SHEET
+        backup.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(ROOT / han_labels.SHEET, backup)
+        for type_name, problem in han_labels.draw_type_labels(names).items():
+            print("type label %s left as it was: %s" % (type_name, problem))
+        written[han_labels.SHEET] = file_hash(ROOT / han_labels.SHEET)
+        changed += 1
+    if written:
+        MANIFEST.write_text(json.dumps(written, indent=0, sort_keys=True))
+    return changed, sum(len(v) for v in edits.values()), placed
+
+
+def english_table(groups, rules):
+    """Makes the table the game uses to spell English words by their sound in syllabics
+    (tools/han/han_english_table.py), without the words that are Hän in this translation.
+    Returns those words, the rows that are written in English, and the English words of
+    those rows that the list of sounds does not have."""
+    import han_english_table as T
+    rows = [(g.english, g.final) for g in groups.values() if g.final is not None and g.final != g.english]
+    rows += [(english, han) for english, han in rules.items() if han]
+    han, prose, missing = T.han_words(rows)
+    T.write(han)
+    return sorted(han), prose, sorted(missing)
