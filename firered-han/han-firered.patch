+def make():
+    import os
+    proc = subprocess.run(["make", "-j%d" % (os.cpu_count() or 2)], cwd=ROOT, capture_output=True, text=True)
+    return proc.returncode, proc.stdout + proc.stderr
+
+
+def too_long_units(log, placed):
+    """Units the compiler rejected because the text overran a fixed-size slot."""
+    found = []
+    for m in re.finditer(r"^(\S+?):(\d+): (?:warning|error): (?:excess elements|initializer-string)", log, re.M):
+        path, line = m.group(1), int(m.group(2))
+        for (first, last), u in placed.get(path, []):
+            if first <= line <= last:
+                found.append(u)
+    return found
+
+
+# The widest line Game Freak put in a text box is 196 px (measured over every map's
+# dialogue with the game's own glyph widths). Wrapped lines stay within that.
+DIALOGUE_PX = 196
+
+
+def load(max_px=DIALOGUE_PX):
+    cm = Charmap()
+    units = scan_all()
+    groups, skipped = build_groups(units, cm)
+    return cm, units, groups, Wrapper(cm, max_px)
+
+
+def main(argv):
+    if len(argv) < 2 or argv[1] not in ("workbook", "tool", "apply", "build", "restore"):
+        sys.exit(__doc__)
+    if argv[1] == "restore":
+        n, edited = restore()
+        import han_english_table
+        han_english_table.write([])       # the text is English again: no word of the table is a Hän word
+        print("restored %d files" % n)
+        if edited:
+            print(EDITED_HELP % "\n  ".join(edited))
+        return
+    args = argv[2:]
+    opts = {}
+    for flag in ("--from", "--rom", "--report", "--was"):
+        if flag in args:
+            i = args.index(flag)
+            opts[flag] = args[i + 1]
+            del args[i:i + 2]
+    if not args:
+        sys.exit(__doc__)
+    book = opts.get("--from") if argv[1] in ("workbook", "tool") else args[0]
+    skip = set()
+    if argv[1] == "build":
+        # the Pokémon pictures and animations of Emerald, from a copy of the pokeemerald source
+        import han_emerald
+        han_emerald.main(["han_emerald.py"])
+        import han_theme
+        han_theme.main(["han_theme.py"])
+    for attempt in range(25):
+        cm, units, groups, wrapper = load()
+        manual, rules, problems = ({}, OrderedDict(), [])
+        if book:
+            manual, rules, problems = read_book(book, groups, cm, opts.get("--rom"))
+        resolve(groups, manual, rules, cm, wrapper, skip)
+        if argv[1] != "build":
+            break
+        files, places, placed = apply(groups)
+        sounds = english_table(groups, rules)
+        code, log = make()
+        if code == 0:
+            break
+        bad = too_long_units(log, placed)
+        if not bad:
+            print(log[-3000:])
+            sys.exit("make failed for a reason this tool does not handle")
+        limits = learned_limits()
+        for u in bad:
+            n = len(cm.encode(to_source(next(g.final for g in groups.values() if u in g.fit_units))))
+            key = "%s|%s" % (u.path, u.context)
+            limits[key] = min(limits.get(key, n - 1), n - 1)
+            skip.add((u.path, u.pos))
+            print("too long for its slot, left in English: %s" % u.where)
+        LEARNED.write_text(json.dumps(limits, indent=1, sort_keys=True))
+    print("%d strings in the source, %d rows; text box width %d px" % (len(units), sum(1 for g in groups.values() if is_translatable(g.english)), wrapper.max_px))
+    counts = defaultdict(int)
+    for g in groups.values():
+        if g.source:
+            counts[g.source] += 1
+    print("rows: " + ", ".join("%s %d" % kv for kv in sorted(counts.items())))
+    for p in problems:
+        print("NOT PLACED:", p)
+    if argv[1] == "workbook":
+        n = write_book(args[0], groups, rules, problems)
+        print("wrote %s: %d rows" % (args[0], n))
+        return
+    if argv[1] == "tool":
+        fixes = []
+        if "--was" in opts and book:
+            for older in opts["--was"].split(","):       # several older files: OLD1.json,OLD2.json
+                for fix in saved_changes(older, book):
+                    if fix not in fixes:
+                        fixes.append(fix)
+        n = write_tool(args[0], groups, rules, fixes)
+        print("wrote %s: %d rows" % (args[0], n))
+        if fixes:
+            print("%d rows changed since %s; a browser that still holds the older text takes the new one" % (len(fixes), opts["--was"]))
+        return
+    if argv[1] == "apply":
+        files, places, placed = apply(groups)
+        sounds = english_table(groups, rules)
+    print("put %d rows into %d places in %d files" % (sum(1 for g in groups.values() if g.final is not None), places, files))
+    han, prose, missing = sounds
+    print("syllabics: English words are spelled by their sound, but these are read as Hän, because the translation has them as Hän words: %s" % (", ".join(han) or "none"))
+    print("syllabics: %d rows of the translation are written in English (most are English rows with one word swapped by a word rule)" % len(prose))
+    if missing:
+        print("syllabics: plain words in those rows that are not in tools/han/english_sounds.txt, so they are read as Hän: %s" % ", ".join(missing))
+    if argv[1] == "build":
+        print("built pokefirered.gba")
+    if "--report" in opts:
+        write_book(opts["--report"], groups, rules, problems)
+
+
+if __name__ == "__main__":
+    main(sys.argv)
