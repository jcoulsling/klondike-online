index 0000000..a5be92b
--- /dev/null
+++ b/tools/han/han_people.py
@@ -0,0 +1,204 @@
+#!/usr/bin/env python3
+"""Brings Emerald's little walking pictures into the build, for the player's PICTURE.
+
+    python3 tools/han/han_people.py [PATH/TO/pokeemerald]      (han_emerald.py runs it)
+
+Jane asked (23 November 2026) that the walking picture match the chosen character as closely as it can: she chose a
+Team Aqua grunt and walked as a LASS. FireRed has no walking picture for the Hoenn characters, so they come from
+Emerald's own, which have the same nine frames, 16 by 32, as FireRed's people.
+
+It writes, from a copy of the pokeemerald source (nothing below is in git):
+
+  graphics/object_events/pics/people/emerald_people/NAME.png   each picture
+  graphics/object_events/palettes/emerald_npc_1.pal, emerald_npc_3.pal   Emerald's colours (2 and 4 are STEVEN's and TWIN's)
+  src/data/object_events/han_people_decl.h    the declarations and the pointer-table lines (OBJ_EVENT_GFX_HAN_PEOPLE + n)
+  src/data/object_events/han_people.h         the pictures, frame tables and graphics info
+
+The list below is the order of the ids. A trainer picture that has one of these takes it in tools/han/han_pics.py.
+"""
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+FIRST_ID = 154          # OBJ_EVENT_GFX_HAN_PEOPLE in include/constants/event_objects.h
+MAX = 40
+# key, Emerald's name for the graphics (gObjectEventPic_NAME / gObjectEventGraphicsInfo_NAME)
+PEOPLE = [
+    "AquaMemberM", "AquaMemberF", "Archie", "MagmaMemberM", "MagmaMemberF", "Maxie", "Wally", "Wallace",
+    "Roxanne", "Brawly", "Tate", "Wattson", "Flannery", "Norman", "Winona", "Sidney", "Phoebe", "Glacia", "Drake",
+    "HexManiac", "RichBoy", "RunningTriathleteM",
+    "RunningTriathleteF", "SwimmerM", "SwimmerF", "ReporterM", "PsychicM", "ProfBirch",
+]
+# FireRed's own gym leaders and Elite Four are standing pictures too (three frames, the steps repeat them), so they
+# walk by the same drawing: key, picture file in graphics/object_events/pics/people, FireRed's name for the graphics
+FIRERED_STATIC = [
+    ("Brock", "brock", "Brock"), ("Misty", "misty", "Misty"), ("LtSurge", "lt_surge", "LtSurge"),
+    ("Erika", "erika", "Erika"), ("Sabrina", "sabrina", "Sabrina"), ("Blaine", "blaine", "Blaine"),
+    ("Bruno", "bruno", "Bruno"), ("Agatha", "agatha", "Agatha"), ("Lance", "lance", "Lance"),
+    ("OldMan2", "old_man_2", "OldMan2"),
+]
+# Emerald's palette tag -> (file name here, base number in han_pics.OW_BASES)
+PAL = {"NPC_1": ("emerald_npc_1", 8), "NPC_2": ("emerald_twin", 6), "NPC_3": ("emerald_npc_3", 9), "NPC_4": ("emerald_steven", 5)}
+EMERALD_PAL_FILE = {"NPC_1": "npc_1", "NPC_2": "npc_2", "NPC_3": "npc_3", "NPC_4": "npc_4"}
+
+
+def all_people():
+    return PEOPLE + ["FR" + k for k, _, _ in FIRERED_STATIC]
+
+
+def snake(name):
+    import re
+    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()
+
+
+def info(emerald):
+    """-> {name: (png path in Emerald, palette tag)}"""
+    import re
+    pics = (emerald / "src/data/object_events/object_event_graphics.h").read_text()
+    infos = (emerald / "src/data/object_events/object_event_graphics_info.h").read_text()
+    out = {}
+    for n in PEOPLE:
+        m = re.search(r"gObjectEventPic_%s\[\] = INCGFX_U32\(\"graphics/object_events/(pics/people/[^\"]*\.png)\"" % n, pics)
+        t = re.search(r"gObjectEventGraphicsInfo_%s = \{\n.*?\.paletteTag = OBJ_EVENT_PAL_TAG_(NPC_\d)" % n, infos, re.S)
+        if not m or not t:
+            sys.exit("han_people.py: Emerald has no walking picture %s as expected" % n)
+        out[n] = (m.group(1), t.group(1))
+    return out
+
+
+def _walk(stand, palette, way, step):
+    """One walking frame drawn from a standing one. The legs are the bottom rows. Facing down or up, one foot lifts a
+    pixel at a time, left then right. Facing left, the front foot reaches forward and lifts, then the back one."""
+    from PIL import Image
+    px = stand.load()
+    rows = [y for y in range(32) if any(px[x, y] for x in range(16))]
+    bottom = rows[-1]
+    top = bottom - 5                      # the legs: the last six rows
+    fr = Image.new("P", (16, 32), 0)
+    fr.putpalette(palette)
+    out = fr.load()
+    for y in range(32):
+        for x in range(16):
+            c = px[x, y]
+            if not c:
+                continue
+            if y < top:
+                out[x, y - 1 if y > 0 else y] = c      # the body rises a pixel on a step
+                continue
+            if way == "side":
+                front = x < 8
+                lift = (front and step == 0) or (not front and step == 1)
+                nx = x + (-1 if front and step == 0 else (1 if not front and step == 1 else 0))
+            else:
+                left = x < 8
+                lift = (left and step == 0) or (not left and step == 1)
+                nx = x
+            ny = y - 1 if lift else y
+            if 0 <= nx < 16 and 0 <= ny < 32:
+                out[nx, ny] = c
+    return fr
+
+
+def nine_frames(raw):
+    """Emerald's gym leaders and Elite Four have three frames only (facing down, up, left). The walking picture
+    needs nine, so the steps are drawn from the standing frames by _walk."""
+    import io
+    from PIL import Image
+    im = Image.open(io.BytesIO(raw))
+    if im.size == (144, 32):
+        return raw
+    if im.size != (48, 32):
+        sys.exit("han_people.py: a walking picture of %s is not what it expects" % (im.size,))
+    pal = im.getpalette()
+    out = Image.new("P", (144, 32), 0)
+    out.putpalette(pal)
+    for i in range(3):
+        stand = im.crop((16 * i, 0, 16 * i + 16, 32))
+        out.paste(stand, (16 * i, 0))
+        for step in (0, 1):
+            out.paste(_walk(stand, pal, "side" if i == 2 else "front", step), (16 * (3 + 2 * i + step), 0))
+    buf = io.BytesIO()
+    out.save(buf, format="PNG", transparency=0)
+    return buf.getvalue()
+
+
+def put(path, data):
+    path = Path(path)
+    data = data if isinstance(data, bytes) else data.encode("utf-8")
+    if not path.exists() or path.read_bytes() != data:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data)
+        return 1
+    return 0
+
+
+def main(argv):
+    import han_emerald
+    emerald = han_emerald.find_emerald(argv)
+    if len(all_people()) > MAX:
+        sys.exit("han_people.py: too many pictures")
+    got = info(emerald)
+    n = 0
+    for name, (png, tag) in got.items():
+        n += put(ROOT / ("graphics/object_events/pics/people/emerald_people/%s.png" % snake(name)),
+                 nine_frames((emerald / "graphics/object_events" / png).read_bytes()))
+    for key, png, _ in FIRERED_STATIC:
+        src = ROOT / "graphics/object_events/pics/people" / (png + ".png")
+        if not src.exists():
+            continue
+        n += put(ROOT / ("graphics/object_events/pics/people/emerald_people/%s.png" % snake("FR" + key)), nine_frames(src.read_bytes()))
+    for tag, (stem, _) in PAL.items():
+        n += put(ROOT / ("graphics/object_events/palettes/%s.pal" % stem),
+                 (emerald / ("graphics/object_events/palettes/%s.pal" % EMERALD_PAL_FILE[tag])).read_bytes())
+    decl = ["// Made by tools/han/han_people.py. Do not edit.", ""]
+    data = ["// Made by tools/han/han_people.py. Do not edit.", ""]
+    ptr = []
+    for i, name in enumerate(all_people()):
+        s = snake(name)
+        decl.append("extern const struct ObjectEventGraphicsInfo gObjectEventGraphicsInfo_HanP%s;" % name)
+        ptr.append("    [%d] = &gObjectEventGraphicsInfo_HanP%s, \\" % (FIRST_ID + i, name))
+        data.append('static const u16 gHanPic_%s[] = INCBIN_U16("graphics/object_events/pics/people/emerald_people/%s.4bpp");' % (name, s))
+        data.append("static const struct SpriteFrameImage sHanPicTable_%s[] = {" % name)
+        for f in range(9):
+            data.append("    overworld_frame(gHanPic_%s, 2, 4, %d)," % (name, f))
+        data.append("};")
+        data.append("const struct ObjectEventGraphicsInfo gObjectEventGraphicsInfo_HanP%s = {" % name)
+        data.append("""    .tileTag = TAG_NONE,
+    .paletteTag = OBJ_EVENT_PAL_TAG_EMERALD_STEVEN,
+    .reflectionPaletteTag = OBJ_EVENT_PAL_TAG_NONE,
+    .size = 256,
+    .width = 16,
+    .height = 32,
+    .paletteSlot = PALSLOT_NPC_SPECIAL,
+    .shadowSize = SHADOW_SIZE_M,
+    .inanimate = FALSE,
+    .disableReflectionPaletteLoad = FALSE,
+    .tracks = TRACKS_FOOT,
+    .oam = &gObjectEventBaseOam_16x32,
+    .subspriteTables = gObjectEventSpriteOamTables_16x32,
+    .anims = sAnimTable_Standard,
+    .images = sHanPicTable_%s,
+    .affineAnims = gDummySpriteAffineAnimTable,
+};
+""" % name)
+    decl.append("")
+    decl.append("#define HAN_PEOPLE_POINTERS \\")
+    decl += ptr
+    decl.append("")
+    n += put(ROOT / "src/data/object_events/han_people_decl.h", "\n".join(decl))
+    n += put(ROOT / "src/data/object_events/han_people.h", "\n".join(data))
+    print("han_people.py: %d walking pictures drawn or from Emerald (%d files new or changed)" % (len(all_people()), n))
+
+
+def ids():
+    """key -> (gfx id, base number)"""
+    return {name: FIRST_ID + i for i, name in enumerate(all_people())}
+
+
+def base_of(name):
+    import han_emerald
+    return PAL[info(han_emerald.find_emerald([]))[name][1]][1]
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/tools/han/han_pics.py b/tools/han/han_pics.py
new file mode 100644
index 0000000..a83946d
--- /dev/null
+++ b/tools/han/han_pics.py
@@ -0,0 +1,465 @@
+#!/usr/bin/env python3
+"""Palette swaps of the game's own trainer pictures (Jane, 22 November 2026).
+
+For every trainer picture of the game (TRAINER_PIC_*, 148 of them) this reads the picture (4bpp, 64 x 64, LZ77) and its
+palette from the files the game itself builds from, and makes
+  - the picture uncompressed (0x800 bytes each), for graphics/han_custom/pics.bin (the battle sprite needs it
+    uncompressed in ROM, and so can the trainer card);
+  - 12 palettes: 0 the original, 1..7 red orange yellow green blue indigo violet, 8 black, 9 white, 10 and 11 two
+    that suit the character (its main colour's opposite, and a turn a third of the way round from it).
+Skin colours and colours with little colour in them (outlines, greys, near white or black) keep what they are, except
+for black and white, which also darken and lighten the colourful parts. Colourful means saturation over 0.25.
+"""
+import colorsys
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+TRANS_AT = 6
+N_VARIANTS = 13   # 0 the original, trans flag at 6, rainbow 1-5 and 7-8, black 9, white 10, 11 and 12 that suit the picture
+RAINBOW = [0.0, 30 / 360, 56 / 360, 125 / 360, 220 / 360, 262 / 360, 290 / 360]
+
+
+def lz(data):
+    size = int.from_bytes(data[1:4], "little")
+    out, i = bytearray(), 4
+    while len(out) < size:
+        flags = data[i]
+        i += 1
+        for b in range(8):
+            if len(out) >= size:
+                break
+            if flags & (0x80 >> b):
+                n = (data[i] >> 4) + 3
+                d = (((data[i] & 15) << 8) | data[i + 1]) + 1
+                i += 2
+                for _ in range(n):
+                    out.append(out[-d])
+            else:
+                out.append(data[i])
+                i += 1
+    return bytes(out[:size])
+
+
+def parse():
+    """-> list of 148 (name, pic bytes, [16 rgb]) in TRAINER_PIC order."""
+    consts = {}
+    for m in re.finditer(r"#define TRAINER_PIC_(\w+)\s+(\d+)", (ROOT / "include/constants/trainers.h").read_text()):
+        consts[m.group(1)] = int(m.group(2))
+    files = dict(re.findall(r"(gTrainer(?:FrontPic|Palette)_\w+)\[\] = INCBIN_U32\(\"([^\"]+)\"", (ROOT / "src/data/graphics/trainers.h").read_text()))
+    t = (ROOT / "src/data/trainer_graphics/front_pic_tables.h").read_text()
+    pics = dict(re.findall(r"TRAINER_SPRITE\((\w+), (\w+),", t))
+    pals = dict(re.findall(r"TRAINER_PAL\((\w+), (\w+)\)", t))
+    n = max(consts.values()) + 1
+    out = [None] * n
+    for name, idx in consts.items():
+        if name not in pics or name not in pals:
+            continue
+        pic = lz((ROOT / files[pics[name]]).read_bytes())
+        raw = lz((ROOT / files[pals[name]]).read_bytes())
+        rgb = []
+        for i in range(16):
+            v = raw[i * 2] | (raw[i * 2 + 1] << 8)
+            rgb.append(((v & 31) * 255 // 31, ((v >> 5) & 31) * 255 // 31, ((v >> 10) & 31) * 255 // 31))
+        pic, rgb = protect(pic, rgb)
+        out[idx] = (name, pic, list(rgb))
+    return out
+
+
+KEEP = {}   # palette (as a tuple) -> colour numbers no variant changes: the lips and blush on a face
+
+
+def _decode(raw):
+    g = [[0] * 64 for _ in range(64)]
+    for t in range(64):
+        for y in range(8):
+            for x in range(8):
+                b = raw[t * 32 + y * 4 + x // 2]
+                g[(t // 8) * 8 + y][(t % 8) * 8 + x] = (b >> 4) if x & 1 else b & 15
+    return g
+
+
+def _encode(g):
+    raw = bytearray(0x800)
+    for t in range(64):
+        for y in range(8):
+            for x in range(4):
+                lo, hi = g[(t // 8) * 8 + y][(t % 8) * 8 + 2 * x], g[(t // 8) * 8 + y][(t % 8) * 8 + 2 * x + 1]
+                raw[t * 32 + y * 4 + x] = lo | (hi << 4)
+    return bytes(raw)
+
+
+def _reddish(c):
+    h, s, v = hsv(c)
+    return (h < 22 / 360 or h > 335 / 360) and s > 0.25 and v > 0.4
+
+
+def protect(pic, pal):
+    """Lips and blush: small patches of red or pink that sit in skin. They share a colour number with clothes, so their
+    pixels are given a number of their own (the same colour), which no palette changes. A number is freed, when the
+    picture uses all 16, by joining its two nearest colours if they are close (within 50 in total). -> pic, pal"""
+    if len(pic) < 0x800:
+        return pic, pal
+    g = _decode(pic)
+    pal = list(pal)
+    skin = lambda c: c and is_skin_or_shade(pal[c]) and colourful(pal[c])
+    seen, found = set(), {}
+    for y in range(64):
+        for x in range(64):
+            c = g[y][x]
+            if (x, y) in seen or not (c and colourful(pal[c]) and not is_skin_or_shade(pal[c]) and _reddish(pal[c])):
+                continue
+            comp = [(x, y)]
+            seen.add((x, y))
+            k = 0
+            while k < len(comp):
+                cx, cy = comp[k]
+                k += 1
+                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    q = (cx + dx, cy + dy)
+                    if 0 <= q[0] < 64 and 0 <= q[1] < 64 and q not in seen and g[q[1]][q[0]] == c:
+                        seen.add(q)
+                        comp.append(q)
+            if len(comp) > 14:
+                continue
+            cs = set(comp)
+            nb = {(cx + dx, cy + dy) for cx, cy in comp for dx in (-1, 0, 1) for dy in (-1, 0, 1)
+                  if (cx + dx, cy + dy) not in cs and 0 <= cx + dx < 64 and 0 <= cy + dy < 64}
+            if nb and sum(1 for q in nb if skin(g[q[1]][q[0]])) / len(nb) >= 0.6:
+                found.setdefault(c, []).extend(comp)
+    if not found:
+        return pic, tuple(pal)
+    keep = set()
+    for c, px in sorted(found.items(), key=lambda kv: -len(kv[1])):
+        used = {v for row in g for v in row}
+        free = [i for i in range(1, 16) if i not in used]
+        if not free:    # join the two nearest colours
+            best = None
+            for i in range(1, 16):
+                for j in range(i + 1, 16):
+                    if i in keep or j in keep:
+                        continue
+                    if is_skin_or_shade(pal[i]) != is_skin_or_shade(pal[j]) or colourful(pal[i]) != colourful(pal[j]):
+                        continue    # skin is never joined to clothes: it would turn with them
+                    dh = abs(hsv(pal[i])[0] - hsv(pal[j])[0])
+                    if colourful(pal[i]) and min(dh, 1 - dh) > 0.06:
+                        continue
+                    d = sum(abs(pal[i][k] - pal[j][k]) for k in range(3))
+                    small = min(sum(row.count(i) for row in g), sum(row.count(j) for row in g))
+                    if d > 50 and not (small <= 6 and d <= 180):
+                        continue        # the change must not be seen: a close colour, or a few pixels only
+                    if best is None or d * max(small, 1) < best[0]:
+                        best = (d * max(small, 1), i, j)
+            if best is None:
+                continue
+            _, i, j = best
+            drop, into = (i, j) if sum(row.count(i) for row in g) <= sum(row.count(j) for row in g) else (j, i)
+            g = [[into if v == drop else v for v in row] for row in g]
+            free = [drop]
+        n = free[0]
+        pal[n] = pal[c]
+        for x, y in px:
+            g[y][x] = n
+        keep.add(n)
+    pal = tuple(pal)
+    KEEP[pal] = keep
+    return _encode(g), pal
+
+
+def hsv(c):
+    return colorsys.rgb_to_hsv(c[0] / 255, c[1] / 255, c[2] / 255)
+
+
+def rgb(h, s, v):
+    r, g, b = colorsys.hsv_to_rgb(h % 1.0, min(1, max(0, s)), min(1, max(0, v)))
+    return (round(r * 255), round(g * 255), round(b * 255))
+
+
+def is_skin(c):
+    h, s, v = hsv(c)
+    return 12 / 360 < h < 42 / 360 and 0.12 < s < 0.55 and v > 0.55
+
+
+def is_skin_or_shade(c):
+    """Skin, and the darker, redder shades that skin has in shadow: the trans flag leaves these alone."""
+    h, s, v = hsv(c)
+    return is_skin(c) or (h < 42 / 360 and 0.12 < s < 0.66 and 0.4 < v and not (h < 10 / 360 and s > 0.5))
+
+
+def colourful(c):
+    h, s, v = hsv(c)
+    return s > 0.14 and 0.18 < v
+
+
+def counts(pic):
+    n = [0] * 16
+    for b in pic:
+        n[b & 15] += 1
+        n[b >> 4] += 1
+    return n
+
+
+def reference(pic, pal):
+    """The numbers that decide how a picture's colours are changed: its main hue and its range of brightness."""
+    cnt = counts(pic)
+    mov = [i for i in range(1, 16) if colourful(pal[i]) and not is_skin(pal[i]) and i not in KEEP.get(tuple(pal), ())]
+    main_h = hsv(pal[max(mov, key=lambda i: cnt[i])])[0] if mov else None
+    vs = [hsv(pal[i])[2] for i in mov] or [0.5]
+    return main_h, min(vs), max(vs)
+
+
+def variants(pic, pal, ref=None, follow=None):
+    cnt = counts(pic)
+    mov = [i for i in range(1, 16) if colourful(pal[i]) and not is_skin(pal[i]) and i not in KEEP.get(tuple(pal), ())]
+    # the main colour: the hue with most pixels
+    main_h = None
+    if mov:
+        best = max(mov, key=lambda i: cnt[i])
+        main_h = hsv(pal[best])[0]
+    if ref is not None:     # a walking picture is changed by the numbers of its big picture, so the two match
+        main_h = ref[0]
+    targets = list(RAINBOW)
+    if main_h is None:
+        main_h = 0.6
+    targets += [None, None]
+    vs = [hsv(pal[i])[2] for i in mov] or [0.5]
+    vlo, vhi = min(vs), max(vs)
+    if ref is not None:
+        vlo, vhi = ref[1], ref[2]
+    out = []
+    for v in range(N_VARIANTS):
+        p = list(pal)
+        for i in mov:
+            h, s, val = hsv(pal[i])
+            if v == 0:
+                continue
+            if 1 <= v <= 7:
+                p[i] = rgb(RAINBOW[v - 1], max(s, 0.55), val)
+            elif v == 8:
+                n = (val - vlo) / (vhi - vlo) if vhi > vlo else 0.5
+                p[i] = rgb(h, s * 0.1, 0.1 + 0.4 * n)
+            elif v == 9:
+                n = (val - vlo) / (vhi - vlo) if vhi > vlo else 0.5
+                p[i] = rgb(0.6, 0.05 * (1 - n), 0.52 + 0.48 * n)
+            elif v == 10:
+                p[i] = rgb(main_h + 0.5 + (h - main_h), max(s, 0.45), val)
+            else:
+                p[i] = rgb(h - main_h + main_h + 1 / 3, max(s, 0.45), val)
+        out.append(p)
+    out[12] = trans_flag(pic, pal, follow)
+    out.insert(TRANS_AT, out.pop(12))    # the trans flag is palette 6
+    return out
+
+
+DARK = 0.38   # colours darker than this are outlines and shadows
+TRANS = [(91, 206, 250), (245, 169, 184), (255, 255, 255)]   # the trans flag: light blue, pink, white
+
+
+def _flag_ranks(pic, pal):
+    """-> {colour number: 0 blue, 1 pink, 2 white} for the picture's coloured parts."""
+    cnt = counts(pic)
+    mov = [i for i in range(1, 16) if colourful(pal[i]) and not is_skin_or_shade(pal[i]) and hsv(pal[i])[2] >= DARK and i not in KEEP.get(tuple(pal), ())]
+    if not mov:
+        return {}
+    def gap(a, b):
+        d = abs(hsv(pal[a])[0] - hsv(pal[b])[0])
+        return min(d, 1 - d)
+    groups = []
+    for i in sorted(mov, key=lambda i: hsv(pal[i])[0]):
+        if groups and gap(i, groups[-1][-1]) < 0.07:
+            groups[-1].append(i)
+        else:
+            groups.append([i])
+    if len(groups) > 1 and gap(groups[0][0], groups[-1][-1]) < 0.07:     # red wraps round
+        groups[0] += groups.pop()
+    late = []       # groups cut from a bigger one by brightness: the lighter part, which takes the second or third stripe
+    while len(groups) + len(late) < 3:
+        big = max(groups, key=lambda g: (len(g), sum(cnt[i] for i in g)))
+        if len(big) < 2:
+            break
+        order = sorted(big, key=lambda i: hsv(pal[i])[2])
+        h = (len(order) + 1) // 2
+        groups.remove(big)
+        groups.append(order[:h])        # the darker part (the outlines and shading) stays with the main colour
+        late.append(order[h:])
+    groups.sort(key=lambda g: -sum(cnt[i] for i in g))
+    late.sort(key=lambda g: -sum(cnt[i] for i in g))
+    ranked = groups + late
+    return {i: min(r, 2) for r, g in enumerate(ranked) for i in g}
+
+
+def trans_flag(pic, pal, follow=None):
+    """The coloured parts (not skin, not grey) become the flag: the biggest patch of one hue light blue, the next pink,
+    the rest white. Each colour keeps its own brightness, so the shading stays. follow = (pic, pal) of the big picture:
+    a walking picture takes each colour's part of the flag from the nearest colour of the big picture, so they match."""
+    mov = [i for i in range(1, 16) if colourful(pal[i]) and not is_skin_or_shade(pal[i]) and hsv(pal[i])[2] >= DARK and i not in KEEP.get(tuple(pal), ())]
+    p = list(pal)   # the dark colours (the outlines) stay as they are, or the flag looks messy
+    if not mov:
+        return p
+    if follow is None:
+        rank = _flag_ranks(pic, pal)
+    else:
+        fr = _flag_ranks(*follow)
+        fp = follow[1]
+        rank = {}
+        for i in mov:
+            h, _, v = hsv(pal[i])
+            def dist(j):
+                d = abs(h - hsv(fp[j])[0])
+                return 2 * min(d, 1 - d) + 0.3 * abs(v - hsv(fp[j])[2])
+            rank[i] = fr[min(fr, key=dist)] if fr else 0
+    for r in range(3):
+        g = [i for i in mov if rank.get(i) == r]
+        if not g:
+            continue
+        vmax = max(hsv(pal[i])[2] for i in g)
+        vmin = min(hsv(pal[i])[2] for i in g)
+        for i in g:
+            t = (hsv(pal[i])[2] - vmin) / (vmax - vmin) if vmax > vmin else 1
+            col = r
+            if r == 2 and hsv(pal[i])[2] < 0.7:     # a darker shade of what is white is a darker pink, not a grey
+                col = 1
+            f = (0.78 + 0.22 * t) if col == 2 else (0.62 + 0.38 * t)
+            p[i] = tuple(min(255, int(c * f)) for c in TRANS[col])
+    return p
+
+
+def c555(c):
+    return (c[0] >> 3) | ((c[1] >> 3) << 5) | ((c[2] >> 3) << 10)
+
+
+def build():
+    data = parse()
+    blob = bytearray()
+    pals = []
+    for d in data:
+        if d is None:
+            blob += bytes(0x800)
+            pals.append([[0] * 16] * N_VARIANTS)
+            continue
+        blob += d[1][:0x800]
+        pals.append([[c555(c) for c in p] for p in variants(d[1], d[2])])
+    return blob, pals, data
+
+
+if __name__ == "__main__":
+    blob, pals, data = build()
+    print(len(data), len(blob), sum(1 for d in data if d))
+
