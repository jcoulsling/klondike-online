diff --git a/tools/han/shot/harness.c b/tools/han/shot/harness.c
new file mode 100644
index 0000000..35fff30
--- /dev/null
+++ b/tools/han/shot/harness.c
@@ -0,0 +1,223 @@
+// Headless mGBA runner: executes a tiny script of waits, key presses and screenshots.
+#include <mgba/core/core.h>
+#include <mgba/core/config.h>
+#include <mgba/core/serialize.h>
+#include <mgba/core/log.h>
+#include <mgba-util/vfs.h>
+#include <mgba/core/blip_buf.h>
+#include <mgba/internal/arm/arm.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static void nolog(struct mLogger* l, int cat, enum mLogLevel lvl, const char* fmt, va_list args) { (void)l;(void)cat;(void)lvl;(void)fmt;(void)args; }
+static struct mLogger sLogger = { .log = nolog };
+
+#define AUDIO_RATE 32768
+static FILE* sAudio;                                 /* audio FILE : the game's sound goes to FILE from now on */
+static long frames = 0;
+#define CALL_MAX 200000
+static unsigned sCallAddr;                           /* callson ADDR : from now on, note r0 and r1 at every call of the function at ADDR */
+static unsigned sCalls[CALL_MAX][2];                 /* callsdump label : print the calls noted so far on one line, and forget them */
+static int sCallCount;                               /* callsoff : stop noting */
+
+/* One frame. The sound of the frame is read every time, and written if a file is open:
+   16 bit, two channels, AUDIO_RATE samples a second, no header. */
+static void step(struct mCore* core) {
+    static int16_t samples[2 * 4096];
+    struct blip_t* left = core->getAudioChannel(core, 0);
+    struct blip_t* right = core->getAudioChannel(core, 1);
+    if (sCallAddr) {                                /* callson: one instruction at a time, noting each call of the function */
+        struct ARMCore* cpu = core->cpu;
+        uint32_t f = core->frameCounter(core);
+        while (core->frameCounter(core) == f) {
+            if ((unsigned) cpu->gprs[15] - 2 == sCallAddr && sCallCount < CALL_MAX) {
+                sCalls[sCallCount][0] = cpu->gprs[0]; sCalls[sCallCount][1] = cpu->gprs[1]; sCallCount++;
+            }
+            core->step(core);
+        }
+    } else {
+        core->runFrame(core);
+    }
+    frames++;
+    int n = blip_samples_avail(left);
+    if (n > 4096) n = 4096;
+    blip_read_samples(left, samples, n, 1);
+    blip_read_samples(right, samples + 1, n, 1);
+    if (sAudio) fwrite(samples, 4, n, sAudio);
+}
+
+static void audiorate(struct mCore* core) {
+    blip_set_rates(core->getAudioChannel(core, 0), core->frequency(core), AUDIO_RATE);
+    blip_set_rates(core->getAudioChannel(core, 1), core->frequency(core), AUDIO_RATE);
+}
+
+static int keybit(const char* k) {
+    const char* names[] = {"A","B","SELECT","START","RIGHT","LEFT","UP","DOWN","R","L"};
+    int bits = 0;                                   /* several keys at once: A+B+START+SELECT */
+    char tmp[64]; strncpy(tmp, k, 63); tmp[63] = 0;
+    for (char* t = strtok(tmp, "+"); t; t = strtok(NULL, "+"))
+        for (int i = 0; i < 10; i++) if (!strcmp(t, names[i])) bits |= 1 << i;
+    return bits;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 3) { fprintf(stderr, "usage: harness rom script\n"); return 1; }
+    mLogSetDefaultLogger(&sLogger);
+    struct mCore* core = mCoreFind(argv[1]);
+    if (!core) { fprintf(stderr, "no core\n"); return 1; }
+    core->init(core);
+    mCoreInitConfig(core, NULL);
+    unsigned w, h;
+    core->desiredVideoDimensions(core, &w, &h);
+    color_t* buf = malloc(w * h * sizeof(color_t));
+    core->setVideoBuffer(core, buf, w);
+    if (!mCoreLoadFile(core, argv[1])) { fprintf(stderr, "load failed\n"); return 1; }
+    core->reset(core);
+    audiorate(core);
+    FILE* f = fopen(argv[2], "r");
+    char cmd[64], arg[512]; int n;
+    char line[1024];
+    while (fgets(line, sizeof line, f)) {
+        if (line[0] == '#' || line[0] == '\n') continue;
+        n = 0; arg[0] = 0;
+        sscanf(line, "%63s %511s %d", cmd, arg, &n);
+        if (!strcmp(cmd, "wait")) {
+            n = atoi(arg);
+            core->setKeys(core, 0);
+            for (int i = 0; i < n; i++) { step(core); }
+        } else if (!strcmp(cmd, "press")) {
+            if (n <= 0) n = 6;
+            core->setKeys(core, keybit(arg));
+            for (int i = 0; i < n; i++) { step(core); }
+            core->setKeys(core, 0);
+            for (int i = 0; i < 6; i++) { step(core); }
+        } else if (!strcmp(cmd, "reset")) {             /* reset : like switching off and on. The save file stays */
+            core->reset(core);
+            audiorate(core);
+        } else if (!strcmp(cmd, "audio")) {             /* audio FILE : record the sound. audio off : stop */
+            if (sAudio) fclose(sAudio);
+            sAudio = strcmp(arg, "off") ? fopen(arg, "wb") : NULL;
+        } else if (!strcmp(cmd, "trace")) {             /* trace ADDR N FRAMES label : run FRAMES frames, print the N bytes each time they change */
+            unsigned addr = strtoul(arg, NULL, 16), nf = 0; char lab[64] = "";
+            unsigned long long last = ~0ULL;
+            sscanf(line, "%*s %*s %*d %u %63s", &nf, lab);
+            for (unsigned fr = 0; fr < nf; fr++) {
+                unsigned long long v = 0;
+                step(core);
+                for (int i = 0; i < n && i < 8; i++) v |= (unsigned long long) core->rawRead8(core, addr + i, -1) << (8 * i);
+                if (v != last) { printf("%s %ld: %llx\n", lab, frames, v); last = v; }
+            }
+        } else if (!strcmp(cmd, "shot")) {
+            FILE* o = fopen(arg, "wb");
+            fprintf(o, "P6\n%u %u\n255\n", w, h);
+            for (unsigned i = 0; i < w * h; i++) {
+                unsigned c = buf[i];
+                fputc(c & 0xFF, o); fputc((c >> 8) & 0xFF, o); fputc((c >> 16) & 0xFF, o);
+            }
+            fclose(o);
+        } else if (!strcmp(cmd, "poke16")) {            /* poke16 ADDR VALUE (hex) */
+            unsigned addr = strtoul(arg, NULL, 16), val = 0; char a2[64];
+            sscanf(line, "%*s %*s %63s", a2); val = strtoul(a2, NULL, 16);
+            core->rawWrite8(core, addr, -1, val & 0xFF); core->rawWrite8(core, addr + 1, -1, (val >> 8) & 0xFF);
+        } else if (!strcmp(cmd, "watch")) {             /* watch ADDR MAXSTEPS label : run one instruction at a time until the
+                                                           32 bit word at ADDR changes. Prints where the game was: pc, lr, r0 to r3. */
+            unsigned addr = strtoul(arg, NULL, 16); char lab[64] = "";
+            sscanf(line, "%*s %*s %*d %63s", lab);
+            struct ARMCore* cpu = core->cpu;
+            unsigned before = 0;
+            for (int i = 0; i < 4; i++) before |= (unsigned) core->rawRead8(core, addr + i, -1) << (8 * i);
+            long steps = 0; int hit = 0;
+            for (; steps < n; steps++) {
+                unsigned pc = cpu->gprs[15];
+                core->step(core);
+                unsigned now = 0;
+                for (int i = 0; i < 4; i++) now |= (unsigned) core->rawRead8(core, addr + i, -1) << (8 * i);
+                if (now != before) {
+                    printf("%s: changed %08x to %08x after %ld steps; pc %08x lr %08x r0 %08x r1 %08x r2 %08x r3 %08x sp %08x\n", lab, before, now, steps,
+                           pc, (unsigned) cpu->gprs[14], (unsigned) cpu->gprs[0], (unsigned) cpu->gprs[1], (unsigned) cpu->gprs[2], (unsigned) cpu->gprs[3], (unsigned) cpu->gprs[13]);
+                    hit = 1; break;
+                }
+            }
+            if (!hit) printf("%s: no change in %ld steps\n", lab, steps);
+        } else if (!strcmp(cmd, "callson")) {
+            sCallAddr = strtoul(arg, NULL, 16) & ~1u;
+        } else if (!strcmp(cmd, "callsoff")) {
+            sCallAddr = 0;
+        } else if (!strcmp(cmd, "callsdump")) {
+            printf("%s:", arg);
+            for (int i = 0; i < sCallCount; i++) printf(" %x,%x", sCalls[i][0], sCalls[i][1]);
+            printf("\n");
+            sCallCount = 0;
+        } else if (!strcmp(cmd, "keys")) {              /* keys A+B : hold these keys from now on, without running a frame. keys NONE lets go. */
+            core->setKeys(core, keybit(arg));
+        } else if (!strcmp(cmd, "calls")) {             /* calls ADDR MAXSTEPS label : run one instruction at a time for MAXSTEPS
+                                                           instructions. Each time the game is about to run the instruction at
+                                                           ADDR (the start of a function), prints r0 and r1. One line in all. */
+            unsigned addr = strtoul(arg, NULL, 16) & ~1u; char lab[64] = "";
+            sscanf(line, "%*s %*s %*d %63s", lab);
+            struct ARMCore* cpu = core->cpu;
+            printf("%s:", lab);
+            for (long steps = 0; steps < n; steps++) {
+                if ((unsigned) cpu->gprs[15] - 2 == addr)
+                    printf(" %x,%x", (unsigned) cpu->gprs[0], (unsigned) cpu->gprs[1]);
+                core->step(core);
+            }
+            printf("\n");
+        } else if (!strcmp(cmd, "poke8")) {             /* poke8 ADDR VALUE (hex) */
+            unsigned addr = strtoul(arg, NULL, 16), val = 0; char a2[64];
+            sscanf(line, "%*s %*s %63s", a2); val = strtoul(a2, NULL, 16);
+            core->rawWrite8(core, addr, -1, val & 0xFF);
+        } else if (!strcmp(cmd, "peek")) {              /* peek ADDR N label : prints N bytes */
+            unsigned addr = strtoul(arg, NULL, 16); char lab[64] = "";
+            sscanf(line, "%*s %*s %*d %63s", lab);
+            printf("%s:", lab);
+            for (int i = 0; i < n; i++) printf(" %02x", core->rawRead8(core, addr + i, -1));
+            printf("\n");
+        } else if (!strcmp(cmd, "peekpath")) {          /* peekpath ADDR N label OFF1 [OFF2] : follow one or two pointers, then print N bytes.
+                                                           The bytes are at *(u32*)ADDR + OFF1, or at *(u32*)(*(u32*)ADDR + OFF1) + OFF2 */
+            unsigned addr = strtoul(arg, NULL, 16); char lab[64] = "", o1[32] = "", o2[32] = "";
+            int k = sscanf(line, "%*s %*s %*d %63s %31s %31s", lab, o1, o2);
+            for (int j = 0; j < k - 1; j++) {
+                unsigned ptr = 0;
+                for (int i = 0; i < 4; i++) ptr |= (unsigned) core->rawRead8(core, addr + i, -1) << (8 * i);
+                addr = ptr + strtoul(j ? o2 : o1, NULL, 16);
+            }
+            printf("%s:", lab);
+            for (int i = 0; i < n; i++) printf(" %02x", core->rawRead8(core, addr + i, -1));
+            printf("\n");
+        } else if (!strcmp(cmd, "peekptr")) {           /* peekptr PTRADDR OFFSET label : one byte at *(u32*)PTRADDR + OFFSET */
+            unsigned paddr = strtoul(arg, NULL, 16), off = 0; char a2[64], lab[64] = "";
+            sscanf(line, "%*s %*s %63s %63s", a2, lab); off = strtoul(a2, NULL, 16);
+            unsigned ptr = 0;
+            for (int i = 0; i < 4; i++) ptr |= (unsigned) core->rawRead8(core, paddr + i, -1) << (8 * i);
+            printf("%s: %02x\n", lab, core->rawRead8(core, ptr + off, -1));
+        } else if (!strcmp(cmd, "pokeptr8")) {          /* pokeptr8 PTRADDR OFFSET VAL : one byte at *(u32*)PTRADDR + OFFSET */
+            unsigned paddr = strtoul(arg, NULL, 16), off = 0, val = 0; char a2[64], a3[64];
+            sscanf(line, "%*s %*s %63s %63s", a2, a3); off = strtoul(a2, NULL, 16); val = strtoul(a3, NULL, 16);
+            unsigned ptr = 0;
+            for (int i = 0; i < 4; i++) ptr |= (unsigned) core->rawRead8(core, paddr + i, -1) << (8 * i);
+            core->rawWrite8(core, ptr + off, -1, val & 0xFF);
+        } else if (!strcmp(cmd, "until")) {             /* until ADDR MASK MAXFRAMES KEY1 KEY2 : alternate keys until (mem & mask) != 0 */
+            unsigned addr = strtoul(arg, NULL, 16), mask = 0, maxf = 0; char k1[16], k2[16];
+            sscanf(line, "%*s %*s %x %u %15s %15s", &mask, &maxf, k1, k2);
+            unsigned f = 0; int which = 0, hit = 0;
+            while (f < maxf && !hit) {
+                core->setKeys(core, keybit(which ? k2 : k1));
+                for (int i = 0; i < 20 && !hit; i++) { step(core); f++; if (core->rawRead8(core, addr, -1) & mask) hit = 1; }
+                which = !which;
+            }
+            core->setKeys(core, 0);
+            printf("until: %s after %u frames\n", hit ? "hit" : "timeout", f);
+        } else if (!strcmp(cmd, "savestate")) {
+            struct VFile* vf = VFileOpen(arg, O_CREAT | O_TRUNC | O_RDWR);
+            mCoreSaveStateNamed(core, vf, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
+            vf->close(vf);
+        } else if (!strcmp(cmd, "loadstate")) {
+            struct VFile* vf = VFileOpen(arg, O_RDONLY);
+            if (vf) { mCoreLoadStateNamed(core, vf, SAVESTATE_SAVEDATA | SAVESTATE_RTC); vf->close(vf); }
+        }
+    }
+    fprintf(stderr, "ran %ld frames\n", frames);
+    return 0;
+}
diff --git a/tools/han/syllabics_test.c b/tools/han/syllabics_test.c
new file mode 100644
index 0000000..34ef580
--- /dev/null
+++ b/tools/han/syllabics_test.c
@@ -0,0 +1,64 @@
+/* Runs the game's syllabics converter on a computer, to check it against Jane's word processor.
+
+       gcc -O1 -o syllabics_test tools/han/syllabics_test.c
+       ./syllabics_test < bytes.txt
+
+   Each line of the input is a string of game text as hex bytes. For each line it prints the pieces the
+   game would show: G<glyph> for a syllabics glyph, with +<marks> when signs follow it; L<byte> for a
+   character shown the usual way. Pieces that show nothing print nothing.
+   tools/han/han_syllabics_check.py makes the input from real strings and compares the output
+   with the word processor. */
+#include <stdio.h>
+#include <string.h>
+
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned char bool8;
+#define TRUE 1
+#define FALSE 0
+
+#include "../../src/data/han_syllabics.h"
+#include "../../src/han_syllabics_core.h"
+
+int main(void)
+{
+    static char line[20000];
+    static u8 text[10000];
+
+    while (fgets(line, sizeof line, stdin))
+    {
+        size_t n = 0, len = strlen(line);
+        const u8 *s;
+        unsigned v;
+
+        for (size_t i = 0; i + 1 < len && sscanf(line + i, "%2x", &v) == 1; i += 2)
+            text[n++] = (u8)v;
+        text[n] = 0xFF;
+        text[n + 1] = text[n + 2] = text[n + 3] = text[n + 4] = 0xFF;
+        for (s = text; *s != 0xFF; )
+        {
+            u16 glyph;
+            u8 used, marks;
+
+            switch (HanSyl_Next(s, &glyph, &used, &marks))
+            {
+            case HAN_SYL_GLYPH:
+                if (marks)
+                    printf("G%d+%d ", glyph, marks);
+                else
+                    printf("G%d ", glyph);
+                s += used;
+                break;
+            case HAN_SYL_SKIP:
+                s += used;
+                break;
+            default:
+                printf("L%02X ", *s);
+                s++;
+                break;
+            }
+        }
+        printf("\n");
+    }
+    return 0;
+}
