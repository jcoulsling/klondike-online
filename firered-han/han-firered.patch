+def c_lengths():
+    """NAME_LENGTH style constants, for the fixed-size name tables."""
+    vals = {}
+    for f in ("include/constants/global.h", "include/battle_main.h", "include/global.h", "include/constants/items.h"):
+        p = ROOT / f
+        if p.exists():
+            for m in re.finditer(r"#define\s+(\w+)\s+(\d+)\s*(?://.*)?$", p.read_text(), re.M):
+                vals.setdefault(m.group(1), int(m.group(2)))
+    return vals
