+// Hän build: four cheats, on this menu or on the title screen.
+//   Select, Select, Select, Up: a new game that starts in the bedroom (HanQuickStart).
+//   Up, Down, Left, Right, Select: the menu of boss fights (CB2_InitBossMenu).
+//   Up, Up, Up, Up, Select: the game's text in Hän syllabics, or back to Latin letters (gHanSyllabics).
+//   Up, Down, Left, Right, Up, Select: the twins' battle in the VIRIDIAN GYM (StartCheatBattle).
+// The last six keys are kept. A code of five keys is written with a 0 first: that key can be any.
+#define CHEAT_LENGTH 6
+
+static const u16 sCheatCodes[][CHEAT_LENGTH] =
+{
+    [CHEAT_JANE_BATTLE - 1] = {0, DPAD_UP, DPAD_DOWN, DPAD_LEFT, DPAD_RIGHT, SELECT_BUTTON},
+    [CHEAT_SYLLABICS - 1]   = {0, DPAD_UP, DPAD_UP, DPAD_UP, DPAD_UP, SELECT_BUTTON},
+    [CHEAT_QUICK_START - 1] = {0, 0, SELECT_BUTTON, SELECT_BUTTON, SELECT_BUTTON, DPAD_UP},
+};
+
+void CheatCode_Reset(void)
+{
+    u8 i;
+
+    for (i = 0; i < CHEAT_LENGTH; i++)
+        sCheatKeys[i] = 0;
+}
+
+// Call once a frame. Returns CHEAT_NONE, or the cheat whose last key was just pressed.
+u8 CheatCodeEntered(void)
+{
+    u16 keys = JOY_NEW(DPAD_ANY | A_BUTTON | B_BUTTON | SELECT_BUTTON | START_BUTTON | L_BUTTON | R_BUTTON);
+    u8 i, j;
+
+    // Hän build: the cheat codes are turned off (Jane, 24 November 2026). Syllabics are a row in the OPTION menu.
+    return CHEAT_NONE;
+    if (keys == 0)
+        return CHEAT_NONE;
+    for (i = 0; i < CHEAT_LENGTH - 1; i++)
+        sCheatKeys[i] = sCheatKeys[i + 1];
+    sCheatKeys[CHEAT_LENGTH - 1] = keys;
+    for (i = 0; i < ARRAY_COUNT(sCheatCodes); i++)
+    {
+        for (j = 0; j < CHEAT_LENGTH && (sCheatCodes[i][j] == 0 || sCheatKeys[j] == sCheatCodes[i][j]); j++)
+            ;
+        if (j == CHEAT_LENGTH)
+        {
+            CheatCode_Reset();
+            sCheatLast = i + 1;
+            return i + 1;
+        }
+    }
+    return CHEAT_NONE;
+}
+
+// Hän build: the quick start. Jane asked for it (22 November 2026): a new game with no Oak speech. A boy or a girl at
+// random, the first name the game offers for each (RED, LEAF), the rival GREEN, and the game starts in the bedroom.
+// The save file is not touched until the player saves, as with any new game.
+extern const u8 gNameChoice_Red[];
+extern const u8 gNameChoice_Leaf[];
+extern const u8 gNameChoice_Green[];
+
+static const u8 sQuickNames[][PLAYER_NAME_LENGTH + 1] = {
+    _("AMBER"), _("ASPEN"), _("BIRCH"), _("CEDAR"), _("CLOVER"), _("DAWN"), _("EMBER"), _("FERN"), _("FINCH"),
+    _("HAZEL"), _("IVY"), _("JUNIPER"), _("KIT"), _("LARK"), _("MAPLE"), _("MOSS"), _("NOVA"), _("ONYX"),
+    _("PEBBLE"), _("QUILL"), _("RAVEN"), _("SAGE"), _("SKY"), _("TANSY"), _("WREN"), _("YARROW"),
+};
+
+void HanQuickStart(void)
+{
+    gSaveBlock2Ptr->playerGender = Random() & 1;
+    // a random name (Jane asked, 23 November 2026), along with the random look
+    StringCopy(gSaveBlock2Ptr->playerName, sQuickNames[Random() % ARRAY_COUNT(sQuickNames)]);
+    HanLookRandom(); // a random look too, when the customizer is in the game
+    StringCopy(gSaveBlock1Ptr->rivalName, gNameChoice_Green);
+    gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_MID;
+    gTextFlags.canABSpeedUpPrint = FALSE;
+    // clear what the title screen or the menu left on the screen (the windows and blending), as the Oak speech does
+    SetVBlankCallback(NULL);
+    ScanlineEffect_Stop();
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    SetGpuReg(REG_OFFSET_WIN0H, 0);
+    SetGpuReg(REG_OFFSET_WIN0V, 0);
+    SetGpuReg(REG_OFFSET_WIN1H, 0);
+    SetGpuReg(REG_OFFSET_WIN1V, 0);
+    SetGpuReg(REG_OFFSET_WININ, 0);
+    SetGpuReg(REG_OFFSET_WINOUT, 0);
+    SetGpuReg(REG_OFFSET_BLDCNT, 0);
+    SetGpuReg(REG_OFFSET_BLDALPHA, 0);
+    SetGpuReg(REG_OFFSET_BLDY, 0);
+    DmaFill16(3, 0, VRAM, VRAM_SIZE);
+    DmaFill32(3, 0, OAM, OAM_SIZE);
+    ResetPaletteFade();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    SetMainCallback2(CB2_NewGame);
+}
+
+static void Task_QuickStartGo(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        FreeAllWindowBuffers();
+        DestroyTask(taskId);
+        HanQuickStart();
+    }
+}
+
+// Shows the menu again from the start, so its words are drawn in the new letters.
+static void Task_ShowMainMenuAgain(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        FreeAllWindowBuffers();
+        DestroyTask(taskId);
+        SetMainCallback2(CB2_InitMainMenu);
+    }
+}
+
+// Hän build: the menu of boss fights. Jane asked for one menu in place of a button code for each fight
+// (17 November 2026). It lists the trainers of sCheatBosses in battle_setup.c by the names the game has for
+// them. Up and Down move, A starts the fight, B goes back to the start of the game.
+static const struct WindowTemplate sBossWindowTemplate[] = {
+    {
+        .bg = 0,
+        .tilemapLeft = 3,
+        .tilemapTop = 2,
+        .width = 24,
+        .height = 16,
+        .paletteNum = 15,
+        .baseBlock = 0x001
+    },
+    DUMMY_WIN_TEMPLATE
+};
+static const u8 sBossCursor[] = _("▶");
+
+static void BossMenu_DrawCursor(u8 pos, bool8 shown)
+{
+    if (shown)
+        AddTextPrinterParameterized3(0, FONT_NORMAL, 2, pos * 16, sTextColor1, -1, sBossCursor);
+    else
+        FillWindowPixelRect(0, PIXEL_FILL(10), 0, pos * 16, 12, 16);
+}
+
+static void Task_BossMenuStart(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        u8 boss = gTasks[taskId].data[0];
+
+        FreeAllWindowBuffers();
+        DestroyTask(taskId);
+        StartCheatBattle(boss);
+    }
+}
+
+static void Task_BossMenu(u8 taskId)
+{
+    s16 *pos = &gTasks[taskId].data[0];
+
+    if (gPaletteFade.active)
+        return;
+    if (JOY_NEW(DPAD_UP | DPAD_DOWN))
+    {
+        BossMenu_DrawCursor(*pos, FALSE);
+        if (JOY_NEW(DPAD_UP))
+            *pos = (*pos == 0) ? CheatBossCount() - 1 : *pos - 1;
+        else
+            *pos = (*pos == CheatBossCount() - 1) ? 0 : *pos + 1;
+        BossMenu_DrawCursor(*pos, TRUE);
+        CopyWindowToVram(0, COPYWIN_GFX);
+        PlaySE(SE_SELECT);
+    }
+    else if (JOY_NEW(A_BUTTON))
+    {
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+        gTasks[taskId].func = Task_BossMenuStart;
+    }
+    else if (JOY_NEW(B_BUTTON))
+    {
+        DoSoftReset();
+    }
+}
+
+void CB2_InitBossMenu(void)
+{
+    u32 i;
+
+    SetVBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    SetGpuReg(REG_OFFSET_BG0CNT, 0);
+    SetGpuReg(REG_OFFSET_BG0HOFS, 0);
+    SetGpuReg(REG_OFFSET_BG0VOFS, 0);
+    DmaFill16(3, 0, (void *)VRAM, VRAM_SIZE);
+    DmaFill32(3, 0, (void *)OAM, OAM_SIZE);
+    DmaFill16(3, 0, (void *)(PLTT + 2), PLTT_SIZE - 2);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplate, NELEMS(sBgTemplate));
+    ChangeBgX(0, 0, 0);
+    ChangeBgY(0, 0, 0);
+    InitWindows(sBossWindowTemplate);
+    DeactivateAllTextPrinters();
+    LoadPalette(sBg_Pal, BG_PLTT_ID(0), sizeof(sBg_Pal));
+    LoadPalette(sTextbox_Pal, BG_PLTT_ID(15), sizeof(sTextbox_Pal));
+    SetGpuReg(REG_OFFSET_WININ, 0);
+    SetGpuReg(REG_OFFSET_WINOUT, 0);
+    SetGpuReg(REG_OFFSET_BLDCNT, 0);
+    SetGpuReg(REG_OFFSET_BLDALPHA, 0);
+    SetGpuReg(REG_OFFSET_BLDY, 0);
+    LoadStdWindowGfx(0, 0x1B1, BG_PLTT_ID(2));
+    FillWindowPixelBuffer(0, PIXEL_FILL(10));
+    for (i = 0; i < CheatBossCount(); i++)
+        AddTextPrinterParameterized3(0, FONT_NORMAL, 14, i * 16, sTextColor1, -1, gTrainers[CheatBossTrainer(i)].trainerName);
+    BossMenu_DrawCursor(0, TRUE);
+    MainMenu_DrawWindow(&sBossWindowTemplate[0]); // the frame first: it writes over the window's place
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_OBJ_1D_MAP | DISPCNT_OBJ_ON | DISPCNT_BG0_ON);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    SetVBlankCallback(VBlankCB_MainMenu);
+    SetMainCallback2(CB2_MainMenu);
+    CreateTask(Task_BossMenu, 0);
+}
+
+static void Task_OpenBossMenu(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        FreeAllWindowBuffers();
+        DestroyTask(taskId);
+        SetMainCallback2(CB2_InitBossMenu);
+    }
+}
