+class Group:
+    def __init__(self, family, data, unit, section, rank):
+        self.family = family
+        self.data = data                 # encoded bytes: the true identity of the string
+        self.key = (family, data)
+        self.units = [unit]
+        self.english = to_friendly(unit.text)
+        self.section, self.rank = section, rank
+        self.han = None                  # typed by a person
+        self.final = None                # what goes in the game
+        self.fit_units = []              # the places it fits
+        self.source = ""
+        self.notes = []
+        self.similar = ""
+
+    @property
+    def dialogue(self):
+        """Shown in the ordinary two-line text box: everything a map script says."""
+        return any(u.kind == "asm" and u.path.startswith("data/maps/") for u in self.units)
