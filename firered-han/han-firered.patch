+#!/usr/bin/env python3
+"""Puts together a trainer from the layers of the "Pokémon Gen 3 Trainer" pack (Jordan Bunke, itch.io), the way the
+pack's own manifest.tds does it, and writes a test sheet.
+
+    python3 tools/han/han_pok3.py [PACK_FOLDER] [OUT.png]
+
+The pack is someone else's art. It is NOT in this repository, the patch or the zip: whoever builds puts the folder
+(called pok3) next to the pokefirered folder, or sets HAN_POK3 to its path. Nothing here copies any of its pictures;
+this file only reads them.
+
+A look is a dict:
+  body      "default-male" | "default-female"
+  head      "standard-head" | "small-head" | "square-jaw"
+  eyes      "default" | "bushy" | ...
+  hair      a name from bases/hair, or None
+  hat       a name from bases/hat, or None
+  top, bottom, shoes   a name from bases/dm-top (df-top...) etc, or None
+  outfit    a name from bases/dm-outfit, or None (a combined outfit replaces top and bottom)
+  skin, hair_col, brow_col, eye_col   (r, g, b)
+  cloth     a list of (r, g, b): the colours of the hat, outfit, top and so on, per the pack's colour slots
+"""
+import colorsys
+import os
+import sys
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+
+BASE_SKIN = (0xb8, 0xf8, 0xb8)
+BASE_HAIR = (0xb0, 0xb0, 0xf8)
+BASE_IRIS = (0xff, 0x00, 0x00)
+BASE_EYE_WHITE = (0x00, 0xff, 0xff)
+BASE_CLOTH = [(0xf0, 0x80, 0x80), (0xf0, 0xb8, 0x80), (0xf0, 0xf0, 0x80), (0xb8, 0xf0, 0x80)]
+SKIN = {(0xb8, 0xf8, 0xb8), (0x98, 0xe8, 0x98), (0x70, 0xd8, 0x70)}
+OUTLINE = {(0x55, 0x78, 0x40), (0x36, 0x40, 0x30)}
+HAIR = {(0xb0, 0xb0, 0xf8), (0x80, 0x80, 0xf0), (0x48, 0x48, 0xc8), (0x30, 0x30, 0x70)}
+IRIS = {(0xff, 0x00, 0x00), (0x88, 0x48, 0x48)}
+EYE_WHITE = {(0x00, 0xff, 0xff), (0xa8, 0xd8, 0xd8)}
+CLOTH = [
+    {(0xf0, 0x80, 0x80), (0xf8, 0xb0, 0xb0), (0xc8, 0x48, 0x48), (0x70, 0x30, 0x30)},
+    {(0xf0, 0xb8, 0x80), (0xf8, 0xd4, 0xb0), (0xc8, 0x88, 0x48), (0x70, 0x50, 0x30)},
+    {(0xf0, 0xf0, 0x80), (0xf8, 0xf8, 0xb0), (0xc8, 0xc8, 0x48), (0x70, 0x70, 0x30)},
+    {(0xb8, 0xf0, 0x80), (0xd4, 0xf8, 0xb0), (0x88, 0xc8, 0x48), (0x50, 0x70, 0x30)},
+]
+
+# The swatches the pack offers (from manifest.tds)
+SKIN_SWATCHES = [(0xf8, 0xd0, 0xb8), (0xa8, 0x80, 0x50), (0xc8, 0x90, 0x60), (0xf8, 0xe0, 0xb8), (0x98, 0x68, 0x60), (0x98, 0x68, 0x40), (0x58, 0x40, 0x2e)]
+HAIR_SWATCHES = [(0x40, 0x40, 0x40), (0x34, 0x28, 0x20), (0x4b, 0x38, 0x2c), (0x68, 0x48, 0x28), (0x82, 0x66, 0x2d), (0xb2, 0x86, 0x4b),
+                 (0xc4, 0xb8, 0x80), (0xde, 0xdb, 0xb8), (0x88, 0x84, 0x80), (0xc4, 0xbe, 0xb8)]
+EYE_SWATCHES = [(0x7b, 0x41, 0x41), (0x8b, 0x8b, 0x94), (0x52, 0x20, 0x41), (0x44, 0x25, 0x25)]
+CLOTHES_SWATCHES = [(0xcb, 0xcb, 0xce), (0x38, 0x38, 0x38), (0xe0, 0x60, 0x40), (0x40, 0x60, 0xe0), (0xa0, 0x40, 0xe0), (0x30, 0x9e, 0xa4),
+                    (0xc0, 0x70, 0x9c), (0x70, 0xc0, 0x70), (0xf8, 0xb0, 0x20), (0x78, 0x40, 0x40), (0x60, 0x90, 0x38), (0x98, 0x90, 0x90)]
+
+# 40 by 40 frames. Rows: S, W, E, N. Columns: walk 0-2 (1 is standing), run 3-5, bike 6-8, fish 9-12, surf 13-14, ball 15-18.
+DIRS = ["S", "W", "E", "N"]
+
+
+def pack_dir():
+    for p in (os.environ.get("HAN_POK3"), ROOT.parent / "pok3", Path.cwd() / "pok3"):
+        if p and Path(p).joinpath("bases").is_dir():
+            return Path(p)
+    return None
+
+
+def hsv(c):
+    return colorsys.rgb_to_hsv(c[0] / 255, c[1] / 255, c[2] / 255)
+
+
+def from_hsv(h, s, v):
+    r, g, b = colorsys.hsv_to_rgb(h % 1.0, s, v)
+    return (round(r * 255), round(g * 255), round(b * 255))
+
+
+def derive(pixel, base, chosen, outline=False):
+    """The pack's replacement: the chosen colour's hue, and saturation and value scaled by how this pixel
+    differs from the base colour."""
+    ph, ps, pv = hsv(pixel)
+    bh, bs, bv = hsv(base)
+    ch, cs, cv = hsv(chosen)
+    s = min(1.0, max(0.0, cs * ps / bs)) if bs else cs
+    v = min(1.0, max(0.0, cv * pv / bv)) if bv else cv
+    if outline:
+        return from_hsv(ch - (bh - ph), s, v)
+    return from_hsv(ch, s, v)
+
+
+class Pack:
+    def __init__(self, folder):
+        self.dir = Path(folder)
+        self.cache = {}
+
+    def names(self, layer):
+        csv = (self.dir / "bases" / layer / (layer + ".csv")).read_text().strip()
+        return [x.split(":")[0] for x in csv.split(",")]
+
+    def counts(self, layer):
+        csv = (self.dir / "bases" / layer / (layer + ".csv")).read_text().strip()
+        return {x.split(":")[0]: int(x.split(":")[1]) if ":" in x else 0 for x in csv.split(",")}
+
+    def image(self, layer, name):
+        key = (layer, name)
+        if key not in self.cache:
+            self.cache[key] = Image.open(self.dir / "bases" / layer / (name + ".png")).convert("RGBA")
+        return self.cache[key].copy()
+
+
+def recolour(im, mapping):
+    """mapping: function (r, g, b) -> (r, g, b) or None."""
+    px = im.load()
+    memo = {}
+    for y in range(im.height):
+        for x in range(im.width):
+            r, g, b, a = px[x, y]
+            if not a:
+                continue
+            k = (r, g, b)
+            if k not in memo:
+                memo[k] = mapping(k)
+            m = memo[k]
+            if m:
+                px[x, y] = (m[0], m[1], m[2], a)
+    return im
+
+
+def role_mapper(sels, influences):
+    """sels: colours of the layer's own slots (cloth sets 0..n-1). influences: [skin, hair, iris] colours that follow."""
+    n = len(sels)
+    skin, hair, iris = (list(influences) + [None, None, None])[:3]
+
+    def f(c):
+        for i in range(n):
+            if c in CLOTH[i]:
+                return derive(c, BASE_CLOTH[i], sels[i])
+        if c in SKIN or c in OUTLINE:
+            return derive(c, BASE_SKIN, skin, outline=c in OUTLINE) if skin else None
+        if c in HAIR:
+            return derive(c, BASE_HAIR, hair) if hair else None
+        if c in IRIS:
+            return derive(c, BASE_IRIS, iris) if iris else None
+        return None
+    return f
+
+
+def head_offset(d, anim, frame):
+    rock3 = lambda f: f - 1 if f % 2 == 0 else 0
+    fish_side = lambda f: 3 if f == 0 else (1 if f == 2 else 2)
+    x = 0
+    if anim == "cycle":
+        x = rock3(frame)
+    elif anim == "fish":
+        if d == "S": x = 0 if frame == 3 else 1
+        elif d == "N": x = 0 if frame > 1 else -1
+        elif d == "E": x = -fish_side(frame)
+        else: x = fish_side(frame)
+    elif anim == "ball":
+        x = -1 if frame in (1, 4) else 0
+    elif anim == "surf":
+        x = 1 if d == "W" else (-1 if d == "E" else 0)
+    if anim in ("idle", "walk"):
+        y = 2 if d == "S" else (4 if d == "N" else 3)
+    elif anim == "run":
+        y = 2 + (0 if d == "S" else 1)
+    elif anim == "cycle":
+        y = 1 + (1 if d == "N" else 0)
+    elif anim == "surf":
+        y = -6 if d == "S" else (-4 if d == "N" else -5)
+    elif anim == "fish":
+        y = -4 if d == "S" else 3
+    elif anim == "ball":
+        y = 2
+    else:
+        y = 0
+    if anim in ("walk", "run"):
+        y += 1 if frame != 1 else 0
+    elif anim == "surf":
+        y += frame
+    elif anim == "fish":
+        if d == "N": y += -1 if frame == 3 else 0
+        elif d == "S": y += 1 if frame == 2 else 0
+        else: y += 1 if frame % 2 == 0 else 0
+    elif anim == "ball":
+        y += -1 if frame == 3 else 0
+    return x, y
+
+
+# (animation, first column, frames)
+ANIMS = [("walk", 0, 3), ("idle", 1, 1), ("run", 3, 3), ("cycle", 6, 3), ("fish", 9, 4), ("surf", 13, 2), ("ball", 15, 4)]
+
+
+def head_sheet(pack, look):
+    """The back parts (behind the body) and the front parts of the head, each a 100 by 20 sheet."""
+    skin = look["skin"]
+    hair_n = pack.counts("hair").get(look.get("hair"), 0) + 1 if look.get("hair") else 0
+    hat_n = pack.counts("hat").get(look.get("hat"), 0) if look.get("hat") else 0
+    cloth = look.get("cloth", [])
+
+    def hair_img(layer):
+        im = pack.image(layer, look["hair"])
+        sels = ([look.get("acc1", CLOTHES_SWATCHES[2]), look.get("acc2", CLOTHES_SWATCHES[3])] + [look["hair_col"]])[-hair_n:] if hair_n > 1 else [look["hair_col"]]
+        # the layer's own colours: accessory sets first, then the influences: skin, hair
+        own = sels[:-1] if hair_n > 1 else []
+        return recolour(im, role_mapper(own, [skin, look["hair_col"]]))
+
+    front = Image.new("RGBA", (100, 20))
+    back = Image.new("RGBA", (100, 20))
+    head = recolour(pack.image("head", look["head"]), role_mapper([], [skin]))
+    front.alpha_composite(head)
+    eyes_src = recolour(pack.image("eyes", look["eyes"]), role_mapper([], [skin, look["brow_col"], look["eye_col"]]))
+    eyes = Image.new("RGBA", (100, 20))
+    for x in range(4):
+        eyes.alpha_composite(eyes_src.crop((x * 20, 0, x * 20 + 20, 20)), (x * 20, 0))
+    eyes.alpha_composite(eyes_src.crop((0, 0, 20, 20)), (80, 0))
+    front.alpha_composite(eyes)
+    if look.get("hair"):
+        hair = hair_img("hair")
+        if look.get("hat"):
+            mask = pack.image("hat-mask", look["hat"])
+            hp, mp = hair.load(), mask.load()
+            for y in range(20):
+                for x in range(100):
+                    if mp[x, y][3]:
+                        hp[x, y] = (0, 0, 0, 0)
+        front.alpha_composite(hair)
+    if look.get("hat"):
+        front.alpha_composite(recolour(pack.image("hat", look["hat"]), role_mapper(cloth[:hat_n], [])))
+    if look.get("hair"):
+        fp = hair_img("hair-front")
+        front.alpha_composite(fp)
+        bk = hair_img("hair-back")
+        if look.get("hat"):
+            mask = pack.image("hat-back-mask", look["hat"])
+            bp, mp = bk.load(), mask.load()
+            for y in range(20):
+                for x in range(100):
+                    if mp[x, y][3]:
+                        bp[x, y] = (0, 0, 0, 0)
+        back.alpha_composite(bk)
+    if look.get("hat"):
+        back.alpha_composite(recolour(pack.image("hat-back", look["hat"]), role_mapper(cloth[:hat_n], [])))
+    return back, front
+
+
+def compose(pack, look):
+    """The whole sheet: 19 columns by 4 rows of 40 by 40, as RGBA."""
+    skin = look["skin"]
+    male = look["body"] == "default-male"
+    pre = "dm" if male else "df"
+    body = recolour(pack.image("body", look["body"]), role_mapper([], [skin]))
+    cloth = look.get("cloth", [])
+    layers = []
+    if look.get("outfit"):
+        n = pack.counts(pre + "-outfit").get(look["outfit"], 1)
+        layers.append(recolour(pack.image(pre + "-outfit", look["outfit"]), role_mapper(cloth[:n], [])))
+    else:
+        for part in ("top", "bottom", "shoes"):
+            if look.get(part):
+                n = pack.counts("%s-%s" % (pre, part)).get(look[part], 1)
+                layers.append(recolour(pack.image("%s-%s" % (pre, part), look[part]), role_mapper(cloth[:n], [])))
+    back, front = head_sheet(pack, look)
+    sheet = Image.new("RGBA", (19 * 40, 160))
+    for ri, d in enumerate(DIRS):
+        for anim, c0, nf in ANIMS:
+            for f in range(nf):
+                col = c0 + f
+                cell = Image.new("RGBA", (40, 40))
+                hx = DIRS.index(d) if not (d == "S" and anim == "run") else 4
+                ox, oy = head_offset(d, anim, f)
+                if not (anim == "ball" and d != "S"):
+                    cell.alpha_composite(back.crop((hx * 20, 0, hx * 20 + 20, 20)), (10 + ox, 10 + oy)) if 10 + ox >= 0 and 10 + oy >= 0 else None
+                cell.alpha_composite(body.crop((col * 40, ri * 40, col * 40 + 40, ri * 40 + 40)))
+                for lay in layers:
+                    cell.alpha_composite(lay.crop((col * 40, ri * 40, col * 40 + 40, ri * 40 + 40)))
+                if not (anim == "ball" and d != "S"):
+                    cell.alpha_composite(front.crop((hx * 20, 0, hx * 20 + 20, 20)), (10 + ox, 10 + oy))
+                sheet.alpha_composite(cell, (col * 40, ri * 40))
+    return sheet
+
+
+def snap(im):
+    """To the GBA's 15 bits a colour: each channel to a multiple of 8."""
+    px = im.load()
+    for y in range(im.height):
+        for x in range(im.width):
+            r, g, b, a = px[x, y]
+            if a:
+                px[x, y] = (r & 0xF8, g & 0xF8, b & 0xF8, 255)
+    return im
+
+
+def colours(im):
+    return {p[:3] for p in im.get_flattened_data() if p[3]} if hasattr(im, "get_flattened_data") else {p[:3] for p in im.getdata() if p[3]}
+
+
+def default_look(pack, male=True):
+    return {"body": "default-male" if male else "default-female", "head": "standard-head", "eyes": "default",
+            "hair": "anime" if male else "ponytail", "hat": None, "top": "t-shirt", "bottom": "pants", "shoes": "simple", "outfit": None,
+            "skin": SKIN_SWATCHES[0], "hair_col": HAIR_SWATCHES[2], "brow_col": HAIR_SWATCHES[2], "eye_col": EYE_SWATCHES[0],
+            "cloth": [CLOTHES_SWATCHES[3], CLOTHES_SWATCHES[1], CLOTHES_SWATCHES[0]]}
+
+
+def main(argv):
+    folder = Path(argv[1]) if len(argv) > 1 else pack_dir()
+    out = Path(argv[2]) if len(argv) > 2 else Path("pok3_test.png")
+    if not folder:
+        sys.exit("han_pok3.py: the pack folder (pok3) was not found. Put it next to pokefirered, or give its path.")
+    pack = Pack(folder)
+    looks = []
+    for male in (True, False):
+        base = default_look(pack, male)
+        looks.append(base)
+        looks.append(dict(base, hair="afro", skin=SKIN_SWATCHES[4], hair_col=HAIR_SWATCHES[0], hat="yakyu-cap", cloth=[CLOTHES_SWATCHES[2], CLOTHES_SWATCHES[1], CLOTHES_SWATCHES[8]], eyes="intense"))
+    rows = []
+    sheets = [snap(compose(pack, lk)) for lk in looks]
+    for sh, lk in zip(sheets, looks):
+        print(lk["body"], lk["hair"], lk["hat"], "colours in the sheet:", len(colours(sh)))
+    # standing frames (column 1) and walking (0,2), all four directions, for each look
+    img = Image.new("RGBA", (len(looks) * 3 * 40, 4 * 40), (110, 150, 110, 255))
+    for i, sh in enumerate(sheets):
+        for ri in range(4):
+            for k, col in enumerate((0, 1, 2)):
+                img.alpha_composite(sh.crop((col * 40, ri * 40, col * 40 + 40, ri * 40 + 40)), ((i * 3 + k) * 40, ri * 40))
+    img = img.resize((img.width * 3, img.height * 3), Image.NEAREST)
+    img.save(out)
+    print("wrote", out)
+
+
+if __name__ == "__main__":
+    main(sys.argv)
