+# The plan: what is meant to be translated. Everything else stays English
+# unless somebody types it. Change these lists to change the plan.
+PLAN_OUT_FAMILIES = {"Trainer classes", "Trainer names", "Item names", "Pokémon names", "Abilities", "Natures"}
+# Side features among the shared scripts. "trainers" is the VS SEEKER rematch lines.
+PLAN_OUT_SCRIPTS = {"help_system", "fame_checker", "trainers", "cable_club", "trainer_card", "pokedude",
+                    "mystery_event_club", "mystery_event_msg"}
