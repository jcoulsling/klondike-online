+// while another of her POKéMON can still come in. The UNOWN is known by its own move.
+static bool8 IsAceHeldBack(s32 monId)
+{
+    s32 i;
+    u8 battlerIn1 = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+    u8 battlerIn2 = battlerIn1;
+
+    if (!(gBattleTypeFlags & BATTLE_TYPE_TRAINER))
+        return FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (GetMonData(&gEnemyParty[monId], MON_DATA_MOVE1 + i) == MOVE_UNOWN_STRIKES)
+            break;
+    }
+    if (i == MAX_MON_MOVES)
+        return FALSE; // not the ace
+
+    if (gBattleTypeFlags & BATTLE_TYPE_DOUBLE)
+        battlerIn2 = GetBattlerAtPosition(B_POSITION_OPPONENT_RIGHT);
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (i == monId
+         || GetMonData(&gEnemyParty[i], MON_DATA_HP) == 0
+         || GetMonData(&gEnemyParty[i], MON_DATA_SPECIES_OR_EGG) == SPECIES_NONE
+         || GetMonData(&gEnemyParty[i], MON_DATA_SPECIES_OR_EGG) == SPECIES_EGG
+         || (i == gBattlerPartyIndexes[battlerIn1] && !(gAbsentBattlerFlags & gBitTable[battlerIn1]))
+         || (i == gBattlerPartyIndexes[battlerIn2] && !(gAbsentBattlerFlags & gBitTable[battlerIn2]))
+         || i == *(gBattleStruct->monToSwitchIntoId + battlerIn1)
+         || i == *(gBattleStruct->monToSwitchIntoId + battlerIn2))
+            continue;
+        return TRUE; // this one can come in first
+    }
+    return FALSE;
+}
