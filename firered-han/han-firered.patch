diff --git a/include/han_custom.h b/include/han_custom.h
new file mode 100644
index 0000000..7440cbe
--- /dev/null
+++ b/include/han_custom.h
@@ -0,0 +1,54 @@
+#ifndef GUARD_HAN_CUSTOM_H
+#define GUARD_HAN_CUSTOM_H
+
+// Hän build: the character customizer. The look is 16 bytes in the save (gSaveBlock2Ptr->hanLook); the game puts the
+// player's overworld pictures and palette together from it while it runs (see tools/han/han_custom.py).
+
+#define HAN_LOOK_SIZE 16
+#define HAN_LOOK_SET   0 // 1 once a look was made
+#define HAN_LOOK_HEAD  1
+#define HAN_LOOK_EYES  2
+#define HAN_LOOK_HAIR  3 // 0 none, then the pack's hairs
+#define HAN_LOOK_HAT   4 // 0 none, then the pack's hats
+#define HAN_LOOK_OUTFIT 5 // 0 top, trousers and shoes; 1 gi; 2 dress with apron
+#define HAN_LOOK_SKIN  6
+#define HAN_LOOK_HAIRCOL 7
+#define HAN_LOOK_EYECOL 8
+#define HAN_LOOK_COL_A 9
+#define HAN_LOOK_COL_B 10
+#define HAN_LOOK_COL_C 11
+#define HAN_LOOK_PIC   12 // the big pictures: 0 the game's own, then the pictures of other trainers (see han_custom.py)
+
+#define HAN_LOOK_PAL   13 // the palette of the big picture: 0 the original, 1..7 rainbow, 8 black, 9 white, 10 and 11 others
+#define HAN_ROWS 13 // the parts shown on the customizer screen, HAN_LOOK_HEAD onwards
+
+extern u16 gHanPlayerPal[16];
+extern u16 gHanPlayerReflPal[16];
+extern bool8 gHanQuick;
+
+void HanCustomHeapReset(void); // the heap was started again: the pictures kept in it are gone
+u8 HanPicStep(u8 pic, s8 dir, u8 gender); // the next picture that suits MALE or FEMALE
+u8 HanPicFits(u8 pic, u8 gender);
+u8 HanPicNumber(u8 pic); // the number the customizer shows for a picture
+u8 HanLookMax(u8 part); // how many choices a part has (including "none" where there is one); 0 if there is no customizer
+void HanLookDefault(void);
+void HanLookRandom(void);
+bool8 HanCustomMake(void);       // TRUE when the pictures were made (again), FALSE when nothing changed
+const u8 *HanCustomFrames(void); // 18 frames of 256 bytes, or NULL
+const u16 *HanCustomPalette(void);
+const u16 *HanCustomReflPalette(void);
+
+const struct SpriteFrameImage *HanBackImages(void);
+u8 HanBackPicId(void); // which back picture the player is shown with in battle
+bool8 HanBackPalette(u8 id, u16 offset);
+u16 HanLinkOppPic(void);
+void HanLinkOppPalette(u8 paletteNum); // the battle sprite of a chosen picture (all five frames), or NULL
+bool8 HanOwLook(u16 *gfx, const u16 **pal, u16 *key); // the walking picture: object graphics id, ROM palette, a key that changes with them
+void HanLookPicPal(u8 *pic, u8 *pal);
+bool8 HanStateFrames(u8 kind, struct SpriteFrameImage *out); // bike, surf, fishing, item, VS Seeker bike frames of the chosen character
+bool8 HanOwFor(u8 pic, u8 pal, u16 *gfx, const u16 **colours);
+void HanReflectionOf(const u16 *pal, u16 *out);
+bool8 HanOakPic(u8 *dest); // the chosen character on the Oak speech screens: TRUE if it was put in video memory
+bool8 HanCustomPicData(const void *src, void *dest); // the palette of the player's front or back picture: writes the recoloured one
+
+#endif // GUARD_HAN_CUSTOM_H
diff --git a/include/han_follower.h b/include/han_follower.h
new file mode 100644
index 0000000..e131f4d
--- /dev/null
+++ b/include/han_follower.h
@@ -0,0 +1,31 @@
+#ifndef GUARD_HAN_FOLLOWER_H
+#define GUARD_HAN_FOLLOWER_H
+
+struct Pokemon;
+
+// Hän build: the first Pokémon of the party walks behind the player on the overworld (src/han_follower.c).
+#define OBJ_EVENT_PAL_TAG_HAN_FOLLOWER 0x1122
+
+extern struct SpriteFrameImage gHanFollowImages[9];
+extern u16 gHanFollowPal[16];
+u16 HanFollowSpecies(void); // species (bit 15 shiny) of the follower now drawn, 0 for none
+u8 HanGhostFollowerCreate(u16 what, u16 palTag); // another player's follower; MAX_SPRITES if it cannot be made
+u8 HanWildSpriteCreate(u16 n, u16 palTag, u8 *palIdx, bool8 load); // a Wild Area Pokémon
+bool8 HanWildHasSprite(u16 n);
+void HanMonMakeShiny(struct Pokemon *mon, bool8 shiny); // src/han_wild.c: the same Pokémon made shiny or not
+void HanMonCharmRoll(struct Pokemon *mon); // with the SHINY CHARM, a wild Pokémon is shiny one time in five
+void HanWildFrame(void); // src/han_wild.c
+bool8 HanWildCollision(void); // the player has bumped into a Wild Area Pokémon: a battle starts
+void HanWildEdgeX(void);
+bool8 HanWildDiveCheck(s16 x, s16 y);
+bool8 HanWildDigIce(void);
+bool8 HanWildDigIceActive(void);
+void HanWildMakeHole(void);
+u8 HanWildOldManParty(struct Pokemon *party);
+void HanGhostFollowerDestroy(u8 id, u16 palTag);
+void HanFollowerWarped(void); // a warp is starting: the next map shows the follower leaving its ball
+void HanFollowerRecall(void); // the player steps into a warp: the follower goes back into its ball
+void HanFollowerFrame(void); // every frame of the overworld, after the camera has moved
