+    gSprites[sCursorId].y = sHanHoennFlyTowns[sSel].y;
+}
+
+static void Move(s8 dx, s8 dy)
+{
+    u8 i, best = sSel;
+    s32 bestScore = 0x7FFFFFFF;
+    s32 ddx, ddy, score;
+
+    for (i = 0; i < HOENN_FLY_COUNT; i++)
+    {
+        if (i == sSel || !FlagGet(VISIT_FLAG(i)))
+            continue;
+        ddx = (s32)sHanHoennFlyTowns[i].x - sHanHoennFlyTowns[sSel].x;
+        ddy = (s32)sHanHoennFlyTowns[i].y - sHanHoennFlyTowns[sSel].y;
+        if (dx != 0 && ddx * dx <= 0)
+            continue;
+        if (dy != 0 && ddy * dy <= 0)
+            continue;
+        if (dx != 0)
+            score = abs(ddx) + 2 * abs(ddy);
+        else
+            score = abs(ddy) + 2 * abs(ddx);
+        if (score < bestScore)
+        {
+            bestScore = score;
+            best = i;
+        }
+    }
+    if (best != sSel)
+    {
+        sSel = best;
+        PlaySE(SE_DEX_SCROLL);
+        ShowName();
+    }
+}
+
+void CB2_OpenHanHoennFly(void)
