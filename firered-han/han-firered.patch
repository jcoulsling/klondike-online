+static void ShowName(void)
+{
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 4, 1, (const u8[]){1, 2, 3}, 0, sHanHoennNames[sHanHoennFlyTowns[sSel].mapsec]);
+    CopyWindowToVram(0, COPYWIN_FULL);
