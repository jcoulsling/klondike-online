+#define HOENN_FLY_COUNT ARRAY_COUNT(sHanHoennFlyTowns)
+#define VISIT_FLAG(i) (HAN_HOENN_FLAG_BASE + 480 + (i)) // a town can be flown to once the player has stood in it
+
+// Called every frame of the overworld: standing in a Hoenn fly town unlocks it.
+void HanHoennVisitFrame(void)
+{
+    u8 i, sec = GetCurrentRegionMapSectionId();
+
+    if (sec >= KANTO_MAPSEC_START)
+        return;
+    for (i = 0; i < HOENN_FLY_COUNT; i++)
+        if (sHanHoennFlyTowns[i].mapsec == sec && !FlagGet(VISIT_FLAG(i)))
+            FlagSet(VISIT_FLAG(i));
+}
+
+void HanHoennVisitAll(void)
+{
+    u8 i;
+
+    for (i = 0; i < HOENN_FLY_COUNT; i++)
+        FlagSet(VISIT_FLAG(i));
+}
+
+static const u8 sText_Hint[] = _("{SELECT_BUTTON}SWITCH REGION");
+
+static const u32 sMapTiles[] = INCBIN_U32("graphics/han_hoenn_map/map.8bpp.lz");
+static const u32 sMapTilemap[] = INCBIN_U32("graphics/han_hoenn_map/map.bin.lz");
+static const u16 sMapPal[] = INCBIN_U16("graphics/han_hoenn_map/map.gbapal");
+static const u8 sCursorGfx[] = INCBIN_U8("graphics/han_hoenn_map/cursor_small.4bpp");
+static const u16 sCursorPal[] = INCBIN_U16("graphics/han_hoenn_map/cursor.gbapal");
+
+static const struct BgTemplate sBgTemplates[] = {
+    { .bg = 1, .charBaseIndex = 1, .mapBaseIndex = 27, .screenSize = 0, .paletteMode = 0, .priority = 0, .baseTile = 0 },
+    { .bg = 2, .charBaseIndex = 0, .mapBaseIndex = 28, .screenSize = 3, .paletteMode = 1, .priority = 1, .baseTile = 0 },
+};
+
