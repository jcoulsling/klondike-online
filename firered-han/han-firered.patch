index 0000000..c62ef35
--- /dev/null
+++ b/tools/han/han_sylveon.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""The pictures of MANDI's SYLVEON, made at build time.
+
+    python3 tools/han/han_sylveon.py          at each build (han_emerald.py runs it)
+
+The game has no SYLVEON: it came in a later game. Jane asked for one on MANDI's team and sent a picture
+of it (17 November 2026): four drawings in a square, front and back, each in its usual colours (left)
+and its rare colours (right). The picture is the later games' art, so it is in neither git nor the patch.
+Whoever builds puts it next to the pokefirered folder as sylveon.png (or sets HAN_SYLVEON to its path).
+
+What this writes, none of it in git, in graphics/pokemon/sylveon/:
+  front.png    the front drawing made to fit 64 by 64, twice (the game's front pictures have two frames)
+  back.png     the back drawing made to fit 64 by 64
+  normal.pal   the colours of the two left drawings (fifteen at most)
+  shiny.pal    for each of those colours, the colour the right drawings have in the same places
+
+Without the picture the game is built all the same, and the SYLVEON is shown as the game's "??" picture.
+"""
+import io
+import os
+import shutil
+import sys
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+HERE = ROOT / "graphics/pokemon/sylveon"
+BLANK = ROOT / "graphics/pokemon/question_mark/double"
+
+
+def put(path, data):
+    if not path.exists() or path.read_bytes() != data:
+        path.write_bytes(data)
+
+
+def jasc(colours):
+    colours = (list(colours) + [(0, 0, 0)] * 16)[:16]
+    return ("JASC-PAL\r\n0100\r\n16\r\n" + "".join("%d %d %d\r\n" % c for c in colours)).encode()
+
+
+def is_ground(p):
+    return p[3] < 128 or (p[0] > 245 and p[1] > 245 and p[2] > 245)
+
+
+def cut(im, box):
+    part = im.crop(box); px = part.load()
+    pts = [(x, y) for y in range(part.height) for x in range(part.width) if not is_ground(px[x, y])]
+    xs = [p[0] for p in pts]; ys = [p[1] for p in pts]
+    return part.crop((min(xs), min(ys), max(xs) + 1, max(ys) + 1))
+
+
+def main(argv):
+    HERE.mkdir(parents=True, exist_ok=True)
+    places = [os.environ.get("HAN_SYLVEON"), ROOT.parent / "sylveon.png"]
+    src = next((Path(p) for p in places if p and Path(p).is_file()), None)
+    if not src:
+        for mine, theirs in (("front.png", "emerald_front.png"), ("back.png", "emerald_back.png"),
+                             ("normal.pal", "emerald_normal.pal"), ("shiny.pal", "emerald_shiny.pal")):
+            put(HERE / mine, (BLANK / theirs).read_bytes())
+        print("han_sylveon.py: no picture found, so MANDI's SYLVEON is shown as ??")
+        return
+    im = Image.open(src).convert("RGBA")
+    w, h = im.width // 2, im.height // 2
+    parts = {"front": cut(im, (0, 0, w, h)), "front shiny": cut(im, (w, 0, 2 * w, h)),
+             "back": cut(im, (0, h, w, 2 * h)), "back shiny": cut(im, (w, h, 2 * w, 2 * h))}
+    light = lambda c: 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]
+    colours = sorted({p[:3] for k in ("front", "back") for p in parts[k].getdata() if not is_ground(p)}, key=light)
+    if len(colours) > 15:
+        sys.exit("han_sylveon.py: the two left drawings have %d colours; the game's pictures have fifteen" % len(colours))
+    # the rare colours: what the right drawing has where the left one has each colour
+    votes = {c: {} for c in colours}
+    for k in ("front", "back"):
+        a, b = parts[k], parts[k + " shiny"]
+        if a.size != b.size:
+            sys.exit("han_sylveon.py: the %s drawings are not the same size in the two colourings" % k)
+        for p, q in zip(a.getdata(), b.getdata()):
+            if not is_ground(p) and not is_ground(q):
+                votes[p[:3]][q[:3]] = votes[p[:3]].get(q[:3], 0) + 1
+    shiny = [max(votes[c], key=votes[c].get) if votes[c] else c for c in colours]
+
+    def frame(part, bottom):
+        scale = min(64 / part.width, 64 / part.height, 1.0)
+        sw, sh = max(1, round(part.width * scale)), max(1, round(part.height * scale))
+        small = part.resize((sw, sh), Image.NEAREST)        # no new colours
+        out = Image.new("P", (64, 64), 0)
+        spx, opx = small.load(), out.load()
+        x0, y0 = (64 - sw) // 2, (64 - sh) if bottom else (64 - sh) // 2
+        for y in range(sh):
+            for x in range(sw):
+                if not is_ground(spx[x, y]):
+                    opx[x0 + x, y0 + y] = 1 + colours.index(spx[x, y][:3])
+        return out
+
+    def save(image, path):
+        flat = []
+        for c in ([(144, 200, 160)] + colours + [(0, 0, 0)] * 16)[:16]:
+            flat += list(c)
+        image.putpalette(flat + [0] * (768 - len(flat)))
+        b = io.BytesIO(); image.save(b, "PNG", bits=4)
+        put(path, b.getvalue())
+
+    f = frame(parts["front"], False)
+    sheet = Image.new("P", (64, 128), 0)
+    sheet.paste(f, (0, 0)); sheet.paste(f, (0, 64))
+    save(sheet, HERE / "front.png")
+    save(frame(parts["back"], True), HERE / "back.png")
+    put(HERE / "normal.pal", jasc([(144, 200, 160)] + colours))
+    put(HERE / "shiny.pal", jasc([(144, 200, 160)] + shiny))
+    print("han_sylveon.py: MANDI's SYLVEON: %s, %d colours" % (src, len(colours)))
+
+
+if __name__ == "__main__":
+    main(sys.argv)
