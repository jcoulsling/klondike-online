+def too_long_units(log, placed):
+    """Units the compiler rejected because the text overran a fixed-size slot."""
+    found = []
+    for m in re.finditer(r"^(\S+?):(\d+): (?:warning|error): (?:excess elements|initializer-string)", log, re.M):
+        path, line = m.group(1), int(m.group(2))
+        for (first, last), u in placed.get(path, []):
+            if first <= line <= last:
+                found.append(u)
+    return found
+
