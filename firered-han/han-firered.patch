+#!/usr/bin/env python3
+"""Hän type labels for pokefirered.
+
+The coloured type labels on the summary screen, TM case and move tutor are
+pictures, not text. This redraws them from the type names in the workbook.
+
+Each label is 32 x 12 pixels. A name is drawn in capitals, in the large
+lettering the game uses when it fits, and in a smaller lettering when it is
+long. Types with no Hän name keep the game's own label.
+
+han_text.py calls this during a build. To look at the labels without building:
+    python3 tools/han/han_labels.py preview OUT.png "TYPE_FIRE=Kwän" "TYPE_WATER=Chu"
+"""
+import re
+import sys
+import unicodedata
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+SHEET = "graphics/interface/menu_info.png"
+INK, SHADOW = 31, 30                     # palette indices used by the stock labels
+GRAVE, DIAERESIS, OGONEK = "̀", "̈", "̨"
+
+# ---------------------------------------------------------------------------
+# Two alphabets. Rows run top to bottom, "#" is ink.
+# ---------------------------------------------------------------------------
+BIG = {  # 7 rows tall, like the game's own labels
+    "A": [".##.", "#..#", "#..#", "####", "#..#", "#..#", "#..#"],
+    "B": ["###.", "#..#", "#..#", "###.", "#..#", "#..#", "###."],
+    "C": [".##.", "#..#", "#...", "#...", "#...", "#..#", ".##."],
+    "D": ["###.", "#..#", "#..#", "#..#", "#..#", "#..#", "###."],
+    "E": ["####", "#...", "#...", "###.", "#...", "#...", "####"],
+    "F": ["####", "#...", "#...", "###.", "#...", "#...", "#..."],
+    "G": [".##.", "#..#", "#...", "#.##", "#..#", "#..#", ".###"],
+    "H": ["#..#", "#..#", "#..#", "####", "#..#", "#..#", "#..#"],
+    "I": ["###", ".#.", ".#.", ".#.", ".#.", ".#.", "###"],
+    "J": ["..##", "...#", "...#", "...#", "...#", "#..#", ".##."],
+    "K": ["#..#", "#.#.", "##..", "##..", "#.#.", "#..#", "#..#"],
+    "L": ["#...", "#...", "#...", "#...", "#...", "#...", "####"],
+    "Ł": [".#..", ".#..", ".##.", "##..", ".#..", ".#..", ".###"],
+    "M": ["#...#", "##.##", "#.#.#", "#.#.#", "#...#", "#...#", "#...#"],
+    "N": ["#..#", "##.#", "##.#", "#.##", "#.##", "#..#", "#..#"],
+    "O": [".##.", "#..#", "#..#", "#..#", "#..#", "#..#", ".##."],
+    "P": ["###.", "#..#", "#..#", "###.", "#...", "#...", "#..."],
+    "Q": [".##.", "#..#", "#..#", "#..#", "#.##", "#..#", ".###"],
+    "R": ["###.", "#..#", "#..#", "###.", "#.#.", "#..#", "#..#"],
+    "S": [".###", "#...", "#...", ".##.", "...#", "...#", "###."],
+    "T": ["###", ".#.", ".#.", ".#.", ".#.", ".#.", ".#."],
+    "U": ["#..#", "#..#", "#..#", "#..#", "#..#", "#..#", ".##."],
+    "V": ["#...#", "#...#", "#...#", ".#.#.", ".#.#.", "..#..", "..#.."],
+    "W": ["#...#", "#...#", "#...#", "#.#.#", "#.#.#", "##.##", "#...#"],
+    "X": ["#..#", "#..#", ".##.", ".##.", ".##.", "#..#", "#..#"],
+    "Y": ["#.#", "#.#", "#.#", ".#.", ".#.", ".#.", ".#."],
+    "Z": ["####", "...#", "..#.", ".#..", "#...", "#...", "####"],
+    "-": ["...", "...", "...", "###", "...", "...", "..."],
+    "'": [".#", ".#", "#.", "..", "..", "..", ".."],
+    " ": ["..", "..", "..", "..", "..", "..", ".."],
+}
+SMALL = {  # 5 rows tall, for long names
+    "A": [".#.", "#.#", "###", "#.#", "#.#"],
+    "B": ["##.", "#.#", "##.", "#.#", "##."],
+    "C": [".##", "#..", "#..", "#..", ".##"],
+    "D": ["##.", "#.#", "#.#", "#.#", "##."],
+    "E": ["###", "#..", "##.", "#..", "###"],
+    "F": ["###", "#..", "##.", "#..", "#.."],
+    "G": [".##", "#..", "#.#", "#.#", ".##"],
+    "H": ["#.#", "#.#", "###", "#.#", "#.#"],
+    "I": ["#", "#", "#", "#", "#"],
+    "J": ["..#", "..#", "..#", "#.#", ".#."],
+    "K": ["#.#", "#.#", "##.", "#.#", "#.#"],
+    "L": ["#..", "#..", "#..", "#..", "###"],
+    "Ł": [".#.", ".##", "##.", ".#.", ".##"],
+    "M": ["#.#", "###", "###", "#.#", "#.#"],
+    "N": ["###", "#.#", "#.#", "#.#", "#.#"],
+    "O": ["###", "#.#", "#.#", "#.#", "###"],
+    "P": ["##.", "#.#", "##.", "#..", "#.."],
+    "Q": ["###", "#.#", "#.#", "###", "..#"],
+    "R": ["##.", "#.#", "##.", "#.#", "#.#"],
+    "S": [".##", "#..", ".#.", "..#", "##."],
+    "T": ["###", ".#.", ".#.", ".#.", ".#."],
+    "U": ["#.#", "#.#", "#.#", "#.#", "###"],
+    "V": ["#.#", "#.#", "#.#", "#.#", ".#."],
+    "W": ["#...#", "#...#", "#.#.#", "#.#.#", ".#.#."],
+    "X": ["#.#", "#.#", ".#.", "#.#", "#.#"],
+    "Y": ["#.#", "#.#", ".#.", ".#.", ".#."],
+    "Z": ["###", "..#", ".#.", "#..", "###"],
+    "-": ["...", "...", "###", "...", "..."],
+    "'": ["#", "#", ".", ".", "."],
+    " ": [".", ".", ".", ".", "."],
+}
+SMALL_I_WIDE = ["###", ".#.", ".#.", ".#.", "###"]   # an I that can carry an accent
+
+
+def letters(text):
+    """Split a name into (base letter, set of marks)."""
+    d = unicodedata.normalize("NFD", text.upper())
+    out, i = [], 0
+    while i < len(d):
+        base, marks, j = d[i], set(), i + 1
+        while j < len(d) and unicodedata.combining(d[j]):
+            marks.add(d[j])
+            j += 1
+        if base in "\u2019\u02bc`":
+            base = "'"
+        out.append((base, marks & {GRAVE, DIAERESIS, OGONEK}))
+        i = j
+    return out
+
+
+def glyph(base, marks, size, bottom):
+    """Ink pixels (x, y) of one letter with its marks, y in label rows 0-11, and its width.
+
+    Rows above a letter, reading down: grave (2 rows), a gap, the two dots
+    (1 row), a gap, then the letter. A gap between every part keeps the marks
+    from running together."""
+    font = BIG if size == "big" else SMALL
+    if base not in font:
+        raise KeyError(base)
+    rows = list(font[base])
+    above = [m for m in (DIAERESIS, GRAVE) if m in marks]
+    if size == "small" and base == "I" and above:
+        rows = list(SMALL_I_WIDE)
+    if size == "big" and above:
+        # make room above the letter: one mark costs one row of height, two cost two
+        for drop in ([2] if len(above) == 1 else [5, 2]):
+            del rows[drop]
+    width = len(rows[0])
+    top = bottom - len(rows) + 1
+    px = [(x, top + y) for y, row in enumerate(rows) for x, ch in enumerate(row) if ch == "#"]
+    cx = width // 2
+    y = top - 2                                  # first free row above the gap
+    if DIAERESIS in marks:
+        px += [(0, y), (width - 1, y)]
+        y -= 2
+    if GRAVE in marks:
+        px += [(max(cx - 1, 0), y - 1), (max(cx, 1), y)]
+    if OGONEK in marks:
+        c = max(width - 2, 0)
+        px += [(c, bottom + 1), (c, bottom + 2), (c + 1, bottom + 2)]
+        width = max(width, c + 2)
+    return px, width
+
+
+def layout(text, size):
+    parts = letters(text)
+    # a letter with both dots and a grave needs one more row, so the whole name sits a row lower
+    bottom = 9 if any({DIAERESIS, GRAVE} <= marks for _, marks in parts) else 8
+    px, x = [], 0
+    for base, marks in parts:
+        g, w = glyph(base, marks, size, bottom)
+        px += [(x + gx, gy) for gx, gy in g]
+        x += w + 1
+    return px, x - 1
+
+
+def choose(text):
+    """Large lettering if the name fits the label, otherwise small."""
+    for size in ("big", "small"):
+        try:
+            px, width = layout(text, size)
+        except KeyError as e:
+            return None, None, "no label letter for %s" % e
+        fits = width <= 30 and all(0 <= y <= 11 for _, y in px)
+        if fits or size == "small":
+            if width > 31 or any(y < 0 or y > 11 for _, y in px):
+                return None, None, "too long for a label"
+            return px, width, None
+    return None, None, "too long for a label"
+
+
+def icon_cells():
+    """TYPE_X -> top-left pixel of its label, read from the game's own table."""
+    src = (ROOT / "src" / "list_menu.c").read_text()
+    cells = {}
+    for m in re.finditer(r"\[(TYPE_\w+) \+ 1\]\s*=\s*\{\s*32,\s*12,\s*(0x[0-9A-Fa-f]+)\s*\}", src):
+        tile = int(m.group(2), 16)
+        cells[m.group(1)] = ((tile % 16) * 8, (tile // 16) * 8)
+    return cells
+
+
+def draw(img, origin, text):
+    """Replace the lettering of one label. Returns a problem string, or None."""
+    px, width, problem = choose(text)
+    if problem:
+        return problem
+    x0, y0 = origin
+    # wipe the old letters back to each row's own background colour
+    for y in range(12):
+        row = [img.getpixel((x0 + x, y0 + y)) for x in range(32)]
+        plain = [c for c in row if c not in (0, INK, SHADOW)]
+        bg = max(set(plain), key=plain.count)
+        for x in range(32):
+            if row[x] in (INK, SHADOW):
+                img.putpixel((x0 + x, y0 + y), bg)
+    left = max((31 - width) // 2, 0)
+    ink = {(left + x, y) for x, y in px}
+    for x, y in ink:                       # drop shadow: right, below, and below right
+        for dx, dy in ((1, 0), (0, 1), (1, 1)):
+            sx, sy = x + dx, y + dy
+            if (sx, sy) not in ink and 0 <= sx < 32 and 0 <= sy < 12 and img.getpixel((x0 + sx, y0 + sy)) != 0:
+                img.putpixel((x0 + sx, y0 + sy), SHADOW)
+    for x, y in ink:
+        img.putpixel((x0 + x, y0 + y), INK)
+    return None
+
+
+def draw_type_labels(names, sheet_path=None):
+    """names: {"TYPE_FIRE": "Kwän", ...}. Redraws the sheet in place.
+    Returns {type: problem} for labels that could not be drawn."""
+    path = Path(sheet_path or ROOT / SHEET)
+    img = Image.open(path)
+    cells = icon_cells()
+    problems = {}
+    for type_name, text in sorted(names.items()):
+        if type_name not in cells:
+            continue
+        problem = draw(img, cells[type_name], text)
+        if problem:
+            problems[type_name] = problem
+    img.save(path)
+    return problems
+
+
+def preview(names, out):
+    img = Image.open(ROOT / SHEET)
+    cells = icon_cells()
+    for type_name, text in names.items():
+        problem = draw(img, cells[type_name], text)
+        if problem:
+            print(type_name, problem)
+    img.convert("RGB").resize((img.width * 6, img.height * 6), Image.NEAREST).save(out)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) >= 3 and sys.argv[1] == "preview":
+        preview(dict(a.split("=", 1) for a in sys.argv[3:]), sys.argv[2])
+    else:
+        sys.exit(__doc__)
