+// ---- Hän build: the character customizer is part of the boy and girl dialog (Jane, 23 November 2026).
+// One window: the first line is BOY or GIRL and Left or Right swaps it, the next two are PICTURE and PALETTE and Left
+// or Right slide them. Up and Down move the arrow, A takes what is shown. The character stands beside the dialog as
+// it is now, in the chosen palette. The look is in the save (src/han_custom.c).
+
+static const struct WindowTemplate sHanBoyGirl_WindowTemplate =
+{
+    .bg = 0,
+    .tilemapLeft = 12,
+    .tilemapTop = 8,
+    .width = 16,
+    .height = 5,
+    .paletteNum = 15,
+    .baseBlock = 545
+};
+
+static const u8 sHanText_Arrow[] = _("{RIGHT_ARROW}");
+static const u8 sHanText_ArrowL[] = _("{LEFT_ARROW}");
+static const u8 sHanText_Picture[] = _("Dòk");
+static const u8 sHanText_Palette[] = _("Jì Dënäkär");
+
+static void HanEd_ClosePreview(void)
+{
+    u8 i;
+
+    for (i = 0; i < 3; i++)
+    {
+        if (sOakSpeechResources->hanPrev[i] != MAX_SPRITES)
+            DestroySprite(&gSprites[sOakSpeechResources->hanPrev[i]]);
+        sOakSpeechResources->hanPrev[i] = MAX_SPRITES;
+    }
+    if (sOakSpeechResources->hanPic != 0xFFFF)
+        FreeAndDestroyTrainerPicSprite(sOakSpeechResources->hanPic);
+    sOakSpeechResources->hanPic = 0xFFFF;
+}
+
+// the character beside the dialog: the big picture, in its palette
+static void HanEd_ShowPreview(void)
+{
+    HanEd_ClosePreview();
+    sOakSpeechResources->hanPic = CreateTrainerPicSprite(PlayerGenderToFrontTrainerPicId(gSaveBlock2Ptr->playerGender, TRUE), TRUE, 50, 80, 5, TAG_NONE);
+}
+
+static void HanEd_Draw(void)
+{
+    struct OakSpeechResources *r = sOakSpeechResources;
+    u8 i;
+    u8 buf[8];
+    const u8 *label;
+
+    FillWindowPixelBuffer(r->hanWin, PIXEL_FILL(1));
+    for (i = 0; i < 3; i++)
+    {
+        r->textColor[0] = 1;
+        r->textColor[1] = 2;
+        r->textColor[2] = 3;
+        if (i == r->hanRow)
+        {
+            AddTextPrinterParameterized3(r->hanWin, FONT_NORMAL, 0, i * 13, r->textColor, 0, sHanText_Arrow);
+            AddTextPrinterParameterized3(r->hanWin, FONT_NORMAL, 78, i * 13, r->textColor, 0, sHanText_ArrowL);
+            AddTextPrinterParameterized3(r->hanWin, FONT_NORMAL, 114, i * 13, r->textColor, 0, sHanText_Arrow);
+        }
+        label = i == 0 ? (gSaveBlock2Ptr->playerGender == MALE ? gText_Boy : gText_Girl) : (i == 1 ? sHanText_Picture : sHanText_Palette);
+        AddTextPrinterParameterized3(r->hanWin, FONT_NORMAL, 10, i * 13, r->textColor, 0, label);
+        if (i != 0)
+        {
+            ConvertIntToDecimalStringN(buf, i == 1 ? HanPicNumber(gSaveBlock2Ptr->hanLook[HAN_LOOK_PIC]) : gSaveBlock2Ptr->hanLook[HAN_LOOK_PAL], STR_CONV_MODE_LEFT_ALIGN, 3);
+            AddTextPrinterParameterized3(r->hanWin, FONT_NORMAL, 88, i * 13, r->textColor, 0, buf);
+        }
+    }
+    while (IsTextPrinterActive(r->hanWin))
+        RunTextPrinters(); // all the letters at once, so no half-drawn frame is shown
+    CopyWindowToVram(r->hanWin, COPYWIN_GFX);
+}
+
+static void Task_HanBoyGirl_Input(u8 taskId)
+{
+    struct OakSpeechResources *r = sOakSpeechResources;
+    u8 *l = gSaveBlock2Ptr->hanLook;
+    u8 part, max;
+    bool8 redraw = FALSE;
+
+    if (JOY_NEW(DPAD_UP) && r->hanRow > 0)
+    {
+        r->hanRow--;
+        redraw = TRUE;
+    }
+    else if (JOY_NEW(DPAD_DOWN) && r->hanRow < 2)
+    {
+        r->hanRow++;
+        redraw = TRUE;
+    }
+    else if (JOY_NEW(DPAD_LEFT) || JOY_NEW(DPAD_RIGHT))
+    {
+        if (r->hanRow == 0)
+        {
+            // swap boy and girl: its body, and the look that goes with it
+            gSaveBlock2Ptr->playerGender = gSaveBlock2Ptr->playerGender == MALE ? FEMALE : MALE;
+            if (l[HAN_LOOK_SET] != 2)
+                l[HAN_LOOK_SET] = 0;
+            else if (!HanPicFits(l[HAN_LOOK_PIC], gSaveBlock2Ptr->playerGender))
+                l[HAN_LOOK_PIC] = 0; // a picture of the other gender goes back to the game's own
+        }
+        else
+        {
+            part = r->hanRow == 1 ? HAN_LOOK_PIC : HAN_LOOK_PAL;
+            max = HanLookMax(part);
+            if (l[HAN_LOOK_SET] == 0)
+                HanLookDefault();
+            if (part == HAN_LOOK_PIC)
+                l[part] = HanPicStep(l[part], JOY_NEW(DPAD_RIGHT) ? 1 : -1, gSaveBlock2Ptr->playerGender);
+            else
+                l[part] = JOY_NEW(DPAD_RIGHT) ? (l[part] + 1) % max : (l[part] + max - 1) % max;
+            l[HAN_LOOK_SET] = 2;
+        }
+        redraw = TRUE;
+        HanEd_ShowPreview();
+    }
+    else if (JOY_NEW(A_BUTTON))
+    {
+        gTasks[taskId].func = Task_OakSpeech_ClearGenderWindows;
+        return;
+    }
+    if (redraw)
+    {
+        PlaySE(SE_SELECT);
+        HanEd_Draw();
+    }
+}
