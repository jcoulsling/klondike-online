+
+static void SpriteCB_SelectionHand(struct Sprite *sprite)
+{
+    // Float up and down above selected Poké Ball
+    sprite->x = sCursorCoords[gTasks[sprite->data[0]].tStarterSelection][0];
+    sprite->y = sCursorCoords[gTasks[sprite->data[0]].tStarterSelection][1];
+    sprite->y2 = Sin(sprite->data[1], 8);
+    sprite->data[1] = (u8)(sprite->data[1]) + 4;
+}
+
+static void SpriteCB_Pokeball(struct Sprite *sprite)
+{
+    // Animate Poké Ball if currently selected
+    if (gTasks[sprite->sTaskId].tStarterSelection == sprite->sBallId)
+        StartSpriteAnimIfDifferent(sprite, 1);
+    else
+        StartSpriteAnimIfDifferent(sprite, 0);
+}
+
+static void SpriteCB_StarterPokemon(struct Sprite *sprite)
+{
+    // Move sprite to upper center of screen
+    if (sprite->x > STARTER_PKMN_POS_X)
+        sprite->x -= 4;
+    if (sprite->x < STARTER_PKMN_POS_X)
+        sprite->x += 4;
+    if (sprite->y > STARTER_PKMN_POS_Y)
+        sprite->y -= 2;
+    if (sprite->y < STARTER_PKMN_POS_Y)
+        sprite->y += 2;
+}
+
+
+// Professor Birch calls a bird and flies off across the screen (VAR_0x8004 = his local id on this map)
+void HanBirchFlyAway(void)
+{
+    u8 id = GetObjectEventIdByLocalIdAndMap(gSpecialVar_0x8004, gSaveBlock1Ptr->location.mapNum, gSaveBlock1Ptr->location.mapGroup);
+
+    if (id >= OBJECT_EVENTS_COUNT)
+        return;
+    gFieldEffectArguments[0] = gObjectEvents[id].spriteId;
+    FieldEffectStart(FLDEFF_NPCFLY_OUT);
+}
+
+// Professor Birch comes to the player: VAR_0x8004 = his local id. He is put four tiles to the player's left, facing right, if the
+// four tiles are free (VAR_RESULT = 1: then he walks three tiles up to the player); otherwise he is put next to the player (0).
+void HanBirchCome(void)
+{
+    s16 x, y;
+    u8 i, id;
+    bool8 free = TRUE;
+
+    PlayerGetDestCoords(&x, &y);
+    for (i = 1; i <= 4; i++)
+    {
+        u8 beh = MapGridGetMetatileBehaviorAt(x - i, y);
+
+        if (MapGridGetCollisionAt(x - i, y) != 0 || MetatileBehavior_IsSurfable(beh))
+            free = FALSE;
+    }
+    gSpecialVar_Result = free;
+    TryMoveObjectEventToMapCoords(gSpecialVar_0x8004, gSaveBlock1Ptr->location.mapNum, gSaveBlock1Ptr->location.mapGroup,
+                                  x - MAP_OFFSET - (free ? 4 : 1), y - MAP_OFFSET);
+    id = GetObjectEventIdByLocalIdAndMap(gSpecialVar_0x8004, gSaveBlock1Ptr->location.mapNum, gSaveBlock1Ptr->location.mapGroup);
+    if (id < OBJECT_EVENTS_COUNT)
+        ObjectEventTurn(&gObjectEvents[id], DIR_EAST);
+}
diff --git a/src/han_syllabics_core.h b/src/han_syllabics_core.h
new file mode 100644
index 0000000..4828587
--- /dev/null
+++ b/src/han_syllabics_core.h
@@ -0,0 +1,206 @@
+// Hän build: turns Latin Hän text into Jane's Hän syllabics, a syllable at a time.
+//
+// It follows the converter in her word processor (han-word-processor.html: tokenize,
+// eaglePreprocess, matchV), set as that page starts: the Eagle way of writing finals,
+// and a letter y between a consonant and its vowel shown as a dot.
+// Two things differ on purpose:
+//  - The end of a string counts as the end of a word. The word processor treats the very
+//    end of its text as a consonant still waiting for a vowel, which only suits typing.
+//  - th, dh, tth, ddh, sr, zr, tr, dr and zh have no final in her font, so here they have none.
+//
+// This file has no game code in it, so the same lines can be compiled on a computer and
+// checked against the word processor (tools/han/syllabics_test.c).
+// It needs u8, u16, bool8, TRUE and FALSE, and the tables in data/han_syllabics.h.
+
+#define HAN_SYL_NONE   0 // not syllabics: show the character the usual way
+#define HAN_SYL_GLYPH  1
+#define HAN_SYL_SKIP   2 // shows nothing
+
+#define HAN_SYL_MARK_NASAL  1
+#define HAN_SYL_MARK_TONE   2
+#define HAN_SYL_MARK_DOT    4
+
+#define HAN_SYL_ONSET_COUNT (sizeof(sHanSylOnsets) / sizeof(sHanSylOnsets[0]))
+#define HAN_SYL_PRENASAL_COUNT (sizeof(sHanSylPrenasal) / sizeof(sHanSylPrenasal[0]))
+
+static u8 HanSyl_Letter(const u8 *s)
+{
+    return sHanSylLetters[*s] & HAN_SYL_LETTER_MASK;
+}
+
+static bool8 HanSyl_VowelAt(const u8 *s)
+{
+    switch (HanSyl_Letter(s))
+    {
+    case HAN_SYL_L_A:
+    case HAN_SYL_L_E:
+    case HAN_SYL_L_I:
+    case HAN_SYL_L_O:
+    case HAN_SYL_L_U:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// The letters at s spell this onset.
+static bool8 HanSyl_Match(const u8 *s, const u8 *letters, u8 length)
+{
+    u8 i;
+
+    for (i = 0; i < length; i++)
+    {
+        if (HanSyl_Letter(s + i) != letters[i])
+            return FALSE;
+    }
+    return TRUE;
+}
+
+// Reads the vowel at s. Gives its column in the grid and its marks. Returns how many characters it took:
+// two when the vowel is written twice, which counts as one and keeps the marks of the first.
+static u8 HanSyl_ReadVowel(const u8 *s, u8 *column, u8 *marks)
+{
+    u8 info = sHanSylLetters[*s];
+    u8 letter = info & HAN_SYL_LETTER_MASK;
+    bool8 dots = (info & HAN_SYL_DIAERESIS) != 0;
+
+    switch (letter)
+    {
+    case HAN_SYL_L_A:
+        *column = dots ? 0 : 1;
+        break;
+    case HAN_SYL_L_E:
+        *column = dots ? 2 : 3;
+        break;
+    case HAN_SYL_L_I:
+        *column = 4;
+        break;
+    case HAN_SYL_L_O:
+        *column = dots ? 2 : 5; // ö is written as ë
+        break;
+    default:
+        *column = 6;
+        break;
+    }
+    if (info & HAN_SYL_NASAL_HOOK)
+        *marks |= HAN_SYL_MARK_NASAL;
+    if (info & HAN_SYL_GRAVE)
+        *marks |= HAN_SYL_MARK_TONE;
+    return HanSyl_Letter(s + 1) == letter ? 2 : 1;
+}
+
+// Reads the next piece of the text at s. For HAN_SYL_GLYPH it gives the glyph and the marks that follow it.
+// used is how many characters of the text the piece took.
+static u8 HanSyl_Next(const u8 *s, u16 *glyph, u8 *used, u8 *marks)
+{
+    const struct HanSylOnset *onset;
+    u8 letter = HanSyl_Letter(s);
+    u8 next, column, i;
+    bool8 dot;
+
+    *marks = 0;
+    *used = 1;
+    if (letter == 0)
+        return HAN_SYL_NONE;
+
+    // An apostrophe that is not part of t', k' and the like is the glottal stop.
+    if (letter == HAN_SYL_APOSTROPHE)
+    {
+        *glyph = HAN_SYL_FINALS_BASE + HAN_SYL_FINAL_GLOTTAL;
+        return HAN_SYL_GLYPH;
+    }
+
+    // n, l, w, y and r at the end of a syllable, the Eagle way: n, nn and nh are all one n final.
+    if (letter == HAN_SYL_L_N || letter == HAN_SYL_L_L || letter == HAN_SYL_L_W || letter == HAN_SYL_L_Y || letter == HAN_SYL_L_R)
+    {
+        next = HanSyl_Letter(s + 1);
+        if ((next == letter || next == HAN_SYL_L_H) && !HanSyl_VowelAt(s + 2))
+        {
+            *used = 2;
+            if (next == letter && letter != HAN_SYL_L_N && letter != HAN_SYL_L_R
+             && HanSyl_Letter(s + 2) == letter && !HanSyl_VowelAt(s + 3))
+                *used = 3;
+            for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+            {
+                onset = &sHanSylOnsets[i];
+                if (onset->length == 1 && onset->letters[0] == letter)
+                    break;
+            }
+            *glyph = HAN_SYL_FINALS_BASE + onset->final;
+            if (sHanSylLetters[*s] & HAN_SYL_GRAVE)
+                *marks = HAN_SYL_MARK_TONE;
+            return HAN_SYL_GLYPH;
+        }
+    }
+
+    // nd, mb, nj, ng and ndz before a vowel: an n final, then the syllable.
+    for (i = 0; i < HAN_SYL_PRENASAL_COUNT; i++)
+    {
+        if (HanSyl_Match(s, &sHanSylPrenasal[i][1], sHanSylPrenasal[i][0]) && HanSyl_VowelAt(s + sHanSylPrenasal[i][0]))
+        {
+            *glyph = HAN_SYL_FINALS_BASE + HAN_SYL_FINAL_N;
+            return HAN_SYL_GLYPH;
+        }
+    }
+
+    // A consonant and a vowel, with or without a y between them.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (!HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        dot = HanSyl_Letter(s + onset->length) == HAN_SYL_L_Y && HanSyl_VowelAt(s + onset->length + 1);
+        if (!dot && !HanSyl_VowelAt(s + onset->length))
+            continue;
+        if (onset->lead != HAN_SYL_NO) // tth is a t final and then th
+        {
+            *glyph = HAN_SYL_FINALS_BASE + onset->lead;
+            return HAN_SYL_GLYPH;
+        }
+        if (onset->row == HAN_SYL_NO)  // r and ng have no syllables
+            return HAN_SYL_NONE;
+        *used = onset->length + dot;
+        *used += HanSyl_ReadVowel(s + *used, &column, marks);
+        if (dot)
+            *marks |= HAN_SYL_MARK_DOT;
+        *glyph = onset->row * HAN_SYL_VOWELS + column;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A vowel with no consonant.
+    if (HanSyl_VowelAt(s))
+    {
+        *used = HanSyl_ReadVowel(s, &column, marks);
+        *glyph = HAN_SYL_ROW_VOWEL * HAN_SYL_VOWELS + column;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A consonant with no vowel after it: its final, if it has one.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (onset->final == HAN_SYL_NO || !HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        if (onset->ejectiveBase && HanSyl_Letter(s + onset->length) == HAN_SYL_APOSTROPHE)
+            break;
+        *used = onset->length;
+        *glyph = HAN_SYL_FINALS_BASE + onset->final;
+        if (sHanSylLetters[*s] & HAN_SYL_GRAVE)
+            *marks = HAN_SYL_MARK_TONE;
+        return HAN_SYL_GLYPH;
+    }
+
+    // A consonant that has no final. The word processor leaves it out, unless its last letter can stand as a final.
+    for (i = 0; i < HAN_SYL_ONSET_COUNT; i++)
+    {
+        onset = &sHanSylOnsets[i];
+        if (!HanSyl_Match(s, onset->letters, onset->length))
+            continue;
+        if (HanSyl_Letter(s + onset->length) != HAN_SYL_APOSTROPHE && !onset->endsInFinal)
+        {
+            *used = onset->length;
+            return HAN_SYL_SKIP;
+        }
+        break;
+    }
+    return HAN_SYL_NONE;
+}
diff --git a/src/han_tower.c b/src/han_tower.c
new file mode 100644
index 0000000..60bd5b6
--- /dev/null
+++ b/src/han_tower.c
@@ -0,0 +1,156 @@
+#include "global.h"
+#include "han_tower.h"
+#include "battle.h"
+#include "event_data.h"
+#include "field_player_avatar.h"
+#include "load_save.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "random.h"
+#include "constants/flags.h"
+#include "constants/maps.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+#include "constants/trainers.h"
+
+// Hän build: the TRAINER TOWER from the POKéMON CENTER. The nurse offers a way in, and at the lobby counter the
+// team is chosen: your own at level 50 (raised or lowered to it), or one of three rental teams. One of the
+// three has a one in three chance to be BRANDON's team instead. The real party is kept in the saved copy
+// (gSaveBlock1Ptr->playerParty) the whole time, and saving does not overwrite it while FLAG_HAN_TOWER_TEMP_PARTY
+// is up, so a reset or a save in the middle of a challenge never costs anyone their own team.
+
+#define TOWER_LEVEL 50
+
+struct HanRental
+{
+    u16 species;
+    u16 moves[MAX_MON_MOVES];
+};
+
+static const struct HanRental sRentals[3][PARTY_SIZE] = {
+    { // A: all round
+        { SPECIES_SNORLAX,   { MOVE_BODY_SLAM, MOVE_EARTHQUAKE, MOVE_SHADOW_BALL, MOVE_REST } },
+        { SPECIES_GENGAR,    { MOVE_SHADOW_BALL, MOVE_THUNDERBOLT, MOVE_ICE_PUNCH, MOVE_HYPNOSIS } },
+        { SPECIES_STARMIE,   { MOVE_SURF, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_RECOVER } },
+        { SPECIES_DRAGONITE, { MOVE_DRAGON_CLAW, MOVE_EARTHQUAKE, MOVE_FIRE_PUNCH, MOVE_THUNDER_WAVE } },
+        { SPECIES_ALAKAZAM,  { MOVE_PSYCHIC, MOVE_SHADOW_BALL, MOVE_THUNDER_WAVE, MOVE_RECOVER } },
+        { SPECIES_GYARADOS,  { MOVE_SURF, MOVE_EARTHQUAKE, MOVE_ICE_BEAM, MOVE_DRAGON_DANCE } },
+    },
+    { // B: hard hitters and walls
+        { SPECIES_CHARIZARD, { MOVE_FLAMETHROWER, MOVE_EARTHQUAKE, MOVE_DRAGON_CLAW, MOVE_ROCK_SLIDE } },
+        { SPECIES_VENUSAUR,  { MOVE_SLEEP_POWDER, MOVE_GIGA_DRAIN, MOVE_SLUDGE_BOMB, MOVE_SYNTHESIS } },
+        { SPECIES_BLASTOISE, { MOVE_SURF, MOVE_ICE_BEAM, MOVE_EARTHQUAKE, MOVE_REST } },
+        { SPECIES_SCIZOR,    { MOVE_SWORDS_DANCE, MOVE_STEEL_WING, MOVE_BRICK_BREAK, MOVE_QUICK_ATTACK } },
+        { SPECIES_SKARMORY,  { MOVE_DRILL_PECK, MOVE_STEEL_WING, MOVE_TOXIC, MOVE_ROAR } },
+        { SPECIES_TYRANITAR, { MOVE_CRUNCH, MOVE_EARTHQUAKE, MOVE_ROCK_SLIDE, MOVE_FIRE_BLAST } },
+    },
+    { // C: fast and tricky
+        { SPECIES_JOLTEON,   { MOVE_THUNDERBOLT, MOVE_SHADOW_BALL, MOVE_THUNDER_WAVE, MOVE_SUBSTITUTE } },
+        { SPECIES_MACHAMP,   { MOVE_CROSS_CHOP, MOVE_EARTHQUAKE, MOVE_ROCK_SLIDE, MOVE_FIRE_PUNCH } },
+        { SPECIES_LAPRAS,    { MOVE_SURF, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_CONFUSE_RAY } },
+        { SPECIES_AERODACTYL,{ MOVE_ROCK_SLIDE, MOVE_EARTHQUAKE, MOVE_AERIAL_ACE, MOVE_TAKE_DOWN } },
+        { SPECIES_GARDEVOIR, { MOVE_PSYCHIC, MOVE_THUNDERBOLT, MOVE_CALM_MIND, MOVE_SHADOW_BALL } },
+        { SPECIES_ARCANINE,  { MOVE_FLAMETHROWER, MOVE_EXTREME_SPEED, MOVE_EARTHQUAKE, MOVE_ROAR } },
+    },
+};
+
+static EWRAM_DATA bool8 sBrandonOffered = FALSE;
+
+static void SetMonToTowerLevel(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u32 exp = gExperienceTables[gSpeciesInfo[species].growthRate][TOWER_LEVEL];
+
+    SetMonData(mon, MON_DATA_EXP, &exp);
+    CalculateMonStats(mon);
+}
+
+static void BuildRentalTeam(u8 team)
+{
+    u8 i, j, count = 0;
+    u8 ivs = 31;
+
+    ZeroPlayerPartyMons();
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        const struct HanRental *r = &sRentals[team][i];
+        u8 evs = 85;
+
+        CreateMon(&gPlayerParty[i], r->species, TOWER_LEVEL, ivs, FALSE, 0, OT_ID_PLAYER_ID, 0);
+        for (j = 0; j < MAX_MON_MOVES; j++)
+        {
+            SetMonData(&gPlayerParty[i], MON_DATA_MOVE1 + j, &r->moves[j]);
+            SetMonData(&gPlayerParty[i], MON_DATA_PP1 + j, &gBattleMoves[r->moves[j]].pp);
+        }
+        for (j = 0; j < NUM_STATS; j++)
+            SetMonData(&gPlayerParty[i], MON_DATA_HP_EV + j, &evs);
+        CalculateMonStats(&gPlayerParty[i]);
+        count++;
+    }
+    gPlayerPartyCount = count;
+}
+
+// 1 when BRANDON's team takes the place of rental team C in this offer
+u8 HanTowerRollSpecial(void)
+{
+    sBrandonOffered = (Random() % 3) == 0;
+    return sBrandonOffered;
+}
+
+// the nurse has offered the way in
+void HanTowerSetReturn(void)
+{
+    FlagSet(FLAG_HAN_TOWER_FROM_CENTER);
+}
+
+// every time the lobby loads: where its door leads. From a POKéMON CENTER it is the last place healed (the same
+// place a white out goes to), otherwise Seven Island, as in the original game.
+void HanTowerApplyReturn(void)
+{
+    if (FlagGet(FLAG_HAN_TOWER_FROM_CENTER))
+    {
+        struct WarpData *w = &gSaveBlock1Ptr->lastHealLocation;
+
+        SetDynamicWarpWithCoords(0, w->mapGroup, w->mapNum, -1, w->x, w->y);
+    }
+    else
+        SetDynamicWarpWithCoords(0, MAP_GROUP(MAP_SEVEN_ISLAND_TRAINER_TOWER), MAP_NUM(MAP_SEVEN_ISLAND_TRAINER_TOWER), -1, 58, 8);
+}
+
+// gSpecialVar_0x8004: 0 your own team, 1 to 3 the rental teams (3 is BRANDON's when he was offered). FALSE: not possible.
+bool8 HanTowerBuildTeam(void)
+{
+    u8 choice = gSpecialVar_0x8004;
+    u8 i;
+
+    if (choice == 0)
+    {
+        // your own team needs a Pokémon that can fight (the tower heals it first)
+        SavePlayerParty();
+        FlagSet(FLAG_HAN_TOWER_TEMP_PARTY);
+        for (i = 0; i < gPlayerPartyCount; i++)
+            SetMonToTowerLevel(&gPlayerParty[i]);
+        return TRUE;
+    }
+    SavePlayerParty();
+    FlagSet(FLAG_HAN_TOWER_TEMP_PARTY);
+    if (choice == 3 && sBrandonOffered)
+    {
+        HanTowerCopyTrainerTeam(TRAINER_LEADER_KOGA); // BRANDON
+        for (i = 0; i < gPlayerPartyCount; i++)
+            SetMonToTowerLevel(&gPlayerParty[i]);
+        return TRUE;
+    }
+    BuildRentalTeam(choice - 1);
+    return TRUE;
+}
+
+// the lobby is where every challenge ends: the player's own team comes back
+void HanTowerRestoreParty(void)
+{
+    if (FlagGet(FLAG_HAN_TOWER_TEMP_PARTY))
+    {
+        LoadPlayerParty();
+        FlagClear(FLAG_HAN_TOWER_TEMP_PARTY);
+    }
+}
diff --git a/src/han_trade.c b/src/han_trade.c
new file mode 100644
index 0000000..d240834
--- /dev/null
+++ b/src/han_trade.c
@@ -0,0 +1,383 @@
+#include "global.h"
+#include "gflib.h"
+#include "battle.h"
+#include "load_save.h"
+#include "main.h"
+#include "overworld.h"
+#include "link.h"
+#include "constants/cable_club.h"
+#include "constants/trainers.h"
+#include "event_data.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "han_custom.h"
+#include "han_multiplayer.h"
+#include "pokedex.h"
+#include "pokemon.h"
+#include "script.h"
+#include "string_util.h"
+#include "constants/songs.h"
+#include "constants/species.h"
+#include "sound.h"
+
+// Hän build: trading Pokémon with another player of the room (Jane, 22 November 2026).
+//
+// Face another player and press A. They are asked, each picks a Pokémon, each sees what the other offers, and if both
+// say yes the two Pokémon swap places in the parties. The messages go through the page like the positions do
+// (struct HanTradeBox in han_multiplayer.h):
+//   A: OFFER(monA) -> B: shows it, B picks monB, COUNTER(monB) -> A: shows it, A says yes, ACCEPT, A swaps at once
+//   B: gets ACCEPT, swaps. Either side can CANCEL, and each gives up after about 20 seconds without an answer.
+// If the connection drops between A's swap and B's, A has both Pokémon: this is for friends.
+
+extern const u8 Han_Trade_Initiate[];
+extern const u8 Han_Trade_Incoming[];
+extern const u8 Han_Battle_Incoming[];
+
+static EWRAM_DATA u8 sPeer = 0;        // the other player's slot
+static EWRAM_DATA u8 sMySlot = 0;      // my party slot that is offered
+static EWRAM_DATA u8 sBusy = 0;        // 1 I started, 2 someone started
+static EWRAM_DATA u8 sLastIn = 0;      // in.seq already looked at
+static EWRAM_DATA u8 sGot = 0;         // 0 nothing yet, 1 counter or accept came, 2 cancel came
+static EWRAM_DATA u8 sKind = 0;
+static EWRAM_DATA u8 sRemoteDone = 0;
+
+static void Send(u8 kind, const struct BoxPokemon *mon)
+{
+    struct HanTradeBox *o = &gHanMailbox.out;
+
+    o->kind = kind;
+    o->slot = sPeer;
+    if (mon != NULL)
+        CpuCopy16(mon, o->mon, sizeof(struct BoxPokemon));
+    o->seq++;
+}
+
+// A Pokémon can go if it is not the last one that is left to fight and is not an egg that would leave only eggs.
+static bool8 CanSend(u8 slot)
+{
+    u8 i, others = 0;
+
+    if (slot >= PARTY_SIZE || GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES) == SPECIES_NONE)
+        return FALSE;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (i != slot && GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE
+         && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG) && GetMonData(&gPlayerParty[i], MON_DATA_HP) > 0)
+            others++;
+    return others > 0 && !GetMonData(&gPlayerParty[slot], MON_DATA_IS_EGG);
+}
+
+static void Swap(const struct BoxPokemon *incoming)
+{
+    struct Pokemon *mon = &gPlayerParty[sMySlot];
+    u32 zero = 0;
+    u8 level;
+    u16 hp, species;
+
+    ZeroMonData(mon);
+    mon->box = *incoming;
+    SetMonData(mon, MON_DATA_STATUS, &zero);
+    level = GetLevelFromBoxMonExp(&mon->box);
+    SetMonData(mon, MON_DATA_LEVEL, &level);
+    CalculateMonStats(mon);
+    hp = GetMonData(mon, MON_DATA_MAX_HP);
+    SetMonData(mon, MON_DATA_HP, &hp);
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_SEEN);
+    GetSetPokedexFlag(SpeciesToNationalPokedexNum(species), FLAG_SET_CAUGHT);
+    PlaySE(SE_SUCCESS);
+}
+
+// ---- specials, called from the scripts in data/scripts/han_trade.inc
+
+// my chosen Pokémon is gSpecialVar_0x8004; FALSE if it cannot go
+u16 HanTradeOffer(void)
+{
+    if (!CanSend(gSpecialVar_0x8004))
+        return FALSE;
+    sMySlot = gSpecialVar_0x8004;
+    sGot = 0;
+    Send(HAN_T_OFFER, &gPlayerParty[sMySlot].box);
+    return TRUE;
+}
+
+// B has chosen (gSpecialVar_0x8004) after an offer: send the counter
+u16 HanTradeCounter(void)
+{
+    if (!CanSend(gSpecialVar_0x8004))
+        return FALSE;
+    sMySlot = gSpecialVar_0x8004;
+    sGot = 0;
+    Send(HAN_T_COUNTER, &gPlayerParty[sMySlot].box);
+    return TRUE;
+}
+
+// 0 nothing yet, 1 the answer came (a counter for A, an accept for B), 2 the other side said no
+u16 HanTradePoll(void)
+{
+    struct HanTradeBox *in = &gHanMailbox.in;
+
+    if (in->seq != sLastIn)
+    {
+        sLastIn = in->seq;
+        if (in->slot == sPeer)
+        {
+            if (in->kind == HAN_T_CANCEL)
+                sGot = 2;
+            else if ((sBusy == 1 && in->kind == HAN_T_COUNTER) || (sBusy == 2 && in->kind == HAN_T_ACCEPT))
+            {
+                sGot = 1;
+                sKind = in->kind;
+            }
+        }
+    }
+    return sGot;
+}
+
+// names for the messages: {STR_VAR_1} the Pokémon coming in, {STR_VAR_2} mine that goes
+void HanTradeNames(void)
+{
+    GetSpeciesName(gStringVar1, GetBoxMonData((struct BoxPokemon *)gHanMailbox.in.mon, MON_DATA_SPECIES));
+    GetSpeciesName(gStringVar2, GetMonData(&gPlayerParty[sMySlot], MON_DATA_SPECIES));
+}
+
+// B is shown the offer before choosing
+void HanTradeNameIn(void)
+{
+    GetSpeciesName(gStringVar1, GetBoxMonData((struct BoxPokemon *)gHanMailbox.in.mon, MON_DATA_SPECIES));
+}
+
+// A says yes: swap, and tell B
+void HanTradeAccept(void)
+{
+    Swap((const struct BoxPokemon *)gHanMailbox.in.mon);
+    Send(HAN_T_ACCEPT, NULL);
+    sBusy = 0;
+}
+
+// B's side after the accept came: A's offer, still in the buffer (accept and cancel carry no Pokémon), comes
+void HanTradeApply(void)
+{
+    Swap((const struct BoxPokemon *)gHanMailbox.in.mon);
+    sBusy = 0;
+}
+
+void HanTradeCancel(void)
+{
+    if (sBusy)
+        Send(HAN_T_CANCEL, NULL);
+    sBusy = 0;
+}
+
+void HanTradeDone(void)
+{
+    sBusy = 0;
+}
+
+
+// ---- battling: the game's own link battle, with the page as the cable (src/han_link.c)
+
+static void BuildLinkPlayer(struct LinkPlayer *lp)
+{
+    u8 *b = (u8 *)lp;
+    u8 i;
+
+    for (i = 0; i < sizeof(*lp); i++)
+        b[i] = 0;
+    lp->trainerId = gSaveBlock2Ptr->playerTrainerId[0] | (gSaveBlock2Ptr->playerTrainerId[1] << 8)
+                  | (gSaveBlock2Ptr->playerTrainerId[2] << 16) | (gSaveBlock2Ptr->playerTrainerId[3] << 24);
+    StringCopy(lp->name, gSaveBlock2Ptr->playerName);
+    lp->gender = gSaveBlock2Ptr->playerGender;
+    lp->linkType = LINKTYPE_BATTLE;
+    lp->language = gGameLanguage;
+    lp->version = gGameVersion + 0x4000;
+    lp->lp_field_2 = 0x8000;
+    HanLookPicPal(&lp->neverRead, &lp->progressFlagsCopy); // the chosen picture and palette go with it
+}
+
+static const u8 gText_HanDouble[] = _("double");
+static const u8 gText_HanSingle[] = _("single");
+static EWRAM_DATA u8 sDouble = 0;   // the battle that was asked for is a double battle
+
+// at least `need` Pokémon that can fight (2 for a double battle)
+static bool8 CanBattle(u8 need)
+{
+    u8 i, n = 0;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP) > 0)
+            n++;
+    return n >= need;
+}
+
+// A asks (gSpecialVar_0x8004 is 1 for a double battle): FALSE if I have too few that can fight
+u16 HanBattleChallenge(void)
+{
+    struct LinkPlayer lp;
+
+    sDouble = gSpecialVar_0x8004 != 0;
+    if (!CanBattle(sDouble ? 2 : 1))
+        return FALSE;
+    BuildLinkPlayer(&lp);
+    lp.id = sDouble;   // (the id is set again when the link starts)
+    CpuCopy16(&lp, gHanMailbox.out.mon, sizeof(struct LinkPlayer));
+    Send(HAN_T_CHALLENGE, NULL);
+    sGot = 0;
+    return TRUE;
+}
+
+// 0 nothing yet, 1 yes, 2 no
+u16 HanBattlePoll(void)
+{
+    struct HanTradeBox *in = &gHanMailbox.in;
+
+    if (in->seq != sLastIn)
+    {
+        sLastIn = in->seq;
+        if (in->slot == sPeer)
+        {
+            if (in->kind == HAN_T_BATTLE_OK)
+            {
+                sGot = 1;
+                sRemoteDone = 1;
+            }
+            else if (in->kind == HAN_T_BATTLE_NO || in->kind == HAN_T_CANCEL)
+                sGot = 2;
+        }
+    }
+    return sGot;
+}
+
+// B is shown the challenge: {STR_VAR_1} is "single" or "double"
+void HanBattleKindName(void)
+{
+    struct LinkPlayer theirs;
+
+    CpuCopy16(gHanMailbox.in.mon, &theirs, sizeof(struct LinkPlayer));
+    StringCopy(gStringVar1, theirs.id != 0 ? gText_HanDouble : gText_HanSingle);
+}
+
+// B says yes: the link starts as player 1, and A is told
+u16 HanBattleAccept(void)
+{
+    struct LinkPlayer mine, theirs;
+
+    CpuCopy16(gHanMailbox.in.mon, &theirs, sizeof(struct LinkPlayer));
+    sDouble = theirs.id != 0;
+    if (!CanBattle(sDouble ? 2 : 1))
+        return FALSE;
+    BuildLinkPlayer(&mine);
+    HanLinkStart(1, sPeer, &mine, &theirs);
+    CpuCopy16(&mine, gHanMailbox.out.mon, sizeof(struct LinkPlayer));
+    Send(HAN_T_BATTLE_OK, NULL);
+    return TRUE;
+}
+
+void HanBattleRefuse(void)
+{
+    Send(HAN_T_BATTLE_NO, NULL);
+    sBusy = 0;
+}
+
+static void CB2_HanBattleReturn(void)
+{
+    switch (gMain.state)
+    {
+    case 0:
+        gBattleTypeFlags &= ~BATTLE_TYPE_LINK_IN_BATTLE;
+        LoadPlayerParty();
+        if (gHanMailbox.link.on)
+            SetCloseLinkCallback();
+        gMain.state++;
+        break;
+    case 1:
+        if (!gHanMailbox.link.on && IsLinkTaskFinished())
+            SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+        break;
+    }
+}
+
+// both players: go into the battle. A (player 0) has its answer in in.mon, B has already started the link.
+void HanBattleLaunch(void)
+{
+    struct LinkPlayer mine, theirs;
+
+    if (sBusy == 1)
+    {
+        BuildLinkPlayer(&mine);
+        CpuCopy16(gHanMailbox.in.mon, &theirs, sizeof(struct LinkPlayer));
+        HanLinkStart(0, sPeer, &mine, &theirs);
+    }
+    sBusy = 0;
+    SavePlayerParty();
+    gLinkType = LINKTYPE_BATTLE;
+    gSpecialVar_0x8004 = sDouble ? USING_DOUBLE_BATTLE : USING_SINGLE_BATTLE;
+    gBattleTypeFlags = BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK | (sDouble ? BATTLE_TYPE_DOUBLE : 0);
+    PlayMapChosenOrBattleBGM(MUS_RS_VS_TRAINER);
+    CleanupOverworldWindowsAndTilemaps();
+    gTrainerBattleOpponent_A = TRAINER_LINK_OPPONENT;
+    gMain.savedCallback = CB2_HanBattleReturn;
+    SetMainCallback2(CB2_InitBattle);
+}
+
+// ---- every frame in the overworld
+
+static bool8 FrontPlayer(u8 *slot)
+{
+    s16 x, y;
+    u8 i;
+
+    GetXYCoordsOneStepInFrontOfPlayer(&x, &y);
+    x -= MAP_OFFSET;
+    y -= MAP_OFFSET;
+    for (i = 0; i < HAN_OTHERS; i++)
+    {
+        if (gHanMailbox.others[i].active && gHanMailbox.spriteIds[i] != MAX_SPRITES
+         && gHanMailbox.others[i].x == x && gHanMailbox.others[i].y == y)
+        {
+            *slot = i;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+void HanTradeFrame(void)
+{
+    struct HanTradeBox *in = &gHanMailbox.in;
+    u8 slot;
+
+    if (sBusy || ArePlayerFieldControlsLocked())
+    {
+        return;
+    }
+    if (in->seq != sLastIn && in->kind == HAN_T_OFFER)
+    {
+        // someone offers a trade
+        sLastIn = in->seq;
+        sPeer = in->slot;
+        sBusy = 2;
+        sGot = 0;
+        ScriptContext_SetupScript(Han_Trade_Incoming);
+        return;
+    }
+    if (in->seq != sLastIn && in->kind == HAN_T_CHALLENGE)
+    {
+        sLastIn = in->seq;
+        sPeer = in->slot;
+        sBusy = 2;
+        sGot = 0;
+        ScriptContext_SetupScript(Han_Battle_Incoming);
+        return;
+    }
+    if (in->seq != sLastIn)
+        sLastIn = in->seq; // a message for a trade that is over
+    if (JOY_NEW(A_BUTTON) && gPlayerAvatar.tileTransitionState == T_NOT_MOVING && FrontPlayer(&slot))
+    {
+        sPeer = slot;
+        sBusy = 1;
+        sGot = 0;
+        ScriptContext_SetupScript(Han_Trade_Initiate);
+    }
+}
