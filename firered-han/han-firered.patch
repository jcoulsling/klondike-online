+    "seviper": "S EH V AY P ER0", "relicanth": "R EH L IH K AE N TH", "aggron": "AE G R AA N",
+    "lileep": "L IH L IY P", "cradily": "K R EY D IH L IY", "ralts": "R AA L T S", "gardevoir": "G AA R D AH0 V AA R",
